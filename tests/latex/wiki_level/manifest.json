      "concepts": ["proposition", "implication", "negation", "contradiction"],
      "expected_imports": [],
      "expected_mathlib_declarations": [],
      "pipeline_checks": [
        "latex_expansion_binding_review",
        "lean_syntactic_correctness",
        "lean_semantic_preservation",
        "lean_execution"
      ]
    },
    {
      "id": "wiki_injective_composition",
