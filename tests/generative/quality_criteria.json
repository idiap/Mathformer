{
  "schema_version": 1,
  "shared_criteria": [
    "source_fidelity",
    "explicit_uncertainty",
    "no_unsupported_completion_claims",
    "no_hidden_strengthening",
    "actionable_blocker_reporting",
    "preservation_of_literal_anchors",
    "backend_specific_api_or_library_grounding"
  ],
  "required_fields": [
    "probe_id",
    "source_excerpt",
    "expected_blocker_class",
    "forbidden_claims",
    "minimum_source_anchor_evidence",
    "required_handoff_skill"
  ],
  "scoring": {
    "pass_threshold": 0.8,
    "critical_probe_threshold": 0.95,
    "failed_high_risk_probe_action": "convert_to_regression_fixture"
  }
}
