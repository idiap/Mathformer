{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mathformer Source Formalizable Unit Inventory",
  "type": "object",
  "required": ["source", "units", "summary"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": {"type": "string"},
        "url": {"type": "string"},
        "retrieved_at_utc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["unit_count", "kind_counts", "high_priority_count"],
      "properties": {
        "unit_count": {"type": "integer", "minimum": 0},
        "kind_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "high_priority_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "section",
          "source_span",
          "formalization_signal",
          "proof_present",
          "dependencies",
          "mathlib_concepts",
          "suggested_lean_surface",
          "priority"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^unit_[0-9]{3}$"},
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "theorem",
              "lemma",
              "corollary",
              "proof",
              "example",
              "formula",
              "notation",
              "prerequisite"
            ]
          },
          "section": {"type": "string"},
          "source_span": {"type": "string"},
          "statement": {"type": "string"},
          "formalization_signal": {"type": "string"},
          "proof_present": {"type": "boolean"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "mathlib_concepts": {"type": "array", "items": {"type": "string"}},
          "suggested_lean_surface": {
            "type": "string",
            "enum": ["def", "structure", "theorem", "lemma", "example", "context"]
          },
          "priority": {"type": "string", "enum": ["high", "medium", "low"]},
          "downstream_routes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
