{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_sympy_source_only_recursive_0000_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "One source-only SymPy case pass with five ordered stages and final aggregation.",
  "aliases": [
    "physics-sympy:source-only-recursive-0000"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunRequest": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "case_id",
          "source_record",
          "output_root"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "source_record": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_root": {
            "type": "string"
          },
          "regenerate_initial_artifact": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "PreparedRun": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "case_id",
          "run_dir",
          "artifact_path",
          "source_packet",
          "initial_draft",
          "stage_specs",
          "_native_json",
          "stage_order"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "run_dir": {
            "type": "string"
          },
          "artifact_path": {
            "type": "string"
          },
          "source_packet": {
            "type": "object"
          },
          "initial_draft": {
            "type": "object"
          },
          "stage_specs": {
            "type": "object",
            "minProperties": 5,
            "maxProperties": 5
          },
          "_native_json": {
            "type": "string"
          },
          "stage_order": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 5,
            "maxItems": 5
          }
        }
      }
    },
    "StageState": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "prepared",
          "next_stage",
          "workflow_stage_reports",
          "command_metadata",
          "blockers",
          "_native_json"
        ],
        "properties": {
          "prepared": {
            "type": "object"
          },
          "next_stage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "workflow_stage_reports": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "command_metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "_native_json": {
            "type": "string"
          }
        }
      }
    },
    "Assessment": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "state",
          "loaded_reports",
          "complete",
          "blocked",
          "_native_json"
        ],
        "properties": {
          "state": {
            "type": "object"
          },
          "loaded_reports": {
            "type": "object"
          },
          "complete": {
            "type": "boolean"
          },
          "blocked": {
            "type": "boolean"
          },
          "_native_json": {
            "type": "string"
          }
        }
      }
    },
    "Flag": {
      "representation": "value",
      "schema": {
        "type": "boolean"
      }
    },
    "RunStatus": {
      "representation": "value",
      "schema": {
        "type": "string",
        "enum": [
          "complete_sympy_physics_derivation",
          "blocked",
          "derivation_partial"
        ]
      }
    },
    "RunReport": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "style",
          "backend",
          "case_id",
          "status",
          "run_dir",
          "workflow_stage_reports",
          "command_metadata",
          "blockers",
          "artifacts"
        ],
        "properties": {
          "style": {
            "const": "physics_sympy_source_only_recursive_goal_run"
          },
          "backend": {
            "const": "sympy"
          },
          "case_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "complete_sympy_physics_derivation",
              "blocked",
              "derivation_partial"
            ]
          },
          "run_dir": {
            "type": "string"
          },
          "workflow_stage_reports": {
            "type": "object"
          },
          "command_metadata": {
            "type": "object"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "artifacts": {
            "type": "object"
          }
        }
      }
    },
    "RunContext": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "working_directory",
          "allow_mutating"
        ],
        "properties": {
          "working_directory": {
            "type": "string"
          },
          "allow_mutating": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "request": {
      "type": "RunRequest"
    },
    "context": {
      "type": "RunContext"
    }
  },
  "outputs": {
    "result": {
      "type": "RunReport",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "request": {
          "type": "RunRequest"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "prepared": {
          "type": "PreparedRun"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_source_only_prepare",
          "operation": "mathformer_sympy_source_only_prepare"
        }
      }
    },
    "pack_state": {
      "inputs": {
        "prepared": {
          "type": "PreparedRun"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "state": {
          "type": "StageState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_source_only_pack_state",
          "operation": "mathformer_sympy_source_only_pack_state"
        }
      }
    },
    "execute_stage": {
      "inputs": {
        "state": {
          "type": "StageState"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "state": {
          "type": "StageState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_source_only_execute_stage",
          "operation": "mathformer_sympy_source_only_execute_stage"
        }
      }
    },
    "assess": {
      "inputs": {
        "state": {
          "type": "StageState"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "assessment": {
          "type": "Assessment"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_source_only_assess",
          "operation": "mathformer_sympy_source_only_assess"
        }
      }
    },
    "emit": {
      "inputs": {
        "assessment": {
          "type": "Assessment"
        },
        "status": {
          "type": "RunStatus"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "result": {
          "type": "RunReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_source_only_emit",
          "operation": "mathformer_sympy_source_only_emit"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "pack",
        "kind": "call",
        "operation": "pack_state",
        "arguments": {
          "prepared": {
            "ref": "steps.prepare.outputs.prepared"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "stages",
        "kind": "loop",
        "description": "Fixed insertion-order stage traversal, not a repair loop. The fifth stage sets done, so ordinary source exhaustion returns normally, even with blockers.",
        "state_type": "StageState",
        "initial": {
          "ref": "steps.pack.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "execute_stage",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "StageState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "assess",
        "kind": "call",
        "operation": "assess",
        "arguments": {
          "state": {
            "ref": "steps.stages.outputs.state"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "finish",
        "kind": "switch",
        "cases": [
          {
            "id": "complete",
            "when": {
              "ref": "steps.assess.outputs.assessment.complete"
            },
            "body": {
              "kind": "call",
              "operation": "emit",
              "arguments": {
                "assessment": {
                  "ref": "steps.assess.outputs.assessment"
                },
                "status": {
                  "literal": "complete_sympy_physics_derivation"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          },
          {
            "id": "blocked",
            "when": {
              "ref": "steps.assess.outputs.assessment.blocked"
            },
            "body": {
              "kind": "call",
              "operation": "emit",
              "arguments": {
                "assessment": {
                  "ref": "steps.assess.outputs.assessment"
                },
                "status": {
                  "literal": "blocked"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "emit",
          "arguments": {
            "assessment": {
              "ref": "steps.assess.outputs.assessment"
            },
            "status": {
              "literal": "derivation_partial"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "RunReport",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "RunReport",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "requested_output_root",
          "selected_sympy_case_artifact",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion",
        "use_dataset_formal_answer"
      ]
    },
    "limits": {
      "wall_time_seconds": 900,
      "max_operation_calls": 9
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description only; no scientific validation, runtime qualification or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
