  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "physics-sympy:source-only-recursive-0000",
      "owner_skill": "skills/physics-sympy/physics-sympy-goal-sample-autoformalizer/SKILL.md"
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP tools and original main share prepare_run, pack_run_state, execute_run_stage, assess_run, emit_run. Native subprocess stages remain unchanged.",
      "inputs": "main normalizes case from --case or registered source-record path (default formalphysics_0000); allowed extra args override case/source/output/regeneration.",
      "failure_policy": "Uncaught launch, JSON, filesystem or other unhandled errors abort; main exits 3 for blocked report, otherwise 0.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "scientific_payloads": "result is build_run report, not a HubResult transport envelope."
    },
    "mathformer.stage_order": {
      "stages": [
        "goal_plan",
        "design_guard_review",
        "repair_expansion_map",
        "recursive_repair_control",
        "grounded_sample_thoroughness"
      ],
      "handoffs": "goal_plan runs executable gates; map reads design_guard_review.json; controller reads repair_expansion.json; shared case artifact/run directory persists.",
      "controller": "Called once with iteration=1, max_iterations=6, no history. Precedence is complete/not_required with empty outstanding set, non-exhaustive map, repeated signature, iteration cap, empty outstanding set, else recurse; blocked map overrides. Decisions are reported only; no repairs or signature history carried.",
      "aliases": "current_evidence.json -> goal_plan.json; repair_expansion.json -> repair_expansion_map.json; controller_decision.json -> recursive_repair_control.json; thoroughness.json -> grounded_sample_thoroughness.json; reasoning.jsonl -> reasoning_log.jsonl."
    }
