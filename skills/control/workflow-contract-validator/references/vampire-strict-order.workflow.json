{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_example_vampire_strict_order_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Fixed strict-order example; project discover_proof_steps through its native caller.",
  "aliases": [
    "example:vampire-strict-order"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Statement": {
      "schema": {
        "type": "string"
      }
    },
    "SearchState": {
      "schema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "token",
          "revision",
          "evidence"
        ],
        "additionalProperties": false,
        "description": "Single-use service-local native generator continuation; evidence is the source-owned stage observation. Native runner, candidates, attempts and winners remain in the process; this is not a resumable checkpoint."
      }
    },
    "Attempt": {
      "schema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "token",
          "revision",
          "evidence"
        ],
        "additionalProperties": false,
        "description": "Single-use service-local native generator continuation; evidence is the source-owned stage observation. Native runner, candidates, attempts and winners remain in the process; this is not a resumable checkpoint."
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "description": "Native discovery report payload, including all attempts, winners, paths and Vampire version.",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "winning_formal_proof": {
            "type": [
              "string",
              "null"
            ]
          },
          "winning_informal_proof": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "ok",
          "attempts",
          "candidate_count",
          "attempt_count",
          "winner",
          "winning_status",
          "winning_formal_proof",
          "winning_informal_proof"
        ]
      }
    },
    "Completion": {
      "schema": {
        "type": "object",
        "properties": {
          "exit_code": {
            "type": "integer",
            "enum": [
              0,
              3
            ]
          },
          "stdout": {
            "type": "string"
          }
        },
        "required": [
          "exit_code",
          "stdout"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {},
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "completion": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.completion"
      }
    }
  },
  "operations": {
    "read_statement": {
      "inputs": {},
      "outputs": {
        "statement": {
          "type": "Statement"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_strict_order_read_statement",
          "operation": "mathformer_strict_order_read_statement"
        }
      }
    },
    "initialize": {
      "inputs": {
        "statement": {
          "type": "Statement"
        }
      },
      "outputs": {
        "state": {
          "type": "SearchState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_strict_order_initialize_search",
          "operation": "mathformer_strict_order_initialize_search"
        }
      }
    },
    "direct_attempt": {
      "inputs": {
        "state": {
          "type": "SearchState"
        }
      },
      "outputs": {
        "attempt": {
          "type": "Attempt"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_strict_order_direct_attempt",
          "operation": "mathformer_strict_order_direct_attempt"
        }
      }
    },
    "carry_and_guard": {
      "inputs": {
        "state": {
          "type": "SearchState"
        },
        "attempt": {
          "type": "Attempt"
        }
      },
      "outputs": {
        "state": {
          "type": "SearchState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_strict_order_carry_candidate",
          "operation": "mathformer_strict_order_carry_candidate"
        }
      }
    },
    "write_report": {
      "inputs": {
        "state": {
          "type": "SearchState"
        },
        "statement": {
          "type": "Statement"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_strict_order_finalize_report",
          "operation": "mathformer_strict_order_finalize_report"
        }
      }
    },
    "present_and_check": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "statement": {
          "type": "Statement"
        }
      },
      "outputs": {
        "completion": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_strict_order_present_and_check",
          "operation": "mathformer_strict_order_present_and_check"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "read",
        "kind": "call",
        "operation": "read_statement",
        "arguments": {}
      },
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "statement": {
            "ref": "steps.read.outputs.statement"
          }
        }
      },
      {
        "id": "candidates",
        "kind": "loop",
        "description": "Fixed caller has one candidate; success or list exhaustion exits normally.",
        "state_type": "SearchState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "attempt",
              "kind": "call",
              "operation": "direct_attempt",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                }
              }
            },
            {
              "id": "carry",
              "kind": "call",
              "operation": "carry_and_guard",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "attempt": {
                  "ref": "steps.attempt.outputs.attempt"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "SearchState",
              "value": {
                "ref": "steps.carry.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "steps.carry.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "SearchState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "report",
        "kind": "call",
        "operation": "write_report",
        "arguments": {
          "state": {
            "ref": "steps.candidates.outputs.state"
          },
          "statement": {
            "ref": "steps.read.outputs.statement"
          }
        }
      },
      {
        "id": "present",
        "kind": "call",
        "operation": "present_and_check",
        "arguments": {
          "report": {
            "ref": "steps.report.outputs.report"
          },
          "statement": {
            "ref": "steps.read.outputs.statement"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.report.outputs.report"
        }
      },
      "completion": {
        "type": "Completion",
        "value": {
          "ref": "steps.present.outputs.completion"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/vampire_atp/strict_order_asymmetry_example/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 180,
      "max_operation_calls": 6
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native execution and artifact persistence only; completion does not establish scientific validity."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
