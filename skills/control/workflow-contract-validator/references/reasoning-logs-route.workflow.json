        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "Admission": {
      "schema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "unknown_action",
              "dependency_cycle",
              "extra_args_for_sequence"
            ]
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "accepted",
          "status",
          "ancestry"
        ],
        "additionalProperties": false
      }
    },
    "DependencyState": {
      "schema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 6
          },
          "dependencies_ok": {
            "type": "boolean"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "index",
          "children",
          "dependencies_ok",
          "ancestry"
        ],
        "additionalProperties": false
      }
    },
    "SelectedMatch": {
      "schema": {
        "type": "object",
        "properties": {
          "route_id": {
            "type": "string",
            "const": "control.reasoning.logs"
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "route_id",
          "score",
          "matched_terms"
        ],
        "additionalProperties": false
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "TraversalState": {
      "schema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "dependencies": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 6
              },
              "dependencies_ok": {
                "type": "boolean"
              },
              "ancestry": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "index",
              "children",
              "dependencies_ok",
              "ancestry"
            ],
            "additionalProperties": false
          },
          "rejection": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "accepted",
          "dependencies",
          "rejection"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "SelectedMatch"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize_route": {
      "inputs": {
        "match": {
          "type": "SelectedMatch"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_initialize_route",
          "operation": "mathformer_logs_route_initialize_route"
        }
      }
    },
    "admit": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_admit",
          "operation": "mathformer_logs_route_admit"
        }
      }
    },
    "reject": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        },
        "state": {
          "type": "TraversalState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_reject",
          "operation": "mathformer_logs_route_reject"
        }
      }
    },
    "initialize_dependencies": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "state": {
          "type": "TraversalState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_initialize_dependencies",
          "operation": "mathformer_logs_route_initialize_dependencies"
        }
      }
    },
    "visit_dependency": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "state": {
          "type": "TraversalState"
        },
        "context": {
          "type": "RunContext"
        },
        "registry": {
          "type": "Registry"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_visit_dependency",
          "operation": "mathformer_logs_route_visit_dependency"
        }
      }
    },
    "advance_dependencies": {
      "inputs": {
        "state": {
          "type": "TraversalState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "registry": {
          "type": "Registry"
        },
        "action_id": {
          "type": "ActionId"
        }
      },
      "outputs": {
        "state": {
          "type": "TraversalState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_advance_dependencies",
          "operation": "mathformer_logs_route_advance_dependencies"
        }
      }
    },
    "finish_dependencies": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "state": {
          "type": "TraversalState"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_finish_dependencies",
          "operation": "mathformer_logs_route_finish_dependencies"
        }
      }
    },
    "finish_route": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "match": {
          "type": "SelectedMatch"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_finish_route",
          "operation": "mathformer_logs_route_finish_route"
        }
      }
    },
    "retain_rejection": {
      "inputs": {
        "state": {
          "type": "TraversalState"
        }
      },
      "outputs": {
        "state": {
          "type": "TraversalState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_logs_route_retain_rejection",
          "operation": "mathformer_logs_route_retain_rejection"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "description": "Native single-action route with a top-level dependency loop. Tagged transport state lets rejected admission bypass all dependency calls; retention is a pure adapter step.",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize_route",
        "arguments": {
          "match": {
            "ref": "inputs.match"
          }
        }
      },
      {
        "id": "admission",
        "kind": "call",
        "operation": "admit",
        "arguments": {
          "action_id": {
            "ref": "steps.initialize.outputs.action_id"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      },
      {
        "id": "seed",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "kind": "call",
              "operation": "initialize_dependencies",
              "arguments": {
                "admission": {
                  "ref": "steps.admission.outputs.admission"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "reject",
              "arguments": {
                "action_id": {
                  "ref": "steps.initialize.outputs.action_id"
                },
                "admission": {
                  "ref": "steps.admission.outputs.admission"
                }
              },
              "id": "reject"
            }
          ],
          "outputs": {
            "state": {
              "type": "TraversalState",
              "value": {
                "ref": "steps.reject.outputs.state"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "TraversalState",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "dependencies",
        "kind": "loop",
        "state_type": "TraversalState",
        "initial": {
          "ref": "steps.seed.outputs.state"
        },
        "max_iterations": 6,
        "on_exhausted": "fail",
        "description": "At item six done is true, so normal traversal never signals exhaustion.",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "accepted",
              "when": {
                "ref": "loop.state.accepted"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "visit",
                    "kind": "call",
                    "operation": "visit_dependency",
                    "arguments": {
                      "action_id": {
                        "ref": "steps.initialize.outputs.action_id"
                      },
                      "state": {
                        "ref": "loop.state"
                      },
                      "context": {
                        "ref": "inputs.context"
                      },
                      "registry": {
                        "ref": "inputs.registry"
                      },
                      "repository_root": {
                        "ref": "inputs.repository_root"
                      }
                    }
                  },
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance_dependencies",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "child": {
                        "ref": "steps.visit.outputs.result"
                      },
                      "context": {
                        "ref": "inputs.context"
                      },
                      "registry": {
                        "ref": "inputs.registry"
                      },
                      "action_id": {
                        "ref": "steps.initialize.outputs.action_id"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "TraversalState",
                    "value": {
                      "ref": "steps.advance.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Flag",
                    "value": {
                      "ref": "steps.advance.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "retain_rejection",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "TraversalState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "TraversalState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "readiness",
        "kind": "call",
        "operation": "finish_dependencies",
        "arguments": {
          "action_id": {
            "ref": "steps.initialize.outputs.action_id"
          },
          "state": {
            "ref": "steps.dependencies.outputs.state"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish_route",
        "arguments": {
          "state": {
            "ref": "steps.initialize.outputs.state"
          },
          "child": {
            "ref": "steps.readiness.outputs.result"
          },
          "context": {
            "ref": "inputs.context"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/reasoning/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 17
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native run and validation results only; completion does not confer scientific truth or artifact promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
