      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "MCP registration",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "reasoning_logs_route_descriptor",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Leaf internals remain native calls inside visit_dependency: real preflight, argv, subprocess capture and write audits. They are not expanded into the graph.",
      "Native leaf timeout_seconds is None and the controller has no global budget; the retained 3600-second and 17-call ceilings are enforced by Lunar only.",
      "Native optional hub logging remains source-owned; Lunar supplies its own required receipts and digests. Network/external capability names are qualification metadata, not grants."
    ]
  },
