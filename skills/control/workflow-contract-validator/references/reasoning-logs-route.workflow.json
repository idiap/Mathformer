      "schema": {
        "type": "boolean"
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 1
