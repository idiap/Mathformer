{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_control_reasoning_logs_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Selected reasoning-log route through native admission and ordered consumer-readiness dependencies.",
  "aliases": [
    "control.reasoning.logs"
  ],
  "lifecycle": "active",
  "activation": {
