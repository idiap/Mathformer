      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "read_statement": {
      "inputs": {},
      "outputs": {
        "statement": {
          "type": "Statement"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_read_statement",
          "operation": "mathformer_group_example_read_statement"
        }
      }
    },
    "initialize_search": {
      "inputs": {
        "statement": {
          "type": "Statement"
        }
      },
      "outputs": {
        "state": {
          "type": "SearchState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_initialize_search",
          "operation": "mathformer_group_example_initialize_search"
        }
      }
    },
    "direct_attempt": {
      "inputs": {
        "state": {
          "type": "SearchState"
        }
      },
      "outputs": {
        "attempt": {
          "type": "RawAttempt"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_direct_attempt",
          "operation": "mathformer_group_example_direct_attempt"
        }
      }
    },
    "carry_candidate": {
      "inputs": {
        "state": {
          "type": "SearchState"
        },
        "attempt": {
          "type": "RawAttempt"
        }
      },
      "outputs": {
        "state": {
          "type": "SearchState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_carry_candidate",
          "operation": "mathformer_group_example_carry_candidate"
        }
      }
    },
    "finalize_report": {
      "inputs": {
        "statement": {
          "type": "Statement"
        },
        "state": {
          "type": "SearchState"
        }
      },
      "outputs": {
        "report": {
          "type": "DiscoveryReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_finalize_report",
          "operation": "mathformer_group_example_finalize_report"
        }
      }
    },
    "print_and_check": {
      "inputs": {
        "statement": {
          "type": "Statement"
        },
        "report": {
          "type": "DiscoveryReport"
        }
      },
      "outputs": {
        "accepted": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_print_and_check",
          "operation": "mathformer_group_example_print_and_check"
        }
      }
    },
    "return_code": {
      "inputs": {
        "code": {
          "type": "ExitCode"
        }
      },
      "outputs": {
        "code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_group_example_return_code",
          "operation": "mathformer_group_example_return_code"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "read",
        "kind": "call",
        "operation": "read_statement",
        "arguments": {}
      },
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize_search",
        "arguments": {
          "statement": {
            "ref": "steps.read.outputs.statement"
          }
        }
      },
      {
        "id": "search",
        "kind": "loop",
        "description": "Fixed input yields exactly one candidate; last-candidate completion is normal even without a proof.",
        "state_type": "SearchState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "attempt",
              "kind": "call",
              "operation": "direct_attempt",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                }
              }
            },
            {
              "id": "carry",
              "kind": "call",
              "operation": "carry_candidate",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "attempt": {
                  "ref": "steps.attempt.outputs.attempt"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "SearchState",
              "value": {
                "ref": "steps.carry.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "steps.carry.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "SearchState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize_report",
        "arguments": {
          "statement": {
            "ref": "steps.read.outputs.statement"
          },
          "state": {
            "ref": "steps.search.outputs.state"
          }
        }
      },
      {
        "id": "print_check",
        "kind": "call",
        "operation": "print_and_check",
        "arguments": {
          "statement": {
            "ref": "steps.read.outputs.statement"
          },
          "report": {
            "ref": "steps.finalize.outputs.report"
          }
        }
      },
      {
        "id": "finish",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.print_check.outputs.accepted"
            },
            "body": {
              "kind": "call",
              "operation": "return_code",
              "arguments": {
                "code": {
                  "literal": 0
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "return_code",
          "arguments": {
            "code": {
              "literal": 3
            }
          }
        },
        "outputs": {
          "code": {
            "type": "ExitCode",
            "value": {
              "ref": "selected.outputs.code"
            }
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "DiscoveryReport",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.finish.outputs.code"
        }
      }
    }
  },
  "policy": {
