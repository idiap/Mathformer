{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_setup_lean_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Execute the selected setup.lean route through its one controlled setup:lean action.",
  "aliases": [
    "setup.lean"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext",
      "representation": "value"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult",
      "representation": "value"
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      },
      "representation": "value"
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "const": "setup:lean"
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "representation": "value"
    },
    "SelectedMatch": {
      "schema": {
        "type": "object",
        "description": "JSON projection of IntentMatch; retain all native route metadata.",
        "properties": {
          "route": {
            "type": "object",
            "properties": {
              "route_id": {
                "type": "string",
                "const": "setup.lean"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "setup:lean"
                ]
              }
            },
            "required": [
              "route_id",
              "action_ids"
            ]
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "route",
          "score",
          "matched_terms"
        ]
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "description": "Native WorkflowAction mapping; selected registration must be unchanged.",
        "properties": {
          "setup:lean": {
            "type": "object"
          }
        },
        "required": [
          "setup:lean"
        ],
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "ActionCount": {
      "schema": {
        "type": "integer",
        "const": 1
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    },
    "match": {
      "type": "SelectedMatch"
    },
    "registry": {
      "type": "Registry"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_setup_lean_route_initialize",
          "operation": "mathformer_setup_lean_route_initialize"
        }
      }
    },
    "select_action": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_setup_lean_route_select_action",
          "operation": "mathformer_setup_lean_route_select_action"
        }
      }
    },
    "run_action": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "context": {
          "type": "RunContext"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_setup_lean_route_run_action",
          "operation": "mathformer_setup_lean_route_run_action"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "action_count": {
          "type": "ActionCount"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_setup_lean_route_advance",
          "operation": "mathformer_setup_lean_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_setup_lean_route_finish",
          "operation": "mathformer_setup_lean_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "description": "The source iterates action_ids; setup.lean contains one item. advance returns done=true after that item, including a failed child, so the bound returns normally.",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select_action",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "run",
              "kind": "call",
              "operation": "run_action",
              "description": "Return native failure payloads as child data so advance and finish still execute; unexpected launch exceptions propagate.",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                },
                "registry": {
                  "ref": "inputs.registry"
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.run.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "action_count": {
                  "literal": 1
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          ".lake/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked setup description only; completion establishes no scientific result, runtime qualification or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
