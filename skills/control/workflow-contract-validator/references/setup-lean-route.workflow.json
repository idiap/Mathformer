    "gaps": [
      "Preflight and installer internals remain inside the native run_action subprocess rather than separate graph nodes; native output capture and write audit are preserved.",
      "Lunar enforces the 3600-second and five-operation ceilings. These are normalization bounds; the native action timeout is None and installer subprocesses have no timeout.",
      "Lunar supplies graph receipts and provenance alongside source-owned diagnostics. Network and external effects require deployment qualification; capability placeholder names are not runtime grants."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "setup.lean",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "setup.lean",
        "title": "Set up the Lean profile",
        "action_ids": [
          "setup:lean"
        ],
        "operator_note": "Requires mutation permission because it can write .lake/."
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered mathformer_setup_lean_route_* tools share native intent-state helpers and run_action with scripts/mathformer.py:run_intent_match. CLI ask --run and native mathformer_ask/mathformer_run_workflow continue to dispatch the native route.",
      "specialization": "Selected match is setup.lean; registry is verified against build_registry with setup:lean unchanged; action_count=1, extra_args=(), no dependencies. Null repository_root uses the native repository default.",
      "action_control": "Admission precedes preflight. Required paths, extra-argument policy and mutation authorization are checked; errors return ok=false without launching. A permitted dry-run returns without launching.",
      "installer": "Otherwise resolve {python} to sys.executable and launch scripts/install_env.py --skip-python --with-lean in the repository root. Validate Python >=3.10, parse arguments, skip Python installation, enter enabled Lean branch.",
      "lean_control": "Resolve existing lake once; run [lake, update], then [lake, build] with that same executable in ROOT_DIR. Missing lake or either checked command failure stops the installer; completion is printed only after success. No installer loop or retry.",
      "action_result": "Capture installer returncode/stdout/stderr; nonzero returncode yields ok=false. Audit repository writes against .lake/ after launch; unexpected writes force ok=false and status=undeclared_writes. Helpers own diagnostics and timing.",
      "failure_policy": "Native ok=false is result data and reaches finish; exceptional operation failure terminates the graph. keep_going cannot add work to a one-action route.",
      "bound_behavior": "After one child, advance.done is true regardless of child success. on_exhausted=fail is unreachable for this fixed native route; Lunar guards exhaustion if the graph exit condition is changed. No native retry or deadline is added.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "context": "All five RunContext flags, selected match including score and matched_terms, exact native registry projection and nullable repository_root are explicit ports. JSON cannot replace commands or native route metadata. Service write-root and read-only policies apply at the run_action binding.",
      "observability": "Lunar supplies graph receipts and provenance; native stdout/stderr, result data, ordered children and route scoring evidence remain source-owned."
    }
  }
