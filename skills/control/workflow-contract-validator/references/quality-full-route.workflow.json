{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_quality_full_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Execute the selected full quality route through ordered native dependencies.",
  "aliases": [
    "quality.full"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Context": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "Result": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 1
          }
        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "Admission": {
      "schema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "accepted",
          "status",
          "ancestry"
        ],
        "additionalProperties": false
      }
    },
    "Dependencies": {
      "schema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 2
          },
          "dependencies_ok": {
            "type": "boolean"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "index",
          "children",
          "dependencies_ok",
          "ancestry"
        ],
        "additionalProperties": false
      }
    },
    "Match": {
      "schema": {
        "type": "object",
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "properties": {
          "route": {
            "type": "object",
            "required": [
              "route_id",
              "action_ids"
            ],
            "properties": {
              "route_id": {
                "const": "quality.full"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "quality:full"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Registry": {
      "schema": {
        "type": "object"
      }
    },
    "Mount": {
      "schema": {
        "type": "object",
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "context": {
      "type": "Context"
    },
    "match": {
      "type": "Match"
    },
    "registry": {
      "type": "Registry"
    },
    "mount": {
      "type": "Mount"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize_route": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_initialize_route",
          "operation": "mathformer_quality_route_initialize_route"
        }
      }
    },
    "admit_quality": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_admit_quality",
          "operation": "mathformer_quality_route_admit_quality"
        }
      }
    },
    "initialize_dependencies": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "state": {
          "type": "Dependencies"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_initialize_dependencies",
          "operation": "mathformer_quality_route_initialize_dependencies"
        }
      }
    },
    "visit_dependency": {
      "inputs": {
        "state": {
          "type": "Dependencies"
        },
        "context": {
          "type": "Context"
        },
        "registry": {
          "type": "Registry"
        },
        "mount": {
          "type": "Mount"
        }
      },
      "outputs": {
        "child": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_visit_dependency",
          "operation": "mathformer_quality_route_visit_dependency"
        }
      }
    },
    "advance_dependencies": {
      "inputs": {
        "state": {
          "type": "Dependencies"
        },
        "child": {
          "type": "Result"
        },
        "context": {
          "type": "Context"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "state": {
          "type": "Dependencies"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_advance_dependencies",
          "operation": "mathformer_quality_route_advance_dependencies"
        }
      }
    },
    "finish_quality": {
      "inputs": {
        "state": {
          "type": "Dependencies"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "child": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_finish_quality",
          "operation": "mathformer_quality_route_finish_quality"
        }
      }
    },
    "reject_quality": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "child": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_reject_quality",
          "operation": "mathformer_quality_route_reject_quality"
        }
      }
    },
    "advance_route": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "Result"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_advance_route",
          "operation": "mathformer_quality_route_advance_route"
        }
      }
    },
    "finish_route": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_finish_route",
          "operation": "mathformer_quality_route_finish_route"
        }
      }
    },
    "carry_rejection": {
      "inputs": {
        "state": {
          "type": "Dependencies"
        },
        "child": {
          "type": "Result"
        }
      },
      "outputs": {
        "state": {
          "type": "Dependencies"
        },
        "done": {
          "type": "Flag"
        },
        "child": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_quality_route_carry_rejection",
          "operation": "mathformer_quality_route_carry_rejection"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize_route",
        "arguments": {}
      },
      {
        "id": "route",
        "kind": "loop",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "admission",
              "kind": "call",
              "operation": "admit_quality",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                },
                "registry": {
                  "ref": "inputs.registry"
                }
              }
            },
            {
              "id": "dispatch",
              "kind": "switch",
              "cases": [
                {
                  "id": "accepted",
                  "when": {
                    "ref": "steps.admission.outputs.admission.accepted"
                  },
                  "body": {
                    "kind": "sequence",
                    "steps": [
                      {
                        "id": "initialize",
                        "kind": "call",
                        "operation": "initialize_dependencies",
                        "arguments": {
                          "admission": {
                            "ref": "steps.admission.outputs.admission"
                          }
                        }
                      }
                    ],
                    "outputs": {
                      "state": {
                        "type": "Dependencies",
                        "value": {
                          "ref": "steps.initialize.outputs.state"
                        }
                      },
                      "rejection": {
                        "type": "Result",
                        "value": {
                          "literal": {
                            "ok": true
                          }
                        }
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "sequence",
                "steps": [
                  {
                    "kind": "call",
                    "operation": "reject_quality",
                    "arguments": {
                      "admission": {
                        "ref": "steps.admission.outputs.admission"
                      }
                    },
                    "id": "reject"
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "Dependencies",
                    "value": {
                      "literal": {
                        "index": 0,
                        "children": [],
                        "dependencies_ok": true,
                        "ancestry": []
                      }
                    }
                  },
                  "rejection": {
                    "type": "Result",
                    "value": {
                      "ref": "steps.reject.outputs.child"
                    }
                  }
                }
              },
              "outputs": {
                "state": {
                  "type": "Dependencies",
                  "value": {
                    "ref": "selected.outputs.state"
                  }
                },
                "rejection": {
                  "type": "Result",
                  "value": {
                    "ref": "selected.outputs.rejection"
                  }
                }
              }
            },
            {
              "id": "dependencies",
              "kind": "loop",
              "state_type": "Dependencies",
              "initial": {
                "ref": "steps.dispatch.outputs.state"
              },
              "max_iterations": 2,
              "on_exhausted": "fail",
              "body": {
                "id": "dispatch_dependency",
                "kind": "switch",
                "cases": [
                  {
                    "id": "accepted",
                    "when": {
                      "ref": "steps.admission.outputs.admission.accepted"
                    },
                    "body": {
                      "kind": "sequence",
                      "steps": [
                        {
                          "id": "visit",
                          "kind": "call",
                          "operation": "visit_dependency",
                          "arguments": {
                            "state": {
                              "ref": "loop.state"
                            },
                            "context": {
                              "ref": "inputs.context"
                            },
                            "registry": {
                              "ref": "inputs.registry"
                            },
                            "mount": {
                              "ref": "inputs.mount"
                            }
                          }
                        },
                        {
                          "id": "advance",
                          "kind": "call",
                          "operation": "advance_dependencies",
                          "arguments": {
                            "state": {
                              "ref": "loop.state"
                            },
                            "child": {
                              "ref": "steps.visit.outputs.child"
                            },
                            "context": {
                              "ref": "inputs.context"
                            },
                            "registry": {
                              "ref": "inputs.registry"
                            }
                          }
                        }
                      ],
                      "outputs": {
                        "state": {
                          "type": "Dependencies",
                          "value": {
                            "ref": "steps.advance.outputs.state"
                          }
                        },
                        "done": {
                          "type": "Flag",
                          "value": {
                            "ref": "steps.advance.outputs.done"
                          }
                        }
                      }
                    }
                  }
                ],
                "default": {
                  "kind": "sequence",
                  "steps": [
                    {
                      "id": "carry",
                      "kind": "call",
                      "operation": "carry_rejection",
                      "arguments": {
                        "state": {
                          "ref": "loop.state"
                        },
                        "child": {
                          "ref": "steps.dispatch.outputs.rejection"
                        }
                      }
                    }
                  ],
                  "outputs": {
                    "state": {
                      "type": "Dependencies",
                      "value": {
                        "ref": "steps.carry.outputs.state"
                      }
                    },
                    "done": {
                      "type": "Flag",
                      "value": {
                        "ref": "steps.carry.outputs.done"
                      }
                    }
                  }
                },
                "outputs": {
                  "state": {
                    "type": "Dependencies",
                    "value": {
                      "ref": "selected.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Flag",
                    "value": {
                      "ref": "selected.outputs.done"
                    }
                  }
                }
              },
              "next_state": {
                "ref": "body.outputs.state"
              },
              "until": {
                "ref": "body.outputs.done"
              },
              "outputs": {
                "state": {
                  "type": "Dependencies",
                  "value": {
                    "ref": "loop.state"
                  }
                }
              }
            },
            {
              "id": "action",
              "kind": "switch",
              "cases": [
                {
                  "id": "accepted",
                  "when": {
                    "ref": "steps.admission.outputs.admission.accepted"
                  },
                  "body": {
                    "id": "finish",
                    "kind": "call",
                    "operation": "finish_quality",
                    "arguments": {
                      "state": {
                        "ref": "steps.dependencies.outputs.state"
                      },
                      "registry": {
                        "ref": "inputs.registry"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "carry",
                    "kind": "call",
                    "operation": "carry_rejection",
                    "arguments": {
                      "state": {
                        "ref": "steps.dependencies.outputs.state"
                      },
                      "child": {
                        "ref": "steps.dispatch.outputs.rejection"
                      }
                    }
                  }
                ],
                "outputs": {
                  "child": {
                    "type": "Result",
                    "value": {
                      "ref": "steps.carry.outputs.child"
                    }
                  }
                }
              },
              "outputs": {
                "child": {
                  "type": "Result",
                  "value": {
                    "ref": "selected.outputs.child"
                  }
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance_route",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.action.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish_route",
        "arguments": {
          "state": {
            "ref": "steps.route.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 16
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description; completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
