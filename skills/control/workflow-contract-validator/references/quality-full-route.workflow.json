    "gaps": [
      "Recursive control:all traversal and comprehensive runner internals remain source-owned inside visit_dependency; their internal checks are not separate graph nodes.",
      "Lunar enforces enclosing time/call budgets and runtime provenance; native source retains its subprocess timeouts, optional logs and write audits, with no route-wide deadline, retry or checkpoint."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "quality.full",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "quality.full",
        "title": "Run the full repository quality gate",
        "action_ids": [
          "quality:full"
        ],
        "skill_routes": [
          "workflow-contract-validator",
          "skill-test-program-orchestrator"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "Callable graph ports share scripts/mathformer.py native functions; recursive dependency internals remain authoritative native calls.",
      "callers": [
        "CLI ask --run",
        "scripts/mcp_server.py::mathformer_run_workflow"
      ],
      "service_controls": "Registry projections must match native declarations; service read-only and write-root ceilings apply before dependency dispatch; omitted entries retain native unknown_action behavior.",
      "selection": "Source-owned quality.full route and build_registry; fresh ancestry, empty extra_args, no caller-supplied action list.",
      "bounds": "One route action and two direct quality dependencies; done is true on the last permitted iteration, returning normally even if ok=false. on_exhausted is unreachable under these fixed lists.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "context_ports": "match preserves route scoring and terms; registry selects immutable native declarations; mount optionally supplies the native repository_root.",
      "rejection_transport": "Dependency loop is outside the admission branch for PRISM scoped exhaustion. Rejected admission carries an inert state and original rejection through carry_rejection; no native initializer, visit, advance or finish runs on that branch."
    },
    "mathformer.composition": {
      "ordered_actions": [
        "quality:full"
      ],
      "action_workflows": [
