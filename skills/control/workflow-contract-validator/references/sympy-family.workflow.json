        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/sympy_family_workflow_tools.py",
        "selector": "register_sympy_family_tools",
        "digest": "sha256:25d5873b17a9d78faae9ccc95577a88e5d7b129166d43f6a64d41d2eb5a0a1a2"
      },
      {
        "path": "scripts/mcp_server.py",
