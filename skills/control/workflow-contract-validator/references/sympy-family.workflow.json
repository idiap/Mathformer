    "gaps": [
      "Invocation restricts the loaded selection to at most 4096 rows; native traversal has no row cap. At exactly 4096 rows the last guard exits normally; exhaustion is unreachable for valid states in this restricted domain.",
      "Hub preflight, dry-run handling, 900-second subprocess supervision and outer write auditing remain native hub boundary responsibilities. The callable DAG projects run(args) and main publication.",
      "Complete native effects require deployment qualification; Lunar records runtime events, effects and provenance. Completion establishes no scientific truth or artifact promotion."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "test:family:sympy",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "test:family:sympy",
        "summary": "Run the comprehensive test matrix for the sympy module family.",
        "family": "sympy",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/test_program/run_comprehensive_tests.py",
          "--module-family",
          "sympy",
          "--json"
        ],
        "depends_on": [],
        "required_paths": [
          "tests/test_program/run_comprehensive_tests.py",
          "tests/test_matrix.json"
        ],
        "required_tools": [],
        "optional_tools": [],
        "writes": [
          "artifacts/"
        ],
        "allows_extra_args": false,
        "timeout_seconds": 900,
        "notes": ""
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP blocks call shared native runner functions; owned context retains parse-time defaults and rejects changed/replayed state. Native stdout is preserved on MCP stderr.",
      "defaults": "Dependency-map-only, changed-file selection, matrix validation, strict mode and fail-on-warning are false; JSONL/JUnit unset; run_id and output_file use parser defaults.",
      "timing": "Native hub subprocess timeout is 900 seconds; per-row default is 120 seconds. The 3600-second policy limit is only a normalization ceiling.",
      "failure_policy": "Failed checks remain report data; publication returns 3 when report.ok is false. Uncaught errors abort without normal publication.",
      "scientific_payloads": "Report describes test outcomes and capabilities, not proofs."
    }
  }
