{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_family_sympy_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "SymPy matrix traversal projected from run(args), with native main publication.",
  "aliases": [
    "test:family:sympy"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Invocation": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_family",
          "profile",
          "extra_args",
          "selected_rows_upper_bound"
        ],
        "properties": {
          "module_family": {
            "const": "sympy"
          },
          "profile": {
            "const": "workstation"
          },
          "extra_args": {
            "const": []
          },
          "selected_rows_upper_bound": {
            "const": 4096,
            "description": "Domain restriction; the loaded SymPy selection must contain at most 4096 rows."
          }
        }
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "matrix",
          "selected",
          "families",
          "index",
          "results"
        ],
        "properties": {
          "matrix": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "status",
                "ok"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "skip",
                    "warn"
                  ]
                },
                "ok": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "run_id",
          "ok",
          "profile",
          "families",
          "summary",
          "results",
          "schema_errors",
          "matrix_errors",
          "capability_ledger",
          "dependency_map"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "profile": {
            "const": "workstation"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schema_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matrix_errors": {
            "const": []
          },
          "capability_ledger": {
            "type": "object"
          },
          "dependency_map": {
            "type": "string"
          }
        }
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    },
    "RuntimeContext": {
      "schema": {
        "type": "object",
        "required": [
          "handle"
        ],
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Cursor": {
      "schema": {
        "type": "object",
        "required": [
          "state",
          "pending"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "object",
            "required": [
              "matrix",
              "selected",
              "families",
              "index",
              "results"
            ],
            "properties": {
              "matrix": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "selected": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "object"
                }
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "status",
                    "ok"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "pass",
                        "fail",
                        "skip",
                        "warn"
                      ]
                    },
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "pending": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "inputs": {
    "invocation": {
      "type": "Invocation"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "invocation": {
          "type": "Invocation"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_family_prepare",
          "operation": "mathformer_sympy_family_prepare"
        }
      }
    },
    "pending": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "pending": {
          "type": "Flag"
        },
        "cursor": {
          "type": "Cursor"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_family_pending",
          "operation": "mathformer_sympy_family_pending"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "invocation": {
          "type": "Invocation"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_family_advance",
          "operation": "mathformer_sympy_family_advance"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "invocation": {
          "type": "Invocation"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_family_finalize",
          "operation": "mathformer_sympy_family_finalize"
        }
      }
    },
    "publish": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_family_publish",
          "operation": "mathformer_sympy_family_publish"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "cursor": {
          "type": "Cursor"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "cursor": {
          "type": "Cursor"
        },
        "pending": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_family_retain_empty",
          "operation": "mathformer_sympy_family_retain_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "invocation": {
            "ref": "inputs.invocation"
          }
        }
      },
      {
        "id": "initial_guard",
        "kind": "call",
        "operation": "pending",
        "arguments": {
          "state": {
            "ref": "steps.prepare.outputs.state"
          },
          "context": {
            "ref": "steps.prepare.outputs.context"
          }
        }
      },
      {
        "kind": "loop",
        "state_type": "Cursor",
        "initial": {
          "ref": "steps.initial_guard.outputs.cursor"
        },
        "max_iterations": 4096,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "pending",
              "when": {
                "ref": "loop.state.pending"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state.state"
                      },
                      "invocation": {
                        "ref": "inputs.invocation"
                      },
                      "context": {
                        "ref": "steps.prepare.outputs.context"
                      }
                    }
                  },
                  {
                    "id": "next_guard",
                    "kind": "call",
                    "operation": "pending",
                    "arguments": {
                      "state": {
                        "ref": "steps.advance.outputs.state"
                      },
                      "context": {
                        "ref": "steps.prepare.outputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "cursor": {
                    "type": "Cursor",
                    "value": {
                      "ref": "steps.next_guard.outputs.cursor"
                    }
                  },
                  "pending": {
                    "type": "Flag",
                    "value": {
                      "ref": "steps.next_guard.outputs.pending"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "id": "empty",
                "kind": "call",
                "operation": "retain_empty",
                "arguments": {
                  "cursor": {
                    "ref": "loop.state"
                  },
                  "context": {
                    "ref": "steps.prepare.outputs.context"
                  }
                }
              }
            ],
            "outputs": {
              "cursor": {
                "type": "Cursor",
                "value": {
                  "ref": "steps.empty.outputs.cursor"
                }
              },
              "pending": {
                "type": "Flag",
                "value": {
                  "ref": "steps.empty.outputs.pending"
                }
              }
            }
          },
          "outputs": {
            "cursor": {
              "type": "Cursor",
              "value": {
                "ref": "selected.outputs.cursor"
              }
            },
            "pending": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.pending"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.cursor"
        },
        "until": {
          "not": {
            "ref": "body.outputs.pending"
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "loop.state.state"
            }
          }
        },
        "id": "traverse"
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.traverse.outputs.state"
          },
          "invocation": {
            "ref": "inputs.invocation"
          },
          "context": {
            "ref": "steps.prepare.outputs.context"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.finalize.outputs.report"
          },
          "context": {
            "ref": "steps.prepare.outputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.publish.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 8197
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked native test outcomes; completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
