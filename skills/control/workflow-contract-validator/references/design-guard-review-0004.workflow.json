    "mathformer.native_boundary": {
      "execution": "Hub preflight and dry-run precede the leaf subprocess; write auditing follows it. These controls remain external to the selected reviewer graph.",
      "input_resolution": "main normalizes --case (hub default formalphysics_0004); case_path honors --sympy-file, otherwise uses MathformerPhysicsLib/SymPy/<case>/MathformerPhysics.py. request carries resolved paths and nullable reasoning_log.",
      "default_path_discrepancy": "The default formalphysics_0004 artifact path is absent; registry preflight checks libraries/MathformerPhysicsLib/SymPy/formalphysics_0004/MathformerPhysics.py. Without --sympy-file the reviewer therefore takes the missing-artifact branch after successful preflight.",
      "output_behavior": "The graph exports the reviewer report, not HubResult. main serializes JSON to stdout or --output, appends a requested optional log event, and returns zero even when report.status is fail; uncaught errors abort. Optional writes remain subject to hub write auditing.",
      "failure_policy": "Report fail is data and does not stop accumulation; uncaught errors stop execution. There is no retry, repair dispatch, convergence test, or persistent checkpoint.",
      "module_transport": "read_and_import retains the imported module and source text under a single-use opaque handle. inspect_module consumes it with matching state without reimporting. Inspection errors consume the handle; abandoned handles are reclaimed at service shutdown."
    }
