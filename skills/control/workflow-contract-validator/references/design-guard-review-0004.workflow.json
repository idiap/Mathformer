          "target": "mathformer_design_guard_read_and_import",
          "operation": "mathformer_design_guard_read_and_import"
        }
      }
    },
    "failed_import": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_design_guard_failed_import",
