          "operation": "mathformer_design_guard_initialize"
        }
      }
    },
    "missing_artifact": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_design_guard_missing_artifact",
          "operation": "mathformer_design_guard_missing_artifact"
        }
      }
    },
