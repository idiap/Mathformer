  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          }
        }
      },
      {
        "id": "artifact_branch",
        "kind": "switch",
        "cases": [
          {
            "id": "absent",
            "when": {
              "not": {
                "ref": "steps.initialize.outputs.artifact_present"
              }
            },
            "body": {
              "kind": "call",
              "operation": "missing_artifact",
              "arguments": {
                "request": {
                  "ref": "inputs.request"
                },
                "state": {
                  "ref": "steps.initialize.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "read",
              "kind": "call",
              "operation": "read_and_import",
              "arguments": {
                "request": {
                  "ref": "inputs.request"
                },
                "state": {
                  "ref": "steps.initialize.outputs.state"
                }
              }
            },
            {
              "id": "import_branch",
              "kind": "switch",
              "cases": [
                {
                  "id": "import_failed",
                  "when": {
                    "not": {
                      "ref": "steps.read.outputs.module_loaded"
                    }
                  },
                  "body": {
                    "kind": "call",
                    "operation": "failed_import",
                    "arguments": {
                      "state": {
                        "ref": "steps.read.outputs.state"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "inspect_module",
                "arguments": {
                  "state": {
                    "ref": "steps.read.outputs.state"
                  },
                  "artifact": {
                    "ref": "steps.read.outputs.artifact"
                  }
                }
              },
              "outputs": {
                "state": {
                  "type": "State",
                  "value": {
                    "ref": "selected.outputs.state"
                  }
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "steps.import_branch.outputs.state"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish_review",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          },
          "state": {
            "ref": "steps.artifact_branch.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      }
    }
  },
