{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_meta_skills_quality_cards_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Validate sorted quality cards, accumulate findings, and write the native report.",
  "aliases": [
    "meta-skills:quality-cards"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "DiscoveryCount": {
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000,
        "description": "Exact count of discovered quality-card paths; specialization precondition, not a native argument."
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "CardState": {
      "schema": {
        "type": "object",
        "required": [
          "schema",
          "paths",
          "cursor",
          "results",
          "findings",
          "repository_root",
          "output_path",
          "has_cards"
        ],
        "properties": {
          "schema": {
            "type": "object"
          },
          "paths": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "ok",
                "findings"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "repository_root": {
            "type": "string"
          },
          "output_path": {
            "type": "string"
          },
          "has_cards": {
            "type": "boolean"
          }
        }
      }
    },
    "ValidationReport": {
      "schema": {
        "type": "object",
        "required": [
          "schema_version",
          "style",
          "ok",
          "card_count",
          "results",
          "findings"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "style": {
            "const": "mathformer_meta_skill_quality_card_validation"
          },
          "ok": {
            "type": "boolean"
          },
          "card_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "ok",
                "findings"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": "string",
        "description": "Repository context root; empty selects the service repository. Fixtures may use a root under artifacts/workflow_hub."
      }
    }
  },
  "inputs": {
    "discovered_card_count": {
      "type": "DiscoveryCount"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    }
  },
  "outputs": {
    "result": {
      "type": "ValidationReport",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {
        "discovered_card_count": {
          "type": "DiscoveryCount"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "state": {
          "type": "CardState"
        },
        "has_cards": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_quality_cards_initialize",
          "operation": "mathformer_quality_cards_initialize"
        }
      }
    },
    "validate_next": {
      "inputs": {
        "state": {
          "type": "CardState"
        }
      },
      "outputs": {
        "state": {
          "type": "CardState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_quality_cards_validate_next",
          "operation": "mathformer_quality_cards_validate_next"
        }
      }
    },
    "write_report": {
      "inputs": {
        "state": {
          "type": "CardState"
        }
      },
      "outputs": {
        "result": {
          "type": "ValidationReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_quality_cards_write_report",
          "operation": "mathformer_quality_cards_write_report"
        }
      }
    },
    "empty": {
      "inputs": {
        "state": {
          "type": "CardState"
        }
      },
      "outputs": {
        "state": {
          "type": "CardState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_quality_cards_empty",
          "operation": "mathformer_quality_cards_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "discovered_card_count": {
            "ref": "inputs.discovered_card_count"
          },
          "repository_root": {
            "ref": "inputs.repository_root"
          }
        }
      },
      {
        "id": "cards",
        "kind": "loop",
        "state_type": "CardState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "loop.state.has_cards"
              },
              "body": {
                "kind": "call",
                "operation": "validate_next",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "empty",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "CardState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "CardState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "report",
        "kind": "call",
        "operation": "write_report",
        "arguments": {
          "state": {
            "ref": "steps.cards.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "ValidationReport",
        "value": {
          "ref": "steps.report.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/meta_skills/skill_quality_card_validation.json",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "validate_quality_cards",
        "write_validation_report"
      ],
      "forbidden": [
        "execute_validation_oracles",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 10002
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked validation description; completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
