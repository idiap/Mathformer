      },
      {
        "path": "scripts/quality_card_tools.py",
        "selector": "register_quality_card_tools; context_root; check_state",
        "digest": "sha256:7572b027bba29addec07313c67607614b86c5b16f0e6baf70786730728ac3160"
      },
      {
