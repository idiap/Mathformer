    ],
    "gaps": [
      "DiscoveryCount must equal actual discovery; more than 10000 cards is outside this specialization. Adapters enforce this before iteration.",
      "Native run has no time or call budget. Lunar enforces projection limits; there are no native retries, resume, or checkpoints.",
      "Per-card finite loops and early returns remain inside validate_next; parsing, type and filesystem exceptions propagate before report creation. Write failure may leave a partial report.",
      "Hub and CLI behavior remain native boundary metadata; Lunar supplies execution receipts for bound operations.",
      "A root-level post-test loop uses an explicit empty-state carry branch so zero cards are never read. This preserves native empty reporting while allowing Lunar to scope exhaustion at the workflow boundary."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "meta-skills:quality-cards",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "meta-skills:quality-cards",
        "summary": "Validate meta-skill quality cards for deterministic and generative boundaries.",
        "family": "meta_skills",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "meta_skills/scripts/validate_skill_quality_cards.py",
          "--json"
        ],
        "depends_on": [],
        "writes": [
          "artifacts/meta_skills/skill_quality_card_validation.json"
        ],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Hub checks preflight; errors or dry-run return without launch. Otherwise launch once and audit writes; undeclared writes force failure.",
      "cli": "main prints JSON or PASS/FAIL and exits 0 for payload.ok, otherwise 1; uncaught exceptions propagate.",
      "test_timeout_seconds": 180,
      "timeout_scope": "Test subprocess timeout only; this hub action has no configured timeout.",
      "failure_policy": "Preserve false payload.ok and failed hub status; ordinary findings are data, not operation exceptions."
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "modeling": "Source run control flow; dependency-free native leaf, with no scientific workflows or oracle execution."
    },
    "mathformer.runtime_context": {
      "repository_root": "Explicit read context for schema, cards, skill existence and relative report paths. Empty selects the service repository. Reports use the native fixed relative path; writes are restricted to the native report or artifacts/workflow_hub and service write policy."
    }
  }
