        "selector": "main; build_report; analyze_file",
        "digest": "sha256:e0583725510d24378fc99eb74caeba2827be462e7365c415c6e740355f3be01f"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "inventory grounded-sample-thoroughness authored contract",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Request specializes parsed main arguments to at most 15 case arguments; empty selection defaults to the 15 curated cases. Larger native selections are outside this contract.",
      "The 3600-second wall limit and operation budget are descriptor ceilings, not source stopping behavior; neither run_suite nor its hub action enforces a timeout.",
      "Checker internals remain a native textual-checker subprocess; no Lean compilation, model calls, repairs or promotion occur. Lunar supplies execution receipts and digests in addition to native reports."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "physics-lean:grounded-sample-thoroughness",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "physics-lean:grounded-sample-thoroughness",
        "family": "physics_lean",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/physics_lean/run_grounded_sample_thoroughness.py",
          "--json"
        ],
        "depends_on": [],
        "allows_extra_args": true,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Four registered MCP tools reuse native source helpers also called by run_suite/main. repository_root relocates source records, Lean data, checker cwd and fixed report path; the executable checker remains project-owned. Defaults preserve CLI paths. MCP redirects native stdout to stderr to preserve transport framing.",
      "scientific_payloads": "Native grounded-thoroughness report, rather than the opaque HubResult transport envelope."
    }
  }
}
