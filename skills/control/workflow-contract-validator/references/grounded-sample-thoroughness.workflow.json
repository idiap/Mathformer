        "selector": "register_grounded_sample_tools(mcp, _analysis_write_policy, ...)",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry/action:physics-lean:grounded-sample-thoroughness",
