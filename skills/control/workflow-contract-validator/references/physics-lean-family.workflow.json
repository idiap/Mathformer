  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "boundary",
        "kind": "call",
        "operation": "prepare_boundary",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          },
          "extra_args": {
            "ref": "inputs.extra_args"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "switch",
        "cases": [
          {
            "id": "yes",
            "when": {
              "ref": "steps.boundary.outputs.execute"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "prepare",
                  "kind": "call",
                  "operation": "prepare_checks",
                  "arguments": {
                    "scope": {
                      "ref": "inputs.scope"
                    },
                    "boundary": {
                      "ref": "steps.boundary.outputs.boundary"
                    },
                    "runtime": {
                      "ref": "steps.boundary.outputs.runtime"
                    }
                  }
                },
                {
                  "id": "guard",
                  "kind": "call",
                  "operation": "checks_pending",
                  "arguments": {
                    "progress": {
                      "ref": "steps.prepare.outputs.progress"
                    },
                    "runtime": {
                      "ref": "steps.boundary.outputs.runtime"
                    }
                  }
                }
              ],
              "outputs": {
                "progress": {
                  "type": "Progress",
                  "value": {
                    "ref": "steps.guard.outputs.progress"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "bypass_progress",
          "arguments": {
            "boundary": {
              "ref": "steps.boundary.outputs.boundary"
            },
            "runtime": {
              "ref": "steps.boundary.outputs.runtime"
            }
          }
        },
        "outputs": {
          "progress": {
            "type": "Progress",
            "value": {
              "ref": "selected.outputs.progress"
            }
          }
        }
      },
      {
        "id": "traversal",
        "kind": "loop",
        "state_type": "Progress",
        "initial": {
          "ref": "steps.prepare.outputs.progress"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "yes",
              "when": {
                "ref": "loop.state.pending"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance_check",
                    "arguments": {
                      "progress": {
                        "ref": "loop.state"
                      },
                      "runtime": {
                        "ref": "steps.boundary.outputs.runtime"
                      }
                    }
                  },
                  {
                    "id": "guard",
                    "kind": "call",
                    "operation": "checks_pending",
                    "arguments": {
                      "progress": {
                        "ref": "steps.advance.outputs.progress"
                      },
                      "runtime": {
                        "ref": "steps.boundary.outputs.runtime"
                      }
                    }
                  }
                ],
                "outputs": {
                  "progress": {
                    "type": "Progress",
                    "value": {
                      "ref": "steps.guard.outputs.progress"
                    }
                  },
                  "pending": {
                    "type": "Boolean",
                    "value": {
                      "ref": "steps.guard.outputs.pending"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "retain_state",
            "arguments": {
              "progress": {
                "ref": "loop.state"
              },
              "runtime": {
                "ref": "steps.boundary.outputs.runtime"
              }
            }
          },
          "outputs": {
            "progress": {
              "type": "Progress",
              "value": {
                "ref": "selected.outputs.progress"
              }
            },
            "pending": {
              "type": "Boolean",
              "value": {
                "ref": "selected.outputs.pending"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.progress"
        },
        "until": {
          "not": {
            "ref": "body.outputs.pending"
          }
        },
        "max_iterations": 11,
        "on_exhausted": "fail",
        "outputs": {
          "progress": {
            "type": "Progress",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "completion",
        "kind": "switch",
        "cases": [
          {
            "id": "yes",
            "when": {
              "ref": "steps.boundary.outputs.execute"
            },
            "body": {
              "kind": "switch",
              "cases": [
                {
                  "id": "yes",
                  "when": {
                    "ref": "steps.traversal.outputs.progress.terminated"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "complete_failure",
                    "arguments": {
                      "boundary": {
                        "ref": "steps.boundary.outputs.boundary"
                      },
                      "runtime": {
                        "ref": "steps.boundary.outputs.runtime"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "finalize",
                    "kind": "call",
                    "operation": "finalize_checks",
                    "arguments": {
                      "progress": {
                        "ref": "steps.traversal.outputs.progress"
                      },
                      "runtime": {
                        "ref": "steps.boundary.outputs.runtime"
                      }
                    }
                  },
                  {
                    "id": "publication",
                    "kind": "switch",
                    "cases": [
                      {
                        "id": "yes",
                        "when": {
                          "ref": "steps.finalize.outputs.terminated"
                        },
                        "body": {
                          "kind": "call",
                          "operation": "complete_failure",
                          "arguments": {
                            "boundary": {
                              "ref": "steps.boundary.outputs.boundary"
                            },
                            "runtime": {
                              "ref": "steps.boundary.outputs.runtime"
                            }
                          }
                        }
                      }
                    ],
                    "default": {
                      "kind": "call",
                      "operation": "publish_and_audit",
                      "arguments": {
                        "report": {
                          "ref": "steps.finalize.outputs.report"
                        },
                        "boundary": {
                          "ref": "steps.boundary.outputs.boundary"
                        },
                        "runtime": {
                          "ref": "steps.boundary.outputs.runtime"
                        }
                      }
                    },
                    "outputs": {
                      "result": {
                        "type": "HubResult",
                        "value": {
                          "ref": "selected.outputs.result"
                        }
                      }
                    }
                  }
                ],
                "outputs": {
                  "result": {
                    "type": "HubResult",
                    "value": {
                      "ref": "steps.publication.outputs.result"
                    }
                  }
                }
              },
              "outputs": {
                "result": {
                  "type": "HubResult",
                  "value": {
                    "ref": "selected.outputs.result"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "return_boundary",
          "arguments": {
            "boundary": {
              "ref": "steps.boundary.outputs.boundary"
            },
            "runtime": {
              "ref": "steps.boundary.outputs.runtime"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.completion.outputs.result"
        }
      }
    }
  },
