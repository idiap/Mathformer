    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 27
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked validation description; completion establishes no scientific truth or promotion."
  },
  "observability": {
