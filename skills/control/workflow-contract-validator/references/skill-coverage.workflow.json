          "skills/SKILL_HOOKS.yaml"
        ],
        "required_tools": [],
        "optional_tools": [],
        "writes": [],
        "allows_extra_args": false,
        "timeout_seconds": null,
        "notes": ""
      }
    },
    "mathformer.native_boundary": {
      "execution": "Shared native audit steps exposed as registered MCP tools; the original main and hub still use the same audit implementation.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "preflight": "Preflight failure or dry-run prevents launch; run_action delegates to run_leaf_action after dependency handling.",
      "completion": "main prints JSON for this hub action and exits 0 if ok, 4 if false with --expect-ok, otherwise 3. Optional reasoning logging stays internal and is not requested. Read/parse/inventory exceptions propagate; no repair or retries.",
      "failure_policy": "Failed subprocess or post-run write audit makes the hub result fail; never reinterpret failure as acceptance.",
      "effects_status": "Audit body is read-only; the surrounding hub can optionally write artifacts/workflow_hub/ reports.",
      "qualification_capability_names_are_not_runtime_grants": true,
      "scientific_payloads": "AuditReport describes coverage; native HubResult is a separate transport envelope."
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "command_after_dependencies": false,
      "used_by": "control:all",
      "keep_going_semantics": "run_action stops on a failed child unless context.keep_going; aggregate ok remains false after any failure.",
      "extra_args_for_sequence": "native per-action policy",
      "modeling": "The graph refines the selected audit body; control:all composition is outside this graph."
    },
    "mathformer.step_mapping": {
      "load_and_pack": "audit_skill_hook_coverage.py:audit_skill_coverage initialization and parser helpers; inventory_skills.py:inventory. Read/split hooks_file, parse hooks, contracts and shared runtimes in that order, then inventory(skills_dir). Inventory reads skills_dir/SKILL_HOOKS.yaml and sorted */*/SKILL.md files. Pack parsed data, inventory and policy; initialize empty classification/finding lists, cursor=0 and more=(skill count>0). Parser section/current-record state and finite line scans stay internal.",
      "classify_one": "audit_skill_hook_coverage.py:audit_skill_coverage, for skill in skill_report['skills']. Visit skills[cursor]. Covered means bool(hook_ids) or int(direct_route_count)>0. Wrapper means default exemption or description contains 'compatibility wrapper'. Append wrapper; uncovered wrapper appends low finding, then skips non-wrapper logic. Otherwise append non-wrapper and either covered name or high uncovered_skill finding. Advance cursor and compute more from remaining skills. Findings do not stop traversal.",
      "pack_empty_state": "audit_skill_hook_coverage.py:audit_skill_coverage, empty for-loop bypass. Pack unchanged accumulated locals when the source collection is empty; visit no item and preserve findings/lists.",
      "thresholds_and_pack": "audit_skill_hook_coverage.py:audit_skill_coverage, coverage_ratio and policy checks before for loop in loops. Compute covered/non-wrapper ratio, or 1.0 for empty non-wrapper inventory. Append high finding if ratio<policy.min_non_wrapper_coverage; then append high finding if contract count<policy.min_loop_count. Neither terminates. Preserve locals, reset cursor=0 and compute more=(contract count>0).",
      "inspect_contract": "audit_skill_hook_coverage.py:audit_skill_coverage, for loop in loops. Visit contracts[cursor]. In order append high missing-required-hooks, medium missing-recommended-hooks and high missing-owner findings; owners come only from present required hooks. Scan required hooks in order: absent/false hook skips subsequent checks; missing reasoning steps appends medium then skips markers. For ids containing loop/suite/review/precheck/support, require a step ending _start or _suite_start and a step ending _complete, _suite_complete or _ready; otherwise append low. Internal scans are bounded by referenced hooks and their steps. Advance cursor and compute more from remaining contracts; findings never stop traversal.",
      "finalize": "audit_skill_hook_coverage.py:audit_skill_coverage, required_control_scripts through return. Compare declared shared runtimes with validate_skill_hooks.py, audit_skill_hook_coverage.py and run_deterministic_skill_tests.py at their source-owned control-skill paths; append high finding with sorted missing paths. Blocking findings have severity==high only. Return ok=not blocking, UTC timestamp, skill/hook identity, summary counts and four-decimal ratio, coverage policy with sorted exemptions, per-contract counts and all findings. Counting and report comprehensions remain internal. Return normally even when ok=false."
    }
  }
}
