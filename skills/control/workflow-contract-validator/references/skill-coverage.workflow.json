{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_control_skill_coverage_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Audit skill hook/direct-route coverage and declared loop contracts without executing scientific loops.",
  "aliases": [
    "control:skill-coverage"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "AuditInputs": {
      "representation": "value",
      "schema": {
        "type": "object",
        "description": "Default hub specialization. Filesystem cardinality restrictions are admissibility preconditions, not added native failure checks.",
        "properties": {
          "hooks_file": {
            "type": "string",
            "const": "skills/SKILL_HOOKS.yaml",
            "description": "Admissible manifest parses to at most 10000 loop contracts."
          },
          "skills_dir": {
            "type": "string",
            "const": "skills",
            "description": "Admissible directory discovers at most 10000 sorted */*/SKILL.md files."
          },
          "min_non_wrapper_coverage": {
            "type": "number",
            "const": 1.0
          },
          "min_loop_count": {
            "type": "integer",
            "const": 6
          }
        },
        "required": [
          "hooks_file",
          "skills_dir",
          "min_non_wrapper_coverage",
          "min_loop_count"
        ],
        "additionalProperties": false
      }
    },
    "AuditState": {
      "representation": "value",
      "schema": {
        "type": "object",
        "description": "Packed native locals plus cursor and continuation guard. Findings never control traversal; coverage_ratio is installed after the skill pass.",
        "properties": {
          "more": {
            "type": "boolean"
          },
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "skills": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object"
            }
          },
          "contracts": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object"
            }
          },
          "hooks": {
            "type": "object"
          },
          "runtime_scripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_wrappers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "covered_non_wrappers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wrappers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "coverage_ratio": {
            "type": "number"
          },
          "skill_report": {
            "type": "object"
          },
          "policy": {
            "type": "object"
          }
        },
        "required": [
          "more",
          "cursor",
          "skills",
          "contracts",
          "hooks",
          "runtime_scripts",
          "non_wrappers",
          "covered_non_wrappers",
          "wrappers",
          "findings",
          "skill_report",
          "policy"
        ],
        "additionalProperties": false
      }
    },
    "AuditReport": {
      "representation": "value",
      "schema": {
        "type": "object",
        "properties": {
          "generated_at_utc": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "hook_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "summary": {
            "type": "object"
          },
          "coverage_policy": {
            "type": "object"
          },
          "loop_contracts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "generated_at_utc",
          "skill",
          "hook_id",
          "ok",
          "summary",
          "coverage_policy",
          "loop_contracts",
          "findings"
        ],
        "additionalProperties": false
      }
    },
    "RepositoryRoot": {
      "representation": "value",
      "schema": {
        "type": "string",
        "minLength": 1,
        "description": "Root used to resolve the native relative hooks and skill paths; inventory retains its native repository containment rules."
      }
    }
  },
  "inputs": {
    "source": {
      "type": "AuditInputs"
    },
    "repo_root": {
      "type": "RepositoryRoot"
    }
  },
  "outputs": {
    "report": {
      "type": "AuditReport",
      "value": {
        "ref": "flow.outputs.report"
      }
    }
  },
  "operations": {
    "load_and_pack": {
      "inputs": {
        "source": {
          "type": "AuditInputs"
        },
        "repo_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_skill_coverage_load_and_pack",
          "operation": "mathformer_skill_coverage_load_and_pack"
        }
      }
    },
    "classify_one": {
      "inputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "outputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_skill_coverage_classify_one",
          "operation": "mathformer_skill_coverage_classify_one"
        }
      }
    },
    "pack_empty_state": {
      "inputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "outputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_skill_coverage_pack_empty_state",
          "operation": "mathformer_skill_coverage_pack_empty_state"
        }
      }
    },
    "thresholds_and_pack": {
      "inputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "outputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_skill_coverage_thresholds_and_pack",
          "operation": "mathformer_skill_coverage_thresholds_and_pack"
        }
      }
    },
    "inspect_contract": {
      "inputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "outputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_skill_coverage_inspect_contract",
          "operation": "mathformer_skill_coverage_inspect_contract"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "AuditState"
        }
      },
      "outputs": {
        "report": {
          "type": "AuditReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_skill_coverage_finalize",
          "operation": "mathformer_skill_coverage_finalize"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "load",
        "kind": "call",
        "operation": "load_and_pack",
        "arguments": {
          "source": {
            "ref": "inputs.source"
          },
          "repo_root": {
            "ref": "inputs.repo_root"
          }
        }
      },
      {
        "kind": "loop",
        "state_type": "AuditState",
        "initial": {
          "ref": "steps.load.outputs.state"
        },
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "guard",
              "kind": "switch",
              "cases": [
                {
                  "id": "nonempty",
                  "when": {
                    "ref": "loop.state.more"
                  },
                  "body": {
                    "kind": "sequence",
                    "steps": [
                      {
                        "id": "visit",
                        "kind": "call",
                        "operation": "classify_one",
                        "arguments": {
                          "state": {
                            "ref": "loop.state"
                          }
                        }
                      }
                    ],
                    "outputs": {
                      "state": {
                        "type": "AuditState",
                        "value": {
                          "ref": "steps.visit.outputs.state"
                        }
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "empty",
                    "kind": "call",
                    "operation": "pack_empty_state",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "AuditState",
                    "value": {
                      "ref": "steps.empty.outputs.state"
                    }
                  }
                }
              },
              "outputs": {
                "state": {
                  "type": "AuditState",
                  "value": {
                    "ref": "selected.outputs.state"
                  }
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "AuditState",
              "value": {
                "ref": "steps.guard.outputs.state"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "not": {
            "ref": "body.outputs.state.more"
          }
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "AuditState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        },
        "id": "skills",
        "description": "Bypass an empty skill scan; otherwise classify every inventory item once in source order."
      },
      {
        "id": "thresholds",
        "kind": "call",
        "operation": "thresholds_and_pack",
        "arguments": {
          "state": {
            "ref": "steps.skills.outputs.state"
          }
        }
      },
      {
        "kind": "loop",
        "state_type": "AuditState",
        "initial": {
          "ref": "steps.thresholds.outputs.state"
        },
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "guard",
              "kind": "switch",
              "cases": [
                {
                  "id": "nonempty",
                  "when": {
                    "ref": "loop.state.more"
                  },
                  "body": {
                    "kind": "sequence",
                    "steps": [
                      {
                        "id": "visit",
                        "kind": "call",
                        "operation": "inspect_contract",
                        "arguments": {
                          "state": {
                            "ref": "loop.state"
                          }
                        }
                      }
                    ],
                    "outputs": {
                      "state": {
                        "type": "AuditState",
                        "value": {
                          "ref": "steps.visit.outputs.state"
                        }
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "empty",
                    "kind": "call",
                    "operation": "pack_empty_state",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "AuditState",
                    "value": {
                      "ref": "steps.empty.outputs.state"
                    }
                  }
                }
              },
              "outputs": {
                "state": {
                  "type": "AuditState",
                  "value": {
                    "ref": "selected.outputs.state"
                  }
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "AuditState",
              "value": {
                "ref": "steps.guard.outputs.state"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "not": {
            "ref": "body.outputs.state.more"
          }
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "AuditState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        },
        "id": "contracts",
        "description": "Bypass an empty contract scan; otherwise inspect every declared contract once in source order."
      },
      {
        "id": "report",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.contracts.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "AuditReport",
        "value": {
          "ref": "steps.report.outputs.report"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "inspect_skill_coverage",
        "inspect_declared_loop_contracts"
      ],
      "forbidden": [
        "execute_scientific_loops",
        "repair_skill_hooks",
        "promote_scientific_results"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 20005
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked coverage audit only; no scientific execution, proof or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
