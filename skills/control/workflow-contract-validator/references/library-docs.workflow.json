{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_docs_library_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Selected main generation path for the fixed docs:library hub invocation.",
  "aliases": [
    "docs:library"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Invocation": {
      "schema": {
        "type": "array",
        "const": [
          "--output-dir",
          "docs/libraries/mathformerlib"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "Configuration": {
      "schema": {
        "type": "object",
        "properties": {
          "roots": {
            "type": "array",
            "const": [
              "MathformerLib",
              "libraries/MathformerLib.lean",
              "Mathformer"
            ],
            "items": {
              "type": "string"
            }
          },
          "output_dir": {
            "const": "docs/libraries/mathformerlib"
          },
          "registry_file": {
            "type": "null"
          },
          "reasoning_log_file": {
            "type": "null"
          },
          "expect_docs": {
            "const": false
          },
          "self_test": {
            "const": false
          },
          "json": {
            "const": false
          }
        },
        "required": [
          "roots",
          "output_dir",
          "registry_file",
          "reasoning_log_file",
          "expect_docs",
          "self_test",
          "json"
        ],
        "additionalProperties": false
      }
    },
    "Modules": {
      "schema": {
        "type": "array",
        "description": "Ordered ModuleDoc records, including imports, comments, declaration slices and hashes.",
        "items": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string"
            },
            "rel_path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "imports": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "declarations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "path": {
              "type": "string"
            },
            "module_comment": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "module",
            "rel_path",
            "sha256",
            "status",
            "imports",
            "declarations",
            "path",
            "module_comment"
          ]
        }
      }
    },
    "Manifest": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "summary": {
            "type": "object"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "index_file": {
            "type": "string"
          },
          "manifest_file": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "summary",
          "modules",
          "index_file",
          "manifest_file"
        ]
      }
    },
    "MainResult": {
      "schema": {
        "type": "object",
        "properties": {
          "returncode": {
            "type": "integer",
            "const": 0
          },
          "stdout": {
            "type": "string"
          },
          "manifest": {
            "type": "object"
          }
        },
        "required": [
          "returncode",
          "stdout",
          "manifest"
        ],
        "additionalProperties": false
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "required": [
          "repository_root"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Invocation"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "result": {
      "type": "MainResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "configure": {
      "inputs": {
        "argv": {
          "type": "Invocation"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "config": {
          "type": "Configuration"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_library_docs_configure",
          "operation": "mathformer_library_docs_configure"
        }
      }
    },
    "collect_modules": {
      "inputs": {
        "config": {
          "type": "Configuration"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "modules": {
          "type": "Modules"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_library_docs_collect_modules",
          "operation": "mathformer_library_docs_collect_modules"
        }
      }
    },
    "publish_docs": {
      "inputs": {
        "config": {
          "type": "Configuration"
        },
        "modules": {
          "type": "Modules"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "manifest": {
          "type": "Manifest"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_library_docs_publish_docs",
          "operation": "mathformer_library_docs_publish_docs"
        }
      }
    },
    "complete_main": {
      "inputs": {
        "config": {
          "type": "Configuration"
        },
        "manifest": {
          "type": "Manifest"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "result": {
          "type": "MainResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_library_docs_complete_main",
          "operation": "mathformer_library_docs_complete_main"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "configure",
        "kind": "call",
        "operation": "configure",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "collect",
        "kind": "call",
        "operation": "collect_modules",
        "arguments": {
          "config": {
            "ref": "steps.configure.outputs.config"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish_docs",
        "arguments": {
          "config": {
            "ref": "steps.configure.outputs.config"
          },
          "modules": {
            "ref": "steps.collect.outputs.modules"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "complete",
        "kind": "call",
        "operation": "complete_main",
        "arguments": {
          "config": {
            "ref": "steps.configure.outputs.config"
          },
          "manifest": {
            "ref": "steps.publish.outputs.manifest"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "MainResult",
        "value": {
          "ref": "steps.complete.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/",
          "docs/libraries/mathformerlib/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 4
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source description only; no runtime qualification or scientific acceptance."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
