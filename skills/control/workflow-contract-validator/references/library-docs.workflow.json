    "gaps": [
      "Graph covers the registered main invocation after controller admission. Native hub preflight, subprocess capture and write audit remain the outer boundary; direct stage calls require host admission and service write policy.",
      "Unrestricted CLI paths (self-test, expect-docs, custom roots, registry and logs) remain available only through the native CLI, excluded by the fixed Invocation and Configuration.",
      "Helper iterations remain native inside their owning operations, with exhaustion and no item cap. Module/comment/declaration records travel losslessly as JSON; some nested fields are structurally open.",
      "Native main has no wall-time or operation budget; the descriptor limits and receipts are enforced by Lunar at the execution boundary."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "docs:library",
      "owner_skill": "skills/mathformerlib/mathformer-library-docs-generator/SKILL.md"
    },
    "mathformer.native_boundary": {
      "execution": "run_action -> run_leaf_action -> main; no dependencies.",
      "command": [
        "{python}",
        "skills/mathformerlib/mathformer-library-docs-generator/scripts/generate_mathformer_library_docs.py",
        "--output-dir",
        "docs/libraries/mathformerlib"
      ],
      "admission": "Reject extra arguments. Preflight blocks missing required script or unauthorized mutation. Preflight errors return failure; dry-run returns without launching.",
      "completion": "Native subprocess captures stdout, stderr and exit status, then audits writes against docs/libraries/mathformerlib/. Hub ok follows exit code and write audit, not manifest.ok. Unexpected writes force ok=false and status=undeclared_writes.",
      "exceptions": "Unhandled generator exceptions terminate the subprocess with failure and may leave partial writes; the native controller still audits a returned nonzero exit. No rollback, retry or checkpoint recovery is supplied.",
      "timeout_seconds": null,
      "limits": "The descriptor wall-time limit is not enforced by main or this hub action."
    }
  }
}
