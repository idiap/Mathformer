      "failure_policy": "Map status blocked/needs_expansion returns 0; uncaught exceptions and preflight/subprocess failures remain execution failures.",
      "scientific_payloads": "Exports describe main's map and emission, not the hub transport envelope.",
      "runtime": "MCP tools invoke the shared native functions; CLI exits become MCP errors. Repository cwd is retained for relative paths. Native JSON companions preserve insertion order. Lunar supplies mandatory execution receipts."
    },
    "mathformer.mapping_semantics": {
      "findings": "Keep dictionary planner findings of high/critical severity (missing defaults high); append compatible review findings or fallback diagnostics. Reviews synthesize blocking surfaces from high/critical findings, or repair_surfaces for fail/blocked reports with no compatible findings.",
      "nodes": "Findings become nodes in encounter order; high/critical nodes are open, others satisfied. Sort outstanding nodes stably by surface priority, then surface name; frontier order starts at 1.",
      "status": "complete iff next_action is complete and outstanding is empty; next_action blocked overrides; otherwise needs_expansion.",
      "signature": "First 16 SHA-256 hex characters of canonical sorted-key compact JSON containing case_id, status and ordered outstanding surface/blockers.",
      "iteration": "No repair/retry loop, persistent carried state, cap, or checkpoint. Rerun gates are metadata only. Controller history, repeated-signature detection, max_iterations (default 6) and caller 300s timeout are outside this action."
    }
