  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse_args",
        "arguments": {
          "extra_args": {
            "ref": "inputs.extra_args"
          }
        }
      },
      {
        "id": "select_map",
        "kind": "switch",
        "cases": [
          {
            "id": "self_test",
            "when": {
              "ref": "steps.parse.outputs.options.self_test"
            },
            "body": {
              "id": "probe",
              "kind": "call",
              "operation": "self_test",
              "arguments": {}
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "acquire_plan",
              "kind": "switch",
              "cases": [
                {
                  "id": "provided_plan",
                  "when": {
                    "ref": "steps.parse.outputs.options.goal_plan_supplied"
                  },
                  "body": {
                    "id": "read_plan",
                    "kind": "call",
                    "operation": "load_plan",
                    "arguments": {
                      "options": {
                        "ref": "steps.parse.outputs.options"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "switch",
                "cases": [
                  {
                    "id": "case_available",
                    "when": {
                      "ref": "steps.parse.outputs.options.case_available"
                    },
                    "body": {
                      "id": "plan",
                      "kind": "call",
                      "description": "Run --run-gates --json with timeout 240s; nonzero exit or invalid/empty JSON becomes a blocking trace_realness plan. Timeout and other errors propagate.",
                      "operation": "run_planner",
                      "arguments": {
                        "options": {
                          "ref": "steps.parse.outputs.options"
                        }
                      }
                    }
                  }
                ],
                "default": {
                  "id": "missing",
                  "kind": "call",
                  "description": "Raise SystemExit('provide --goal-plan or --case'); no output is produced.",
                  "operation": "missing_input",
                  "arguments": {}
                },
                "outputs": {
                  "plan": {
                    "type": "GoalPlan",
                    "value": {
                      "ref": "selected.outputs.plan"
                    }
                  },
                  "plan_json": {
                    "type": "NativeJson",
                    "value": {
                      "ref": "selected.outputs.plan_json"
                    }
                  }
                }
              },
              "outputs": {
                "plan": {
                  "type": "GoalPlan",
                  "value": {
                    "ref": "selected.outputs.plan"
                  }
                },
                "plan_json": {
                  "type": "NativeJson",
                  "value": {
                    "ref": "selected.outputs.plan_json"
                  }
                }
              }
            },
            {
              "id": "reviews",
              "kind": "call",
              "operation": "load_reviews",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                }
              }
            },
            {
              "id": "construct",
              "kind": "call",
              "description": "Accumulate findings and nodes, sort outstanding nodes, construct ordered frontier, determine status and compute signature; finite traversals only.",
              "operation": "build_map",
              "arguments": {
                "plan": {
                  "ref": "steps.acquire_plan.outputs.plan"
                },
                "reviews": {
                  "ref": "steps.reviews.outputs.reviews"
                },
                "plan_json": {
                  "ref": "steps.acquire_plan.outputs.plan_json"
                },
                "reviews_json": {
                  "ref": "steps.reviews.outputs.reviews_json"
                }
              }
            }
          ],
          "outputs": {
            "expansion": {
              "type": "ExpansionMap",
              "value": {
                "ref": "steps.construct.outputs.expansion"
              }
            },
            "expansion_json": {
              "type": "NativeJson",
              "value": {
                "ref": "steps.construct.outputs.expansion_json"
              }
            }
          }
        },
        "outputs": {
          "expansion": {
            "type": "ExpansionMap",
            "value": {
              "ref": "selected.outputs.expansion"
            }
          },
          "expansion_json": {
            "type": "NativeJson",
            "value": {
              "ref": "selected.outputs.expansion_json"
            }
          }
        }
      },
      {
        "id": "emit",
        "kind": "call",
        "description": "Runs for complete, blocked and needs_expansion alike; uncaught serialization, write or logging errors fail execution.",
        "operation": "emit",
        "arguments": {
          "options": {
            "ref": "steps.parse.outputs.options"
          },
          "expansion": {
            "ref": "steps.select_map.outputs.expansion"
          },
          "expansion_json": {
            "ref": "steps.select_map.outputs.expansion_json"
          }
        }
      }
    ],
    "outputs": {
      "expansion": {
        "type": "ExpansionMap",
        "value": {
          "ref": "steps.select_map.outputs.expansion"
        }
      },
      "result": {
        "type": "Emission",
        "value": {
          "ref": "steps.emit.outputs.result"
        }
      },
      "expansion_json": {
        "type": "NativeJson",
        "value": {
          "ref": "steps.select_map.outputs.expansion_json"
        }
      }
    }
  },
  "policy": {
