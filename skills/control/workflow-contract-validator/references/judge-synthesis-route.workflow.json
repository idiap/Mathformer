    "gaps": [
      "Native action internals remain owned by execute_action; report artifacts are captured in HubResult stdout and filesystem outputs, rather than materialized as separate workflow ports.",
      "The 3600-second limit is a Lunar descriptor budget, not a native route-wide deadline. Native subprocess timeouts remain 180 and 300 seconds; the graph uses at most eight operation calls."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "report.formalphysics.judge_synthesis",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md"
    },
    "mathformer.composition": {
      "ordered_actions": [
        "physics-lean:formalphysics-judge-synthesis-report-self-test",
        "physics-lean:formalphysics-judge-synthesis-report"
      ],
      "selection": "Already selected route; supplied match carries score and matched terms, with native route metadata reconstructed from build_intent_routes.",
      "registry_constraint": "Supplied registry entries must equal native action_to_dict projections; native commands, write declarations, empty dependencies and 180/300-second timeouts are pinned. Missing entries preserve native rejection and final metadata failure.",
      "bound_semantics": "Two iterations complete normally; on_exhausted is unreachable for conforming advance outputs."
    },
    "mathformer.native_boundary": {
      "execution": "CLI ask --run and MCP dispatch retain run_intent_match. Callable MCP ports share its native initialize/select/run_action/advance/finish functions; Lunar compiles and executes the bounded graph with receipts and digests.",
      "failure_policy": "Failed children are data for sticky aggregation; unexpected exceptions terminate without a final route envelope.",
      "self_test": "Temporary fixtures, builder invocation, artifact checks, JSON assertions and HTML marker checks remain inside the first action.",
      "report_builder": "Load comparative JSON, ingest supplied Codex files if present, summarize approaches and judge/reviewer evidence, compare aspects, derive strengths/weaknesses/cases/todos, then emit JSON, Markdown, HTML and todo files.",
      "aspect_traversal": "Five fixed aspects carry approaches, IDs, index and accumulated rows; rounded score gaps select clear advantage at >=0.75, slight advantage at >0, otherwise tie.",
      "completion": "Other traversals are input-sized; pending judges become statuses and todos, with no judge execution, repair loop, retry or resume."
    }
  }
