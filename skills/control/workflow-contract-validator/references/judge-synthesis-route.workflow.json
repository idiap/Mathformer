{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_report_formalphysics_judge_synthesis_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Execute the selected synthesis route: self-test, then report generation, retaining ordered results and sticky failure.",
  "aliases": [
    "report.formalphysics.judge_synthesis"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "enum": [
          "physics-lean:formalphysics-judge-synthesis-report-self-test",
          "physics-lean:formalphysics-judge-synthesis-report"
        ]
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "children"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "SelectedMatch": {
      "schema": {
        "type": "object",
        "description": "Match metadata; the route definition is fixed by this contract's native identity.",
        "required": [
          "score",
          "matched_terms"
        ],
        "properties": {
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "description": "Checked native WorkflowAction projections keyed by action id. Missing entries retain native unknown_action and final metadata KeyError behavior; altered entries are rejected.",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "SelectedMatch"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_judge_synthesis_route_initialize",
          "operation": "mathformer_judge_synthesis_route_initialize"
        }
      }
    },
    "select_action": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_judge_synthesis_route_select_action",
          "operation": "mathformer_judge_synthesis_route_select_action"
        }
      }
    },
    "execute_action": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "registry": {
          "type": "Registry"
        },
        "context": {
          "type": "RunContext"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_judge_synthesis_route_execute_action",
          "operation": "mathformer_judge_synthesis_route_execute_action"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_judge_synthesis_route_advance",
          "operation": "mathformer_judge_synthesis_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_judge_synthesis_route_finish",
          "operation": "mathformer_judge_synthesis_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "description": "At most two ordered actions; the second advancement always sets done, so the native bound returns normally.",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 2,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select_action",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "execute",
              "kind": "call",
              "operation": "execute_action",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "temporary_self_test_fixtures",
          "artifacts/formalphysics_judge_synthesis/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 8
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Report synthesis and child execution status establish no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
