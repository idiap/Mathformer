{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_control_thematic_layout_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Parse layout CLI arguments, optionally repair managed views, build a validation report, print it and return status.",
  "aliases": [
    "control:thematic-layout"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "representation": "value"
    },
    "Options": {
      "schema": {
        "type": "object",
        "properties": {
          "apply": {
            "type": "boolean"
          },
          "json": {
            "type": "boolean"
          },
          "halted": {
            "type": "boolean"
          },
          "stdout": {
            "type": "string"
          }
        },
        "required": [
          "apply",
          "json",
          "halted",
          "stdout"
        ],
        "additionalProperties": false
      },
      "representation": "value"
    },
    "LayoutReport": {
      "schema": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "view_count": {
                "type": "integer",
                "minimum": 0
              },
              "view_states": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "invalid_views": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "skill_theme_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "flat_skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "misclassified_skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "script_theme_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "test_alias_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "unclassified_root_scripts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unclassified_root_tests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unclassified_root_docs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_doc_themes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "backend_component_states": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "library_component_states": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "missing_backend_components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_library_components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "legacy_component_roots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "root_lean_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ok",
              "view_count",
              "view_states",
              "invalid_views",
              "skill_theme_counts",
              "flat_skills",
              "misclassified_skills",
              "script_theme_counts",
              "test_alias_counts",
              "unclassified_root_scripts",
              "unclassified_root_tests",
              "unclassified_root_docs",
              "missing_doc_themes",
              "backend_component_states",
              "library_component_states",
              "missing_backend_components",
              "missing_library_components",
              "legacy_component_roots",
              "root_lean_files"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "representation": "value"
    },
    "Completion": {
      "schema": {
        "type": "object",
        "properties": {
          "stdout": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        "required": [
          "stdout",
          "exit_code"
        ],
        "additionalProperties": false
      },
      "representation": "value"
    },
    "Context": {
      "schema": {
        "type": "object",
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "required": [
          "repository_root"
        ],
        "additionalProperties": false
      },
      "representation": "value"
    },
    "ReportJson": {
      "schema": {
        "type": "string"
      },
      "representation": "value"
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "report": {
      "type": "LayoutReport",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "completion": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.completion"
      }
    }
  },
  "operations": {
    "parse": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "options": {
          "type": "Options"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_layout_parse",
          "operation": "mathformer_layout_parse"
        }
      }
    },
    "repair": {
      "inputs": {
        "context": {
          "type": "Context"
        }
      },
      "outputs": {},
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_layout_repair",
          "operation": "mathformer_layout_repair"
        }
      },
      "effects": {
        "filesystem": {
          "read": [
            "repository"
          ],
          "write": [
            "managed_script_and_test_aliases"
          ]
        },
        "network": [],
        "external_write": []
      }
    },
    "validate_layout": {
      "inputs": {
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "LayoutReport"
        },
        "report_json": {
          "type": "ReportJson"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_layout_validate",
          "operation": "mathformer_layout_validate"
        }
      },
      "effects": {
        "filesystem": {
          "read": [
            "repository"
          ],
          "write": []
        },
        "network": [],
        "external_write": []
      }
    },
    "emit_return": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "report": {
          "type": "LayoutReport"
        },
        "report_json": {
          "type": "ReportJson"
        }
      },
      "outputs": {
        "completion": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_layout_emit",
          "operation": "mathformer_layout_emit"
        }
      }
    },
    "early_return": {
      "inputs": {
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "report": {
          "type": "LayoutReport"
        },
        "completion": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_layout_halt",
          "operation": "mathformer_layout_halt"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "help",
            "when": {
              "ref": "steps.parse.outputs.options.halted"
            },
            "body": {
              "kind": "call",
              "operation": "early_return",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "validate",
              "kind": "switch",
              "cases": [
                {
                  "id": "apply",
                  "when": {
                    "ref": "steps.parse.outputs.options.apply"
                  },
                  "body": {
                    "kind": "sequence",
                    "steps": [
                      {
                        "id": "repair",
                        "kind": "call",
                        "operation": "repair",
                        "arguments": {
                          "context": {
                            "ref": "inputs.context"
                          }
                        }
                      },
                      {
                        "id": "report_after_repair",
                        "kind": "call",
                        "operation": "validate_layout",
                        "arguments": {
                          "context": {
                            "ref": "inputs.context"
                          }
                        }
                      }
                    ],
                    "outputs": {
                      "report": {
                        "type": "LayoutReport",
                        "value": {
                          "ref": "steps.report_after_repair.outputs.report"
                        }
                      },
                      "report_json": {
                        "type": "ReportJson",
                        "value": {
                          "ref": "steps.report_after_repair.outputs.report_json"
                        }
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "validate_layout",
                "arguments": {
                  "context": {
                    "ref": "inputs.context"
                  }
                }
              },
              "outputs": {
                "report": {
                  "type": "LayoutReport",
                  "value": {
                    "ref": "selected.outputs.report"
                  }
                },
                "report_json": {
                  "type": "ReportJson",
                  "value": {
                    "ref": "selected.outputs.report_json"
                  }
                }
              }
            },
            {
              "id": "finish",
              "kind": "call",
              "operation": "emit_return",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                },
                "report": {
                  "ref": "steps.validate.outputs.report"
                },
                "report_json": {
                  "ref": "steps.validate.outputs.report_json"
                }
              }
            }
          ],
          "outputs": {
            "report": {
              "type": "LayoutReport",
              "value": {
                "ref": "steps.validate.outputs.report"
              }
            },
            "completion": {
              "type": "Completion",
              "value": {
                "ref": "steps.finish.outputs.completion"
              }
            }
          }
        },
        "outputs": {
          "report": {
            "type": "LayoutReport",
            "value": {
              "ref": "selected.outputs.report"
            }
          },
          "completion": {
            "type": "Completion",
            "value": {
              "ref": "selected.outputs.completion"
            }
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "LayoutReport",
        "value": {
          "ref": "steps.dispatch.outputs.report"
        }
      },
      "completion": {
        "type": "Completion",
        "value": {
          "ref": "steps.dispatch.outputs.completion"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository"
        ],
        "write": [
          "managed_script_and_test_aliases",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "validate_thematic_layout",
        "repair_managed_aliases_when_apply"
      ],
      "forbidden": [
        "replace_occupied_non_symlink_aliases",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 4
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native repository layout validation and optional managed alias repair only; no scientific endorsement."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
