        "digest": "sha256:2a7e5f0889ebb18614d4d3fce5d5029aaf868c7709d8ff837a890e6b06d99b21"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "MCP registration",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "authored thematic layout descriptor adoption",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      },
      {
        "path": "tests/mcp/run_thematic_layout_workflow_tests.py",
        "selector": "deterministic native/MCP/Lunar integration fixtures",
        "digest": "sha256:96975ae234de3d2e5bf6cdff089b370e9224abb8bb3ddd7e54b55550323af5d4"
      },
      {
        "path": "tests/test_matrix.json",
        "selector": "mcp.thematic_layout.workflow",
        "digest": "sha256:6ab7f3ac79747ff01ad2ff8bce20180b97ad48437e44cb5d3c030580d1961249"
      }
    ],
    "gaps": [
      "Helper iterations remain inside owning operations. They accumulate alias mappings, per-path states, counts and failure collections over finite declared tables and filesystem listings; repair additionally carries filesystem changes. No retry, convergence, global budget, or exhaustion behavior is added.",
      "The native implementation has no global timeout or call ceiling; Lunar enforces the retained descriptor limits of 3600 seconds and four operation calls.",
      "Hub preflight, dry-run and post-execution write audit remain external controller behavior, not main graph nodes. Mandatory receipts/provenance are contract requirements, not upgrades to native logging.",
      "Invalid argparse input and repair SystemExit preserve native diagnostics and stop downstream execution, translated to MCP tool errors so the service remains alive. Successful argparse help returns exit 0 and null report without filesystem steps."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "control:thematic-layout",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "control:thematic-layout",
        "family": "control",
        "kind": "validation",
        "safety": "read_only",
        "command": [
          "{python}",
          "scripts/organize_repository_layout.py",
          "--json"
        ],
        "depends_on": [],
        "writes": [],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Main-entrypoint projection; the existing hub launches only --json, so apply=false and validation cannot repair aliases. Standalone main also accepts --apply.",
      "hub_context": "Preflight failure or dry-run prevents launch. run_action/run_leaf_action dispatch the registered action; post-execution write audit can override subprocess success. Optional hub report writes belong to the controller.",
      "failure_policy": "A failing report is still printed and returned with native exit 1; exceptions/SystemExit can terminate earlier. Do not interpret descriptor completion as subprocess success.",
      "scientific_payloads": "LayoutReport is repository validation, not a proof artifact."
    }
  }
}
