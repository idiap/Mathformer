  "operations": {
    "initialize_results": {
      "inputs": {},
      "outputs": {
        "results": {
          "type": "Results"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_initialize_results",
          "operation": "mathformer_dependency_failure_initialize_results"
        }
      }
    },
    "collect_next": {
      "inputs": {
        "results": {
          "type": "Results"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "results": {
          "type": "Results"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_collect_next",
          "operation": "mathformer_dependency_failure_collect_next"
        }
      }
    },
    "begin_validation": {
      "inputs": {
        "results": {
          "type": "Results"
        }
      },
      "outputs": {
        "state": {
          "type": "ValidationState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_begin_validation",
          "operation": "mathformer_dependency_failure_begin_validation"
        }
      }
    },
    "inspect_current": {
      "inputs": {
        "state": {
          "type": "ValidationState"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        },
        "missing": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_inspect_current",
          "operation": "mathformer_dependency_failure_inspect_current"
        }
      }
    },
    "record_missing": {
      "inputs": {
        "state": {
          "type": "ValidationState"
        },
        "result": {
          "type": "Result"
        }
      },
      "outputs": {
        "findings": {
          "type": "Findings"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_record_missing",
          "operation": "mathformer_dependency_failure_record_missing"
        }
      }
    },
    "check_nonempty": {
      "inputs": {
        "state": {
          "type": "ValidationState"
        },
        "result": {
          "type": "Result"
        }
      },
      "outputs": {
        "findings": {
          "type": "Findings"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_check_nonempty",
          "operation": "mathformer_dependency_failure_check_nonempty"
        }
      }
    },
    "advance_validation": {
      "inputs": {
        "state": {
          "type": "ValidationState"
        },
        "findings": {
          "type": "Findings"
        }
      },
      "outputs": {
        "state": {
          "type": "ValidationState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_advance_validation",
          "operation": "mathformer_dependency_failure_advance_validation"
        }
      }
    },
    "build_report": {
      "inputs": {
        "state": {
          "type": "ValidationState"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_dependency_failure_build_report",
          "operation": "mathformer_dependency_failure_build_report"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize_results",
        "arguments": {}
      },
      {
        "id": "collect",
        "kind": "loop",
        "state_type": "Results",
        "initial": {
          "ref": "steps.initialize.outputs.results"
        },
        "max_iterations": 2,
        "on_exhausted": "fail",
        "description": "Sequential source list comprehension over exactly two fixed scripts. done is true on the second iteration, so reaching the bound returns normally.",
        "body": {
          "kind": "call",
          "operation": "collect_next",
          "arguments": {
            "results": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.results"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "results": {
            "type": "Results",
            "value": {
              "ref": "body.outputs.results"
            }
          }
        }
      },
      {
        "id": "prepare_validation",
        "kind": "call",
        "operation": "begin_validation",
        "arguments": {
          "results": {
            "ref": "steps.collect.outputs.results"
          }
        }
      },
      {
        "id": "validate",
        "kind": "loop",
        "state_type": "ValidationState",
        "initial": {
          "ref": "steps.prepare_validation.outputs.state"
        },
        "max_iterations": 2,
        "on_exhausted": "fail",
        "description": "Exactly two validation iterations on normal execution; no repair, retry or early termination for findings. done is true at the bound; exhaustion is unreachable for source-produced state.",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "inspect",
              "kind": "call",
              "operation": "inspect_current",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                }
              }
            },
            {
              "id": "choose_checks",
              "kind": "switch",
              "cases": [
                {
                  "id": "missing_json",
                  "when": {
                    "ref": "steps.inspect.outputs.missing"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "record_missing",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "result": {
                        "ref": "steps.inspect.outputs.result"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "check_nonempty",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "result": {
                    "ref": "steps.inspect.outputs.result"
                  }
                }
              },
              "outputs": {
                "findings": {
                  "type": "Findings",
                  "value": {
                    "ref": "selected.outputs.findings"
                  }
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance_validation",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "findings": {
                  "ref": "steps.choose_checks.outputs.findings"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "ValidationState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "ValidationState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "build_report",
        "arguments": {
          "state": {
            "ref": "steps.validate.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
