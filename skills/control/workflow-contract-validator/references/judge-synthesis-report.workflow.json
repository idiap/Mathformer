        "id": "physics-lean:formalphysics-judge-synthesis-report",
        "family": "physics_lean",
        "kind": "render",
        "safety": "writes_artifacts",
        "depends_on": [],
        "allows_extra_args": true,
        "timeout_seconds": 300,
        "writes": [
          "artifacts/formalphysics_judge_synthesis/"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "scripts/mathformer.py run_action dispatches run_leaf_action; no dependencies, appended override argv, preflight and dry-run before launch, write audit after launch.",
      "input_scope": "argv is the final selected-main argument vector; hub defaults select hub_selected_examples comparative input/output and --json; direct CLI output defaults to latest.",
      "failure_policy": "Missing required comparative input exits; uncaught read/synthesis/write errors abort; hub timeout or undeclared writes yield failure, even after outputs exist.",
      "limits": "3600 seconds is a descriptor ceiling, not the native 300-second subprocess timeout; 12 calls covers the normal graph, with no retries or refinement.",
      "outputs": "Report writes are limited to the declared hub root under hub invocation; direct CLI accepts output-dir. Self-test writes/asserts in a temporary directory and returns before comparative input handling.",
      "ordered_payloads": "Loaded, Report, Approaches, AspectState and Synthesis use native_json envelopes to preserve native dictionary order through canonical transport. Paths resolve from the MCP service working directory, as they do for selected main argv. Native CLI output is emitted on the MCP server diagnostic stream and retained as printed_result.",
      "compiler_lowering": "Lunar requires exhaustion exits at root scope. The aspect loop is lifted out of the mode branch. The self-test path carries absent state through empty_aspects and retain_aspects; these adapters perform no native work. The self_test operation remains the only substantive self-test work; comparative source calls and their order are unchanged."
    }
