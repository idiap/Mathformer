{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_lean_formalphysics_judge_synthesis_report_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "FormalPhysics synthesis CLI; load comparative evidence, ingest optional judge results, summarize, and emit reports.",
  "aliases": [
    "physics-lean:formalphysics-judge-synthesis-report"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "required": [
          "self_test",
          "comparative_report",
          "output_dir",
          "codex_results_json",
          "codex_results_dir",
          "json"
        ],
        "properties": {
          "self_test": {
            "type": "boolean"
          },
          "comparative_report": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_dir": {
            "type": "string"
          },
          "codex_results_json": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "codex_results_dir": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "json": {
            "type": "boolean"
          }
        }
      }
    },
    "Loaded": {
      "schema": {
        "type": "object",
        "required": [
          "native_json"
        ],
        "properties": {
          "native_json": {
            "type": "string",
            "description": "Native ordered JSON for Loaded; preserves insertion order used by rankings, TODO IDs, and renderers."
          }
        },
        "additionalProperties": false
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "native_json"
        ],
        "properties": {
          "native_json": {
            "type": "string",
            "description": "Native ordered JSON for Report; preserves insertion order used by rankings, TODO IDs, and renderers."
          }
        },
        "additionalProperties": false
      }
    },
    "Approaches": {
      "schema": {
        "type": "object",
        "required": [
          "native_json"
        ],
        "properties": {
          "native_json": {
            "type": "string",
            "description": "Native ordered JSON for Approaches; preserves insertion order used by rankings, TODO IDs, and renderers."
          }
        },
        "additionalProperties": false
      }
    },
    "AspectState": {
      "schema": {
        "type": "object",
        "required": [
          "native_json"
        ],
        "properties": {
          "native_json": {
            "type": "string",
            "description": "Native ordered JSON for AspectState; preserves insertion order used by rankings, TODO IDs, and renderers."
          }
        },
        "additionalProperties": false
      }
    },
    "Done": {
      "schema": {
        "type": "boolean"
      }
    },
    "Synthesis": {
      "schema": {
        "type": "object",
        "required": [
          "native_json"
        ],
        "properties": {
          "native_json": {
            "type": "string",
            "description": "Native ordered JSON for Synthesis; preserves insertion order used by rankings, TODO IDs, and renderers."
          }
        },
        "additionalProperties": false
      }
    },
    "Completion": {
      "schema": {
        "type": "object",
        "required": [
          "returncode",
          "printed_result"
        ],
        "properties": {
          "returncode": {
            "type": "integer",
            "const": 0
          },
          "printed_result": {
            "type": "object",
            "required": [
              "ok",
              "style",
              "artifacts"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "style": {
                "type": "string"
              },
              "artifacts": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    }
  },
  "outputs": {
    "result": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "parse_cli": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "options": {
          "type": "Options"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_parse_cli",
          "operation": "mathformer_synthesis_builder_parse_cli"
        }
      }
    },
    "self_test": {
      "inputs": {
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "result": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_self_test",
          "operation": "mathformer_synthesis_builder_self_test"
        }
      }
    },
    "load_inputs": {
      "inputs": {
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "loaded": {
          "type": "Loaded"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_load_inputs",
          "operation": "mathformer_synthesis_builder_load_inputs"
        }
      }
    },
    "attach_results": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_attach_results",
          "operation": "mathformer_synthesis_builder_attach_results"
        }
      }
    },
    "summarize_approaches": {
      "inputs": {
        "report": {
          "type": "Report"
        }
      },
      "outputs": {
        "approaches": {
          "type": "Approaches"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_summarize_approaches",
          "operation": "mathformer_synthesis_builder_summarize_approaches"
        }
      }
    },
    "pack_aspects": {
      "inputs": {
        "approaches": {
          "type": "Approaches"
        }
      },
      "outputs": {
        "state": {
          "type": "AspectState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_pack_aspects",
          "operation": "mathformer_synthesis_builder_pack_aspects"
        }
      }
    },
    "compare_next_aspect": {
      "inputs": {
        "state": {
          "type": "AspectState"
        }
      },
      "outputs": {
        "state": {
          "type": "AspectState"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_compare_next_aspect",
          "operation": "mathformer_synthesis_builder_compare_next_aspect"
        }
      }
    },
    "finish_synthesis": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "aspects": {
          "type": "AspectState"
        }
      },
      "outputs": {
        "synthesis": {
          "type": "Synthesis"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_finish_synthesis",
          "operation": "mathformer_synthesis_builder_finish_synthesis"
        }
      }
    },
    "emit": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "synthesis": {
          "type": "Synthesis"
        }
      },
      "outputs": {
        "result": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_emit",
          "operation": "mathformer_synthesis_builder_emit"
        }
      }
    },
    "empty_aspects": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "AspectState"
        },
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_empty_aspects",
          "operation": "mathformer_synthesis_builder_empty_aspects"
        }
      }
    },
    "retain_aspects": {
      "inputs": {
        "state": {
          "type": "AspectState"
        }
      },
      "outputs": {
        "state": {
          "type": "AspectState"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_synthesis_builder_retain_aspects",
          "operation": "mathformer_synthesis_builder_retain_aspects"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse_cli",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "switch",
        "cases": [
          {
            "id": "synthetic",
            "when": {
              "ref": "steps.parse.outputs.options.self_test"
            },
            "body": {
              "id": "empty",
              "kind": "call",
              "operation": "empty_aspects",
              "arguments": {}
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "load",
              "kind": "call",
              "operation": "load_inputs",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                }
              }
            },
            {
              "id": "attach",
              "kind": "call",
              "operation": "attach_results",
              "arguments": {
                "loaded": {
                  "ref": "steps.load.outputs.loaded"
                }
              }
            },
            {
              "id": "approaches",
              "kind": "call",
              "operation": "summarize_approaches",
              "arguments": {
                "report": {
                  "ref": "steps.attach.outputs.report"
                }
              }
            },
            {
              "id": "pack",
              "kind": "call",
              "operation": "pack_aspects",
              "arguments": {
                "approaches": {
                  "ref": "steps.approaches.outputs.approaches"
                }
              }
            }
          ],
          "outputs": {
            "report": {
              "type": "Report",
              "value": {
                "ref": "steps.attach.outputs.report"
              }
            },
            "state": {
              "type": "AspectState",
              "value": {
                "ref": "steps.pack.outputs.state"
              }
            }
          }
        },
        "outputs": {
          "report": {
            "type": "Report",
            "value": {
              "ref": "selected.outputs.report"
            }
          },
          "state": {
            "type": "AspectState",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "aspects",
        "kind": "loop",
        "state_type": "AspectState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "synthetic",
              "when": {
                "ref": "steps.parse.outputs.options.self_test"
              },
              "body": {
                "id": "retain",
                "kind": "call",
                "operation": "retain_aspects",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "compare_next_aspect",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "AspectState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Done",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "description": "Exact ASPECTS cardinality; fifth item sets done and returns normally. Exhaustion is unreachable for this source.",
        "outputs": {
          "state": {
            "type": "AspectState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "mode",
        "kind": "switch",
        "cases": [
          {
            "id": "synthetic",
            "when": {
              "ref": "steps.parse.outputs.options.self_test"
            },
            "body": {
              "kind": "call",
              "operation": "self_test",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "synthesize",
              "kind": "call",
              "operation": "finish_synthesis",
              "arguments": {
                "report": {
                  "ref": "steps.prepare.outputs.report"
                },
                "aspects": {
                  "ref": "steps.aspects.outputs.state"
                }
              }
            },
            {
              "id": "write",
              "kind": "call",
              "operation": "emit",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                },
                "synthesis": {
                  "ref": "steps.synthesize.outputs.synthesis"
                }
              }
            }
          ],
          "outputs": {
            "result": {
              "type": "Completion",
              "value": {
                "ref": "steps.write.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "Completion",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Completion",
        "value": {
          "ref": "steps.mode.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/formalphysics_judge_synthesis/",
          "artifacts/workflow_hub/",
          "self_test_temporary_directory"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "read_comparative_evidence",
        "summarize_judge_results",
        "write_synthesis_reports"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion",
        "execute_pending_judges"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 12
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked report completion establishes no proof, scientific endorsement or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
