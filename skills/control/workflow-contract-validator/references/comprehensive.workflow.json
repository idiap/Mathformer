{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_comprehensive_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Comprehensive matrix traversal for the registered workstation invocation.",
  "aliases": [
    "test:comprehensive"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Matrix": {
      "representation": "file",
      "schema": {
        "type": "object",
        "required": [
          "schema_version",
          "tests"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          }
        },
        "description": "Canonical tests/test_matrix.json; specialization admits at most 4096 rows."
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "matrix",
          "selected",
          "families",
          "index",
          "results"
        ],
        "properties": {
          "matrix": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "results": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Done": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "run_id",
          "ok",
          "profile",
          "families",
          "summary",
          "results",
          "schema_errors",
          "matrix_errors",
          "capability_ledger",
          "dependency_map"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "profile": {
            "const": "workstation"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schema_errors": {
            "type": "array"
          },
          "matrix_errors": {
            "type": "array"
          },
          "capability_ledger": {
            "type": "object"
          },
          "dependency_map": {
            "type": "string"
          }
        }
      }
    },
    "Publication": {
      "schema": {
        "type": "object",
        "required": [
          "exit_code",
          "json",
          "jsonl",
          "junit"
        ],
        "properties": {
          "exit_code": {
            "enum": [
              0,
              3
            ]
          },
          "json": {
            "type": "string"
          },
          "jsonl": {
            "type": "string"
          },
          "junit": {
            "type": "string"
          }
        }
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "RuntimeContext": {
      "schema": {
        "type": "object",
        "required": [
          "handle"
        ],
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "matrix": {
      "type": "Matrix"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "publication": {
      "type": "Publication",
      "value": {
        "ref": "flow.outputs.publication"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "matrix": {
          "type": "Matrix"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_prepare",
          "operation": "mathformer_comprehensive_prepare"
        }
      }
    },
    "cursor_guard": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_cursor_guard",
          "operation": "mathformer_comprehensive_cursor_guard"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_advance",
          "operation": "mathformer_comprehensive_advance"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_finalize",
          "operation": "mathformer_comprehensive_finalize"
        }
      }
    },
    "publish": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "publication": {
          "type": "Publication"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_publish",
          "operation": "mathformer_comprehensive_publish"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "RuntimeContext"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_retain_empty",
          "operation": "mathformer_comprehensive_retain_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "matrix": {
            "ref": "inputs.matrix"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "initial_guard",
        "kind": "call",
        "operation": "cursor_guard",
        "arguments": {
          "state": {
            "ref": "steps.prepare.outputs.state"
          },
          "context": {
            "ref": "steps.prepare.outputs.context"
          }
        }
      },
      {
        "id": "checks",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "max_iterations": 4096,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "empty",
              "when": {
                "ref": "steps.initial_guard.outputs.done"
              },
              "body": {
                "kind": "call",
                "operation": "retain_empty",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "context": {
                    "ref": "steps.prepare.outputs.context"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "id": "advance",
                "kind": "call",
                "operation": "advance",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "context": {
                    "ref": "steps.prepare.outputs.context"
                  }
                }
              },
              {
                "id": "guard",
                "kind": "call",
                "operation": "cursor_guard",
                "arguments": {
                  "state": {
                    "ref": "steps.advance.outputs.state"
                  },
                  "context": {
                    "ref": "steps.prepare.outputs.context"
                  }
                }
              }
            ],
            "outputs": {
              "state": {
                "type": "State",
                "value": {
                  "ref": "steps.advance.outputs.state"
                }
              },
              "done": {
                "type": "Done",
                "value": {
                  "ref": "steps.guard.outputs.done"
                }
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Done",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        },
        "description": "One native advance per selected row. Empty selection retains its unchanged state once without running a check. The final allowed iteration succeeds when done; exhaustion fails before finalization."
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.checks.outputs.state"
          },
          "context": {
            "ref": "steps.prepare.outputs.context"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.finalize.outputs.report"
          },
          "context": {
            "ref": "steps.prepare.outputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "publication": {
        "type": "Publication",
        "value": {
          "ref": "steps.publish.outputs.publication"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 8196
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description; no scientific validity or runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "tests/test_program/run_comprehensive_tests.py",
        "selector": "run; prepare_checks; advance_check; finalize_checks; publish_report; main",
        "digest": "sha256:60c9992ddfa80820b0c1e255d51b3e192f23d19efac01002713637c80056157a"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry/test:comprehensive; run_action; run_leaf_action",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/comprehensive_workflow_tools.py",
        "selector": "register_comprehensive_tools",
        "digest": "sha256:cc7607ec03ba69752563a14858389e9ce0ed273fc93ed7f6525e99ffb74caed5"
      },
      {
        "path": "scripts/comprehensive_strict_tools.py",
        "selector": "source_runner",
        "digest": "sha256:692874cb5a8c7869a675ee2fe16f2a3a88ab7be2dfe103a5c995217f372afecd"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_comprehensive_tools",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "hub_workflows/test:comprehensive",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Only the fixed hub workstation path is modeled; dependency-map-only and changed-file selection are excluded.",
      "The input matrix is specialized to at most 4096 rows; the native runner has no such cap.",
      "With that constraint, the final iteration exits normally even at 4096; exhaustion is unreachable for valid state.",
      "The native cursor has no global budget; the outer hub owns its 3600s process timeout and Lunar enforces host wall-time and operation-call budgets.",
      "Hub preflight/dry-run, outer timeout/write audit and HubResult envelope remain outside this runner graph.",
      "Payloads retain native row/result objects; full row schemas and external effect qualification remain outside this specialization."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "test:comprehensive",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md"
    },
    "mathformer.native_boundary": {
      "execution": "scripts/mathformer.py::run_action -> run_leaf_action -> main -> run",
      "command": [
        "{python}",
        "tests/test_program/run_comprehensive_tests.py",
        "--module-family",
        "all",
        "--write-jsonl",
        "--write-junit",
        "--json"
      ],
      "profile": "workstation",
      "allows_extra_args": false,
      "timeout_seconds": 3600,
      "fixed_flags": {
        "fail_on_warning": false,
        "validate_matrix": false,
        "changed_files_only": false,
        "emit_dependency_map_only": false
      },
      "failure_policy": "Ordinary failed results are accumulated; exceptions abort; failed reports exit 3.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "callable_context": "MCP blocks share prepare_checks, advance_check, finalize_checks and publish_report. An owned process-local context retains parse-time defaults and verifies cursor history; it is not a resumable checkpoint. Native CLI JSON is emitted on stderr while MCP owns stdout."
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "invoked_by": "quality:full after control:all"
    }
  }
}
