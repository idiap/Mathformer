{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_prism_native_semantic_parallel_e2e_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Validate the full catalog, run selected public/material PRISM entrypoints concurrently, and report bounded placeholder safety.",
  "aliases": [
    "prism:native-semantic-parallel-e2e"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Config": {
      "schema": {
        "type": "object",
        "description": "Hub-default specialization. The root must contain the current complete 14-entry catalog; initialize checks this prerequisite.",
        "properties": {
          "root": {
            "type": "string",
            "const": "mathformer-prism"
          },
          "prism_bin": {
            "type": "string"
          },
          "jobs": {
            "type": "integer",
            "const": 4
          },
          "handler": {
            "type": "string",
            "const": "codex"
          },
          "report_path": {
            "type": "string",
            "const": "mathformer-prism/tests/native-semantic-parallel-e2e.json"
          },
          "selected_workflows": {
            "type": "null"
          }
        },
        "required": [
          "root",
          "prism_bin",
          "jobs",
          "handler",
          "report_path",
          "selected_workflows"
        ],
        "additionalProperties": false
      }
    },
    "StaticState": {
      "schema": {
        "type": "object",
        "description": "Process-local source session capability, phase, and catalog cursor. Exact tokens are required; stale and out-of-order calls fail and close the session.",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "cursor": {
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "phase",
          "cursor"
        ],
        "additionalProperties": false
      }
    },
    "RuntimeState": {
      "schema": {
        "type": "object",
        "description": "Process-local source session capability owning submitted futures, accumulators, executor and temporary directory. Close joins all submitted futures.",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "cursor": {
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "phase",
          "cursor"
        ],
        "additionalProperties": false
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "string",
            "const": "parallel-workflow-conformance"
          },
          "schema_version": {
            "type": "string",
            "const": "2.0"
          },
          "status": {
            "type": "string",
            "const": "passed"
          },
          "workflow_count": {
            "type": "integer"
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "artifact",
          "schema_version",
          "status",
          "workflow_count",
          "workflows",
          "evidence"
        ]
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "properties": {
          "working_directory": {
            "type": "string"
          }
        },
        "required": [
          "working_directory"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "config": {
      "type": "Config"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {
        "config": {
          "type": "Config"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "StaticState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_prism_initialize",
          "operation": "mathformer_prism_initialize"
        }
      }
    },
    "validate_entry": {
      "inputs": {
        "state": {
          "type": "StaticState"
        }
      },
      "outputs": {
        "state": {
          "type": "StaticState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_prism_validate_entry",
          "operation": "mathformer_prism_validate_entry"
        }
      }
    },
    "prepare_runtime": {
      "inputs": {
        "state": {
          "type": "StaticState"
        }
      },
      "outputs": {
        "state": {
          "type": "RuntimeState"
        }
      },
      "execution": {
        "mode": "mixed",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_prism_prepare_runtime",
          "operation": "mathformer_prism_prepare_runtime"
        }
      }
    },
    "await_entry": {
      "inputs": {
        "state": {
          "type": "RuntimeState"
        }
      },
      "outputs": {
        "state": {
          "type": "RuntimeState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "mixed",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_prism_await_entry",
          "operation": "mathformer_prism_await_entry"
        }
      }
    },
    "finish_runtime": {
      "inputs": {
        "state": {
          "type": "RuntimeState"
        }
      },
      "outputs": {
        "state": {
          "type": "RuntimeState"
        }
      },
      "execution": {
        "mode": "mixed",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_prism_finish_runtime",
          "operation": "mathformer_prism_finish_runtime"
        }
      }
    },
    "write_report": {
      "inputs": {
        "state": {
          "type": "RuntimeState"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_prism_write_report",
          "operation": "mathformer_prism_write_report"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "config": {
            "ref": "inputs.config"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "catalog",
        "kind": "loop",
        "state_type": "StaticState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "body": {
          "id": "validate_next",
          "kind": "call",
          "operation": "validate_entry",
          "arguments": {
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 14,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "StaticState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "submit",
        "kind": "call",
        "operation": "prepare_runtime",
        "arguments": {
          "state": {
            "ref": "steps.catalog.outputs.state"
          }
        }
      },
      {
        "id": "await_all",
        "kind": "loop",
        "state_type": "RuntimeState",
        "initial": {
          "ref": "steps.submit.outputs.state"
        },
        "body": {
          "id": "await_next",
          "kind": "call",
          "operation": "await_entry",
          "arguments": {
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 14,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "RuntimeState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "join",
        "kind": "call",
        "operation": "finish_runtime",
        "arguments": {
          "state": {
            "ref": "steps.await_all.outputs.state"
          }
        }
      },
      {
        "id": "report",
        "kind": "call",
        "operation": "write_report",
        "arguments": {
          "state": {
            "ref": "steps.join.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.report.outputs.report"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/",
          "mathformer-prism/tests/native-semantic-parallel-e2e.json",
          "temporary_prism_runs",
          "context.working_directory/mathformer-prism/tests/native-semantic-parallel-e2e.json"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 32
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Completion establishes bounded placeholder nonpromotion safety; general behavioral/semantic equivalence and scientific truth are not established."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "scripts/prism/verify_mathformer_prism.py",
        "digest": "sha256:6f954c3d888531f4dcc98983d6ce0d1bd590450357058f6c937a30cf4ea61cff",
        "selector": "VerificationSession; verify; run_one; main"
      },
      {
        "path": "scripts/mathformer.py",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "scripts/prism_verification_tools.py",
        "digest": "sha256:2978f475c5a451273c5b7349fd2dcae3e659fc3142a5768de85db96788b03593",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "scripts/mcp_server.py",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "scripts/mathformer_mcp_service.py",
        "digest": "sha256:ff2a57a3dc268e73d31e34605d80a65a5bdc6e16e28ad41af5752ad8bae60164",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "tests/test_matrix.json",
        "digest": "sha256:37d6007feda4e1ca63ce5115e4c57732a25fbb81926a7e5230a08dbfde8c0d08",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "tests/mcp/run_prism_verification_workflow_tests.py",
        "digest": "sha256:2b945cc31e008d4d3be29e1cbb00c2fc6554e8f0bdee480409105ec72eeea24b",
        "selector": "native registration and workflow binding"
      },
      {
        "path": "tests/mcp/fixtures/prism_verification_original.py.txt",
        "digest": "sha256:c2c0fc9c74ac6cb51e3c5c34289d8674ba6a61d0c19a9427a649ca6869582dc5",
        "selector": "native registration and workflow binding"
      }
    ],
    "gaps": [
      "Specialized to hub-default Codex, four workers, full selection and exactly 14 catalog entries. Source traversals remain finite without a numeric source cap; descriptor loops fail on exhaustion.",
      "Process-local capability states retain real source resources and accumulators. Nested plan checks and run_one branches remain in their owning operations; this is not a full Python-equivalence model.",
      "The 3600-second timeout belongs to the hub launcher; verify/run_one impose no subprocess timeout. The 32-call limit is a descriptor budget.",
      "External native provider/compiler execution remains an environment prerequisite. Offline fixtures establish adapter execution and bounded safety checks, not general semantic equivalence or scientific truth.",
      "Interrupted MCP clients must call mathformer_prism_close or terminate the service to join work and release session resources. Session tokens are not restartable or transferable between service processes."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "prism:native-semantic-parallel-e2e",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "prism:native-semantic-parallel-e2e",
        "summary": "Run the full PRISM native-handler end-to-end suite with bounded semantic safety oracles and four parallel workers.",
        "family": "e2e",
        "kind": "validation",
        "safety": "writes_repo",
        "command": [
          "uv",
          "run",
          "python",
          "scripts/prism/verify_mathformer_prism.py",
          "--root",
          "mathformer-prism",
          "--jobs",
          "4",
          "--handler",
          "codex",
          "--output",
          "mathformer-prism/tests/native-semantic-parallel-e2e.json"
        ],
        "depends_on": [],
        "required_paths": [
          "scripts/prism/verify_mathformer_prism.py",
          "scripts/prism/reviewed_reasoning_projections.json",
          "mathformer-prism/",
          "../to_prism/.venv/bin/prism"
        ],
        "required_tools": [
          "uv",
          "codex"
        ],
        "optional_tools": [],
        "writes": [
          "mathformer-prism/tests/native-semantic-parallel-e2e.json"
        ],
        "allows_extra_args": false,
        "timeout_seconds": 3600,
        "notes": "Requires native Codex access and the adjacent to_prism PRISM executable."
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP tools invoke VerificationSession source steps shared with verify(). Explicit context resolves relative root/report paths within the repository. Session resources close on native failures, explicit close, or service exit.",
      "context_fields": [
        "working_directory"
      ],
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "failure_policy": "Never turn native preflight or subprocess failure into acceptance.",
      "scientific_payloads": "Report describes bounded conformance and placeholder safety."
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "command_after_dependencies": false,
      "keep_going_semantics": "Hub keep_going does not suppress verifier failure; verify awaits every submitted future before collective runtime failure.",
      "extra_args_for_sequence": "native per-action policy",
      "modeling": "Ordered shared source blocks with finite catalog and future traversals; the source session owns concurrent run_one callbacks, resource lifetime and cleanup."
    }
  }
}
