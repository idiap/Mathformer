{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_docs_validate_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Execute the selected docs.validate route through the native controlled action engine.",
  "aliases": [
    "docs.validate"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Context": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "Result": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Match": {
      "schema": {
        "type": "object",
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "properties": {
          "route": {
            "type": "object",
            "required": [
              "route_id",
              "action_ids"
            ],
            "properties": {
              "route_id": {
                "const": "docs.validate"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "test:docs"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Registry": {
      "schema": {
        "type": "object"
      }
    },
    "Mount": {
      "schema": {
        "type": "object",
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "children"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Action": {
      "schema": {
        "type": "string",
        "const": "test:docs"
      }
    },
    "Count": {
      "schema": {
        "type": "integer",
        "const": 1
      }
    },
    "Done": {
      "schema": {
        "type": "boolean"
      }
    }
  },
  "inputs": {
    "match": {
      "type": "Match"
    },
    "registry": {
      "type": "Registry"
    },
    "context": {
      "type": "Context"
    },
    "mount": {
      "type": "Mount"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_docs_route_initialize",
          "operation": "mathformer_docs_route_initialize"
        }
      }
    },
    "select_action": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "match": {
          "type": "Match"
        }
      },
      "outputs": {
        "action": {
          "type": "Action"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_docs_route_select_action",
          "operation": "mathformer_docs_route_select_action"
        }
      }
    },
    "run_action": {
      "inputs": {
        "action": {
          "type": "Action"
        },
        "registry": {
          "type": "Registry"
        },
        "context": {
          "type": "Context"
        },
        "mount": {
          "type": "Mount"
        }
      },
      "outputs": {
        "child": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_docs_route_run_action",
          "operation": "mathformer_docs_route_run_action"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "child": {
          "type": "Result"
        },
        "context": {
          "type": "Context"
        },
        "action_count": {
          "type": "Count"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_docs_route_advance",
          "operation": "mathformer_docs_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "match": {
          "type": "Match"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_docs_route_finish",
          "operation": "mathformer_docs_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {},
        "description": "Initialize ok=true and children=[]."
      },
      {
        "id": "actions",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "description": "Native ordered action traversal specialized to exactly [test:docs]. Its first iteration always sets done=true, including child failure; normal termination occurs at the bound, never an exhaustion error.\n",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select_action",
              "kind": "call",
              "operation": "select_action",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              },
              "description": "Select match.route.action_ids[len(state.children)]."
            },
            {
              "id": "execute_action",
              "kind": "call",
              "operation": "run_action",
              "arguments": {
                "action": {
                  "ref": "steps.select_action.outputs.action"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "mount": {
                  "ref": "inputs.mount"
                }
              },
              "description": "Apply admission and preflight in native order. Errors return negative child data; after successful preflight dry_run returns without launch. Otherwise run tests/run_docs.py --json, capture exit/stdout/stderr, then audit writes. Timeout and undeclared writes set ok=false; unexpected launch errors propagate. No extra arguments are supplied.\n"
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute_action.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "action_count": {
                  "literal": 1
                }
              },
              "description": "Append child once in order; set ok=prior ok AND bool(child.get(ok,false)). Stop when child count equals action_count OR child failed without keep_going. Failure stays sticky; keep_going cannot add a second action.\n"
            }
          ],
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Done",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        },
        "description": "Return schema_version=1, accumulated ok, route metadata from intent_match_to_dict(match,registry), and ordered children. Status is intent_run_completed if ok, otherwise intent_run_failed.\n"
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked execution description; completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
