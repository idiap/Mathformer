  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "docs.validate",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md"
    },
    "mathformer.native_boundary": {
      "execution": "Registered mathformer_docs_route_* tools invoke the same intent-state helpers and run_action as run_intent_match; the generated graph preserves one ordered route action.",
      "callers": "CLI ask --run uses the highest-ranked match; MCP mathformer_ask and mathformer_run_workflow call the same function.",
      "mcp_admission": "Resolve normalized ID to docs.validate, reject nonempty route extra_args, check service write roots before non-dry execution.",
      "mount": "Empty mount preserves the default repository root; repository_root is forwarded to run_action when supplied.",
      "timeout": "CLI test:docs has no overall timeout; MCP caps its leaf command with a configurable timeout, default 600 seconds.",
      "effects": "Qualification capability names are metadata, never runtime grants.",
      "registration": "Registry values select the exact source-owned test:docs declaration. No extra arguments, retries or additional subprocess timeout are supplied.",
      "service_admission": "Non-dry execution checks service read-only policy and mounted artifacts/ write root before invoking the native action. Dry-run preserves native preflight without launching."
    },
    "mathformer.delegated_runner": {
      "command": "tests/run_docs.py --json delegates once to tests/test_program/run_comprehensive_tests.py for docs and mathformerlib with JSONL and JUnit reports.",
      "state": "Load tests/test_matrix.json; retain matrix, selected checks in matrix order, families, index=0 and results=[].",
      "traversal": "While index<len(selected), run one check, append its result and increment index; ordinary failures never stop traversal.",
      "checks": "Missing optional dependencies skip under workstation defaults; configured per-check timeouts default to 120 seconds. Timeouts, unexpected exit codes and undeclared writes fail checks.",
      "completion": "After all selected checks, validate results, build capability summary and dependency snapshot; publish JSON, JSONL and JUnit in source order, then exit 0 if ok else 3.",
      "bounds": "Finite selected-check traversal, including empty selection; no retries. This traversal remains owned by the delegated operation."
