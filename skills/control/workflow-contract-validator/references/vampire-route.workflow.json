{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_prove_vampire_atp_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Selected Vampire route controller; one ordered atp:demo action and native result aggregation.",
  "aliases": [
    "prove.vampire.atp"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext",
      "representation": "value"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult",
      "representation": "value"
    },
    "RouteMatch": {
      "schema": {
        "type": "object",
        "properties": {
          "route": {
            "type": "object",
            "properties": {
              "route_id": {
                "type": "string",
                "const": "prove.vampire.atp"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "atp:demo"
                ],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "route_id",
              "action_ids"
            ]
          },
          "score": {
            "type": "integer"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "additionalProperties": false
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "const": "atp:demo"
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "RouteMatch"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "RepositoryRoot",
      "required": false
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_vampire_route_initialize",
          "operation": "mathformer_vampire_route_initialize"
        }
      }
    },
    "select_action": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "RouteMatch"
        }
      },
      "outputs": {
        "action": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_vampire_route_select_action",
          "operation": "mathformer_vampire_route_select_action"
        }
      }
    },
    "run_action": {
      "inputs": {
        "action": {
          "type": "ActionId"
        },
        "context": {
          "type": "RunContext"
        },
        "registry": {
          "type": "Registry"
        },
        "repository_root": {
          "type": "RepositoryRoot",
          "required": false
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_vampire_route_run_action",
          "operation": "mathformer_vampire_route_run_action"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_vampire_route_advance",
          "operation": "mathformer_vampire_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "RouteMatch"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_vampire_route_finish",
          "operation": "mathformer_vampire_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "description": "Native for over the single registered action; done is true after its first child even on failure, so the normal return occurs at the bound.",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select_action",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "execute",
              "kind": "call",
              "operation": "run_action",
              "description": "Native failure payloads remain data for advance; uncaught exceptions terminate.",
              "arguments": {
                "action": {
                  "ref": "steps.select.outputs.action"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                }
              }
            },
            {
              "id": "carry",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.carry.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "steps.carry.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/vampire_atp/atp_function_demo/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked controller specification; neither a scientific proof nor runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
