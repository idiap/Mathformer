      "ordered_actions": [
        "atp:demo"
      ],
      "action_workflows": [
        "hub_atp_demo_workflow"
      ],
      "keep_going_semantics": "Failure is sticky; stop on failure unless keep_going. This singleton route always stops after its child.",
