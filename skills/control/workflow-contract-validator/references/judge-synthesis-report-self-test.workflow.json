    "mathformer.native_boundary": {
      "execution": "Shared run_check helpers exposed as registered MCP tools with an owned context, immutable paths/state and ordered stages. Builder normal CLI remains native.",
      "failure_policy": "Recorded high findings accumulate through later checks; exceptions stop execution and release temporary files.",
      "effects_status": "Source run_check writes fixtures and all four generated artifacts only in TemporaryDirectory; hub audits repository writes.",
      "temporary_outputs": [
        "synthesis_report.json",
        "synthesis_report.md",
        "synthesis_report.html",
        "synthesis_todos.md"
      ],
      "native_limits": "Hub subprocess timeout is 180 seconds; inner builder subprocess has no timeout.",
      "lifecycle": "Temporary paths are scope-local; cleanup precedes normal report return and occurs immediately on native tool errors. Interrupted graphs are reclaimed at MCP server shutdown.",
      "context": "Opaque session_id owns the TemporaryDirectory, workspace, builder result and check state; callers cannot replace paths or skip stages."
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "modeling": "Source run_check ordering; builder internal finite passes are opaque; no retry, repair or convergence loop."
    },
    "mathformer.step_semantics": {
      "prepare_fixture": "Source run_check/write_comparative_report/write_codex_results: initialize findings, enter TemporaryDirectory, write one case with two candidates (accepted/current and blocked/external), 14 metrics each, four pending prompts and two completed result records.",
      "invoke_builder": "Source run_report_builder and builder main: invoke once via sys.executable with comparative, output, results and --json; capture code/stdout/stderr without inner timeout. Invalid stdout JSON becomes {}; other decoded JSON is unchanged. Normal CLI loads/attaches results, aggregates approaches/five aspects, strengths/weaknesses, disagreements and TODO classifications, then writes JSON/Markdown/HTML/TODO files. Not builder self_test; finite helper passes remain internal.",
      "start_checks": "Source run_check: carry initially empty findings; independently append high synthesis_builder_failed with stderr if code != 0, then synthesis_builder_not_ok with payload if payload.get(ok) is not True. Pack workspace, payload.get(artifacts, {}), findings, index=0 and empty html_text. Unexpected payload shapes can raise.",
      "check_artifact": "Source run_check artifact for-loop: inspect tuple (json, html, markdown, todos) at index; append high missing_{key}_artifact with artifacts if path is falsy or Path.exists() is false. Preserve previous findings, advance index and compute done when all four are checked. No early exit on findings.",
      "prepare_inspection": "Source run_check report_json/html_path guards: compute present from a truthy reported path and Path.exists(), at this point in source order. Pack unchanged findings/artifacts/workspace; for present HTML read UTF-8 html_text and reset marker index to zero. JSON remains unread until check_json.",
      "check_json": "Source run_check JSON branch: load artifact JSON; independently append high findings for wrong synthesis style, reference role != non_gold_reference_evidence, current accepted_count != 1 or external blocked_count != 1, absent current strengths or external weaknesses, fewer than five aspects, absent synthesis_todos, ingested results != 2, absent agreement_counts, or open_repo_actionable_count != 0. Preserve check order; malformed JSON/uncaught errors terminate.",
      "carry_state": "Source run_check missing-file branch fall-through: pack and export unchanged findings, artifacts, workspace and cursor; missing-artifact findings were already recorded.",
      "check_marker": "Source run_check HTML for-loop: in order check FormalPhysics Judge Synthesis, Aspect Comparison, Strengths, Weaknesses, Prompt Readiness, Completed Result Disagreements, Action Register. If absent append high html_marker_missing with marker; advance index and compute done after seven, retaining all prior findings.",
      "finish": "Close the owned temporary directory before exposing the native finish report and main exit code (0 or 3). Source and tool exceptions release the scope; graph interruption is reclaimed at MCP server shutdown."
    }
  }
}
