  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "fixture",
        "kind": "call",
        "operation": "prepare_fixture",
        "arguments": {}
      },
      {
        "id": "builder",
        "kind": "call",
        "operation": "invoke_builder",
        "arguments": {
          "workspace": {
            "ref": "steps.fixture.outputs.workspace"
          },
          "context": {
            "ref": "steps.fixture.outputs.context"
          }
        }
      },
      {
        "id": "checks",
        "kind": "call",
        "operation": "start_checks",
        "arguments": {
          "workspace": {
            "ref": "steps.fixture.outputs.workspace"
          },
          "result": {
            "ref": "steps.builder.outputs.result"
          },
          "context": {
            "ref": "steps.fixture.outputs.context"
          }
        }
      },
      {
        "id": "artifacts",
        "kind": "loop",
        "state_type": "CheckState",
        "initial": {
          "ref": "steps.checks.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "check_artifact",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "steps.fixture.outputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 4,
        "on_exhausted": "fail",
        "description": "Fixed four-element tuple; done is true after the fourth check, so normal completion at the bound is preserved.",
        "outputs": {
          "state": {
            "type": "CheckState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "json_guard",
        "kind": "call",
        "operation": "prepare_inspection",
        "arguments": {
          "state": {
            "ref": "steps.artifacts.outputs.state"
          },
          "format": {
            "literal": "json"
          },
          "context": {
            "ref": "steps.fixture.outputs.context"
          }
        }
      },
      {
        "id": "json_check",
        "kind": "switch",
        "cases": [
          {
            "id": "exists",
            "when": {
              "ref": "steps.json_guard.outputs.present"
            },
            "body": {
              "kind": "call",
              "operation": "check_json",
              "arguments": {
                "state": {
                  "ref": "steps.json_guard.outputs.state"
                },
                "context": {
                  "ref": "steps.fixture.outputs.context"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "carry_state",
              "arguments": {
                "state": {
                  "ref": "steps.json_guard.outputs.state"
                },
                "context": {
                  "ref": "steps.fixture.outputs.context"
                }
              },
              "id": "retain"
            }
          ],
          "outputs": {
            "state": {
              "type": "CheckState",
              "value": {
                "ref": "steps.retain.outputs.state"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "CheckState",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "html_guard",
        "kind": "call",
        "operation": "prepare_inspection",
        "arguments": {
          "state": {
            "ref": "steps.json_check.outputs.state"
          },
          "format": {
            "literal": "html"
          },
          "context": {
            "ref": "steps.fixture.outputs.context"
          }
        }
      },
      {
        "kind": "loop",
        "state_type": "CheckState",
        "initial": {
          "ref": "steps.html_guard.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "exists",
              "when": {
                "ref": "steps.html_guard.outputs.present"
              },
              "body": {
                "kind": "call",
                "operation": "check_marker",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "context": {
                    "ref": "steps.fixture.outputs.context"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "carry_state",
            "arguments": {
              "state": {
                "ref": "loop.state"
              },
              "context": {
                "ref": "steps.fixture.outputs.context"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "CheckState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 7,
        "on_exhausted": "fail",
        "description": "Fixed seven-marker tuple; done is true on marker seven. Exhaustion is unreachable for the source fixture.",
        "outputs": {
          "state": {
            "type": "CheckState",
            "value": {
              "ref": "loop.state"
            }
          }
        },
        "id": "html_check"
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.html_check.outputs.state"
          },
          "context": {
            "ref": "steps.fixture.outputs.context"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "TestReport",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.finish.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
