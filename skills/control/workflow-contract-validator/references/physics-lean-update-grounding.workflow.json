  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "discover",
        "kind": "call",
        "operation": "discover",
        "arguments": {
          "repository_root": {
            "ref": "inputs.repository_root"
          },
          "scope": {
            "ref": "inputs.scope"
          }
        }
      },
      {
        "id": "scan",
        "kind": "loop",
        "state_type": "ScanState",
        "initial": {
          "ref": "steps.discover.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "loop.state.nonempty"
              },
              "body": {
                "id": "visit",
                "kind": "call",
                "operation": "scan_next",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "repository_root": {
                    "ref": "inputs.repository_root"
                  }
                }
              }
            }
          ],
          "default": {
            "id": "empty",
            "kind": "call",
            "operation": "empty_scan",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "ScanState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 1024,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "ScanState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "extract",
        "kind": "call",
        "operation": "extract_cases",
        "arguments": {
          "state": {
            "ref": "steps.scan.outputs.state"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare_updates",
        "arguments": {
          "cases": {
            "ref": "steps.extract.outputs.cases"
          },
          "options": {
            "ref": "steps.discover.outputs.options"
          }
        }
      },
      {
        "id": "updates",
        "kind": "loop",
        "state_type": "UpdateState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "all": [
                  {
                    "ref": "steps.prepare.outputs.run"
                  },
                  {
                    "ref": "loop.state.nonempty"
                  }
                ]
              },
              "body": {
                "id": "visit",
                "kind": "call",
                "operation": "update_next",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "repository_root": {
                    "ref": "inputs.repository_root"
                  }
                }
              }
            }
          ],
          "default": {
            "id": "empty",
            "kind": "call",
            "operation": "empty_updates",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "UpdateState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 1024,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "UpdateState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "emit",
        "kind": "call",
        "operation": "emit_audit",
        "arguments": {
          "repository_root": {
            "ref": "inputs.repository_root"
          },
          "cases": {
            "ref": "steps.extract.outputs.cases"
          },
          "case_history": {
            "ref": "steps.extract.outputs.case_history"
          },
          "options": {
            "ref": "steps.discover.outputs.options"
          }
        }
      }
    ],
    "outputs": {
      "audit_json": {
        "type": "Audit",
        "value": {
          "ref": "steps.emit.outputs.audit_json"
        }
      },
      "audit_markdown": {
        "type": "Text",
        "value": {
          "ref": "steps.emit.outputs.audit_markdown"
        }
      },
      "printed_counts": {
        "type": "Counts",
        "value": {
          "ref": "steps.emit.outputs.printed_counts"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.emit.outputs.exit_code"
        }
      }
    }
  },
