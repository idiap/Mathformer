{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_environment_validate_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Selected environment.validate route through the authoritative native controller.",
  "aliases": [
    "environment.validate"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "const": "test:family:environment"
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "Match": {
      "schema": {
        "type": "object",
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "properties": {
          "route": {
            "type": "object",
            "required": [
              "route_id",
              "action_ids"
            ],
            "properties": {
              "route_id": {
                "const": "environment.validate"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "test:family:environment"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Registry": {
      "schema": {
        "type": "object"
      }
    },
    "Mount": {
      "schema": {
        "type": "object",
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "Count": {
      "schema": {
        "type": "integer",
        "const": 1
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "Match"
    },
    "registry": {
      "type": "Registry"
    },
    "mount": {
      "type": "Mount"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_environment_route_initialize",
          "operation": "mathformer_environment_route_initialize"
        }
      }
    },
    "select": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_environment_route_select",
          "operation": "mathformer_environment_route_select"
        }
      }
    },
    "execute": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "context": {
          "type": "RunContext"
        },
        "registry": {
          "type": "Registry"
        },
        "mount": {
          "type": "Mount"
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_environment_route_execute",
          "operation": "mathformer_environment_route_execute"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "action_count": {
          "type": "Count"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_environment_route_advance",
          "operation": "mathformer_environment_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_environment_route_finish",
          "operation": "mathformer_environment_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {},
        "description": "Initialize ok=true and children=[] with no retained history."
      },
      {
        "id": "actions",
        "kind": "loop",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "description": "Exactly one native action. advance sets done at action_count=1, so the bound returns normally even for a failed child; exhaustion is unreachable.",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              },
              "description": "Select match.route.action_ids[len(state.children)] in route order."
            },
            {
              "id": "execute",
              "kind": "call",
              "operation": "execute",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "mount": {
                  "ref": "inputs.mount"
                }
              },
              "description": "run_action applies native admission/preflight, dry-run and subprocess/write controls. Returned child.ok=false is data, not a graph exception. Unexpected native exceptions propagate."
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "action_count": {
                  "literal": 1
                }
              },
              "description": "Append child in order; ok=previous.ok and bool(child.get(\"ok\",false)). done=len(updated.children)==1 or (not child.get(\"ok\",false) and not context.keep_going). keep_going cannot extend this one-action route."
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        },
        "description": "Return schema_version=1, aggregate ok, native route metadata, ordered children, and status intent_run_completed if ok else intent_run_failed."
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked controlled execution; completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
