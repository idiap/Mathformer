{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_control_normalize_workflows_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Inventory, render, optionally write, and check normalized workflow descriptors.",
  "aliases": [
    "control:normalize-workflows"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "required": [
          "write",
          "json",
          "halted"
        ],
        "properties": {
          "write": {
            "type": "boolean"
          },
          "json": {
            "type": "boolean"
          },
          "halted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Descriptors": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Ordered JSON descriptor strings preserve source dictionary insertion order across transports for native YAML serialization."
      }
    },
    "Rendered": {
      "schema": {
        "type": "object",
        "required": [
          "files",
          "catalog",
          "file_order"
        ],
        "properties": {
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "catalog": {
            "type": "object"
          },
          "file_order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Relative path-to-content mapping and catalog with records, hashes and counts."
      }
    },
    "Result": {
      "schema": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "counts",
              "descriptor_count",
              "schema_and_dataflow_validated",
              "execution_migrated",
              "runtime_bindings_qualified",
              "errors"
            ],
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "descriptor_count": {
                "type": "integer",
                "minimum": 0
              },
              "schema_and_dataflow_validated": {
                "type": "boolean"
              },
              "execution_migrated": {
                "const": false
              },
              "runtime_bindings_qualified": {
                "const": false
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      }
    },
    "OutputDirectory": {
      "schema": {
        "type": "string",
        "description": "Repository-relative output directory in the declared write roots; empty uses native OUTPUT."
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    },
    "output_directory": {
      "type": "OutputDirectory"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "parse": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "options": {
          "type": "Options"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_normalize_parse",
          "operation": "mathformer_normalize_parse"
        }
      }
    },
    "inventory": {
      "inputs": {},
      "outputs": {
        "descriptors": {
          "type": "Descriptors"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_normalize_inventory",
          "operation": "mathformer_normalize_inventory"
        }
      }
    },
    "render": {
      "inputs": {
        "descriptors": {
          "type": "Descriptors"
        }
      },
      "outputs": {
        "rendered": {
          "type": "Rendered"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_normalize_render",
          "operation": "mathformer_normalize_render"
        }
      }
    },
    "write": {
      "inputs": {
        "rendered": {
          "type": "Rendered"
        },
        "output_directory": {
          "type": "OutputDirectory"
        }
      },
      "outputs": {},
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_normalize_write",
          "operation": "mathformer_normalize_write"
        }
      }
    },
    "check": {
      "inputs": {
        "rendered": {
          "type": "Rendered"
        },
        "output_directory": {
          "type": "OutputDirectory"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_normalize_check",
          "operation": "mathformer_normalize_check"
        }
      }
    },
    "finish": {
      "inputs": {
        "result": {
          "type": "Result"
        },
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_normalize_finish",
          "operation": "mathformer_normalize_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "help",
            "when": {
              "ref": "steps.parse.outputs.options.halted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "stop",
                  "kind": "call",
                  "operation": "finish",
                  "arguments": {
                    "result": {
                      "literal": null
                    },
                    "options": {
                      "ref": "steps.parse.outputs.options"
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "Result",
                  "value": {
                    "literal": null
                  }
                },
                "exit_code": {
                  "type": "ExitCode",
                  "value": {
                    "ref": "steps.stop.outputs.exit_code"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "inventory",
              "kind": "call",
              "operation": "inventory",
              "arguments": {}
            },
            {
              "id": "render",
              "kind": "call",
              "operation": "render",
              "arguments": {
                "descriptors": {
                  "ref": "steps.inventory.outputs.descriptors"
                }
              }
            },
            {
              "id": "check_mode",
              "kind": "switch",
              "cases": [
                {
                  "id": "write_requested",
                  "when": {
                    "ref": "steps.parse.outputs.options.write"
                  },
                  "body": {
                    "kind": "sequence",
                    "steps": [
                      {
                        "id": "write_files",
                        "kind": "call",
                        "operation": "write",
                        "arguments": {
                          "rendered": {
                            "ref": "steps.render.outputs.rendered"
                          },
                          "output_directory": {
                            "ref": "inputs.output_directory"
                          }
                        }
                      },
                      {
                        "id": "check_written",
                        "kind": "call",
                        "operation": "check",
                        "arguments": {
                          "rendered": {
                            "ref": "steps.render.outputs.rendered"
                          },
                          "output_directory": {
                            "ref": "inputs.output_directory"
                          }
                        }
                      }
                    ],
                    "outputs": {
                      "result": {
                        "type": "Result",
                        "value": {
                          "ref": "steps.check_written.outputs.result"
                        }
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "check",
                "arguments": {
                  "rendered": {
                    "ref": "steps.render.outputs.rendered"
                  },
                  "output_directory": {
                    "ref": "inputs.output_directory"
                  }
                }
              },
              "outputs": {
                "result": {
                  "type": "Result",
                  "value": {
                    "ref": "selected.outputs.result"
                  }
                }
              }
            },
            {
              "id": "finish",
              "kind": "call",
              "operation": "finish",
              "arguments": {
                "result": {
                  "ref": "steps.check_mode.outputs.result"
                },
                "options": {
                  "ref": "steps.parse.outputs.options"
                }
              }
            }
          ],
          "outputs": {
            "result": {
              "type": "Result",
              "value": {
                "ref": "steps.check_mode.outputs.result"
              }
            },
            "exit_code": {
              "type": "ExitCode",
              "value": {
                "ref": "steps.finish.outputs.exit_code"
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "Result",
            "value": {
              "ref": "selected.outputs.result"
            }
          },
          "exit_code": {
            "type": "ExitCode",
            "value": {
              "ref": "selected.outputs.exit_code"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.dispatch.outputs.result"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.dispatch.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/",
          "skills/control/workflow-contract-validator/references/normalized-workflows/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "read_source_registries",
        "generate_descriptors",
        "validate_descriptors",
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "execute_scientific_workflows",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 6
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Descriptor checking establishes no runtime qualification, scientific result or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
