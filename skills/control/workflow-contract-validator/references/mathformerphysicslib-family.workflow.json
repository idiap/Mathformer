  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "invocation": {
            "ref": "inputs.invocation"
          }
        }
      },
      {
        "id": "enter",
        "kind": "call",
        "operation": "enter",
        "arguments": {
          "context": {
            "ref": "steps.parse.outputs.context"
          },
          "args": {
            "ref": "steps.parse.outputs.args"
          }
        }
      },
      {
        "id": "initial",
        "kind": "switch",
        "cases": [
          {
            "id": "active",
            "when": {
              "ref": "steps.enter.outputs.snapshot_only"
            },
            "body": {
              "id": "snapshot_frame",
              "kind": "call",
              "operation": "snapshot_frame",
              "arguments": {
                "context": {
                  "ref": "steps.parse.outputs.context"
                }
              }
            }
          }
        ],
        "default": {
          "id": "prepare",
          "kind": "call",
          "operation": "prepare",
          "arguments": {
            "context": {
              "ref": "steps.parse.outputs.context"
            },
            "args": {
              "ref": "steps.parse.outputs.args"
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "initial_guard",
        "kind": "call",
        "operation": "cursor_guard",
        "arguments": {
          "context": {
            "ref": "steps.parse.outputs.context"
          },
          "state": {
            "ref": "steps.initial.outputs.state"
          }
        }
      },
      {
        "id": "checks",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.initial.outputs.state"
        },
        "max_iterations": 15,
        "on_exhausted": "fail",
        "body": {
          "id": "visit",
          "kind": "switch",
          "cases": [
            {
              "id": "active",
              "when": {
                "ref": "steps.initial_guard.outputs.remaining"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "context": {
                        "ref": "steps.parse.outputs.context"
                      },
                      "args": {
                        "ref": "steps.parse.outputs.args"
                      },
                      "state": {
                        "ref": "loop.state"
                      }
                    }
                  },
                  {
                    "id": "cursor_guard",
                    "kind": "call",
                    "operation": "cursor_guard",
                    "arguments": {
                      "context": {
                        "ref": "steps.parse.outputs.context"
                      },
                      "state": {
                        "ref": "steps.advance.outputs.state"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "State",
                    "value": {
                      "ref": "steps.advance.outputs.state"
                    }
                  },
                  "remaining": {
                    "type": "Flag",
                    "value": {
                      "ref": "steps.cursor_guard.outputs.remaining"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "id": "retain",
                "kind": "call",
                "operation": "retain",
                "arguments": {
                  "context": {
                    "ref": "steps.parse.outputs.context"
                  },
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            ],
            "outputs": {
              "state": {
                "type": "State",
                "value": {
                  "ref": "steps.retain.outputs.state"
                }
              },
              "remaining": {
                "type": "Flag",
                "value": {
                  "literal": false
                }
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "remaining": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.remaining"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "not": {
            "ref": "body.outputs.remaining"
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "switch",
        "cases": [
          {
            "id": "active",
            "when": {
              "ref": "steps.enter.outputs.snapshot_only"
            },
            "body": {
              "id": "snapshot",
              "kind": "call",
              "operation": "snapshot",
              "arguments": {
                "context": {
                  "ref": "steps.parse.outputs.context"
                },
                "args": {
                  "ref": "steps.parse.outputs.args"
                }
              }
            }
          }
        ],
        "default": {
          "id": "finalize",
          "kind": "call",
          "operation": "finalize",
          "arguments": {
            "context": {
              "ref": "steps.parse.outputs.context"
            },
            "args": {
              "ref": "steps.parse.outputs.args"
            },
            "state": {
              "ref": "steps.checks.outputs.state"
            }
          }
        },
        "outputs": {
          "report": {
            "type": "Report",
            "value": {
              "ref": "selected.outputs.report"
            }
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "context": {
            "ref": "steps.parse.outputs.context"
          },
          "args": {
            "ref": "steps.parse.outputs.args"
          },
          "report": {
            "ref": "steps.finish.outputs.report"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.publish.outputs.exit_code"
        }
      }
    }
  },
