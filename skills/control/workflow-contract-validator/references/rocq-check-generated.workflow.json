{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_rocq_check_generated_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Hub-controlled structural validation followed by optional Rocq compilation.",
  "aliases": [
    "rocq:check-generated"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Boundary": {
      "schema": {
        "type": "object",
        "required": [
          "execute",
          "payload",
          "snapshot"
        ],
        "properties": {
          "execute": {
            "type": "boolean"
          },
          "payload": {
            "type": "object"
          },
          "snapshot": {
            "type": "object"
          }
        }
      }
    },
    "File": {
      "schema": {
        "type": "string"
      }
    },
    "Files": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Structural": {
      "schema": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "Structurals": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "External": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "skipped"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "skipped": {
            "type": "boolean"
          }
        }
      }
    },
    "Externals": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ok",
            "skipped"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "skipped": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "file_count",
          "validations",
          "external_checks"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          },
          "validations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "external_checks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": "string"
      }
    },
    "ExtraArgs": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    },
    "extra_args": {
      "type": "ExtraArgs"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "context": {
          "type": "RunContext"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        },
        "extra_args": {
          "type": "ExtraArgs"
        }
      },
      "outputs": {
        "boundary": {
          "type": "Boundary"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_prepare",
          "operation": "mathformer_rocq_check_prepare"
        }
      }
    },
    "early_return": {
      "inputs": {
        "boundary": {
          "type": "Boundary"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_early_return",
          "operation": "mathformer_rocq_check_early_return"
        }
      }
    },
    "collect": {
      "inputs": {
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "files": {
          "type": "Files"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_collect",
          "operation": "mathformer_rocq_check_collect"
        }
      }
    },
    "structural": {
      "inputs": {
        "files": {
          "type": "Files"
        }
      },
      "outputs": {
        "result": {
          "type": "Structurals"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_structural",
          "operation": "mathformer_rocq_check_structural"
        }
      }
    },
    "external": {
      "inputs": {
        "files": {
          "type": "Files"
        }
      },
      "outputs": {
        "result": {
          "type": "Externals"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_external",
          "operation": "mathformer_rocq_check_external"
        }
      }
    },
    "aggregate": {
      "inputs": {
        "files": {
          "type": "Files"
        },
        "validations": {
          "type": "Structurals"
        },
        "external": {
          "type": "Externals"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_aggregate",
          "operation": "mathformer_rocq_check_aggregate"
        }
      }
    },
    "complete": {
      "inputs": {
        "boundary": {
          "type": "Boundary"
        },
        "report": {
          "type": "Report"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_rocq_check_complete",
          "operation": "mathformer_rocq_check_complete"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "admission",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          },
          "repository_root": {
            "ref": "inputs.repository_root"
          },
          "extra_args": {
            "ref": "inputs.extra_args"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "execute",
            "when": {
              "ref": "steps.admission.outputs.boundary.execute"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "collection",
                  "kind": "call",
                  "operation": "collect",
                  "arguments": {
                    "repository_root": {
                      "ref": "inputs.repository_root"
                    }
                  }
                },
                {
                  "id": "structural_pass",
                  "kind": "call",
                  "operation": "structural",
                  "arguments": {
                    "files": {
                      "ref": "steps.collection.outputs.files"
                    }
                  }
                },
                {
                  "id": "external_pass",
                  "kind": "call",
                  "operation": "external",
                  "arguments": {
                    "files": {
                      "ref": "steps.collection.outputs.files"
                    }
                  }
                },
                {
                  "id": "aggregation",
                  "kind": "call",
                  "operation": "aggregate",
                  "arguments": {
                    "files": {
                      "ref": "steps.collection.outputs.files"
                    },
                    "validations": {
                      "ref": "steps.structural_pass.outputs.result"
                    },
                    "external": {
                      "ref": "steps.external_pass.outputs.result"
                    }
                  }
                },
                {
                  "id": "completion",
                  "kind": "call",
                  "operation": "complete",
                  "arguments": {
                    "boundary": {
                      "ref": "steps.admission.outputs.boundary"
                    },
                    "report": {
                      "ref": "steps.aggregation.outputs.report"
                    },
                    "repository_root": {
                      "ref": "inputs.repository_root"
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "HubResult",
                  "value": {
                    "ref": "steps.completion.outputs.result"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "early_return",
          "arguments": {
            "boundary": {
              "ref": "steps.admission.outputs.boundary"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.dispatch.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 1000000
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Structural or compiler acceptance establishes no scientific claim or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "complete",
    "sources": [
      {
        "path": "skills/rocq/rocq-execution-runner/scripts/check_rocq_file.py",
        "selector": "run_validation",
        "digest": "sha256:31df31ec4979898572f90fa951fb4fe5ee06f7f5c54876094d4da97583bff6c2"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry/action:rocq:check-generated; run_action; prepare_leaf_boundary; complete_leaf_boundary; finish_leaf_boundary",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "backends/rocq/MathformerRocq/autoformalize.py",
        "selector": "validate_file; validate_rocq_text; find_rocq_compiler; run_external_check",
        "digest": "sha256:f9c9d219a34c1e02c9cad4259613f1235122d3f389ac3cdfebb7c858d18bee23"
      },
      {
        "path": "scripts/rocq_check_tools.py",
        "selector": "register_rocq_check_tools",
        "digest": "sha256:b6ccc86accffdf25f00f74ff5141026c17247f340f75af678e2a12d5cd1e0d87"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_rocq_check_tools",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "rocq:check-generated authored projection",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": []
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "rocq:check-generated",
      "owner_skill": "skills/rocq/rocq-execution-runner/SKILL.md",
      "contract": {
        "id": "rocq:check-generated",
        "family": "rocq",
        "kind": "validation",
        "safety": "read_only",
        "command": [
          "{python}",
          "skills/rocq/rocq-execution-runner/scripts/check_rocq_file.py",
          "--path",
          "MathformerRocq",
          "--json"
        ],
        "depends_on": [],
        "allows_extra_args": false,
        "timeout_seconds": null,
        "writes": []
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP operations reuse native file checks, report aggregation, preflight, dry-run, JSON formatting and write audit. repository_root supplies the execution mount; registered argv and compiler policy remain fixed.",
      "failure_policy": "Keep failed native outcomes; audit can override subprocess success."
    },
    "mathformer.traversal": {
      "bounds": "Each source-owned pass traverses exactly the collected file count in order, returning its accumulated result list; empty sets return normally. No artificial traversal limit or convergence loop.",
      "failure": "Reported structural failures, compiler failures, and timeouts do not stop traversal; unhandled exceptions do.",
      "path_mismatch": "Registered MathformerRocq is absent at repository root; existing backends/rocq/MathformerRocq is not substituted. Collection is empty and report.ok=false.",
      "alternate_caller": "Wiki-suite passes its generated directory and configurable compiler policy; this contract specializes the hub argv with 120-second attempts and require_compiler=false."
    }
  }
}
