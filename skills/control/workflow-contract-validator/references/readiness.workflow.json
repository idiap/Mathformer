{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_control_reasoning_log_consumer_readiness_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Run the six ordered reasoning-log consumer readiness gates.",
  "aliases": [
    "control:reasoning-log-consumer-readiness"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../readiness-interface.schema.json#/$defs/RunContext",
      "representation": "value"
    },
    "Request": {
      "schema": {
        "type": "object",
        "required": [
          "action_id",
          "extra_args",
          "seen"
        ],
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "const": "control:reasoning-log-consumer-readiness",
            "type": "string"
          },
          "extra_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seen": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Admission": {
      "schema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "unknown_action",
              "dependency_cycle",
              "extra_args_for_sequence"
            ]
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "accepted",
          "status",
          "ancestry"
        ],
        "additionalProperties": false
      }
    },
    "DependencyState": {
      "schema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "children": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              },
              "required": [
                "ok"
              ]
            }
          },
          "dependencies_ok": {
            "type": "boolean"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "index",
          "children",
          "dependencies_ok",
          "ancestry"
        ],
        "additionalProperties": false
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "HubResult": {
      "schema": "../../readiness-interface.schema.json#/$defs/HubResult",
      "representation": "value"
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "request": {
      "type": "Request"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "admit": {
      "inputs": {
        "request": {
          "type": "Request"
        }
      },
      "outputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_admit",
          "operation": "mathformer_readiness_admit"
        }
      }
    },
    "reject": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_reject",
          "operation": "mathformer_readiness_reject"
        }
      }
    },
    "initialize": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_initialize",
          "operation": "mathformer_readiness_initialize"
        }
      }
    },
    "visit": {
      "inputs": {
        "context": {
          "type": "RunContext"
        },
        "state": {
          "type": "DependencyState"
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_visit",
          "operation": "mathformer_readiness_visit"
        }
      }
    },
    "advance": {
      "inputs": {
        "context": {
          "type": "RunContext"
        },
        "state": {
          "type": "DependencyState"
        },
        "child": {
          "type": "HubResult"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_advance",
          "operation": "mathformer_readiness_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_finish",
          "operation": "mathformer_readiness_finish"
        }
      }
    },
    "carry": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        },
        "result": {
          "type": "HubResult"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        },
        "done": {
          "type": "Boolean"
        },
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_readiness_carry",
          "operation": "mathformer_readiness_carry"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "admission",
        "kind": "call",
        "operation": "admit",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "initial",
                  "kind": "call",
                  "operation": "initialize",
                  "arguments": {
                    "admission": {
                      "ref": "steps.admission.outputs.admission"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "DependencyState",
                  "value": {
                    "ref": "steps.initial.outputs.state"
                  }
                },
                "rejection": {
                  "type": "HubResult",
                  "value": {
                    "literal": {
                      "ok": true
                    }
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "reject",
              "arguments": {
                "admission": {
                  "ref": "steps.admission.outputs.admission"
                },
                "request": {
                  "ref": "inputs.request"
                }
              },
              "id": "rejection"
            }
          ],
          "outputs": {
            "state": {
              "type": "DependencyState",
              "value": {
                "literal": {
                  "index": 0,
                  "children": [],
                  "dependencies_ok": true,
                  "ancestry": []
                }
              }
            },
            "rejection": {
              "type": "HubResult",
              "value": {
                "ref": "steps.rejection.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "DependencyState",
            "value": {
              "ref": "selected.outputs.state"
            }
          },
          "rejection": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.rejection"
            }
          }
        }
      },
      {
        "id": "dependencies",
        "kind": "loop",
        "state_type": "DependencyState",
        "initial": {
          "ref": "steps.dispatch.outputs.state"
        },
        "max_iterations": 6,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "accepted",
              "when": {
                "ref": "steps.admission.outputs.admission.accepted"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "child",
                    "kind": "call",
                    "operation": "visit",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "context": {
                        "ref": "inputs.context"
                      }
                    }
                  },
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "child": {
                        "ref": "steps.child.outputs.child"
                      },
                      "context": {
                        "ref": "inputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "DependencyState",
                    "value": {
                      "ref": "steps.advance.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Boolean",
                    "value": {
                      "ref": "steps.advance.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "kind": "call",
                "operation": "carry",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "result": {
                    "ref": "steps.dispatch.outputs.rejection"
                  }
                },
                "id": "carry"
              }
            ],
            "outputs": {
              "state": {
                "type": "DependencyState",
                "value": {
                  "ref": "steps.carry.outputs.state"
                }
              },
              "done": {
                "type": "Boolean",
                "value": {
                  "ref": "steps.carry.outputs.done"
                }
              }
            }
          },
          "outputs": {
            "state": {
              "type": "DependencyState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "DependencyState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "completion",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "id": "completion",
              "kind": "call",
              "operation": "finish",
              "arguments": {
                "state": {
                  "ref": "steps.dependencies.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "carry",
              "arguments": {
                "state": {
                  "ref": "steps.dispatch.outputs.state"
                },
                "result": {
                  "ref": "steps.dispatch.outputs.rejection"
                }
              },
              "id": "carry"
            }
          ],
          "outputs": {
            "result": {
              "type": "HubResult",
              "value": {
                "ref": "steps.carry.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.completion.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/reasoning/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 16
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description only; no scientific truth or runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "scripts/mathformer.py",
        "selector": "run_action",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/readiness_tools.py",
        "selector": "register_readiness_tools",
        "digest": "sha256:889c927f5343068c4ff65ad0975cab0dc852d335c6da00bcf83c4f7f068c5d6e"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_readiness_tools(mcp)",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer_mcp_service.py",
        "selector": "mcp_tools",
        "digest": "sha256:ff2a57a3dc268e73d31e34605d80a65a5bdc6e16e28ad41af5752ad8bae60164"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "inventory",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      },
      {
        "path": "skills/control/workflow-contract-validator/references/normalized-workflows/readiness-interface.schema.json",
        "selector": "$defs.HubResult",
        "digest": "sha256:2044258361238efbaf791daf0b7b9f7bba6a35c4e858469f4c05aef3bbfce9b1"
      }
    ],
    "gaps": [
      "Recursive child internals stay inside visit; child failures remain native result data.",
      "Lunar enforces descriptor wall/call budgets; native run_action has no global budget or retries. All six canonical leaves have timeout_seconds=null.",
      "Required receipts/provenance and effect ceilings do not qualify optional native logging or external effects.",
      "Canonical action specialization makes unknown-action admission unreachable through Request.action_id."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "control:reasoning-log-consumer-readiness",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md"
    },
    "mathformer.composition": {
      "ordered_dependencies": [
        "control:reasoning-log-smoke",
        "control:reasoning-log-coverage",
        "control:reasoning-log-quality",
        "control:reasoning-log-consumer-contract",
        "control:reasoning-log-index",
        "control:reasoning-log-index-validate"
      ],
      "command_after_dependencies": false,
      "index_behavior": "Ensure fixtures, then index artifacts/reasoning/self_test/good.jsonl.",
      "keep_going_semantics": "Continue after child failure only when enabled; aggregate failure never recovers.",
      "admission_bypass": "Transport-only carry bypasses rejected admissions without native child visits or completion; loop is outside switch for Lunar scoped-exit compatibility.",
      "bound_behavior": "Sixth advancement returns done=true; canonical execution completes without exhaustion."
    },
    "mathformer.native_boundary": {
      "execution": "Registered mathformer_readiness_* MCP tools call shared native controller functions with canonical build_registry and full RunContext; no service timeout cap is added.",
      "callers": "main run calls run_action; ask --run selects control.reasoning.logs and run_intent_match calls run_action.",
      "completion": "CLI exits 0 for ok=true, otherwise 1.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true
    }
  }
}
