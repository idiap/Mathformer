    "gaps": [
      "The observer implements reflection only; immutable revision construction, independent testing and adopted/experimental/rejected/blocked dispositions remain declarative.",
      "Native phase internals, callbacks, finite evidence scans, counters and logging remain inside owning operations; no candidate refinement loop exists.",
      "Registered MCP bindings are qualified by deterministic file fixtures through the real Lunar/PRISM compile/execute path; receipts and digests are host outputs, additional to native observer events."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "profile",
      "native_id": "trajectory_reflection_and_process_improvement",
      "owner_skill": "skills/control/reasoning-flow-language/SKILL.md",
      "contract": {
        "id": "trajectory_reflection_and_process_improvement",
        "goal": "Propose and independently test an immutable reasoning revision without weakening prior successful behavior.",
        "protected_properties": [
          "prior_successful_cases",
          "hook_coverage",
          "reasoning_log_validity",
          "evaluation_contract_integrity",
          "candidate_lineage",
          "rollback_target"
        ],
        "trust_transition": {
          "from": "observed_workflow_trajectory",
          "to": "tested_scoped_reasoning_revision_or_retained_baseline"
        }
      }
    },
    "mathformer.execution": {
      "runtime_owner": "skills/autoformalization/autoformalization-reflective-refinement-loop/SKILL.md",
      "native_bounds": "One pass; no native retries, checkpoints, convergence loop or wall-time bound. Slice default 8 has no positivity validation.",
      "host_limits": "Retained 3600-second descriptor budget; six calls cover one normal pass, not a native timeout.",
      "failure_behavior": "Argparse and uncaught errors terminate earlier; packet gate failure returns 3 only after persistence and requested baseline handling. No rollback of earlier writes.",
      "transport": "MCP preserves successful parser help as halted and maps invalid argparse exits to ValueError; native console output is redirected to stderr."
    }
  }
}
