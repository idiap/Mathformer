{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "profile_trajectory_reflection_and_process_improvement_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Runnable one-pass reflection observer for the trajectory reflection profile; revision construction, testing and adoption dispositions remain declarative.",
  "aliases": [
    "trajectory_reflection_and_process_improvement"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "Loaded": {
      "schema": {
        "type": "object",
        "required": [
          "paths",
          "report",
          "baseline",
          "monitor",
          "halted",
          "write_baseline",
          "max_opportunities",
          "json"
        ],
        "properties": {
          "paths": {
            "type": "object"
          },
          "report": {
            "type": "object"
          },
          "baseline": {
            "type": [
              "object",
              "null"
            ]
          },
          "monitor": {
            "type": [
              "object",
              "null"
            ]
          },
          "halted": {
            "type": "boolean"
          },
          "write_baseline": {
            "type": "boolean"
          },
          "max_opportunities": {
            "type": "integer",
            "description": "Default 8; native Python slice accepts zero and negatives."
          },
          "json": {
            "type": "boolean"
          }
        }
      }
    },
    "Observation": {
      "schema": {
        "type": "object",
        "required": [
          "log_validation",
          "reasoning_summary",
          "baseline_comparison",
          "commands"
        ],
        "properties": {
          "log_validation": {
            "type": "object"
          },
          "reasoning_summary": {
            "type": "object"
          },
          "baseline_comparison": {
            "type": "object"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Opportunities": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "priority",
            "owner_skill",
            "monotonicity_gate"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "priority": {
              "type": "string"
            },
            "owner_skill": {
              "type": "string"
            },
            "monotonicity_gate": {
              "type": "object"
            }
          }
        }
      }
    },
    "Packet": {
      "schema": {
        "type": [
          "object",
          "null"
        ],
        "description": "Null only for parser help; otherwise the native refinement packet.",
        "required": [
          "ok",
          "summary",
          "opportunities",
          "gate_decision",
          "todos",
          "monotonicity_contract"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "summary": {
            "type": "object"
          },
          "opportunities": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "gate_decision": {
            "type": "object"
          },
          "todos": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "monotonicity_contract": {
            "type": "object"
          }
        }
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    }
  },
  "outputs": {
    "packet": {
      "type": "Packet",
      "value": {
        "ref": "flow.outputs.packet"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "load": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "loaded": {
          "type": "Loaded"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_load",
          "operation": "mathformer_reflection_load"
        }
      }
    },
    "observe": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        }
      },
      "outputs": {
        "observation": {
          "type": "Observation"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_observe",
          "operation": "mathformer_reflection_observe"
        }
      }
    },
    "propose": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        },
        "observation": {
          "type": "Observation"
        }
      },
      "outputs": {
        "opportunities": {
          "type": "Opportunities"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_propose",
          "operation": "mathformer_reflection_propose"
        }
      }
    },
    "pack": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        },
        "observation": {
          "type": "Observation"
        },
        "opportunities": {
          "type": "Opportunities"
        }
      },
      "outputs": {
        "packet": {
          "type": "Packet"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_pack",
          "operation": "mathformer_reflection_pack"
        }
      }
    },
    "persist": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        },
        "packet": {
          "type": "Packet"
        }
      },
      "outputs": {},
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_persist",
          "operation": "mathformer_reflection_persist"
        }
      }
    },
    "finish_with_baseline": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        },
        "packet": {
          "type": "Packet"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_finish_with_baseline",
          "operation": "mathformer_reflection_finish_with_baseline"
        }
      }
    },
    "finish": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        },
        "packet": {
          "type": "Packet"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_finish",
          "operation": "mathformer_reflection_finish"
        }
      }
    },
    "help": {
      "inputs": {
        "loaded": {
          "type": "Loaded"
        }
      },
      "outputs": {
        "packet": {
          "type": "Packet"
        },
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reflection_help",
          "operation": "mathformer_reflection_help"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "load",
        "kind": "call",
        "operation": "load",
        "description": "Parse options and resolve paths; emit start and load report plus existing optional baseline/monitor. Parser help stops before I/O; invalid arguments terminate early.",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "parser_help",
            "when": {
              "ref": "steps.load.outputs.loaded.halted"
            },
            "body": {
              "kind": "call",
              "operation": "help",
              "arguments": {
                "loaded": {
                  "ref": "steps.load.outputs.loaded"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "observe",
              "kind": "call",
              "operation": "observe",
              "description": "Strict log validation, event summary, baseline success/compatibility/difficulty comparison, then regression-command recommendations; commands are never executed.",
              "arguments": {
                "loaded": {
                  "ref": "steps.load.outputs.loaded"
                }
              }
            },
            {
              "id": "propose",
              "kind": "call",
              "operation": "propose",
              "description": "Native evidence collectors select opportunities; fallback suite expansion requires no opportunities and a passing report. Attach preservation obligations, stable-sort by priority, slice [:max_opportunities], then log retained items.",
              "arguments": {
                "loaded": {
                  "ref": "steps.load.outputs.loaded"
                },
                "observation": {
                  "ref": "steps.observe.outputs.observation"
                }
              }
            },
            {
              "id": "pack",
              "kind": "call",
              "operation": "pack",
              "description": "Compute monotonicity contract and four gates (passing report, strict log, no baseline regressions, no supplied critic regressions), then package evidence, summary, opportunities and TODOs even when gates fail.",
              "arguments": {
                "loaded": {
                  "ref": "steps.load.outputs.loaded"
                },
                "observation": {
                  "ref": "steps.observe.outputs.observation"
                },
                "opportunities": {
                  "ref": "steps.propose.outputs.opportunities"
                }
              }
            },
            {
              "id": "persist",
              "kind": "call",
              "operation": "persist",
              "description": "Persist packet before baseline handling, including a failed packet.",
              "arguments": {
                "loaded": {
                  "ref": "steps.load.outputs.loaded"
                },
                "packet": {
                  "ref": "steps.pack.outputs.packet"
                }
              }
            },
            {
              "id": "finish",
              "kind": "switch",
              "cases": [
                {
                  "id": "snapshot_requested",
                  "when": {
                    "ref": "steps.load.outputs.loaded.write_baseline"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "finish_with_baseline",
                    "description": "Require baseline path or raise ValueError after packet persistence; snapshot report even if gates failed, then emit completion, print and return 0 if packet.ok else 3.",
                    "arguments": {
                      "loaded": {
                        "ref": "steps.load.outputs.loaded"
                      },
                      "packet": {
                        "ref": "steps.pack.outputs.packet"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "finish",
                "description": "Emit completion, print JSON or text per parsed flag, and return 0 if packet.ok else 3.",
                "arguments": {
                  "loaded": {
                    "ref": "steps.load.outputs.loaded"
                  },
                  "packet": {
                    "ref": "steps.pack.outputs.packet"
                  }
                }
              },
              "outputs": {
                "exit_code": {
                  "type": "ExitCode",
                  "value": {
                    "ref": "selected.outputs.exit_code"
                  }
                }
              }
            }
          ],
          "outputs": {
            "packet": {
              "type": "Packet",
              "value": {
                "ref": "steps.pack.outputs.packet"
              }
            },
            "exit_code": {
              "type": "ExitCode",
              "value": {
                "ref": "steps.finish.outputs.exit_code"
              }
            }
          }
        },
        "outputs": {
          "packet": {
            "type": "Packet",
            "value": {
              "ref": "selected.outputs.packet"
            }
          },
          "exit_code": {
            "type": "ExitCode",
            "value": {
              "ref": "selected.outputs.exit_code"
            }
          }
        }
      }
    ],
    "outputs": {
      "packet": {
        "type": "Packet",
        "value": {
          "ref": "steps.dispatch.outputs.packet"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.dispatch.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "input_reports"
        ],
        "write": [
          "reflection_packet",
          "observer_log",
          "baseline_file"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "inspect_declared_contract",
        "observe_evidence",
        "propose_opportunities",
        "write_reflection_packet",
        "snapshot_baseline"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion",
        "execute_regression_commands",
        "apply_proposed_changes",
        "adopt_reasoning_revision"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 6
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Reflection recommendations and gate evidence only; no scientific result or profile adoption disposition is established."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
