    "gaps": [
      "CLI parsing, loading, self-test and emission remain outside the selected build_loop_plan boundary. Reports are supplied as values; no context ports are needed by this pure function.",
      "Payload schemas retain opaque input fields and source-permitted passthrough output values.",
      "Native code has no iterative repair, timeout, receipts or call cap. Lunar supplies runtime receipts and the descriptor budgets; the nine loop_steps are advisory data, not executed stages."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "physics-lean:pathology-repair-loop",
      "owner_skill": "skills/physics-lean/physics-lean-pathology-repair-orchestrator/SKILL.md",
      "contract": {
        "id": "physics-lean:pathology-repair-loop",
        "family": "physics_lean",
        "kind": "validation",
        "safety": "writes_artifacts",
        "depends_on": [],
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Three registered MCP tools share extracted native aggregation, status assignment and assembly helpers with build_loop_plan; the existing CLI and hub subprocess remain unchanged.",
      "main_behavior": "main loads optional monitor, object and workbench JSON in order, then repeated repair plans; absent paths yield empty dictionaries and an empty repair-plan list. Self-test instead uses fixed fixture inputs and assertions. One aggregation returns, then JSON goes to stdout or --output (creating parent directories); exit is 0 even for blocked plans. Read/parse/conversion/shape/write errors and failed assertions propagate.",
      "limits": "No native time budget or operation-call cap. Lunar enforces the retained 3600-second and three-call descriptor limits; no loop exhaustion exists in this one-pass planner.",
      "iteration": "No recursive execution, retry, convergence test, iteration cap or loop-carried state.",
      "callers": "run_recursive_goal_case.py::finish_plans and run_lean_physics_backend_suite.py::finish_controlled call this planner. The broader goal-case separately plans generative repair, expansion and recursive control with iteration/max-iterations arguments; those are outside this contract."
    }
  }
}
