{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_lean_pathology_repair_loop_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Aggregate supplied pathology reports into one library-first repair plan; no repair execution.",
  "aliases": [
    "physics-lean:pathology-repair-loop"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Reports": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "monitor_report",
          "object_packet",
          "workbench_plan",
          "repair_plans"
        ],
        "properties": {
          "monitor_report": {
            "type": "object"
          },
          "object_packet": {
            "type": "object"
          },
          "workbench_plan": {
            "type": "object"
          },
          "repair_plans": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Findings": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "active_categories",
          "missing_repair_plans",
          "blockers",
          "monitor_pass",
          "has_blockers"
        ],
        "properties": {
          "active_categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_repair_plans": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "monitor_pass": {
            "type": "boolean"
          },
          "has_blockers": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Status": {
      "schema": {
        "type": "string",
        "enum": [
          "not_required",
          "blocked_on_library_or_labels",
          "ready_for_target_refinement"
        ]
      }
    },
    "Plan": {
      "representation": "value",
      "schema": {
        "type": "object",
        "required": [
          "style",
          "status",
          "active_categories",
          "object_count",
          "workbench_status",
          "repair_plan_styles",
          "missing_repair_plans",
          "blockers",
          "loop_steps",
          "target_refinement_policy",
          "rerun_gates"
        ],
        "properties": {
          "style": {
            "const": "physics_lean_pathology_repair_loop_plan"
          },
          "status": {
            "enum": [
              "not_required",
              "blocked_on_library_or_labels",
              "ready_for_target_refinement"
            ]
          },
          "active_categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "object_count": {},
          "workbench_status": {},
          "repair_plan_styles": {
            "type": "array"
          },
          "missing_repair_plans": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "loop_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "step",
                "owner_skill",
                "status"
              ],
              "properties": {
                "step": {
                  "type": "string"
                },
                "owner_skill": {
                  "type": "string"
                },
                "status": {}
              }
            }
          },
          "target_refinement_policy": {
            "type": "object",
            "required": [
              "may_edit_target_theorem",
              "library_first_required",
              "allowed_target_edits"
            ],
            "properties": {
              "may_edit_target_theorem": {
                "type": "boolean"
              },
              "library_first_required": {
                "const": true
              },
              "allowed_target_edits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "rerun_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "reports": {
      "type": "Reports"
    }
  },
  "outputs": {
    "result": {
      "type": "Plan",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "aggregate": {
      "inputs": {
        "reports": {
          "type": "Reports"
        }
      },
      "outputs": {
        "findings": {
          "type": "Findings"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_pathology_repair_aggregate",
          "operation": "mathformer_pathology_repair_aggregate"
        }
      }
    },
    "assign_status": {
      "inputs": {
        "status": {
          "type": "Status"
        }
      },
      "outputs": {
        "status": {
          "type": "Status"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_pathology_repair_assign_status",
          "operation": "mathformer_pathology_repair_assign_status"
        }
      }
    },
    "assemble": {
      "inputs": {
        "reports": {
          "type": "Reports"
        },
        "findings": {
          "type": "Findings"
        },
        "status": {
          "type": "Status"
        }
      },
      "outputs": {
        "result": {
          "type": "Plan"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_pathology_repair_assemble",
          "operation": "mathformer_pathology_repair_assemble"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "aggregate",
        "kind": "call",
        "operation": "aggregate",
        "description": "Convert dictionary category counts with int; non-dictionary counts become empty. Sort categories with positive counts. Map styles via REPAIR_STYLE_TO_CATEGORY, falling back to str(style); later plans overwrite earlier mappings. Collect non-mathformer_reused workbench items, stringified explicit repair blockers, blocked_on_library/needs_labeling statuses, and missing category plans. Deduplicate/sort blockers. Pack findings; monitor_pass is monitor_report.get('status') == 'pass'; has_blockers is bool(blockers). Traversals are local to this call; no state survives this invocation.",
        "arguments": {
          "reports": {
            "ref": "inputs.reports"
          }
        }
      },
      {
        "id": "status",
        "kind": "switch",
        "description": "Monitor pass takes precedence over every blocker; empty evidence may reach ready.",
        "cases": [
          {
            "id": "monitor_pass",
            "when": {
              "ref": "steps.aggregate.outputs.findings.monitor_pass"
            },
            "body": {
              "kind": "call",
              "operation": "assign_status",
              "arguments": {
                "status": {
                  "literal": "not_required"
                }
              }
            }
          },
          {
            "id": "blockers_present",
            "when": {
              "ref": "steps.aggregate.outputs.findings.has_blockers"
            },
            "body": {
              "kind": "call",
              "operation": "assign_status",
              "arguments": {
                "status": {
                  "literal": "blocked_on_library_or_labels"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "assign_status",
          "arguments": {
            "status": {
              "literal": "ready_for_target_refinement"
            }
          }
        },
        "outputs": {
          "status": {
            "type": "Status",
            "value": {
              "ref": "selected.outputs.status"
            }
          }
        }
      },
      {
        "id": "assemble",
        "kind": "call",
        "operation": "assemble",
        "description": "Return source fields, object_count fallback, workbench status, ordered repair styles, source-owned target edit policy and rerun_gates. loop_steps describes monitoring, detection, workbench, specific repairs, generative proposals, expansion mapping, recursive control, target refinement and acceptance, in that order; none is executed. Generative/expansion/control entries are not_required only for not_required status, otherwise pending. Only ready_for_target_refinement allows target edits. Acceptance gates always remain pending; blockers remain present even on monitor pass.",
        "arguments": {
          "reports": {
            "ref": "inputs.reports"
          },
          "findings": {
            "ref": "steps.aggregate.outputs.findings"
          },
          "status": {
            "ref": "steps.status.outputs.status"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Plan",
        "value": {
          "ref": "steps.assemble.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "aggregate_supplied_reports",
        "describe_repair_plan"
      ],
      "forbidden": [
        "execute_repair_stages",
        "promote_unchecked_artifacts",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 3
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "A returned plan is neither repair execution nor acceptance or proof."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
