  "inputs": {
    "options": {
      "type": "Options"
    }
  },
  "outputs": {
    "completion": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.completion"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_sympy_wiki_prepare",
          "operation": "mathformer_sympy_wiki_prepare"
        }
      }
    },
    "execute": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "result": {
          "type": "StepResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_sympy_wiki_execute",
          "operation": "mathformer_sympy_wiki_execute"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "result": {
          "type": "StepResult"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_sympy_wiki_advance",
          "operation": "mathformer_sympy_wiki_advance"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "completion": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_sympy_wiki_finalize",
          "operation": "mathformer_sympy_wiki_finalize"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "options": {
            "ref": "inputs.options"
          }
        }
      },
      {
        "id": "commands",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "max_iterations": 11,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "execute",
              "kind": "call",
              "operation": "execute",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "result": {
                  "ref": "steps.execute.outputs.result"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Done",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.commands.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "completion": {
        "type": "Completion",
        "value": {
          "ref": "steps.finalize.outputs.completion"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs",
          "artifact_root"
        ],
        "write": [
          "artifact_root",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow",
        "produce_validation_report"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 24
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked orchestration description only; completion establishes no scientific truth, promotion, or runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
