  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "sympy:wiki",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md"
    },
    "mathformer.execution": {
      "source": "tests/sympy/run_wiki_case.py:main",
      "source_tex": "tests/latex/wiki_level/sum_first_odd_numbers.tex",
      "command_order": [
        "dependency_probe",
        "api_index",
        "parse_source",
        "model_assumptions",
        "ground_api",
        "draft_artifact",
        "execute_artifact",
        "validate_identity",
        "search_counterexamples",
        "verify_trace",
        "consistency_report"
      ],
      "dependencies": "model_assumptions consumes parse_packet; ground_api consumes api_index; draft consumes parse_packet, assumptions, api_grounding and produces AutoformalizedSumFirstOddNumbers.py. Execution, identity, counterexamples and trace consume that artifact. Consistency consumes it plus parse, assumptions, grounding, draft, execution, identity, counterexamples and trace reports.",
      "artifacts": "dependency_probe.json; api_index.json; parse_packet.json; assumptions.json; api_grounding.json; draft_report.json; execution_report.json; symbolic_validation.json; counterexample_report.json; trace_verification.json; sympy_consistency_report.json/.md/.html; e2e_report.json",
      "command_details": "API indexing includes --self-test. Ground concepts: finite_sum, odd_numbers, square, symbolic_simplification, natural_number. Counterexample search uses --max-n 100. Exact argv and path wiring are constructed by prepare from source.",
      "bound_semantics": "Exactly 11 planned commands, each executed at most once. done is true on failure or the eleventh completion; the source returns normally at that bound. on_exhausted=fail is unreachable for correctly implemented advance.",
      "artifact_semantics": "Fixed filesystem paths are carried in State and read/written by successive commands; no artifact existence is implied by a planned path or failed run.",
      "binding_notes": "The CLI and MCP share prepare, execute_step, advance and finalize. MCP validates the fixed plan and command prefix, applies service write policy, and sends native print output to service stderr to preserve stdio transport."
    },
    "mathformer.native_boundary": {
      "execution": "Hub sympy:wiki launches this script with --json, no dependencies, no hub timeout; preflight, dry-run handling and post-execution write audit remain owned by scripts/mathformer.py, outside the selected main() graph.",
      "direct_cli": "Allows --artifact-root and --json; artifact_root is a host-resolved resource supporting that override.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "failure_policy": "Preserve completion.exit_code=1 on any recorded failed step; exceptions prevent normal completion. A returned failed report is not acceptance.",
      "other_callers": "Slow deterministic skill tests impose 180 seconds externally; SymPy self-test fallbacks may call main's script when expected artifacts are missing. Neither adds a deadline to main()."
    }
  }
