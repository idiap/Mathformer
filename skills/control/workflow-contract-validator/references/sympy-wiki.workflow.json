      "schema": {
        "type": "object",
        "required": [
          "report",
          "report_path",
          "exit_code"
        ],
        "properties": {
          "report": {
            "type": "object",
            "required": [
              "ok",
              "python",
              "results",
              "artifacts"
            ],
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "python": {
                "type": "string"
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "cmd",
                    "ok",
                    "returncode",
                    "duration_ms",
                    "stdout",
                    "stderr"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
