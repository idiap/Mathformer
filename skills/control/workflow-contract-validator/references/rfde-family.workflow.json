  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "enter",
        "kind": "call",
        "operation": "enter",
        "arguments": {
          "args": {
            "ref": "inputs.args"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "args": {
            "ref": "inputs.args"
          },
          "matrix": {
            "ref": "inputs.matrix"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "initial_guard",
        "kind": "call",
        "operation": "pending",
        "arguments": {
          "state": {
            "ref": "steps.prepare.outputs.state"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "traverse",
        "kind": "loop",
        "state_type": "Cursor",
        "initial": {
          "ref": "steps.initial_guard.outputs.cursor"
        },
        "max_iterations": 3,
        "on_exhausted": "fail",
        "description": "One check per pending cursor; retain_empty carries zero checks without invoking run_check. The third advance normally stops after its false guard.",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "pending",
              "when": {
                "ref": "loop.state.pending"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state.state"
                      },
                      "args": {
                        "ref": "inputs.args"
                      },
                      "context": {
                        "ref": "steps.enter.outputs.context"
                      }
                    }
                  },
                  {
                    "id": "guard",
                    "kind": "call",
                    "operation": "pending",
                    "arguments": {
                      "state": {
                        "ref": "steps.advance.outputs.state"
                      },
                      "context": {
                        "ref": "steps.enter.outputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "cursor": {
                    "type": "Cursor",
                    "value": {
                      "ref": "steps.guard.outputs.cursor"
                    }
                  },
                  "pending": {
                    "type": "Boolean",
                    "value": {
                      "ref": "steps.guard.outputs.pending"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "retain_empty",
            "arguments": {
              "cursor": {
                "ref": "loop.state"
              },
              "context": {
                "ref": "steps.enter.outputs.context"
              }
            }
          },
          "outputs": {
            "cursor": {
              "type": "Cursor",
              "value": {
                "ref": "selected.outputs.cursor"
              }
            },
            "pending": {
              "type": "Boolean",
              "value": {
                "ref": "selected.outputs.pending"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.cursor"
        },
        "until": {
          "not": {
            "ref": "body.outputs.pending"
          }
        },
        "outputs": {
          "state": {
            "type": "CheckState",
            "value": {
              "ref": "loop.state.state"
            }
          }
        }
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.traverse.outputs.state"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.finalize.outputs.report"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.publish.outputs.exit_code"
        }
      },
      "publication": {
        "type": "Publication",
        "value": {
          "ref": "steps.publish.outputs.publication"
        }
      }
    }
