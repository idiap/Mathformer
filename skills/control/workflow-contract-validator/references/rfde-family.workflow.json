    "mathformer.native_boundary": {
      "execution": "CLI and NL rfde.evaluate route through run_action/run_leaf_action; MCP mathformer_run_workflow delegates to mathformer_run_action.",
      "matrix_mount": "tests/test_matrix.json",
      "fixed_arguments": "Dependency-map-only, changed-files-only, matrix validation, strict capability gating and optional output formats are inactive.",
      "check_semantics": "Current critic-monitor self-test, descriptive-evaluator self-test and reflective-observer --help use 180/240/120 seconds; expected exit 0; no optional dependencies.",
      "stopping": "Empty selection skips traversal; exact third-row completion returns normally; exhaustion fails without finalization. Failed result records never stop later checks; uncaught errors abort.",
      "limits": "900 seconds is the native hub subprocess timeout; 11 operation calls is a descriptor budget. The old 3600-second limit was not native.",
      "keep_going": "Does not alter the runner check loop."
    },
    "mathformer.runtime_binding": {
      "execution": "run_action then run_leaf_action; preflight failure/dry-run returns before launch, otherwise subprocess and final write audit.",
      "failure_policy": "Hub timeout or undeclared writes forces failure independently of the report; unexpected source exceptions propagate.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "block_execution": "MCP tools call shared native functions, recheck service policy and verify server-owned invocation/state/report and phase on every call. Publication returns native stdout separately from JSON-RPC."
    },
    "mathformer.specialization": {
      "matrix_input": "Exact native file tests/test_matrix.json; no alternative manifest or injected rows.",
      "bound": "The root loop carries Cursor(state,pending). retain_empty carries a zero-check selection without calling run_check. This equivalent encoding avoids unsupported branch-local loop exhaustion in Lunar. At most three advances; the final native guard stops normally. Preparation rejects a larger selection before any check.",
