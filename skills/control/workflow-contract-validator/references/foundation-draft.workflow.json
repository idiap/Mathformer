      "self_test_request": "skills/mathformerphysicslib/mathformerphysicslib-foundation-drafter/scripts/draft_foundation_modules.py::main self_test branch. Pack source_packet_id=self_test, surfaces=[{foundation_module: Fields}], write=false; ignore --surface-plan and --write.",
