{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_lean_foundation_draft_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Model main → build_draft: select static foundation templates, preview or overwrite them once, then emit a candidate report.",
  "aliases": [
    "physics-lean:foundation-draft"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "required": [
          "surface_plan",
          "write",
          "output",
          "self_test",
          "json"
        ],
        "properties": {
          "surface_plan": {
            "type": [
              "string",
              "null"
            ]
          },
          "write": {
            "type": "boolean"
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "self_test": {
            "type": "boolean"
          },
          "json": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Request": {
      "schema": {
        "type": "object",
        "required": [
          "plan",
          "write"
        ],
        "properties": {
          "plan": true,
          "write": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "DraftState": {
      "schema": {
        "type": "object",
        "required": [
          "modules",
          "cursor",
          "items",
          "item_history"
        ],
        "properties": {
          "modules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Carriers",
                "Contexts",
                "Fields",
                "HilbertSpace",
                "Laws",
                "Operators",
                "PositionMomentumModels",
                "UnboundedOperators",
                "Units",
                "VectorCalculus"
              ]
            }
          },
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "items": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "module",
                "path",
                "state",
                "contains_mathlib_grounding",
                "declaration_count"
              ],
              "properties": {
                "module": {
                  "enum": [
                    "Carriers",
                    "Contexts",
                    "Fields",
                    "HilbertSpace",
                    "Laws",
                    "Operators",
                    "PositionMomentumModels",
                    "UnboundedOperators",
                    "Units",
                    "VectorCalculus"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "state": {
                  "const": "candidate_generated"
                },
                "contains_mathlib_grounding": {
                  "type": "boolean"
                },
                "declaration_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "item_history": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "description": "Native item JSON preserves insertion order through canonical transport."
          }
        },
        "additionalProperties": false
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "style",
          "source_surface_plan",
          "write",
          "accepted_index",
          "modules",
          "terminal_state"
        ],
        "properties": {
          "style": {
            "const": "physics_foundation_generation_report"
          },
          "source_surface_plan": true,
          "write": {
            "type": "boolean"
          },
          "accepted_index": {
            "const": "MathformerPhysicsLib/Lean/Foundations.lean"
          },
          "modules": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "module",
                "path",
                "state",
                "contains_mathlib_grounding",
                "declaration_count"
              ],
              "properties": {
                "module": {
                  "enum": [
                    "Carriers",
                    "Contexts",
                    "Fields",
                    "HilbertSpace",
                    "Laws",
                    "Operators",
                    "PositionMomentumModels",
                    "UnboundedOperators",
                    "Units",
                    "VectorCalculus"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "state": {
                  "const": "candidate_generated"
                },
                "contains_mathlib_grounding": {
                  "type": "boolean"
                },
                "declaration_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "terminal_state": {
            "enum": [
              "draft_written",
              "draft_preview"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "ExitCode": {
      "schema": {
        "const": 0,
        "type": "integer"
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "repository_root",
          "allow_mutating"
        ],
        "properties": {
          "repository_root": {
            "type": "string",
            "minLength": 1
          },
          "allow_mutating": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "RenderedReport": {
      "schema": {
        "type": "string"
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "parse": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "options": {
          "type": "Options"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_parse",
          "operation": "mathformer_foundation_draft_parse"
        }
      }
    },
    "self_test_request": {
      "inputs": {},
      "outputs": {
        "request": {
          "type": "Request"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_self_test_request",
          "operation": "mathformer_foundation_draft_self_test_request"
        }
      }
    },
    "load_request": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "request": {
          "type": "Request"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_load_request",
          "operation": "mathformer_foundation_draft_load_request"
        }
      }
    },
    "initialize": {
      "inputs": {
        "request": {
          "type": "Request"
        }
      },
      "outputs": {
        "state": {
          "type": "DraftState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_initialize",
          "operation": "mathformer_foundation_draft_initialize"
        }
      }
    },
    "draft_next": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "state": {
          "type": "DraftState"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "DraftState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_draft_next",
          "operation": "mathformer_foundation_draft_draft_next"
        }
      }
    },
    "finish": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "state": {
          "type": "DraftState"
        },
        "options": {
          "type": "Options"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        },
        "rendered_report": {
          "type": "RenderedReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_finish",
          "operation": "mathformer_foundation_draft_finish"
        }
      }
    },
    "emit": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "report": {
          "type": "Report"
        },
        "context": {
          "type": "Context"
        },
        "rendered_report": {
          "type": "RenderedReport"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_draft_emit",
          "operation": "mathformer_foundation_draft_emit"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "choose_request",
        "kind": "switch",
        "cases": [
          {
            "id": "self_test",
            "when": {
              "ref": "steps.parse.outputs.options.self_test"
            },
            "body": {
              "kind": "call",
              "operation": "self_test_request",
              "arguments": {}
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "load_request",
          "arguments": {
            "options": {
              "ref": "steps.parse.outputs.options"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "outputs": {
          "request": {
            "type": "Request",
            "value": {
              "ref": "selected.outputs.request"
            }
          }
        }
      },
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "request": {
            "ref": "steps.choose_request.outputs.request"
          }
        }
      },
      {
        "id": "draft_modules",
        "kind": "loop",
        "description": "Exactly one visit per selected template (1–10). The tenth visit completes normally with done=true; exhaustion is unreachable for source-selected modules.",
        "state_type": "DraftState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "draft_next",
          "arguments": {
            "request": {
              "ref": "steps.choose_request.outputs.request"
            },
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 10,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "DraftState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "request": {
            "ref": "steps.choose_request.outputs.request"
          },
          "state": {
            "ref": "steps.draft_modules.outputs.state"
          },
          "options": {
            "ref": "steps.parse.outputs.options"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "emit",
        "kind": "call",
        "operation": "emit",
        "arguments": {
          "options": {
            "ref": "steps.parse.outputs.options"
          },
          "report": {
            "ref": "steps.finish.outputs.report"
          },
          "context": {
            "ref": "inputs.context"
          },
          "rendered_report": {
            "ref": "steps.finish.outputs.rendered_report"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.emit.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/",
          "MathformerPhysicsLib/Lean/Foundations/",
          "MathformerPhysicsLib/Lean/Foundations.lean",
          "native_output_path"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow",
        "preview_static_candidates",
        "overwrite_selected_templates_when_write"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion",
        "promote_candidates"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 15
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Candidate generation only; no missing-declaration comparison, Lean compilation, scientific verification, or promotion."
  },
