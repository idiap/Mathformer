{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_mathformerphysicslib_coherence_gate_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Select coherence reports and repairs, aggregate diagnostics, emit requested reports, and return main's exit code.",
  "aliases": [
    "mathformerphysicslib:coherence-gate"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Args": {
      "schema": {
        "type": "object",
        "description": "Parsed main CLI options; absent paths are null.",
        "required": [
          "report",
          "repair_plan",
          "output",
          "markdown_output",
          "self_test",
          "require_release",
          "json"
        ],
        "properties": {
          "report": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repair_plan": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "markdown_output": {
            "type": [
              "string",
              "null"
            ]
          },
          "self_test": {
            "type": "boolean"
          },
          "require_release": {
            "type": "boolean"
          },
          "json": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Reports": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "Ordered grounding/critic reports or supplied JSON reports; findings are consumed by native helpers."
      }
    },
    "Repairs": {
      "schema": {
        "type": "object",
        "description": "Loaded or proposed repair plan; actions are never applied."
      }
    },
    "Gate": {
      "schema": {
        "type": "object",
        "required": [
          "status",
          "high_findings",
          "medium_findings",
          "release_ok",
          "repair_plan_status",
          "repair_action_count"
        ],
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "warn",
              "blocked"
            ]
          },
          "high_findings": {
            "type": "integer",
            "minimum": 0
          },
          "medium_findings": {
            "type": "integer",
            "minimum": 0
          },
          "release_ok": {
            "type": "boolean"
          },
          "repair_plan_status": {},
          "repair_action_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    },
    "SerializedGate": {
      "schema": {
        "type": "string",
        "description": "Native aggregate JSON preserving object insertion order across canonicalizing transports for requested JSON output."
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    }
  },
  "outputs": {
    "payload": {
      "type": "Gate",
      "value": {
        "ref": "flow.outputs.payload"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "parse": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "args": {
          "type": "Args"
        },
        "supplied_reports": {
          "type": "Flag"
        },
        "supplied_repairs": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_parse",
          "operation": "mathformer_coherence_gate_parse"
        }
      }
    },
    "load_reports": {
      "inputs": {
        "args": {
          "type": "Args"
        }
      },
      "outputs": {
        "reports": {
          "type": "Reports"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_load_reports",
          "operation": "mathformer_coherence_gate_load_reports"
        }
      }
    },
    "default_reports": {
      "inputs": {
        "args": {
          "type": "Args"
        }
      },
      "outputs": {
        "reports": {
          "type": "Reports"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_default_reports",
          "operation": "mathformer_coherence_gate_default_reports"
        }
      }
    },
    "load_repairs": {
      "inputs": {
        "args": {
          "type": "Args"
        }
      },
      "outputs": {
        "repairs": {
          "type": "Repairs"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_load_repairs",
          "operation": "mathformer_coherence_gate_load_repairs"
        }
      }
    },
    "propose_repairs": {
      "inputs": {
        "reports": {
          "type": "Reports"
        }
      },
      "outputs": {
        "repairs": {
          "type": "Repairs"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_propose_repairs",
          "operation": "mathformer_coherence_gate_propose_repairs"
        }
      }
    },
    "aggregate": {
      "inputs": {
        "reports": {
          "type": "Reports"
        },
        "repairs": {
          "type": "Repairs"
        }
      },
      "outputs": {
        "payload": {
          "type": "Gate"
        },
        "serialized_payload": {
          "type": "SerializedGate"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_aggregate",
          "operation": "mathformer_coherence_gate_aggregate"
        }
      }
    },
    "emit_return": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "repairs": {
          "type": "Repairs"
        },
        "serialized_payload": {
          "type": "SerializedGate"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_gate_emit_return",
          "operation": "mathformer_coherence_gate_emit_return"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "reports",
        "kind": "switch",
        "cases": [
          {
            "id": "supplied",
            "when": {
              "ref": "steps.parse.outputs.supplied_reports"
            },
            "body": {
              "kind": "call",
              "operation": "load_reports",
              "arguments": {
                "args": {
                  "ref": "steps.parse.outputs.args"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "default_reports",
          "arguments": {
            "args": {
              "ref": "steps.parse.outputs.args"
            }
          }
        },
        "outputs": {
          "reports": {
            "type": "Reports",
            "value": {
              "ref": "selected.outputs.reports"
            }
          }
        }
      },
      {
        "id": "repairs",
        "kind": "switch",
        "cases": [
          {
            "id": "supplied",
            "when": {
              "ref": "steps.parse.outputs.supplied_repairs"
            },
            "body": {
              "kind": "call",
              "operation": "load_repairs",
              "arguments": {
                "args": {
                  "ref": "steps.parse.outputs.args"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "propose_repairs",
          "arguments": {
            "reports": {
              "ref": "steps.reports.outputs.reports"
            }
          }
        },
        "outputs": {
          "repairs": {
            "type": "Repairs",
            "value": {
              "ref": "selected.outputs.repairs"
            }
          }
        }
      },
      {
        "id": "aggregate",
        "kind": "call",
        "operation": "aggregate",
        "arguments": {
          "reports": {
            "ref": "steps.reports.outputs.reports"
          },
          "repairs": {
            "ref": "steps.repairs.outputs.repairs"
          }
        }
      },
      {
        "id": "emit_return",
        "kind": "call",
        "operation": "emit_return",
        "arguments": {
          "args": {
            "ref": "steps.parse.outputs.args"
          },
          "repairs": {
            "ref": "steps.repairs.outputs.repairs"
          },
          "serialized_payload": {
            "ref": "steps.aggregate.outputs.serialized_payload"
          }
        }
      }
    ],
    "outputs": {
      "payload": {
        "type": "Gate",
        "value": {
          "ref": "steps.aggregate.outputs.payload"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.emit_return.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "requested_json_output",
          "requested_markdown_output",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "read_coherence_inputs",
        "propose_repairs",
        "compute_diagnostics",
        "emit_requested_reports"
      ],
      "forbidden": [
        "apply_repairs",
        "infer_scientific_truth_from_completion",
        "bypass_native_controls"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked diagnostics only; native release/property flags do not establish scientific truth or actual artifact promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
