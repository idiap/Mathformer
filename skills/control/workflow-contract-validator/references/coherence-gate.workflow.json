    "gaps": [
      "Helper internals remain inside their owning native operations; coverage models main-level control flow.",
      "The 3600-second and five-call bounds are enforced by Lunar; standalone main has no native timeout or input-size cap.",
      "Native stdout is emitted to the MCP stdio diagnostic channel; Lunar supplies required execution receipts and artifact digests."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "mathformerphysicslib:coherence-gate",
      "owner_skill": "skills/mathformerphysicslib/mathformerphysicslib-coherence-gate/SKILL.md",
      "contract": {
        "id": "mathformerphysicslib:coherence-gate",
        "summary": "Smoke-test MathformerPhysicsLib coherence gate.",
        "family": "mathformerphysicslib",
        "kind": "validation",
        "safety": "read_only",
        "command": [
          "{python}",
          "skills/mathformerphysicslib/mathformerphysicslib-coherence-gate/scripts/gate_coherence.py",
          "--self-test",
          "--json"
        ],
        "depends_on": [],
        "writes": [],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Existing scripts/mathformer.py controller launches one subprocess after preflight; dry-run and preflight errors prevent launch.",
      "failure_policy": "Hub success depends on subprocess exit code and undeclared-write audit; diagnostics status is separate. main returns 0 by default even for blocked diagnostics; require-release may return 3. Argparse errors terminate with its native exit; unhandled errors terminate execution.",
      "input_scope": "argv models main directly. The registered action fixes argv to --self-test --json, forbids extra args, has no dependencies, and requests no output files. Standalone argv may supply reports, repair plan, and output paths.",
      "callers": [
        "coherence-suite",
        "physics-lib:coherence-gate"
      ],
      "effects_status": "partial_native_declarations"
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "command_after_dependencies": false,
      "modeling": "Single main pass; report and repair selection precede aggregation, annotation, optional writes, stdout and exit. All repeated traversals are finite and input-sized, contained in owning operations. No refinement loop, exhaustion status, checkpoint, or retries."
    }
  }
