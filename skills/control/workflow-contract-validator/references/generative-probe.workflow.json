{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_generative_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Specify main's ordered probe validation and reporting, specialized to at most 10000 probes. Hub invocation uses --json; no probe generation or scoring occurs.",
  "aliases": [
    "test:generative"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Request": {
      "schema": {
        "type": "object",
        "description": "Specialization precondition: probe_count equals the length of the list loaded from probes.json (absent probes means zero); it is at most 10000. This is an authoring-domain restriction, not a native CLI argument.",
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "probe_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "argv",
          "probe_count"
        ],
        "additionalProperties": false
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "properties": {
          "required_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "probes": {
            "type": "array",
            "items": {},
            "maxItems": 10000
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "json": {
            "type": "boolean"
          }
        },
        "required": [
          "required_fields",
          "probes",
          "index",
          "errors",
          "has_more",
          "json"
        ],
        "additionalProperties": false
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "criteria_file": {
            "const": "tests/generative/quality_criteria.json"
          },
          "probes_file": {
            "const": "tests/generative/probes/probes.json"
          },
          "probe_count": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "const": "validate-only"
          },
          "codex_exec_policy": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "ok",
          "criteria_file",
          "probes_file",
          "probe_count",
          "errors",
          "mode",
          "codex_exec_policy"
        ],
        "additionalProperties": false
      }
    },
    "Completion": {
      "schema": {
        "type": "object",
        "properties": {
          "report_path": {
            "const": "artifacts/test_program/generative/probe_validation_report.json"
          },
          "exit_code": {
            "type": "integer",
            "enum": [
              0,
              3
            ]
          },
          "stdout": {
            "type": "string"
          }
        },
        "required": [
          "report_path",
          "exit_code",
          "stdout"
        ],
        "additionalProperties": false
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "required": [
          "repository_root"
        ],
        "additionalProperties": false
      }
    },
    "Runtime": {
      "schema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "required": [
          "handle"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "request": {
      "type": "Request"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "completion": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.completion"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "runtime": {
          "type": "Runtime"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_probe_initialize",
          "operation": "mathformer_probe_initialize"
        }
      }
    },
    "inspect_probe": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "runtime": {
          "type": "Runtime"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_probe_inspect_probe",
          "operation": "mathformer_probe_inspect_probe"
        }
      }
    },
    "build_report": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "runtime": {
          "type": "Runtime"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_probe_build_report",
          "operation": "mathformer_probe_build_report"
        }
      }
    },
    "publish": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "json": {
          "type": "Boolean"
        },
        "runtime": {
          "type": "Runtime"
        }
      },
      "outputs": {
        "completion": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_probe_publish",
          "operation": "mathformer_probe_publish"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "runtime": {
          "type": "Runtime"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_probe_retain_empty",
          "operation": "mathformer_probe_retain_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "traverse",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "loop.state.has_more"
              },
              "body": {
                "kind": "call",
                "operation": "inspect_probe",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "runtime": {
                    "ref": "steps.initialize.outputs.runtime"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "retain_empty",
            "arguments": {
              "state": {
                "ref": "loop.state"
              },
              "runtime": {
                "ref": "steps.initialize.outputs.runtime"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "not": {
            "ref": "body.outputs.state.has_more"
          }
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "validate",
        "kind": "call",
        "operation": "build_report",
        "arguments": {
          "state": {
            "ref": "steps.traverse.outputs.state"
          },
          "runtime": {
            "ref": "steps.initialize.outputs.runtime"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.validate.outputs.report"
          },
          "json": {
            "ref": "steps.initialize.outputs.state.json"
          },
          "runtime": {
            "ref": "steps.initialize.outputs.runtime"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.validate.outputs.report"
        }
      },
      "completion": {
        "type": "Completion",
        "value": {
          "ref": "steps.publish.outputs.completion"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 10003
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Probe structure validation only; no generated content or scientific acceptance."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "tests/run_generative.py",
        "selector": "main (delegates validation to validate)",
        "digest": "sha256:ee9bba99a6e0b2c3e0d1152e161d637a358c20bb801a12dfcec74d5b8e651701"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry/action:test:generative; run_action; run_leaf_action; preflight",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/generative_probes_route_tools.py",
        "selector": "checked_registry; mathformer_generative_probes_invoke",
        "digest": "sha256:7dd49d1f9552aab1acee500c2eaea342590985527545fb7b1126d9a3dbcd98bd"
      },
      {
        "path": "scripts/generative_probe_workflow_tools.py",
        "selector": "register_generative_probe_workflow_tools",
        "digest": "sha256:8c146e22bcc5a1ea074f990e35c67c9fc3da77275bab3772f8ff8e5c7d9626c3"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_generative_probe_workflow_tools",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer_mcp_service.py",
        "selector": "mcp_tools",
        "digest": "sha256:ff2a57a3dc268e73d31e34605d80a65a5bdc6e16e28ad41af5752ad8bae60164"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "inventory/test:generative",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Shared source continuations implement every operation. Context.repository_root selects the native input/output mount; Runtime is service-owned continuation authority. Native stdout is retained in completion.stdout rather than printed on the MCP transport.",
      "The native traversal is unbounded. This projection covers loaded lists of 0..10000 probes; Request.probe_count must match their actual length. At exactly 10000 probes the final guard stops normally, even with errors. Exhaustion is unreachable within the specialization; larger lists are outside its domain, not native exhaustion failures.",
      "File, JSON and structural exceptions propagate and prevent later report writing. Normal validation errors do not abort traversal. Parser exits remain owned by initialize. The typed projection does not claim full Python equivalence.",
      "The graph specifies the selected main implementation; hub admission, preflight, one subprocess launch and write auditing remain native controller behavior. It is not an executable replacement for run_action.",
      "3600 seconds and 10003 calls are normalization budgets; the registered process timeout is 900 seconds. Receipts and digests are contract requirements, not evidence that native optional logging already implements them."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "test:generative",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "test:generative",
        "summary": "Run generative quality probes.",
        "family": "generative",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/run_generative.py",
          "--json"
        ],
        "depends_on": [],
        "required_paths": [
          "tests/run_generative.py"
        ],
        "required_tools": [],
        "optional_tools": [],
        "writes": [
          "artifacts/"
        ],
        "allows_extra_args": false,
        "timeout_seconds": 900,
        "notes": ""
      }
    },
    "mathformer.native_boundary": {
      "execution": "Graph invokes the shared main implementation through registered MCP continuations; the existing hub controller remains the separate native entry boundary.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "failure_policy": "Admission and preflight precede launching. Rejection or dry-run returns without launching. Otherwise snapshot, launch once, then audit writes, also on timeout. Nonzero exit, timeout or undeclared writes makes the hub result unsuccessful. Unexpected launch exceptions propagate before the final audit.",
      "route": "generative.probes and its route tools dispatch through the same run_action.",
      "scientific_payloads": "HubResult is the transport envelope; Report is the native probe report."
    }
  }
}
