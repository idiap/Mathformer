  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "physics-lib:coherence-api-critic",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "physics-lib:coherence-api-critic",
        "summary": "Alias for MathformerPhysicsLib API operability critic.",
        "family": "mathformerphysicslib",
        "kind": "sequence",
        "safety": "read_only",
        "command": [],
        "depends_on": [
          "mathformerphysicslib:api-operability-critic"
        ],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.composition": {
      "ordered_dependencies": [
        "mathformerphysicslib:api-operability-critic"
      ],
      "command_after_dependencies": false,
      "specialization": "Fixed build_registry alias; one dependency, no configurable list. The bound exits normally after one visit; exhaustion is unreachable."
    },
    "mathformer.native_boundary": {
      "callers": "CLI and intent invoke run_action; MCP mathformer_run_workflow resolves this normalized ID to the alias and delegates through mathformer_run_action.",
      "input_defaults": "Supply empty extra_args and seen for ordinary top-level invocation.",
      "native_limits": "No retries, repair iterations, concept-count cap or configured subprocess timeout; the separate critic specialization's 1024-concept bound does not apply.",
      "self_test": "self_test_payload builds a fixture graph, runs grounding and critics, constructs advisory plans and checks assertions. Its report bundle lacks concept_occurrence_index, so main canonicalizes it to an empty graph before the final critic_api call. No refinement or repair is executed.",
      "critic_semantics": "critic_api traverses concepts once with accumulated findings. Missing owners and owners outside Foundations are skipped; absent owner files read as empty text. Required API terms match case-insensitively. Required terms with zero matches yield high; fewer than min(2, required-term count) yield low. Findings never stop traversal; report.ok is false iff any finding is high.",
      "execution": "Registered mathformer_coherence_api_alias_* tools reuse the shared hub steps. A transport-only carry preserves rejection data through a top-level loop because Lunar cannot scope branch-local loop exhaustion; rejected admission performs no child visit."
    }
  }
