        "digest": "sha256:472e64b1c7af4fb1b698bcb7bb140ee49a5d6e3fd7b3a7a27aaaec2b03fd302a"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry formalphysics:extra-sympy; run_action; prepare_leaf_boundary; run_leaf_action; finish_leaf_boundary",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/formalphysics_extra_sympy_tools.py",
        "selector": "register_extra_sympy_tools",
        "digest": "sha256:1986f0c0f27a4b241ea3d68a3853f9912bf9071abec749e0df73b729b5d8e486"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_extra_sympy_tools",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "inventory formalphysics:extra-sympy",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Each case retains the native helper as an opaque operation; scientific payloads and external effects are not independently qualified.",
      "The descriptor wall-time budget is enforced by Lunar, not by native hub or helper subprocess timeouts.",
      "Native artifact writes remain subject to the unchanged hub write declarations; undeclared writes fail the final hub result.",
      "Exception diagnostics retain their Python traceback with the staged observation frame instead of a child-process top-level frame."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "formalphysics:extra-sympy",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md"
    },
    "mathformer.native_boundary": {
      "execution": "Native preflight and write audit around shared source case traversal, exposed by registered staged MCP tools.",
      "command": [
        "{python}",
        "scripts/generate_formalphysics_extra_sympy.py",
        "--json"
      ],
      "depends_on": [],
      "allows_extra_args": false,
      "timeout_seconds": null,
      "specialization": "Required options are exactly json=true and promote_lib=false; other CLI branches are outside this hub route.",
      "ordered_cases": [
        "formalphysics_0066",
        "formalphysics_0191",
        "formalphysics_0172",
        "formalphysics_0119",
        "formalphysics_0026",
        "formalphysics_0176",
        "formalphysics_0054",
        "formalphysics_0059"
      ],
      "carried_state": "Ordered summaries and index; stdout/stderr and termination carry the child-process observation across staged ports.",
      "failure_policy": "Exceptions abort remaining cases; hub still audits child writes. Non-complete summaries continue and yield exit 3.",
      "compiler_layout": "The loop is root-scoped for Lunar exhaustion handling. On rejected preflight or dry-run, initialization and one pure no-op loop turn only pack data; no case or finish/audit is called."
    }
  }
}
