{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_formalphysics_extra_sympy_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Extended FormalPhysics SymPy generation through the registered hub command.",
  "aliases": [
    "formalphysics:extra-sympy"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Boundary": {
      "schema": {
        "type": "object",
        "required": [
          "payload",
          "snapshot"
        ],
        "properties": {
          "payload": {
            "type": "object"
          },
          "snapshot": {
            "type": "object"
          }
        }
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "required": [
          "json",
          "promote_lib"
        ],
        "properties": {
          "json": {
            "const": true
          },
          "promote_lib": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "index",
          "summaries",
          "termination",
          "stdout",
          "stderr",
          "summaries_json"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "summaries": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object"
            }
          },
          "termination": {
            "type": [
              "object",
              "null"
            ]
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "summaries_json": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Attempt": {
      "schema": {
        "type": "object",
        "required": [
          "returned",
          "summary",
          "termination",
          "stdout",
          "stderr",
          "summary_json"
        ],
        "properties": {
          "returned": {
            "type": "boolean"
          },
          "summary": {
            "type": [
              "object",
              "null"
            ]
          },
          "termination": {
            "type": [
              "object",
              "null"
            ]
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "summary_json": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "ProcessResult": {
      "schema": {
        "type": "object",
        "required": [
          "returncode",
          "stdout",
          "stderr"
        ],
        "properties": {
          "returncode": {
            "type": "integer"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "options": {
      "type": "Options"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "boundary": {
          "type": "Boundary"
        },
        "execute": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_prepare",
          "operation": "mathformer_extra_sympy_prepare"
        }
      }
    },
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_initialize",
          "operation": "mathformer_extra_sympy_initialize"
        }
      }
    },
    "visit": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "options": {
          "type": "Options"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "attempt": {
          "type": "Attempt"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_visit",
          "operation": "mathformer_extra_sympy_visit"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "attempt": {
          "type": "Attempt"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_advance",
          "operation": "mathformer_extra_sympy_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "process": {
          "type": "ProcessResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_finish",
          "operation": "mathformer_extra_sympy_finish"
        }
      }
    },
    "audit": {
      "inputs": {
        "boundary": {
          "type": "Boundary"
        },
        "process": {
          "type": "ProcessResult"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_audit",
          "operation": "mathformer_extra_sympy_audit"
        }
      }
    },
    "return_boundary": {
      "inputs": {
        "boundary": {
          "type": "Boundary"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_return_boundary",
          "operation": "mathformer_extra_sympy_return_boundary"
        }
      }
    },
    "skip": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_extra_sympy_skip",
          "operation": "mathformer_extra_sympy_skip"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "cases",
        "kind": "loop",
        "description": "Eight fixed cases, no retry or repair. The eighth returned case sets done=true and exits normally; exhaustion is unreachable for this list. Child termination sets done=true earlier and skips remaining cases.",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 8,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "execute",
              "when": {
                "ref": "steps.prepare.outputs.execute"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "visit",
                    "kind": "call",
                    "operation": "visit",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "options": {
                        "ref": "inputs.options"
                      },
                      "context": {
                        "ref": "inputs.context"
                      }
                    }
                  },
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "attempt": {
                        "ref": "steps.visit.outputs.attempt"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "State",
                    "value": {
                      "ref": "steps.advance.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Flag",
                    "value": {
                      "ref": "steps.advance.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "skip",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "execute",
            "when": {
              "ref": "steps.prepare.outputs.execute"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "finish",
                  "kind": "call",
                  "operation": "finish",
                  "arguments": {
                    "state": {
                      "ref": "steps.cases.outputs.state"
                    },
                    "options": {
                      "ref": "inputs.options"
                    }
                  }
                },
                {
                  "id": "audit",
                  "kind": "call",
                  "operation": "audit",
                  "arguments": {
                    "boundary": {
                      "ref": "steps.prepare.outputs.boundary"
                    },
                    "process": {
                      "ref": "steps.finish.outputs.process"
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "HubResult",
                  "value": {
                    "ref": "steps.audit.outputs.result"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "return_boundary",
          "arguments": {
            "boundary": {
              "ref": "steps.prepare.outputs.boundary"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.dispatch.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/",
          "backends/sympy/MathformerSympyPhysics/",
          "libraries/MathformerPhysicsLib/SymPy/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 20
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native workflow completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
