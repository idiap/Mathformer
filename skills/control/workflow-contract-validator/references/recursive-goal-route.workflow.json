    "mathformer.control": {
      "helper_timeout_seconds": 240,
      "grounding_timeout_seconds": 360,
      "compiler_timeout": "none locally; hub runner bounded at 900 seconds",
      "stage_ok": "run_stage: returncode=0 AND expected output exists; timeout gives returncode 124. No automatic retries.",
