    "gaps": [
      "Scope is build_chapter_plan with resolved inventory. The existing full_report, theory_path, output_dir and options ports supply its complete native context. Caller main obtains JSON or extraction, including optional prose fallback, and prepends extraction records outside this contract.",
      "Input specialization limits full_report to 1000 units; larger inventories are outside this contract. Delegated job loops/gates and helper internals remain inside their owning operations; additional declarative hooks are not scheduled.",
      "Inherited 3600s workflow ceiling is a host policy, not a native aggregate timeout. Required-command failures, outer subprocess timeouts and unhandled exceptions abort; recorded object blocks/gate failures do not. Result reuse is native persistence, not checkpoint resume."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "loop",
      "native_id": "textbook_theory_autoformalization_loop",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md"
    },
    "mathformer.membership": {
      "required_hooks_are_not_an_execution_schedule": true,
      "owner_skills": [
        "latex-archive-theory-extractor",
        "textbook-theory-tex-organizer",
        "textbook-chapter-autoformalization-orchestrator",
        "textbook-autoformalization-batch-orchestrator",
        "result-existence-precheck-orchestrator",
        "source-line-translation-packet-builder",
        "mathlib-grounding-maximizer",
        "lean-execution-runner",
        "lean-compile-checker",
        "source-formalization-drift-guard",
        "autoformalization-result-realness-verifier",
        "lean-consistency-report-orchestrator"
      ],
      "runtime_accounting": {
        "shared_steps": "inventory_and_pack, prepare_chapter, run_objects, append_and_advance, write_plan are shared with build_chapter_plan; delegated job processing and gates remain native subprocesses."
      }
    },
    "mathformer.steps": {
      "inventory_and_pack": "orchestrate_textbook_chapters.py::build_chapter_plan calls chapter_inventory then select_chapters; pack selected/all inventories and empty entries/commands, compute nonempty guard. Unmatched explicit chapter filters raise.",
      "prepare_chapter": "build_chapter_plan loop: write_chapter_theory_report (preserve paired units), run section organizer, then batch builder; optional max_jobs_per_chapter and no_proof_jobs. Pack entry/commands and compute should_run by index equality OR case-insensitive ID equality/title substring; absent run selectors mean false. Required preparation commands default to 600s each.",
      "run_objects": "build_chapter_plan should_run branch invokes run_textbook_autoformalization_batch.py::run_batch via required subprocess (1800s default), then attaches run_manifest/run_summary and command record. Runner filters kind, start offset, max count (chapter caller supplies no kind); processes jobs sequentially, reusing result.json unless forced. Otherwise provider availability, one generation attempt (900s), then realness and unified consistency with Lean unless skipped. Unavailable provider => blocked_no_generative_provider; failed/timed-out/blocked/empty generation => blocked_generation; both gates pass => complete, otherwise draft_failed_gates. These statuses continue later jobs; unhandled exceptions abort. Persists per-job results, Lean/gate artifacts and manifests, collecting existing recorded summaries. No proof feedback or repair. Gate success uses the native gate-command exit codes. In particular, a consistency report can record a failed compiler layer while its CLI exits zero; the batch can then record complete. The report payload and recorded status are preserved independently.",
      "append_and_advance": "build_chapter_plan commands.append and chapter_entries.append plus native for-loop advancement: append chapter records, remove consumed chapter from remaining selection, pack next state and compute done when selection exhausted. Does not inspect object status to stop.",
      "write_plan": "build_chapter_plan final manifest assembly, summary aggregation and write_json(output_dir/chapter_plan.json), returning manifest. Empty selection succeeds. CLI success is not evidence that every object passed.",
      "empty_selection": "Pure transport identity for an initially empty selection; no source command, preparation, or extra native inventory call. The root loop guard is inside its body to support Lunar scoped exhaustion."
    }
  }
}
