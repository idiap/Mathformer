{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "loop_textbook_theory_autoformalization_loop_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Sequential chapter inventory, section organization, object queue preparation and explicitly selected execution; no convergence retry.",
  "aliases": [
    "textbook_theory_autoformalization_loop"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Path": {
      "schema": {
        "type": "string",
        "minLength": 1
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "description": "Native argparse options; omitted fields use parse_args defaults. Run selectors are mutually exclusive.",
        "properties": {
          "archive": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "chapter_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "chapter_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "max_chapters": {
            "type": [
              "integer",
              "null"
            ]
          },
          "max_jobs_per_chapter": {
            "type": [
              "integer",
              "null"
            ]
          },
          "no_proof_jobs": {
            "type": "boolean",
            "default": false
          },
          "run_chapter_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_chapter_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "none",
              "codex-cli"
            ],
            "default": "none"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_run_jobs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "start_at": {
            "type": "integer",
            "default": 1
          },
          "skip_lean_check": {
            "type": "boolean",
            "default": false
          },
          "force": {
            "type": "boolean",
            "default": false
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "default": 600
          },
          "run_timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "default": 1800
          }
        },
        "additionalProperties": false,
        "not": {
          "required": [
            "run_chapter_id",
            "run_chapter_index"
          ],
          "properties": {
            "run_chapter_id": {
              "type": "string",
              "minLength": 1
            },
            "run_chapter_index": {
              "type": "integer"
            }
          }
        }
      }
    },
    "Theory": {
      "schema": {
        "type": "object",
        "required": [
          "units"
        ],
        "properties": {
          "units": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object"
            }
          }
        },
        "description": "Resolved full_report. Specialization admits at most 1000 units, hence at most 1000 chapters; payload retains source provenance."
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "remaining",
          "entries",
          "commands",
          "all_chapters",
          "has_chapters"
        ],
        "properties": {
          "remaining": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object"
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "all_chapters": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "has_chapters": {
            "type": "boolean"
          }
        },
        "description": "Ordered remaining chapters, accumulated chapter entries and command records; all_chapters retains the unfiltered inventory."
      }
    },
    "Prepared": {
      "schema": {
        "type": "object",
        "required": [
          "entry",
          "commands",
          "should_run"
        ],
        "properties": {
          "entry": {
            "type": "object"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "should_run": {
            "type": "boolean"
          }
        },
        "description": "Native chapter entry with inventory, organized/batch paths and summaries, nullable run_manifest; commands for this chapter."
      }
    },
    "Plan": {
      "schema": {
        "type": "object",
        "required": [
          "manifest_file",
          "chapters",
          "all_chapters",
          "commands",
          "summary"
        ],
        "properties": {
          "manifest_file": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "all_chapters": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object"
          }
        },
        "description": "Returned chapter_plan.json payload, including source, selection, counts and per-chapter artifact references."
      }
    }
  },
  "inputs": {
    "options": {
      "type": "Options"
    },
    "full_report": {
      "type": "Theory"
    },
    "theory_path": {
      "type": "Path"
    },
    "output_dir": {
      "type": "Path"
    }
  },
  "outputs": {
    "chapter_plan": {
      "type": "Plan",
      "value": {
        "ref": "flow.outputs.plan"
      }
    }
  },
  "operations": {
    "inventory_and_pack": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "full_report": {
          "type": "Theory"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "has_chapters": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_textbook_chapter_inventory",
          "operation": "mathformer_textbook_chapter_inventory"
        }
      }
    },
    "prepare_chapter": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "options": {
          "type": "Options"
        },
        "full_report": {
          "type": "Theory"
        },
        "output_dir": {
          "type": "Path"
        }
      },
      "outputs": {
        "prepared": {
          "type": "Prepared"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_textbook_chapter_prepare",
          "operation": "mathformer_textbook_chapter_prepare"
        }
      }
    },
    "run_objects": {
      "inputs": {
        "prepared": {
          "type": "Prepared"
        },
        "options": {
          "type": "Options"
        },
        "output_dir": {
          "type": "Path"
        }
      },
      "outputs": {
        "prepared": {
          "type": "Prepared"
        }
      },
      "execution": {
        "mode": "mixed",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_textbook_chapter_run",
          "operation": "mathformer_textbook_chapter_run"
        }
      }
    },
    "append_and_advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "prepared": {
          "type": "Prepared"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_textbook_chapter_advance",
          "operation": "mathformer_textbook_chapter_advance"
        }
      }
    },
    "write_plan": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "options": {
          "type": "Options"
        },
        "theory_path": {
          "type": "Path"
        },
        "output_dir": {
          "type": "Path"
        }
      },
      "outputs": {
        "plan": {
          "type": "Plan"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_textbook_chapter_write",
          "operation": "mathformer_textbook_chapter_write"
        }
      }
    },
    "empty_selection": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_textbook_chapter_empty",
          "operation": "mathformer_textbook_chapter_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "inventory",
        "kind": "call",
        "operation": "inventory_and_pack",
        "arguments": {
          "options": {
            "ref": "inputs.options"
          },
          "full_report": {
            "ref": "inputs.full_report"
          }
        }
      },
      {
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.inventory.outputs.state"
        },
        "max_iterations": 1000,
        "on_exhausted": "fail",
        "description": "One selected chapter per nonempty iteration; an empty inventory takes a pure identity adapter and stops without native chapter calls. At most 1000 units guarantee chapter exhaustion within 1000 iterations.",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "loop.state.has_chapters"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "prepare",
                    "kind": "call",
                    "operation": "prepare_chapter",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "options": {
                        "ref": "inputs.options"
                      },
                      "full_report": {
                        "ref": "inputs.full_report"
                      },
                      "output_dir": {
                        "ref": "inputs.output_dir"
                      }
                    }
                  },
                  {
                    "id": "run_or_queue",
                    "kind": "switch",
                    "cases": [
                      {
                        "id": "run",
                        "when": {
                          "ref": "steps.prepare.outputs.prepared.should_run"
                        },
                        "body": {
                          "kind": "sequence",
                          "steps": [
                            {
                              "kind": "call",
                              "operation": "run_objects",
                              "arguments": {
                                "prepared": {
                                  "ref": "steps.prepare.outputs.prepared"
                                },
                                "options": {
                                  "ref": "inputs.options"
                                },
                                "output_dir": {
                                  "ref": "inputs.output_dir"
                                }
                              },
                              "id": "run"
                            },
                            {
                              "id": "advance",
                              "kind": "call",
                              "operation": "append_and_advance",
                              "arguments": {
                                "state": {
                                  "ref": "loop.state"
                                },
                                "prepared": {
                                  "ref": "steps.run.outputs.prepared"
                                }
                              }
                            }
                          ],
                          "outputs": {
                            "state": {
                              "type": "State",
                              "value": {
                                "ref": "steps.advance.outputs.state"
                              }
                            },
                            "done": {
                              "type": "Flag",
                              "value": {
                                "ref": "steps.advance.outputs.done"
                              }
                            }
                          }
                        }
                      }
                    ],
                    "default": {
                      "id": "advance",
                      "kind": "call",
                      "operation": "append_and_advance",
                      "arguments": {
                        "state": {
                          "ref": "loop.state"
                        },
                        "prepared": {
                          "ref": "steps.prepare.outputs.prepared"
                        }
                      }
                    },
                    "outputs": {
                      "state": {
                        "type": "State",
                        "value": {
                          "ref": "selected.outputs.state"
                        }
                      },
                      "done": {
                        "type": "Flag",
                        "value": {
                          "ref": "selected.outputs.done"
                        }
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "State",
                    "value": {
                      "ref": "steps.run_or_queue.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Flag",
                    "value": {
                      "ref": "steps.run_or_queue.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "empty_selection",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "loop.state"
            }
          }
        },
        "id": "iterate"
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "write_plan",
        "arguments": {
          "state": {
            "ref": "steps.iterate.outputs.state"
          },
          "options": {
            "ref": "inputs.options"
          },
          "theory_path": {
            "ref": "inputs.theory_path"
          },
          "output_dir": {
            "ref": "inputs.output_dir"
          }
        }
      }
    ],
    "outputs": {
      "plan": {
        "type": "Plan",
        "value": {
          "ref": "steps.finalize.outputs.plan"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "textbook_source",
          "run_artifacts"
        ],
        "write": [
          "run_artifacts"
        ]
      },
      "network": [
        "configured_generation_provider"
      ],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "prepare_chapter_queues",
        "run_explicitly_selected_chapters",
        "record_gate_results"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion",
        "automatic_promotion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 3002
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked specification; completion establishes neither scientific truth nor promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
