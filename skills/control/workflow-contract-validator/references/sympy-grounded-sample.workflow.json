          "case": {
            "type": "string",
            "default": "formalphysics_0000"
          },
          "sympy_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning_log": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "GateState": {
      "schema": {
        "type": "object",
        "description": "Source-local evidence snapshot with an opaque server-owned module handle. Raw validator objects and the imported module remain in the same server process; modified, replayed and out-of-order states are rejected.",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reasoning_log": {
            "type": [
              "string",
              "null"
            ]
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "object"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "design_guard": {
            "type": "object"
          },
          "validation": {
            "type": "object"
          }
        },
        "required": [
          "case_id",
          "path",
          "reasoning_log",
          "module",
          "checks",
          "findings",
          "design_guard"
        ]
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "properties": {
          "style": {
            "const": "physics_sympy_grounded_sample_thoroughness"
          },
          "backend": {
            "const": "sympy"
          },
          "case_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "compiled_or_executed",
              "grounded_scaffold",
              "derivation_partial",
              "complete_sympy_physics_derivation",
              "blocked"
            ]
          },
          "artifact_path": {
            "type": "string"
          },
          "checks": {
            "type": "object"
          },
          "design_guard_summary": {
            "type": "object"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status_scale": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "style",
          "backend",
          "case_id",
          "status",
          "artifact_path",
          "checks",
          "design_guard_summary",
          "findings",
          "status_scale"
        ]
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    },
    "EmissionContext": {
      "schema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "handle"
        ],
        "additionalProperties": false,
        "description": "Single-use ownership handle for the original ordered native report. Transport canonicalization must not change source-owned JSON or log emission."
      }
    }
  },
  "inputs": {
    "request": {
      "type": "Request"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "steps.evaluate.outputs.report"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "steps.emit.outputs.exit_code"
      }
    }
  },
  "operations": {
