      "inputs": {
        "request": {
          "type": "Request"
        }
      },
      "outputs": {
        "state": {
          "type": "GateState"
        },
        "imported": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_grounded_import_state",
          "operation": "mathformer_sympy_grounded_import_state"
        }
      }
    },
    "blocked_report": {
      "inputs": {
        "state": {
          "type": "GateState"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        },
        "emission": {
          "type": "EmissionContext"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_grounded_blocked_report",
          "operation": "mathformer_sympy_grounded_blocked_report"
        }
      }
    },
    "inspect_validate": {
      "inputs": {
        "state": {
          "type": "GateState"
        }
      },
      "outputs": {
        "state": {
          "type": "GateState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_grounded_inspect_validate",
          "operation": "mathformer_sympy_grounded_inspect_validate"
        }
      }
    },
    "design_and_review": {
      "inputs": {
        "state": {
          "type": "GateState"
        }
      },
      "outputs": {
        "state": {
          "type": "GateState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_grounded_design_and_review",
          "operation": "mathformer_sympy_grounded_design_and_review"
        }
      }
    },
    "classify_report": {
      "inputs": {
        "state": {
          "type": "GateState"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        },
        "emission": {
          "type": "EmissionContext"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_grounded_classify_report",
          "operation": "mathformer_sympy_grounded_classify_report"
        }
      }
    },
    "emit": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "report": {
          "type": "Report"
        },
        "emission": {
          "type": "EmissionContext"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_sympy_grounded_emit",
          "operation": "mathformer_sympy_grounded_emit"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "import",
        "kind": "call",
        "operation": "import_state",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          }
        }
      },
      {
        "id": "evaluate",
        "kind": "switch",
        "cases": [
          {
            "id": "imported",
            "when": {
              "ref": "steps.import.outputs.imported"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "validate",
                  "kind": "call",
                  "operation": "inspect_validate",
                  "arguments": {
                    "state": {
                      "ref": "steps.import.outputs.state"
                    }
                  }
                },
                {
                  "id": "design_review",
                  "kind": "call",
                  "operation": "design_and_review",
                  "arguments": {
                    "state": {
                      "ref": "steps.validate.outputs.state"
                    }
                  }
                },
                {
                  "id": "classify",
                  "kind": "call",
                  "operation": "classify_report",
                  "arguments": {
                    "state": {
                      "ref": "steps.design_review.outputs.state"
                    }
                  }
                }
              ],
              "outputs": {
                "report": {
                  "type": "Report",
                  "value": {
                    "ref": "steps.classify.outputs.report"
                  }
                },
                "emission": {
                  "type": "EmissionContext",
                  "value": {
                    "ref": "steps.classify.outputs.emission"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "blocked_report",
          "arguments": {
            "state": {
              "ref": "steps.import.outputs.state"
            }
          }
        },
        "outputs": {
          "report": {
            "type": "Report",
            "value": {
              "ref": "selected.outputs.report"
            }
          },
          "emission": {
            "type": "EmissionContext",
            "value": {
              "ref": "selected.outputs.emission"
            }
          }
        }
      },
      {
        "id": "emit",
        "kind": "call",
        "operation": "emit",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          },
          "report": {
            "ref": "steps.evaluate.outputs.report"
          },
          "emission": {
            "ref": "steps.evaluate.outputs.emission"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.evaluate.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.emit.outputs.exit_code"
        }
      }
    }
  },
