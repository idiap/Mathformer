{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_sympy_grounded_sample_thoroughness_0000_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Import one SymPy artifact, collect grounded-thoroughness checks, classify and emit its report.",
  "aliases": [
