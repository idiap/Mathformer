      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "emission": {
      "type": "Emission",
      "value": {
        "ref": "flow.outputs.emission"
      }
    }
  },
  "operations": {
    "parse": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "args": {
          "type": "Args"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_parse",
          "operation": "mathformer_foundation_verify_parse"
        }
      }
    },
    "self_test": {
      "inputs": {
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "VerifyState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_self_test",
          "operation": "mathformer_foundation_verify_self_test"
        }
      }
    },
    "initialize": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "VerifyState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_initialize",
          "operation": "mathformer_foundation_verify_initialize"
        }
      }
    },
    "scan_next": {
      "inputs": {
        "state": {
          "type": "VerifyState"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "VerifyState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_scan_next",
          "operation": "mathformer_foundation_verify_scan_next"
        }
      }
    },
    "collect": {
      "inputs": {
        "state": {
          "type": "VerifyState"
        }
      },
      "outputs": {
        "structure": {
          "type": "Structure"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_collect",
          "operation": "mathformer_foundation_verify_collect"
        }
      }
    },
    "compile_index": {
      "inputs": {
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "index": {
          "type": "IndexResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_compile_index",
          "operation": "mathformer_foundation_verify_compile_index"
        }
      }
    },
    "skip_compile": {
      "inputs": {},
      "outputs": {
        "index": {
          "type": "IndexResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_skip_compile",
          "operation": "mathformer_foundation_verify_skip_compile"
        }
      }
    },
    "finalize": {
      "inputs": {
        "structure": {
          "type": "Structure"
        },
        "index": {
          "type": "IndexResult"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_finalize",
          "operation": "mathformer_foundation_verify_finalize"
        }
      }
    },
    "emit": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "report": {
          "type": "Report"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "emission": {
          "type": "Emission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_emit",
          "operation": "mathformer_foundation_verify_emit"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "state": {
          "type": "VerifyState"
        }
      },
      "outputs": {
        "state": {
          "type": "VerifyState"
        },
