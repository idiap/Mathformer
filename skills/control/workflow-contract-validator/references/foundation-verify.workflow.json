          "exit_code"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "repository_root",
          "allow_mutating"
        ],
        "properties": {
          "repository_root": {
            "type": "string",
            "minLength": 1
          },
          "allow_mutating": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "VerifyState": {
      "schema": {
        "type": "object",
        "required": [
          "scan",
          "done",
          "self_test_report"
        ],
        "properties": {
          "scan": {
            "type": "object",
            "required": [
              "paths",
              "cursor",
              "modules"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 256
              },
              "cursor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "modules": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 256,
                "description": "Ordered check_module results with path, ok, promotion_ready, blockers, warnings, declaration_comment_count."
              }
            },
            "additionalProperties": false
          },
          "done": {
            "type": "boolean"
          },
          "self_test_report": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
