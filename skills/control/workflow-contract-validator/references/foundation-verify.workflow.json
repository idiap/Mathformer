            "minimum": 0,
            "maximum": 256
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 256,
            "description": "Ordered check_module results with path, ok, promotion_ready, blockers, warnings, declaration_comment_count."
          }
        },
        "additionalProperties": false
      }
    },
    "Structure": {
      "schema": {
        "type": "object",
        "required": [
          "modules",
          "blockers"
        ],
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 256
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "IndexResult": {
      "schema": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "skipped": {
            "type": "boolean"
          },
          "module": {
            "type": "string"
          },
          "returncode": {
            "type": "integer"
          },
          "stdout_tail": {
            "type": "string"
          },
          "stderr_tail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "style",
          "module_count",
          "ok",
          "promotion_ready_count",
          "modules",
          "accepted_index_compile",
          "blockers",
          "terminal_state"
        ],
        "properties": {
          "style": {
            "const": "physics_foundation_verification_report"
          },
          "module_count": {
            "type": "integer",
            "minimum": 0
          },
          "ok": {
            "type": "boolean"
          },
          "promotion_ready_count": {
            "type": "integer",
            "minimum": 0
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 256
          },
          "accepted_index_compile": {
            "type": "object"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terminal_state": {
            "enum": [
              "verification_passed",
              "verification_blocked"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "Emission": {
      "schema": {
        "type": "object",
        "required": [
