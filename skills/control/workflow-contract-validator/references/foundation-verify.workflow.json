          "target": "mathformer_foundation_verify_retain_empty",
          "operation": "mathformer_foundation_verify_retain_empty"
        }
      }
    },
    "self_test_report": {
      "inputs": {
        "state": {
          "type": "VerifyState"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_foundation_verify_self_test_report",
          "operation": "mathformer_foundation_verify_self_test_report"
        }
      }
    }
