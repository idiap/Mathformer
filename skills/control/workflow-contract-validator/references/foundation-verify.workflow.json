        "maxItems": 256,
        "description": "Native main argv; specialization admits at most 256 tokens and at most 256 selected modules, including defaults."
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Args": {
      "schema": {
        "type": "object",
        "required": [
