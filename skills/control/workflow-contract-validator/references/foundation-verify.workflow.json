  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "switch",
        "cases": [
          {
            "id": "self_test",
            "when": {
              "ref": "steps.parse.outputs.args.self_test"
            },
            "body": {
              "kind": "call",
              "operation": "self_test",
              "arguments": {
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "initialize",
          "arguments": {
            "args": {
              "ref": "steps.parse.outputs.args"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "outputs": {
          "state": {
            "type": "VerifyState",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "modules",
        "kind": "loop",
        "state_type": "VerifyState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "empty_or_self_test",
              "when": {
                "ref": "loop.state.done"
              },
              "body": {
                "kind": "call",
                "operation": "retain_empty",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "scan_next",
            "arguments": {
              "state": {
                "ref": "loop.state"
              },
              "context": {
                "ref": "inputs.context"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "VerifyState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 256,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "VerifyState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "verify",
        "kind": "switch",
        "cases": [
          {
            "id": "self_test",
            "when": {
              "ref": "steps.parse.outputs.args.self_test"
            },
            "body": {
              "kind": "call",
              "operation": "self_test_report",
              "arguments": {
                "state": {
                  "ref": "steps.modules.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "collect",
              "arguments": {
                "state": {
                  "ref": "steps.modules.outputs.state"
                }
              },
              "id": "collect"
            },
            {
              "id": "index",
              "kind": "switch",
              "cases": [
                {
                  "id": "skip",
                  "when": {
                    "ref": "steps.parse.outputs.args.skip_index_compile"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "skip_compile",
                    "arguments": {}
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "compile_index",
                "arguments": {
                  "context": {
                    "ref": "inputs.context"
                  }
                }
              },
              "outputs": {
                "index": {
                  "type": "IndexResult",
                  "value": {
                    "ref": "selected.outputs.index"
                  }
                }
              }
            },
            {
              "id": "finalize",
              "kind": "call",
              "operation": "finalize",
              "arguments": {
                "structure": {
                  "ref": "steps.collect.outputs.structure"
                },
                "index": {
                  "ref": "steps.index.outputs.index"
                }
              }
            }
          ],
          "outputs": {
            "report": {
              "type": "Report",
              "value": {
                "ref": "steps.finalize.outputs.report"
              }
            }
          }
        },
        "outputs": {
          "report": {
            "type": "Report",
            "value": {
              "ref": "selected.outputs.report"
            }
          }
        }
      },
      {
        "id": "emit",
        "kind": "call",
        "operation": "emit",
        "arguments": {
          "args": {
            "ref": "steps.parse.outputs.args"
          },
          "report": {
            "ref": "steps.verify.outputs.report"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.verify.outputs.report"
        }
      },
      "emission": {
        "type": "Emission",
        "value": {
          "ref": "steps.emit.outputs.emission"
        }
      }
    }
  },
