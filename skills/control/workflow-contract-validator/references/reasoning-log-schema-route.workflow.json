    "mathformer.native_boundary": {
      "execution": "MCP ports call the shared native run_intent_match steps. run_action remains authoritative for its complete action boundary; Lunar executes the typed outer graph.",
      "failure_policy": "Preserve native failed child payloads and aggregate route failure; unexpected controller exceptions propagate.",
      "limits": "Five modeled operation calls, at most one subprocess, no retry or convergence loop.",
      "bound_behavior": "done is true at the first iteration; native return is normal even for failed child results, so exhaustion is unreachable."
