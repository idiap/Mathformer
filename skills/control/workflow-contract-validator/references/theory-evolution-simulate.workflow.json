        "digest": "sha256:f44e80b65b7c4111f5a98919a09fee6ac76ab1cc9ef87c4ed0aeaf4e58788de1"
      },
      {
        "path": "scripts/theory_evolution_simulate_tools.py",
        "digest": "sha256:93c48685bbcc186a986b10be91729964cca40fc712716230b12f7191c5699a88"
      },
      {
        "path": "scripts/mcp_server.py",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer_mcp_service.py",
        "digest": "sha256:ff2a57a3dc268e73d31e34605d80a65a5bdc6e16e28ad41af5752ad8bae60164"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Input specialization: runs<=64, phases<=16, duration_steps<=256; native source has no upper caps. Nonpositive runs still fail during aggregation; empty phase ranges skip updates.",
      "The expanded MCP graph exposes the scientific CLI body. Hub preflight, dry-run, subprocess capture, 1200-second timeout and post-launch write audit remain at the owning hub boundary, not graph operations. MCP uses service write guards and Lunar budgets.",
      "File payloads are materialized by context.model_path and verified against the supplied model. Relative paths resolve in context.working_directory. Native stdout is emitted to MCP stderr and returned as stdout; failures propagate as rejected calls.",
      "Empty ranges traverse one identity adapter cycle because v1 loops are post-tested. Adapters inspect pending before invoking native initialization, phase entry, update, phase advancement or classification. No native scientific step executes for an empty range."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "paper:theory-evolution-simulate",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "paper:theory-evolution-simulate",
        "summary": "Run one theory-evolution simulation; pass model/output arguments after `--`.",
        "family": "paper",
        "kind": "generation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "paper_skills/theory-evolution-simulator/scripts/simulate_theory_evolution.py"
        ],
        "depends_on": [],
        "writes": [
          "artifacts/paper_skills/"
        ],
        "allows_extra_args": true,
        "timeout_seconds": 1200
      }
    },
    "mathformer.native_boundary": {
      "execution": "Existing hub subprocess remains available; expanded tools execute shared source functions under the MCP service write guard.",
      "failure_policy": "Nonzero exit or 1200-second subprocess timeout yields hub ok=false; post-launch undeclared writes also set ok=false/status=undeclared_writes. Do not infer scientific acceptance from process or hub completion.",
      "effects_status": "partial_native_declarations",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "scientific_payloads": "Result models main's successful payload, not the native HubResult transport envelope."
    },
    "mathformer.bounds": {
      "semantics": "Ordered post-tested loops; empty ranges traverse guarded identity adapters without native work. pending=false at exact caps; exhaustion fails. Nonpositive runs fail in native summarize.",
      "budgets": "3600 seconds and 264322 operation calls are descriptor ceilings, not source budgets. The native subprocess timeout is 1200 seconds. No additional scientific stopping rule or checkpoint is implied."
    }
  }
