    "gaps": [
      "Helper traversals remain in native operations; bounds are fixture concepts and occurrences, configured targets and API terms, findings and sorted Lean files. No retry, repair execution or convergence loop exists.",
      "Payload types preserve native packets without encoding all nested fields. Completion projects the native payload and exit code.",
      "Hub admission/preflight, dry-run, subprocess and write auditing remain with the native hub. Direct MCP step tools expose the CLI workflow separately and do not impersonate hub admission; writes use service write policy and configured roots.",
      "The retained 3600-second and seven-call budgets are enforced by Lunar. The native CLI itself has no timeout. Native stdout is routed to MCP stderr to preserve stdio protocol."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "mathformerphysicslib:coherence-inventory",
      "owner_skill": "skills/mathformerphysicslib/mathformerphysicslib-coherence-inventory-builder/SKILL.md",
      "contract": {
        "id": "mathformerphysicslib:coherence-inventory",
        "summary": "Smoke-test MathformerPhysicsLib coherence inventory construction.",
        "family": "mathformerphysicslib",
        "kind": "validation",
        "safety": "read_only",
        "command": [
          "{python}",
          "skills/mathformerphysicslib/mathformerphysicslib-coherence-inventory-builder/scripts/build_coherence_inventory.py",
          "--self-test",
          "--json"
        ],
        "depends_on": [],
        "writes": [],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Native hub control remains unchanged. MCP step adapters share implementation with main and self_test_payload; they execute deterministically without providers or proof processes.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "failure_policy": "Assertion or uncaught I/O errors fail execution; main returns zero after normal JSON emission even if gate.status is blocked.",
      "invocation": "The registered action always supplies --self-test --json and no output path. Argv models main's CLI separately; native action accepts no extra arguments.",
      "callers": [
        "coherence-suite sequence",
        "physics-lib:coherence-inventory alias",
        "test-matrix smoke test"
      ]
    }
  }
}
