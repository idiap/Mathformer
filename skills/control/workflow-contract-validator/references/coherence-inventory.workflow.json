{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_mathformerphysicslib_coherence_inventory_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Run the native coherence inventory CLI as callable shared steps: select self-test or repository inventory, optionally write JSON, always emit JSON and return zero on normal completion.",
  "aliases": [
    "mathformerphysicslib:coherence-inventory"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Native main(argv) arguments; the hub supplies exactly --self-test --json."
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "properties": {
          "self_test": {
            "type": "boolean"
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "json": {
            "type": "boolean"
          }
        },
        "required": [
          "self_test",
          "output",
          "json"
        ],
        "additionalProperties": false
      }
    },
    "Inventory": {
      "schema": {
        "type": "object",
        "description": "Inventory packet with concept_occurrence_index and integration flags; repository branch also contains modules and declaration counts."
      }
    },
    "Graph": {
      "schema": {
        "type": "object",
        "description": "Canonical concept graph: concepts, owner status, targets, API terms and ambiguity counts."
      }
    },
    "Grounding": {
      "schema": {
        "type": "object",
        "description": "Per-concept Mathlib grounding, failed candidates and level counters."
      }
    },
    "Critics": {
      "schema": {
        "type": "object",
        "description": "Ordered redefinition, integration and API report bundle, including findings and reuse metrics."
      }
    },
    "Payload": {
      "schema": {
        "type": "object",
        "description": "Either repository inventory or self-test {ok, graph, grounding, repair, gate, generative}; blockers remain report data."
      }
    },
    "Completion": {
      "schema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object"
          },
          "exit_code": {
            "const": 0,
            "type": "integer"
          }
        },
        "required": [
          "payload",
          "exit_code"
        ],
        "additionalProperties": false
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": "string",
        "description": "Repository filesystem context; native default is the Mathformer checkout. Inventory retains the native MathformerPhysicsLib path; API reads owner paths relative to this root."
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    }
  },
  "outputs": {
    "result": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "parse": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "options": {
          "type": "Options"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_parse",
          "operation": "mathformer_coherence_inventory_parse"
        }
      }
    },
    "fixture": {
      "inputs": {},
      "outputs": {
        "inventory": {
          "type": "Inventory"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_fixture",
          "operation": "mathformer_coherence_inventory_fixture"
        }
      }
    },
    "canonicalize": {
      "inputs": {
        "inventory": {
          "type": "Inventory"
        }
      },
      "outputs": {
        "graph": {
          "type": "Graph"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_canonicalize",
          "operation": "mathformer_coherence_inventory_canonicalize"
        }
      }
    },
    "grounding": {
      "inputs": {
        "graph": {
          "type": "Graph"
        }
      },
      "outputs": {
        "grounding": {
          "type": "Grounding"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_grounding",
          "operation": "mathformer_coherence_inventory_grounding"
        }
      }
    },
    "critics": {
      "inputs": {
        "inventory": {
          "type": "Inventory"
        },
        "graph": {
          "type": "Graph"
        },
        "grounding": {
          "type": "Grounding"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "critics": {
          "type": "Critics"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_critics",
          "operation": "mathformer_coherence_inventory_critics"
        }
      }
    },
    "finish": {
      "inputs": {
        "graph": {
          "type": "Graph"
        },
        "grounding": {
          "type": "Grounding"
        },
        "critics": {
          "type": "Critics"
        }
      },
      "outputs": {
        "payload": {
          "type": "Payload"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_finish",
          "operation": "mathformer_coherence_inventory_finish"
        }
      }
    },
    "inventory": {
      "inputs": {
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "payload": {
          "type": "Payload"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_inventory",
          "operation": "mathformer_coherence_inventory_inventory"
        }
      }
    },
    "emit": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "payload": {
          "type": "Payload"
        }
      },
      "outputs": {
        "result": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_inventory_emit",
          "operation": "mathformer_coherence_inventory_emit"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "select_payload",
        "kind": "switch",
        "cases": [
          {
            "id": "self_test",
            "when": {
              "ref": "steps.parse.outputs.options.self_test"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "fixture",
                  "kind": "call",
                  "operation": "fixture",
                  "arguments": {}
                },
                {
                  "id": "canonicalize",
                  "kind": "call",
                  "operation": "canonicalize",
                  "arguments": {
                    "inventory": {
                      "ref": "steps.fixture.outputs.inventory"
                    }
                  }
                },
                {
                  "id": "grounding",
                  "kind": "call",
                  "operation": "grounding",
                  "arguments": {
                    "graph": {
                      "ref": "steps.canonicalize.outputs.graph"
                    }
                  }
                },
                {
                  "id": "critics",
                  "kind": "call",
                  "operation": "critics",
                  "arguments": {
                    "inventory": {
                      "ref": "steps.fixture.outputs.inventory"
                    },
                    "graph": {
                      "ref": "steps.canonicalize.outputs.graph"
                    },
                    "grounding": {
                      "ref": "steps.grounding.outputs.grounding"
                    },
                    "repository_root": {
                      "ref": "inputs.repository_root"
                    }
                  },
                  "description": "Findings and reuse metrics accumulate over concepts and occurrences. Integration also checks the actual foundation index. API reads foundation owner text and matches configured API terms; high/low API findings remain data."
                },
                {
                  "id": "finish",
                  "kind": "call",
                  "operation": "finish",
                  "arguments": {
                    "graph": {
                      "ref": "steps.canonicalize.outputs.graph"
                    },
                    "grounding": {
                      "ref": "steps.grounding.outputs.grounding"
                    },
                    "critics": {
                      "ref": "steps.critics.outputs.critics"
                    }
                  },
                  "description": "Report/finding traversals accumulate repair actions and high/medium severity counts. Gate is blocked if high>0, warn if only medium>0, otherwise accepted. Build seven advisory probes as data; invoke no model or repair. Assert two concepts, nonempty grounding and failed candidates, duplicate ownership finding, one healthy reuse, seven structured prompts and evidence-only blocking policy."
                }
              ],
              "outputs": {
                "payload": {
                  "type": "Payload",
                  "value": {
                    "ref": "steps.finish.outputs.payload"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "inventory",
          "arguments": {
            "repository_root": {
              "ref": "inputs.repository_root"
            }
          }
        },
        "outputs": {
          "payload": {
            "type": "Payload",
            "value": {
              "ref": "selected.outputs.payload"
            }
          }
        }
      },
      {
        "id": "emit",
        "kind": "call",
        "operation": "emit",
        "arguments": {
          "options": {
            "ref": "steps.parse.outputs.options"
          },
          "payload": {
            "ref": "steps.select_payload.outputs.payload"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Completion",
        "value": {
          "ref": "steps.emit.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository"
        ],
        "write": [
          "requested_output_path",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "inspect_repository",
        "construct_advisory_reports",
        "write_requested_json",
        "emit_json"
      ],
      "forbidden": [
        "execute_repairs",
        "invoke_model",
        "promote_scientific_claims",
        "bypass_native_controls"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 7
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Self-test completion and advisory coherence data only; no proof, promotion or model execution."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
