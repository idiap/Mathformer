  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "load",
        "kind": "call",
        "operation": "load_and_pack",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "select",
        "kind": "loop",
        "state_type": "BatchState",
        "initial": {
          "ref": "steps.load.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "write_next_source",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "BatchState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "ground",
        "kind": "call",
        "operation": "build_grounding",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "compile",
        "kind": "loop",
        "state_type": "BatchState",
        "initial": {
          "ref": "steps.select.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "compile_next",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "BatchState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "review",
        "kind": "loop",
        "state_type": "BatchState",
        "initial": {
          "ref": "steps.compile.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "review_next",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "BatchState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "completeness",
        "kind": "loop",
        "state_type": "BatchState",
        "initial": {
          "ref": "steps.review.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "check_next",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "grounding": {
              "ref": "steps.ground.outputs.grounding"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "BatchState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "guards",
        "kind": "call",
        "operation": "compute_guards",
        "arguments": {
          "state": {
            "ref": "steps.completeness.outputs.state"
          },
          "grounding": {
            "ref": "steps.ground.outputs.grounding"
          }
        }
      },
      {
        "id": "classify",
        "kind": "switch",
        "cases": [
          {
            "id": "blocked",
            "when": {
              "ref": "steps.guards.outputs.guards.target_restating"
            },
            "body": {
              "kind": "call",
              "operation": "return_status",
              "arguments": {
                "status": {
                  "literal": "blocked_target_restating_assumption"
                }
              }
            }
          },
          {
            "id": "partial",
            "when": {
              "ref": "steps.guards.outputs.guards.partial"
            },
            "body": {
              "kind": "call",
              "operation": "return_status",
              "arguments": {
                "status": {
                  "literal": "derivation_partial"
                }
              }
            }
          },
          {
            "id": "complete",
            "when": {
              "ref": "steps.guards.outputs.guards.all_complete"
            },
            "body": {
              "kind": "call",
              "operation": "return_status",
              "arguments": {
                "status": {
                  "literal": "complete_autoformalization"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "return_status",
          "arguments": {
            "status": {
              "literal": "grounded_scaffold"
            }
          }
        },
        "outputs": {
          "status": {
            "type": "Status",
            "value": {
              "ref": "selected.outputs.status"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "write_reports",
        "arguments": {
          "state": {
            "ref": "steps.completeness.outputs.state"
          },
          "grounding": {
            "ref": "steps.ground.outputs.grounding"
          },
          "status": {
            "ref": "steps.classify.outputs.status"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "RunReport",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      },
      "recursive_plan": {
        "type": "GroundingPlan",
        "value": {
          "ref": "steps.finish.outputs.recursive_plan"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.finish.outputs.exit_code"
        }
      }
    }
  },
