{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_family_lean_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Lean matrix traversal and report publication under the native hub boundary.",
  "aliases": [
    "test:family:lean"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Args": {
      "schema": {
        "type": "object",
        "required": [
          "module_family",
          "profile",
          "emit_dependency_map_only",
          "fail_on_warning",
          "changed_files_only",
          "validate_matrix",
          "json"
        ],
        "properties": {
          "module_family": {
            "const": [
              "lean"
            ]
          },
          "profile": {
            "const": "workstation"
          },
          "emit_dependency_map_only": {
            "type": "boolean",
            "const": false
          },
          "fail_on_warning": {
            "const": false
          },
          "changed_files_only": {
            "const": false
          },
          "validate_matrix": {
            "const": false
          },
          "json": {
            "const": true
          }
        },
        "description": "Parsed fixed hub invocation; other fields retain parse_args defaults.",
        "additionalProperties": false
      }
    },
    "Domain": {
      "schema": {
        "type": "object",
        "required": [
          "max_selected_rows"
        ],
        "properties": {
          "max_selected_rows": {
            "type": "integer",
            "const": 4096
          }
        },
        "additionalProperties": false,
        "description": "Input precondition that canonical Lean selection has at most 4096 rows."
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "matrix",
          "selected",
          "families",
          "index",
          "results"
        ],
        "properties": {
          "matrix": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "results": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "run_id",
          "families",
          "summary",
          "results",
          "schema_errors",
          "matrix_errors"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "run_id": {
            "type": "string"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schema_errors": {
            "type": "array"
          },
          "matrix_errors": {
            "type": "array"
          }
        }
      }
    },
    "Exit": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "handle"
        ],
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "args": {
      "type": "Args"
    },
    "domain": {
      "type": "Domain"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "exit_code": {
      "type": "Exit",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "enter": {
      "inputs": {
        "args": {
          "type": "Args"
        }
      },
      "outputs": {
        "snapshot_only": {
          "type": "Bool"
        },
        "context": {
          "type": "Context"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_enter",
          "operation": "mathformer_lean_family_enter"
        }
      }
    },
    "snapshot": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_snapshot",
          "operation": "mathformer_lean_family_snapshot"
        }
      }
    },
    "prepare": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "domain": {
          "type": "Domain"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_prepare",
          "operation": "mathformer_lean_family_prepare"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_advance",
          "operation": "mathformer_lean_family_advance"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_finalize",
          "operation": "mathformer_lean_family_finalize"
        }
      }
    },
    "publish": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "Exit"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_publish",
          "operation": "mathformer_lean_family_publish"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_lean_family_retain_empty",
          "operation": "mathformer_lean_family_retain_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "enter",
        "kind": "call",
        "operation": "enter",
        "arguments": {
          "args": {
            "ref": "inputs.args"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "domain": {
            "ref": "inputs.domain"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "checks",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "max_iterations": 4096,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "empty",
              "when": {
                "ref": "steps.prepare.outputs.done"
              },
              "body": {
                "id": "retain",
                "kind": "call",
                "operation": "retain_empty",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "args": {
                    "ref": "inputs.args"
                  },
                  "context": {
                    "ref": "steps.enter.outputs.context"
                  }
                }
              }
            }
          ],
          "default": {
            "id": "advance",
            "kind": "call",
            "operation": "advance",
            "arguments": {
              "state": {
                "ref": "loop.state"
              },
              "args": {
                "ref": "inputs.args"
              },
              "context": {
                "ref": "steps.enter.outputs.context"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.checks.outputs.state"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.finalize.outputs.report"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "exit_code": {
        "type": "Exit",
        "value": {
          "ref": "steps.publish.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 4100
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description only; no scientific result or runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
