      "category": "hub",
      "native_id": "test:family:lean",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "test:family:lean",
        "family": "lean",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/test_program/run_comprehensive_tests.py",
          "--module-family",
          "lean",
          "--json"
        ],
        "depends_on": [],
        "allows_extra_args": false,
        "timeout_seconds": 900,
        "writes": [
          "artifacts/"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "main -> parse_args -> run -> publish_report; invoked only after native hub preflight. Dry-run does not run the runner.",
      "failure_policy": "Preserve failed preflight, subprocess exit and write-audit status; never convert to acceptance.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true
    }
