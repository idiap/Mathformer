                },
                "state_json": {
                  "ref": "steps.policies.outputs.state_json"
                }
              }
            },
            {
              "id": "status",
              "kind": "switch",
              "cases": [
                {
                  "id": "unnecessary",
                  "when": {
                    "ref": "steps.assess.outputs.assessment.not_required"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "assign_status",
                    "arguments": {
                      "value": {
                        "literal": "not_required"
                      }
                    }
                  }
                },
                {
                  "id": "outstanding",
                  "when": {
                    "ref": "steps.assess.outputs.assessment.has_outstanding"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "assign_status",
                    "arguments": {
                      "value": {
                        "literal": "needs_expansion"
                      }
                    }
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "assign_status",
                "arguments": {
                  "value": {
                    "literal": "complete"
                  }
                }
              },
              "outputs": {
                "status": {
                  "type": "Status",
                  "value": {
                    "ref": "selected.outputs.status"
