{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_mathformerphysicslib_coherence_suite_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Ordered nine-child MathformerPhysicsLib coherence smoke suite.",
  "aliases": [
    "mathformerphysicslib:coherence-suite"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../coherence-suite-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../coherence-suite-interface.schema.json#/$defs/HubResult"
    },
    "Strings": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "Admission": {
      "schema": {
        "type": "object",
        "required": [
          "accepted",
          "status",
          "ancestry"
        ],
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "unknown_action",
              "dependency_cycle",
              "extra_args_for_sequence"
            ]
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "DependencyState": {
      "schema": {
        "type": "object",
        "required": [
          "index",
          "children",
          "dependencies_ok",
          "ancestry"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "children": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "object"
            }
          },
          "dependencies_ok": {
            "type": "boolean"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "extra_args": {
      "type": "Strings",
      "required": false
    },
    "seen": {
      "type": "Strings",
      "required": false
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "admit": {
      "inputs": {
        "extra_args": {
          "type": "Strings",
          "required": false
        },
        "seen": {
          "type": "Strings",
          "required": false
        }
      },
      "outputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_admit",
          "operation": "mathformer_coherence_suite_admit"
        }
      }
    },
    "reject": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_reject",
          "operation": "mathformer_coherence_suite_reject"
        }
      }
    },
    "initialize": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_initialize",
          "operation": "mathformer_coherence_suite_initialize"
        }
      }
    },
    "visit": {
      "inputs": {
        "context": {
          "type": "RunContext"
        },
        "state": {
          "type": "DependencyState"
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_visit",
          "operation": "mathformer_coherence_suite_visit"
        }
      }
    },
    "advance": {
      "inputs": {
        "context": {
          "type": "RunContext"
        },
        "state": {
          "type": "DependencyState"
        },
        "child": {
          "type": "HubResult"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_advance",
          "operation": "mathformer_coherence_suite_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_finish",
          "operation": "mathformer_coherence_suite_finish"
        }
      }
    },
    "carry": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        },
        "result": {
          "type": "HubResult"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        },
        "done": {
          "type": "Boolean"
        },
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_suite_carry",
          "operation": "mathformer_coherence_suite_carry"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "admission",
        "kind": "call",
        "operation": "admit",
        "arguments": {
          "extra_args": {
            "ref": "inputs.extra_args"
          },
          "seen": {
            "ref": "inputs.seen"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "initial",
                  "kind": "call",
                  "operation": "initialize",
                  "arguments": {
                    "admission": {
                      "ref": "steps.admission.outputs.admission"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "DependencyState",
                  "value": {
                    "ref": "steps.initial.outputs.state"
                  }
                },
                "rejection": {
                  "type": "HubResult",
                  "value": {
                    "literal": {
                      "ok": true
                    }
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "reject",
              "arguments": {
                "admission": {
                  "ref": "steps.admission.outputs.admission"
                }
              },
              "id": "rejection"
            }
          ],
          "outputs": {
            "state": {
              "type": "DependencyState",
              "value": {
                "literal": {
                  "index": 0,
                  "children": [],
                  "dependencies_ok": true,
                  "ancestry": []
                }
              }
            },
            "rejection": {
              "type": "HubResult",
              "value": {
                "ref": "steps.rejection.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "DependencyState",
            "value": {
              "ref": "selected.outputs.state"
            }
          },
          "rejection": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.rejection"
            }
          }
        }
      },
      {
        "id": "dependencies",
        "kind": "loop",
        "state_type": "DependencyState",
        "initial": {
          "ref": "steps.dispatch.outputs.state"
        },
        "max_iterations": 9,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "accepted",
              "when": {
                "ref": "steps.admission.outputs.admission.accepted"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "child",
                    "kind": "call",
                    "operation": "visit",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "context": {
                        "ref": "inputs.context"
                      }
                    }
                  },
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "child": {
                        "ref": "steps.child.outputs.child"
                      },
                      "context": {
                        "ref": "inputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "DependencyState",
                    "value": {
                      "ref": "steps.advance.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Boolean",
                    "value": {
                      "ref": "steps.advance.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "kind": "call",
                "operation": "carry",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "result": {
                    "ref": "steps.dispatch.outputs.rejection"
                  }
                },
                "id": "carry"
              }
            ],
            "outputs": {
              "state": {
                "type": "DependencyState",
                "value": {
                  "ref": "steps.carry.outputs.state"
                }
              },
              "done": {
                "type": "Boolean",
                "value": {
                  "ref": "steps.carry.outputs.done"
                }
              }
            }
          },
          "outputs": {
            "state": {
              "type": "DependencyState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "DependencyState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "completion",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "id": "completion",
              "kind": "call",
              "operation": "finish",
              "arguments": {
                "state": {
                  "ref": "steps.dependencies.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "carry",
              "arguments": {
                "state": {
                  "ref": "steps.dispatch.outputs.state"
                },
                "result": {
                  "ref": "steps.dispatch.outputs.rejection"
                }
              },
              "id": "carry"
            }
          ],
          "outputs": {
            "result": {
              "type": "HubResult",
              "value": {
                "ref": "steps.carry.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.completion.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 22
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description only; completion establishes no scientific result or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "scripts/mathformer.py",
        "selector": "run_action (suite defined in build_registry)",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
