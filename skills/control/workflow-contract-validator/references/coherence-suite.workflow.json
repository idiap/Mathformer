        "selector": "register_coherence_suite_tools",
        "digest": "sha256:f01f545deae5fdef5acfcfc30fafa39bc7059e66b3184a29f41fb336f3345ace"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_coherence_suite_tools(mcp)",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer_mcp_service.py",
        "selector": "mcp_tools",
        "digest": "sha256:ff2a57a3dc268e73d31e34605d80a65a5bdc6e16e28ad41af5752ad8bae60164"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "inventory",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      },
      {
        "path": "skills/control/workflow-contract-validator/references/normalized-workflows/coherence-suite-interface.schema.json",
        "digest": "sha256:4a91ca964de2b06ef6a6bbadce40eb2035d079c9978e4612b135839c0a052bf5",
        "selector": "$defs"
      }
    ],
    "gaps": [
      "Leaf helper internals remain inside visit; child result dictionaries are opaque in carried state.",
      "The 3600-second and 22-call limits are Lunar normalization bounds, not native timeouts or native budgets.",
      "Network/external effects require qualification; mandatory receipts do not upgrade optional native logs.",
      "Fixed suite specialization makes unknown-action admission unreachable through this interface."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "mathformerphysicslib:coherence-suite",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "family": "mathformerphysicslib",
      "kind": "sequence",
      "safety": "read_only"
    },
    "mathformer.composition": {
      "ordered_dependencies": [
        "mathformerphysicslib:coherence-inventory",
        "mathformerphysicslib:concept-canonicalize",
        "mathformerphysicslib:mathlib-grounding-audit",
        "mathformerphysicslib:redefinition-critic",
        "mathformerphysicslib:integration-critic",
        "mathformerphysicslib:api-operability-critic",
        "mathformerphysicslib:generative-coherence-critic",
        "mathformerphysicslib:coherence-repair-plan",
        "mathformerphysicslib:coherence-gate"
      ],
      "command_after_dependencies": false,
      "child_mode": "Independent --self-test --json subprocesses, executed sequentially."
    },
    "mathformer.native_boundary": {
      "admission": "Unknown action, cycle, then sequence extra-argument checks; rejection returns failure data without children.",
      "leaf": "Required paths/tools and argument/mutation preflight; errors return without launch, dry-run returns argv, otherwise capture subprocess output/status and audit changes. Undeclared writes force failure.",
      "failure": "Child ok=false is data consumed by advance; continued successes never restore aggregate success. Unexpected launch exceptions propagate.",
      "timeout_seconds": null,
      "bound_behavior": "Exactly nine registered children; the ninth advance returns done=true and finishes normally, including when aggregate ok=false.",
      "callers": "CLI run and run_intent_match via physics-lib:coherence-suite; MCP normalized IDs dispatch through mathformer_run_workflow, mathformer_run_action and hub.run_action under service controls.",
      "separate_report": "The natural-language coherence route schedules coherence-loop-report afterward; this suite never calls it.",
      "execution": "Registered mathformer_coherence_suite_* tools call the shared native helpers with build_registry and the full RunContext. Transport-only carry returns rejection unchanged; the top-level loop avoids Lunar scoped-exit limitations."
    }
  }
}
