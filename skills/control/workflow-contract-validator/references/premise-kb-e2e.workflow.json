        "membership.membership.probably_present and group.inverse_product_reverse_order in membership.membership.resolved_entry_ids",
        "not absent.membership.probably_present",
        "any search hit ID in {group.inverse_triple_product_reverse_order, vampire.group_inverse_of_triple_product_reverses_order, group.inverse_product_reverse_order}",
        "all search hits contain cosine_distance",
        "0 <= distance.distance.cosine_distance <= 1",
        "promote.entry.status == reviewed_informal",
        "reject.entry.status == rejected",
        "report.entry_count >= 7 and report.rejected_count >= 1"
      ],
      "iteration": "No workflow loop or refinement; comprehensions and any/all only inspect returned hits and assertions.",
      "exit": "All CLI operations precede assertion aggregation. False assertions still print results then exit 3; all true exit 0. Assertion failure is not an early gate."
