{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_kb_e2e_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Reset the premise KB, execute the fixed regression sequence, aggregate assertions, print results and return 0 or 3.",
  "aliases": [
    "kb:e2e"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Request": {
      "schema": {
        "type": "object",
        "properties": {
          "kb_root": {
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "artifact_root": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "properties": {
          "kb_root": {
            "type": "string"
          },
          "absolute_root": {
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "responses": {
            "type": "object"
          },
          "artifact_root": {
            "type": "string"
          }
        },
        "required": [
          "kb_root",
          "absolute_root",
          "json",
          "responses",
          "artifact_root"
        ],
        "additionalProperties": false
      }
    },
    "Payload": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "kb_root": {
            "type": "string"
          },
          "assertions": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "top_hit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "distance": {
            "type": "object"
          },
          "report": {
            "type": "object"
          }
        },
        "required": [
          "ok",
          "kb_root",
          "assertions",
          "top_hit_ids",
          "distance",
          "report"
        ],
        "additionalProperties": false
      }
    },
    "Result": {
      "schema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object"
          },
          "stdout": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer",
            "enum": [
              0,
              3
            ]
          }
        },
        "required": [
          "payload",
          "stdout",
          "exit_code"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "request": {
      "type": "Request"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "request": {
          "type": "Request"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_e2e_prepare",
          "operation": "mathformer_kb_e2e_prepare"
        }
      }
    },
    "populate": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_e2e_populate",
          "operation": "mathformer_kb_e2e_populate"
        }
      }
    },
    "query": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_e2e_query",
          "operation": "mathformer_kb_e2e_query"
        }
      }
    },
    "update_report": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_e2e_update_report",
          "operation": "mathformer_kb_e2e_update_report"
        }
      }
    },
    "assess": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "payload": {
          "type": "Payload"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_e2e_assess",
          "operation": "mathformer_kb_e2e_assess"
        }
      }
    },
    "emit": {
      "inputs": {
        "payload": {
          "type": "Payload"
        },
        "format": {
          "type": "Request"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_e2e_emit",
          "operation": "mathformer_kb_e2e_emit"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          }
        }
      },
      {
        "id": "populate",
        "kind": "call",
        "operation": "populate",
        "arguments": {
          "state": {
            "ref": "steps.prepare.outputs.state"
          }
        }
      },
      {
        "id": "query",
        "kind": "call",
        "operation": "query",
        "arguments": {
          "state": {
            "ref": "steps.populate.outputs.state"
          }
        }
      },
      {
        "id": "update_report",
        "kind": "call",
        "operation": "update_report",
        "arguments": {
          "state": {
            "ref": "steps.query.outputs.state"
          }
        }
      },
      {
        "id": "assess",
        "kind": "call",
        "operation": "assess",
        "arguments": {
          "state": {
            "ref": "steps.update_report.outputs.state"
          }
        }
      },
      {
        "id": "output",
        "kind": "switch",
        "cases": [
          {
            "id": "json",
            "when": {
              "ref": "steps.update_report.outputs.state.json"
            },
            "body": {
              "kind": "call",
              "operation": "emit",
              "arguments": {
                "payload": {
                  "ref": "steps.assess.outputs.payload"
                },
                "format": {
                  "literal": {
                    "json": true
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "emit",
          "arguments": {
            "payload": {
              "ref": "steps.assess.outputs.payload"
            },
            "format": {
              "literal": {
                "json": false
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "Result",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.output.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/kb/",
          "artifacts/workflow_hub/",
          "selected_kb_root"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 6
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Regression completion establishes neither scientific truth nor a proved artifact; reviewed_informal is the source's test status."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
