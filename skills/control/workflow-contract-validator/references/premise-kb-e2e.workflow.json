    "mathformer.regression": {
      "state": "State packs main's local paths/options and retained JSON responses coupled to one on-disk KB; it is not a checkpoint.",
      "cli_failure": "run_cli invokes sys.executable and scripts/manage_premise_kb.py --json in REPO_ROOT. A nonzero exit immediately raises RuntimeError; invalid JSON immediately aborts. No retries or subsequent assertions occur after either failure.",
      "present_statement": "In a group, the inverse of a product is the product of the inverses in reverse order.",
      "absent_statement": "Every compact operator theorem about Banach spaces is currently absent from this tiny test KB.",
      "query": "inverse of a triple product in a group reverses order",
      "assertions": [
        "init.ok",
        "seeds.entry_count >= 8",
        "vampire.candidate_count >= 1",
        "Path(bloom.paths.manifest).is_file()",
