    "gaps": [
      "Hub defaults constrain promote_lib=false and json=false; standalone CLI alternatives are outside this specialization.",
      "Helpers remain opaque inside owning operations; scientific payload schemas are partial structural projections.",
      "This graph exposes main through guarded MCP steps, not the hub subprocess envelope: hub dry-run, write audit and optional hub reports remain owned by mathformer_run_workflow.",
      "Lunar enforces contract budgets and runtime receipts; native CLI execution and its external-tool runner have no timeout. External effects retain the candidate qualification declarations."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "formalphysics:top10-sympy",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "formalphysics:top10-sympy",
        "family": "physics_sympy",
        "kind": "generation",
        "safety": "writes_repo",
        "command": [
          "{python}",
          "scripts/generate_formalphysics_top10_sympy.py"
        ],
        "depends_on": [],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Hub preflight blocks failures; dry-run skips main; wrapper uses runpy for authoritative implementation.",
      "failure_policy": "Hub audits writes afterward; undeclared writes can fail the result despite subprocess success.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "scientific_payloads": "Aggregate and process exit code describe main; hub status is a separate envelope."
    }
  }
}
