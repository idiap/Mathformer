    "gaps": [
      "Empty input uses a no-event advance adapter because Lunar cannot compile branch-local loop exhaustion. It returns unchanged state and done=true without calling the native event body.",
      "Only summarize is expanded. CLI and hub boundaries are retained in extension metadata. Direct indexer and consumer callers bypass those wrappers.",
      "The adapter admits at most 10000 loaded events, rejecting larger inputs without truncation. Native summarize remains uncapped.",
      "3600 seconds and 10005 operation calls are Lunar descriptor limits, not native budgets; the hub action has timeout_seconds=null.",
      "Mandatory receipts and digests are host requirements, not native emissions. Exceptions abort; no retry or checkpoint support is added."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "control:reasoning-log-summary",
      "owner_skill": "skills/control/reasoning-log-schema-guardian/SKILL.md",
      "contract": {
        "id": "control:reasoning-log-summary",
        "family": "control",
        "kind": "inspection",
        "safety": "read_only",
        "depends_on": [],
        "writes": [],
        "allows_extra_args": true,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "run_action \u2192 run_leaf_action launches the registered script once with --json after preflight. Preflight failure or dry-run prevents launch. Capture stdout/stderr and audit writes; undeclared writes fail the hub result. No subprocess timeout.",
      "cli": "main uses --log-file or the first existing default: default_good_fixture(), artifacts/physics_sympy/recursive_goal_runs/formalphysics_0000/reasoning.jsonl, artifacts/wiki_level_suite/reasoning.jsonl; if none exists, select default_good_fixture(). Generate self-test fixtures when the selected path is that missing fixture. Call summarize; render sorted indented JSON with ensure_ascii=False. Optionally mkdir/write --output-file with a trailing newline. Print when --json or no output file. Return 0 if summary.ok, otherwise 3. Uncaught exceptions abort.",
      "direct_callers": "Indexer and consumer-contract tests call summarize directly. This graph returns Summary from the function boundary rather than a HubResult envelope.",
      "effects_scope": "Core effects describe summarize only. Fixture generation and optional output writes belong to the CLI wrapper and may violate the hub action's declared writes=[] when launched there."
    }
  }
