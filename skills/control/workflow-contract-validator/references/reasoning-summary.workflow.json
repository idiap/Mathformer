{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_control_reasoning_log_summary_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Load, validate, audit and summarize reasoning-log events. Specialization restricted to logs yielding at most 10000 loaded events; native summarize is uncapped.",
  "aliases": [
    "control:reasoning-log-summary"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "LogFile": {
      "schema": {
        "type": "string",
        "minLength": 1,
        "description": "Input domain: this path must yield 0..10000 events through load_events. Larger logs are excluded, never truncated."
      }
    },
    "Path": {
      "schema": {
        "type": "string",
        "minLength": 1
      }
    },
    "Events": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "maxItems": 10000
      }
    },
    "Validation": {
      "schema": {
        "type": "object",
        "description": "Native validation result including ok and summary."
      }
    },
    "Quality": {
      "schema": {
        "type": "object",
        "description": "Native quality result including ok, quality_scores and consumer_readiness."
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "cursor",
          "skills",
          "hooks",
          "run_ids",
          "timeline",
          "decisions",
          "risks",
          "next_actions",
          "artifacts"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "skills": {
            "type": "array"
          },
          "hooks": {
            "type": "array"
          },
          "run_ids": {
            "type": "array"
          },
          "timeline": {
            "type": "array"
          },
          "decisions": {
            "type": "array"
          },
          "risks": {
            "type": "array"
          },
          "next_actions": {
            "type": "array"
          },
          "artifacts": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "Summary": {
      "schema": {
        "type": "object",
        "required": [
          "schema_version",
          "style",
          "ok",
          "run_id",
          "run_ids",
          "log_file",
          "event_count",
          "skills",
          "hooks",
          "timeline",
          "decisions",
          "risks",
          "next_actions",
          "artifacts",
          "validation",
          "quality"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "style": {
            "const": "reasoning_log_consumer_summary"
          },
          "ok": {
            "type": "boolean"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_count": {
            "type": "integer",
            "minimum": 0
          },
          "log_file": {
            "type": "string"
          },
          "run_ids": {
            "type": "array"
          },
          "skills": {
            "type": "array"
          },
          "hooks": {
            "type": "array"
          },
          "timeline": {
            "type": "array"
          },
          "decisions": {
            "type": "array"
          },
          "risks": {
            "type": "array"
          },
          "next_actions": {
            "type": "array"
          },
          "artifacts": {
            "type": "object"
          },
          "validation": {
            "type": "object"
          },
          "quality": {
            "type": "object"
          }
        }
      }
    }
  },
  "inputs": {
    "log_file": {
      "type": "LogFile"
    },
    "hooks_file": {
      "type": "Path"
    }
  },
  "outputs": {
    "summary": {
      "type": "Summary",
      "value": {
        "ref": "flow.outputs.summary"
      }
    }
  },
  "operations": {
    "load": {
      "inputs": {
        "log_file": {
          "type": "LogFile"
        }
      },
      "outputs": {
        "events": {
          "type": "Events"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_summary_load",
          "operation": "mathformer_reasoning_summary_load"
        }
      }
    },
    "validate": {
      "inputs": {
        "log_file": {
          "type": "LogFile"
        },
        "hooks_file": {
          "type": "Path"
        }
      },
      "outputs": {
        "validation": {
          "type": "Validation"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_summary_validate",
          "operation": "mathformer_reasoning_summary_validate"
        }
      }
    },
    "audit": {
      "inputs": {
        "log_file": {
          "type": "LogFile"
        },
        "hooks_file": {
          "type": "Path"
        }
      },
      "outputs": {
        "quality": {
          "type": "Quality"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_summary_audit",
          "operation": "mathformer_reasoning_summary_audit"
        }
      }
    },
    "initialize": {
      "inputs": {
        "events": {
          "type": "Events"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "empty": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_summary_initialize",
          "operation": "mathformer_reasoning_summary_initialize"
        }
      }
    },
    "advance": {
      "inputs": {
        "events": {
          "type": "Events"
        },
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_summary_advance",
          "operation": "mathformer_reasoning_summary_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "log_file": {
          "type": "LogFile"
        },
        "events": {
          "type": "Events"
        },
        "validation": {
          "type": "Validation"
        },
        "quality": {
          "type": "Quality"
        },
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "summary": {
          "type": "Summary"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_summary_finish",
          "operation": "mathformer_reasoning_summary_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "load",
        "kind": "call",
        "operation": "load",
        "arguments": {
          "log_file": {
            "ref": "inputs.log_file"
          }
        }
      },
      {
        "id": "validate",
        "kind": "call",
        "operation": "validate",
        "arguments": {
          "log_file": {
            "ref": "inputs.log_file"
          },
          "hooks_file": {
            "ref": "inputs.hooks_file"
          }
        }
      },
      {
        "id": "audit",
        "kind": "call",
        "operation": "audit",
        "arguments": {
          "log_file": {
            "ref": "inputs.log_file"
          },
          "hooks_file": {
            "ref": "inputs.hooks_file"
          }
        }
      },
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "events": {
            "ref": "steps.load.outputs.events"
          }
        }
      },
      {
        "id": "events",
        "kind": "loop",
        "description": "One iteration per loaded event, with no status-dependent break or retry. Empty input uses a no-event exhaustion adapter. Exactly 10000 events completes normally; larger inputs are rejected at load.",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "advance",
          "arguments": {
            "events": {
              "ref": "steps.load.outputs.events"
            },
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "log_file": {
            "ref": "inputs.log_file"
          },
          "events": {
            "ref": "steps.load.outputs.events"
          },
          "validation": {
            "ref": "steps.validate.outputs.validation"
          },
          "quality": {
            "ref": "steps.audit.outputs.quality"
          },
          "state": {
            "ref": "steps.events.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "summary": {
        "type": "Summary",
        "value": {
          "ref": "steps.finish.outputs.summary"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "read_reasoning_logs",
        "compute_consumer_summary"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 10005
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Consumer summary only; ok requires native validation and quality success. No proof, promotion or runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
