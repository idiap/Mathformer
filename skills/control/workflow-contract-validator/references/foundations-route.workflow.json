            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "concepts",
        "kind": "loop",
        "description": "Exactly 16 source-owned concepts; normal completion at cursor 16, with no refinement or repair.",
        "state_type": "ConceptState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "append_concept",
          "arguments": {
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 16,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "ConceptState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
