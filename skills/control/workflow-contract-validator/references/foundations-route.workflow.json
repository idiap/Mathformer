          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "verify",
        "kind": "call",
        "operation": "verify",
        "arguments": {
          "paths": {
            "ref": "steps.prepare.outputs.paths"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "workbench",
        "kind": "call",
        "operation": "workbench",
        "arguments": {
          "packet": {
            "ref": "steps.intake.outputs.packet"
          },
          "paths": {
            "ref": "steps.prepare.outputs.paths"
          },
          "context": {
