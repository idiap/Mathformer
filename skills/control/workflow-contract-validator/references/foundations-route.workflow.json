            "ref": "steps.surface.outputs.report"
          },
          "draft": {
            "ref": "steps.draft.outputs.report"
          },
          "verify": {
            "ref": "steps.verify.outputs.report"
          },
          "workbench": {
            "ref": "steps.workbench.outputs.report"
          },
          "context": {
