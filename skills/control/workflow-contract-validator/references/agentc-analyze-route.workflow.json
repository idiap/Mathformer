        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Analyzer internals are retained within invoke_action; valid-argument direct action invocation is outside this route.",
      "Native optional logging does not guarantee v1 receipts; Lunar supplies runtime receipts and provenance.",
      "Native subprocess timeout remains unset on this route. The 3600-second contract deadline is a Lunar runtime policy, not a native controller timeout."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "agentc.analyze",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "agentc.analyze",
        "title": "Analyze AgentC logs",
        "action_ids": [
          "agentc:analyze-logs"
        ],
        "skill_routes": [
          "autoformalization-agentc"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "Selected native run_intent_match route through shared initialization, native run_action, advance and finish blocks. Explicit repository_root is threaded through native preflight, process cwd and write audits.",
      "selection": "NL selection precedes this contract; registry and route metadata remain source-owned.",
      "arguments": "No extra_args input is forwarded; MCP route dispatch rejects nonempty extra_args.",
      "failure_policy": "Failed child payloads remain data for aggregation; exceptions terminate without retry.",
      "analyzer_direct_action": "With valid arguments, main loads a JSON object, filters fields and supplies defaults, then delegates collection and saving to agentc.py. Collection sorts events, accumulates counters/timings, FIFO-pairs starts/completions, flattens dependency reports, deduplicates paths, analyzes existing Lean files and summarizes refinement history. Optional missing inputs and malformed log records are skipped. Version deltas require two versions. Input/queue exhaustion ends loops; no iteration budget exists and top error lines are capped at 20. JSON precedes LaTeX, then both paths print and exit 0 returns. Exceptions stop without retries and may leave partial output. None of this analysis is reached by ordinary route execution.",
      "timeout": "Native CLI subprocess limit remains unset; this staged MCP binding preserves it. Ordinary mathformer_ask/mathformer_run_workflow retain their configurable 600-second MCP default. Lunar enforces the workflow wall-time policy."
    }
  }
}
