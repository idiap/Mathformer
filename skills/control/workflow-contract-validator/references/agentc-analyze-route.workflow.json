      },
      {
        "path": "skills/autoformalization/autoformalization-agentc/scripts/agentc.py",
        "selector": "build_autoformalization_statistics; save_autoformalization_statistics",
        "digest": "sha256:f905407d76dcf8caaecf50716c9d6f8b0d342c65cda61dafe63254236312767f"
      },
      {
        "path": "scripts/agentc_analyze_route_tools.py",
        "selector": "register_agentc_analyze_route_tools; selected_match",
        "digest": "sha256:e8116242aaf738ff656282058a903742fcd18c0430718992aa677bcf6cb19274"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
