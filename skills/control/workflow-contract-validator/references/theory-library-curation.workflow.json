{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "profile_theory_library_curation_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Specification-only projection of the theory-library curation epistemic dependencies and terminal dispositions; no execution schedule is established.",
  "aliases": [
    "theory_library_curation"
  ],
  "lifecycle": "draft",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Context": {
      "schema": {
        "description": "Opaque ERFL Context; concrete invocation payload is unspecified."
      },
      "representation": "value"
    },
    "Bundle": {
      "schema": {
        "description": "Opaque ERFL Bundle; candidates and curated candidates retain the same semantic kind."
      },
      "representation": "value"
    },
    "Evidence": {
      "schema": {
        "description": "Opaque ERFL Evidence for grounding."
      },
      "representation": "value"
    },
    "Assessment": {
      "schema": {
        "description": "Opaque ERFL Assessment against grounding evidence."
      },
      "representation": "value"
    },
    "Plan": {
      "schema": {
        "description": "Opaque ERFL Plan; deriving a plan does not execute it."
      },
      "representation": "value"
    },
    "Decision": {
      "schema": {
        "type": "string",
        "enum": [
          "accepted",
          "repair_required",
          "rejected"
        ],
        "description": "Symbolic encoding of the three declared e dispositions, not a native runtime payload schema."
      },
      "representation": "value"
    }
  },
  "inputs": {
    "curation_request": {
      "type": "Context",
      "required": true
    }
  },
  "outputs": {
    "curation_status": {
      "type": "Decision",
      "value": {
        "ref": "flow.outputs.curation_status"
      }
    }
  },
  "operations": {
    "retrieve_candidates": {
      "inputs": {
        "curation_request": {
          "type": "Context"
        }
      },
      "outputs": {
        "candidates": {
          "type": "Bundle"
        }
      },
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (q:Q): retrieve candidates; no executable normalized binding exists."
      }
    },
    "establish_grounding": {
      "inputs": {
        "candidates": {
          "type": "Bundle"
        }
      },
      "outputs": {
        "grounding": {
          "type": "Evidence"
        }
      },
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (g:G): establish grounding evidence; no executable normalized binding exists."
      }
    },
    "assess_candidates": {
      "inputs": {
        "candidates": {
          "type": "Bundle"
        },
        "grounding": {
          "type": "Evidence"
        }
      },
      "outputs": {
        "assessment": {
          "type": "Assessment"
        }
      },
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (r:R): assess candidates against grounding; no executable normalized binding exists."
      }
    },
    "derive_repair_plan": {
      "inputs": {
        "candidates": {
          "type": "Bundle"
        },
        "assessment": {
          "type": "Assessment"
        }
      },
      "outputs": {
        "repair": {
          "type": "Plan"
        }
      },
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (x:X): derive a repair plan without applying it; no executable normalized binding exists."
      }
    },
    "construct_curated_candidate": {
      "inputs": {
        "candidates": {
          "type": "Bundle"
        },
        "repair": {
          "type": "Plan"
        }
      },
      "outputs": {
        "curated_candidate": {
          "type": "Bundle"
        }
      },
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (f:F): construct a candidate from candidates and repair; no executable normalized binding exists."
      }
    },
    "calibrate_candidate": {
      "inputs": {
        "curated_candidate": {
          "type": "Bundle"
        },
        "assessment": {
          "type": "Assessment"
        }
      },
      "outputs": {
        "curation_status": {
          "type": "Decision"
        }
      },
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (e:E): calibrate using the existing assessment; no executable normalized binding exists."
      }
    },
    "declare_persistence": {
      "inputs": {
        "curation_status": {
          "type": "Decision"
        }
      },
      "outputs": {},
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (e -persist-> kb0): declare persistence of the calibrated decision to file(\"MathformerKB\"); this declaration neither writes nor attests persistence success; no executable normalized binding exists."
      }
    },
    "accept": {
      "inputs": {
        "curation_status": {
          "type": "Decision"
        }
      },
      "outputs": {},
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (on e.accepted => accept): terminal epistemic acceptance, without asserting durable promotion; no executable normalized binding exists."
      }
    },
    "stop": {
      "inputs": {
        "curation_status": {
          "type": "Decision"
        }
      },
      "outputs": {},
      "execution": {
        "mode": "specification_only",
        "reason": "examples/reasoning_flows/theory_library_curation.rflow (on e.repair_required => stop; on e.rejected => stop): terminate this profile without repair execution or repetition; no executable normalized binding exists."
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "description": "Declaration order and epistemic data dependencies only; all calls are unavailable specification interfaces.",
    "steps": [
      {
        "id": "q",
        "kind": "call",
        "operation": "retrieve_candidates",
        "arguments": {
          "curation_request": {
            "ref": "inputs.curation_request"
          }
        }
      },
      {
        "id": "g",
        "kind": "call",
        "operation": "establish_grounding",
        "arguments": {
          "candidates": {
            "ref": "steps.q.outputs.candidates"
          }
        }
      },
      {
        "id": "r",
        "kind": "call",
        "operation": "assess_candidates",
        "arguments": {
          "candidates": {
            "ref": "steps.q.outputs.candidates"
          },
          "grounding": {
            "ref": "steps.g.outputs.grounding"
          }
        }
      },
      {
        "id": "x",
        "kind": "call",
        "operation": "derive_repair_plan",
        "arguments": {
          "candidates": {
            "ref": "steps.q.outputs.candidates"
          },
          "assessment": {
            "ref": "steps.r.outputs.assessment"
          }
        }
      },
      {
        "id": "f",
        "kind": "call",
        "operation": "construct_curated_candidate",
        "arguments": {
          "candidates": {
            "ref": "steps.q.outputs.candidates"
          },
          "repair": {
            "ref": "steps.x.outputs.repair"
          }
        }
      },
      {
        "id": "e",
        "kind": "call",
        "operation": "calibrate_candidate",
        "arguments": {
          "curated_candidate": {
            "ref": "steps.f.outputs.curated_candidate"
          },
          "assessment": {
            "ref": "steps.r.outputs.assessment"
          }
        }
      },
      {
        "id": "persistence",
        "kind": "call",
        "operation": "declare_persistence",
        "arguments": {
          "curation_status": {
            "ref": "steps.e.outputs.curation_status"
          }
        }
      },
      {
        "id": "terminal",
        "kind": "switch",
        "description": "The source declares accept on accepted and stop on repair_required or rejected.",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "eq": [
                {
                  "ref": "steps.e.outputs.curation_status"
                },
                {
                  "literal": "accepted"
                }
              ]
            },
            "body": {
              "kind": "call",
              "operation": "accept",
              "arguments": {
                "curation_status": {
                  "ref": "steps.e.outputs.curation_status"
                }
              }
            }
          },
          {
            "id": "repair_required",
            "when": {
              "eq": [
                {
                  "ref": "steps.e.outputs.curation_status"
                },
                {
                  "literal": "repair_required"
                }
              ]
            },
            "body": {
              "kind": "call",
              "operation": "stop",
              "arguments": {
                "curation_status": {
                  "ref": "steps.e.outputs.curation_status"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "stop",
          "description": "Rejected is the remaining value in the closed symbolic Decision type.",
          "arguments": {
            "curation_status": {
              "ref": "steps.e.outputs.curation_status"
            }
          }
        },
        "outputs": {
          "curation_status": {
            "type": "Decision",
            "value": {
              "ref": "steps.e.outputs.curation_status"
            }
          }
        }
      }
    ],
    "outputs": {
      "curation_status": {
        "type": "Decision",
        "value": {
          "ref": "steps.terminal.outputs.curation_status"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "inspect_declared_contract"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 8
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked epistemic description only; no scientific result, runtime qualification, persistence success or durable promotion is established."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
