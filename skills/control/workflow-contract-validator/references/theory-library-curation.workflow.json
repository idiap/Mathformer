  },
  "extensions": {
    "mathformer.source": {
      "category": "profile",
      "native_id": "theory_library_curation",
      "owner_skill": "skills/control/reasoning-flow-language/SKILL.md",
      "contract": {
        "id": "theory_library_curation",
        "goal": "Turn reusable candidates into coherent, provenance-bearing library knowledge.",
        "trust_transition": {
          "from": "reusable_candidate",
          "to": "accepted_curated_entry_or_repair_plan"
        }
      }
    }
  }
}
