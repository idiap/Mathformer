{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathformer:lean-build-interface:v1",
  "$comment": "SPDX-FileCopyrightText: 2026 Idiap Research Institute; SPDX-License-Identifier: MIT. Source: scripts/mathformer.py RunContext, action_to_dict, run_action, run_leaf_action, run_intent_match. This types the hub envelope, not scientific artifacts.",
  "$defs": {
    "RunContext": {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "json_output": {
          "type": "boolean"
        },
        "keep_going": {
          "type": "boolean"
        },
        "allow_mutating": {
          "type": "boolean"
        },
        "write_report": {
          "type": "boolean"
        }
      },
      "required": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "additionalProperties": false
    },
    "ActionMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "safety": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allows_extra_args": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary",
        "family",
        "kind",
        "safety",
        "command",
        "depends_on",
        "required_paths",
        "required_tools",
        "optional_tools",
        "writes",
        "allows_extra_args",
        "timeout_seconds",
        "notes"
      ],
      "additionalProperties": false
    },
    "HubResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "action": {
          "$ref": "#/$defs/ActionMetadata"
        },
        "action_id": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "preflight_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "additionalProperties": false
            }
          ]
        },
        "stderr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "base64"
              ],
              "additionalProperties": false
            }
          ]
        },
        "timeout_seconds": {
          "type": "integer"
        },
        "write_audit": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HubResult"
          }
        },
        "leaf": {
          "$ref": "#/$defs/HubResult"
        },
        "route": {
          "type": "object"
        },
        "cycle": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report_file": {
          "type": "string"
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    }
  }
}
