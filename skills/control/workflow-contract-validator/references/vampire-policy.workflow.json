    "gaps": [
      "Only the fixed example direct branch is modeled. premise_loop=false leaves premise generation and minimization inactive; other caller settings are outside this contract.",
      "Native generator state is service-owned and single-use, transported by opaque revision handles. It cannot be resumed after service loss.",
      "A service-owned process enforces the hub cumulative 180-second timeout across native stages; native Vampire receives --time_limit 10 and has no Python subprocess timeout. Source exceptions retain native post-process write audit and fail their operation; native no-winner printing failure is captured as process exit 1 and then write-audited.",
      "Complete external capability qualification is host-owned; this contract retains the original effect and authority ceilings."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "example:vampire-policy",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "example:vampire-policy",
        "summary": "Run the policy-chain informal-to-Vampire example.",
        "family": "atp",
        "kind": "demo",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "examples/vampire_informal_to_proofs.py"
        ],
        "depends_on": [],
        "required_paths": [
          "examples/vampire_informal_to_proofs.py"
        ],
        "required_tools": [],
        "optional_tools": [
          "vampire"
        ],
        "writes": [
          "artifacts/vampire_atp/policy_chain_example/"
        ],
        "allows_extra_args": false,
        "timeout_seconds": 180,
        "notes": ""
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP tools resume the authoritative native generator at its existing yields, share the CLI print/check implementation, and reuse native hub preflight and write audit. A service-owned process preserves the hub cumulative 180-second timeout and terminates the child prover on timeout.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "failure_policy": "Preserve preflight rejection and dry-run envelopes. Source search exceptions run the native post-process write audit, then fail the calling operation without retries. Capture native example print/check exceptions as nonzero process outcomes and preserve write audit failures.",
      "scientific_payloads": "HubResult is the transport envelope; Report is the backend discovery payload."
    },
    "mathformer.search": {
      "specialization": "Fixed input file; artifact_root=artifacts/vampire_atp/policy_chain_example/; time_limit=10; premise_loop=false. Current templates return 1..2 candidates, constrained by State.candidates; supplied policy returns one.",
      "proof_found": "SZS Theorem, Unsatisfiable or ContradictoryAxioms, independently of subprocess return code. First proof_found wins and immediately stops candidate search.",
      "bounds": "Vampire commands receive --time_limit 10; subprocess.run has no Python timeout, including version probing. Hub enforces 180 seconds on example process; 3600 seconds is not a native bound.",
      "failure": "No winner still produces discovery_report.json; example then raises while indexing null informal_proof. Exceptions and hub timeout remain process failures.",
      "call_budget": "11 is a descriptor ceiling sufficient for two candidates; native code has no equivalent operation-call budget.",
      "guard_lowering": "Root-level bounded loop carries an inactive continuation for dry-run/preflight rejection. Guarded loop body and finalization skip all native search operations when execute=false."
    }
  }
}
