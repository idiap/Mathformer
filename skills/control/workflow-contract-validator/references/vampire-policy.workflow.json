{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_example_vampire_policy_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Direct candidate search for the fixed policy-chain example within native hub controls.",
  "aliases": [
    "example:vampire-policy"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext",
      "representation": "value"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult",
      "representation": "value"
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      },
      "representation": "value"
    },
    "Text": {
      "schema": {
        "type": "string"
      },
      "representation": "value"
    },
    "Plan": {
      "schema": {
        "type": "object",
        "required": [
          "token",
          "execute"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "execute": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "Service-owned native hub boundary. execute=false preserves dry-run and rejected preflight payloads."
      },
      "representation": "value"
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "token",
          "revision",
          "evidence"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Single-use service-local continuation over discover_proof_steps. Native candidates, index, attempts, winner fields and runner stay in the suspended generator; evidence is the exact native stage observation. No restart or replay."
      },
      "representation": "value"
    },
    "RawAttempt": {
      "schema": {
        "type": "object",
        "required": [
          "token",
          "revision",
          "evidence"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Single-use final_attempt continuation, with native proof_found and final_premise_ids evidence; raw native attempt remains in the generator."
      },
      "representation": "value"
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "attempts",
          "winning_informal_proof",
          "winning_formal_proof"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "winning_informal_proof": {
            "type": [
              "object",
              "null"
            ]
          },
          "winning_formal_proof": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "Native discovery_report.json payload including winner, statuses, counts and artifact paths."
      },
      "representation": "value"
    },
    "Outcome": {
      "schema": {
        "type": "object",
        "description": "Native process outcome including exit code, output or exception, or dry-run skip outcome; not scientific acceptance."
      },
      "representation": "value"
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "preflight": {
      "inputs": {
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "plan": {
          "type": "Plan"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_preflight",
          "operation": "mathformer_policy_preflight"
        }
      }
    },
    "read_statement": {
      "inputs": {
        "plan": {
          "type": "Plan"
        }
      },
      "outputs": {
        "statement": {
          "type": "Text"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_read_statement",
          "operation": "mathformer_policy_read_statement"
        }
      }
    },
    "initialize": {
      "inputs": {
        "statement": {
          "type": "Text"
        },
        "plan": {
          "type": "Plan"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_initialize",
          "operation": "mathformer_policy_initialize"
        }
      }
    },
    "direct_attempt": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "attempt": {
          "type": "RawAttempt"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_direct_attempt",
          "operation": "mathformer_policy_direct_attempt"
        }
      }
    },
    "carry": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "attempt": {
          "type": "RawAttempt"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_carry",
          "operation": "mathformer_policy_carry"
        }
      }
    },
    "write_report": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_write_report",
          "operation": "mathformer_policy_write_report"
        }
      }
    },
    "finish_example": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "statement": {
          "type": "Text"
        }
      },
      "outputs": {
        "outcome": {
          "type": "Outcome"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_finish_example",
          "operation": "mathformer_policy_finish_example"
        }
      }
    },
    "skip": {
      "inputs": {
        "plan": {
          "type": "Plan"
        }
      },
      "outputs": {
        "outcome": {
          "type": "Outcome"
        },
        "state": {
          "type": "State"
        },
        "statement": {
          "type": "Text"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_skip",
          "operation": "mathformer_policy_skip"
        }
      }
    },
    "audit": {
      "inputs": {
        "plan": {
          "type": "Plan"
        },
        "outcome": {
          "type": "Outcome"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_policy_audit",
          "operation": "mathformer_policy_audit"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "preflight",
        "kind": "call",
        "operation": "preflight",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "initialize",
        "kind": "switch",
        "cases": [
          {
            "id": "execute",
            "when": {
              "ref": "steps.preflight.outputs.plan.execute"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "read",
                  "kind": "call",
                  "operation": "read_statement",
                  "arguments": {
                    "plan": {
                      "ref": "steps.preflight.outputs.plan"
                    }
                  }
                },
                {
                  "id": "initialize",
                  "kind": "call",
                  "operation": "initialize",
                  "arguments": {
                    "statement": {
                      "ref": "steps.read.outputs.statement"
                    },
                    "plan": {
                      "ref": "steps.preflight.outputs.plan"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "State",
                  "value": {
                    "ref": "steps.initialize.outputs.state"
                  }
                },
                "statement": {
                  "type": "Text",
                  "value": {
                    "ref": "steps.read.outputs.statement"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "skip",
              "kind": "call",
              "operation": "skip",
              "arguments": {
                "plan": {
                  "ref": "steps.preflight.outputs.plan"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "steps.skip.outputs.state"
              }
            },
            "statement": {
              "type": "Text",
              "value": {
                "ref": "steps.skip.outputs.statement"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          },
          "statement": {
            "type": "Text",
            "value": {
              "ref": "selected.outputs.statement"
            }
          }
        }
      },
      {
        "id": "search",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 2,
        "on_exhausted": "fail",
        "description": "Finite ordered portfolio: one candidate for supplied invoice policy, at most two in current templates. No retries. done=true on final candidate even without proof, so portfolio exhaustion returns normally; on_exhausted is unreachable within this specialization.",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "execute",
              "when": {
                "ref": "steps.preflight.outputs.plan.execute"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "attempt",
                    "kind": "call",
                    "operation": "direct_attempt",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      }
                    }
                  },
                  {
                    "id": "carry",
                    "kind": "call",
                    "operation": "carry",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "attempt": {
                        "ref": "steps.attempt.outputs.attempt"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "State",
                    "value": {
                      "ref": "steps.carry.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Bool",
                    "value": {
                      "ref": "steps.carry.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "id": "skip",
                "kind": "call",
                "operation": "skip",
                "arguments": {
                  "plan": {
                    "ref": "steps.preflight.outputs.plan"
                  }
                }
              }
            ],
            "outputs": {
              "state": {
                "type": "State",
                "value": {
                  "ref": "steps.skip.outputs.state"
                }
              },
              "done": {
                "type": "Bool",
                "value": {
                  "ref": "steps.skip.outputs.done"
                }
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "execute",
            "when": {
              "ref": "steps.preflight.outputs.plan.execute"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "report",
                  "kind": "call",
                  "operation": "write_report",
                  "arguments": {
                    "state": {
                      "ref": "steps.search.outputs.state"
                    }
                  }
                },
                {
                  "id": "finish",
                  "kind": "call",
                  "operation": "finish_example",
                  "arguments": {
                    "report": {
                      "ref": "steps.report.outputs.report"
                    },
                    "statement": {
                      "ref": "steps.initialize.outputs.statement"
                    }
                  }
                }
              ],
              "outputs": {
                "outcome": {
                  "type": "Outcome",
                  "value": {
                    "ref": "steps.finish.outputs.outcome"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "skip",
              "kind": "call",
              "operation": "skip",
              "arguments": {
                "plan": {
                  "ref": "steps.preflight.outputs.plan"
                }
              }
            }
          ],
          "outputs": {
            "outcome": {
              "type": "Outcome",
              "value": {
                "ref": "steps.skip.outputs.outcome"
              }
            }
          }
        },
        "outputs": {
          "outcome": {
            "type": "Outcome",
            "value": {
              "ref": "selected.outputs.outcome"
            }
          }
        }
      },
      {
        "id": "audit",
        "kind": "call",
        "operation": "audit",
        "arguments": {
          "plan": {
            "ref": "steps.preflight.outputs.plan"
          },
          "outcome": {
            "ref": "steps.dispatch.outputs.outcome"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.audit.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/vampire_atp/policy_chain_example/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 180,
      "max_operation_calls": 11
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native staged execution of the fixed policy example; completion does not establish scientific acceptance or theorem promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
