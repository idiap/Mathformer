{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_family_paper_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Paper-family check traversal in run(args), followed by native report publication.",
  "aliases": [
    "test:family:paper"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Args": {
      "schema": {
        "type": "object",
        "required": [
          "module_family",
          "profile",
          "changed_files_only",
          "validate_matrix",
          "emit_dependency_map_only",
          "fail_on_warning",
          "run_id",
          "output_file",
          "write_jsonl",
          "write_junit",
          "json"
        ],
        "additionalProperties": false,
        "properties": {
          "module_family": {
            "const": [
              "paper"
            ]
          },
          "profile": {
            "const": "workstation"
          },
          "changed_files_only": {
            "const": false
          },
          "validate_matrix": {
            "const": false
          },
          "emit_dependency_map_only": {
            "const": false
          },
          "fail_on_warning": {
            "const": false
          },
          "run_id": {
            "type": "string"
          },
          "output_file": {
            "const": "artifacts/test_program/deterministic_tests.json"
          },
          "write_jsonl": {
            "type": "null"
          },
          "write_junit": {
            "type": "null"
          },
          "json": {
            "const": true
          }
        }
      }
    },
    "MatrixFile": {
      "representation": "file",
      "media_type": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "schema_version",
          "tests"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            },
            "contains": {
              "type": "object",
              "required": [
                "module_family"
              ],
              "properties": {
                "module_family": {
                  "const": "paper"
                }
              }
            },
            "minContains": 0,
            "maxContains": 3
          }
        }
      }
    },
    "CheckState": {
      "schema": {
        "type": "object",
        "required": [
          "matrix",
          "selected",
          "families",
          "index",
          "results"
        ],
        "additionalProperties": false,
        "properties": {
          "matrix": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "results": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "run_id",
          "ok",
          "families",
          "summary",
          "results",
          "schema_errors",
          "matrix_errors"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schema_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matrix_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capability_ledger": {
            "type": "object"
          },
          "dependency_map": {
            "type": "string"
          }
        }
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "handle"
        ],
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Publication": {
      "schema": {
        "type": "object",
        "required": [
          "report_path",
          "stdout"
        ],
        "additionalProperties": false,
        "properties": {
          "report_path": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          }
        }
      }
    },
    "Cursor": {
      "schema": {
        "type": "object",
        "required": [
          "state",
          "pending"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "object",
            "required": [
              "matrix",
              "selected",
              "families",
              "index",
              "results"
            ],
            "additionalProperties": false,
            "properties": {
              "matrix": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "selected": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object"
                }
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "results": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "pending": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "inputs": {
    "args": {
      "type": "Args"
    },
    "matrix": {
      "type": "MatrixFile"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    },
    "publication": {
      "type": "Publication",
      "value": {
        "ref": "flow.outputs.publication"
      }
    }
  },
  "operations": {
    "enter": {
      "inputs": {
        "args": {
          "type": "Args"
        }
      },
      "outputs": {
        "snapshot_only": {
          "type": "Bool"
        },
        "context": {
          "type": "Context"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_enter",
          "operation": "mathformer_paper_family_enter"
        }
      }
    },
    "prepare": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "matrix": {
          "type": "MatrixFile"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "CheckState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_prepare",
          "operation": "mathformer_paper_family_prepare"
        }
      }
    },
    "pending": {
      "inputs": {
        "state": {
          "type": "CheckState"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "pending": {
          "type": "Bool"
        },
        "cursor": {
          "type": "Cursor"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_pending",
          "operation": "mathformer_paper_family_pending"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "CheckState"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "CheckState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_advance",
          "operation": "mathformer_paper_family_advance"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "CheckState"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_finalize",
          "operation": "mathformer_paper_family_finalize"
        }
      }
    },
    "publish": {
      "inputs": {
        "report": {
          "type": "Report"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        },
        "publication": {
          "type": "Publication"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_publish",
          "operation": "mathformer_paper_family_publish"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "cursor": {
          "type": "Cursor"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "cursor": {
          "type": "Cursor"
        },
        "pending": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_paper_family_retain_empty",
          "operation": "mathformer_paper_family_retain_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "enter",
        "kind": "call",
        "operation": "enter",
        "arguments": {
          "args": {
            "ref": "inputs.args"
          }
        }
      },
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "args": {
            "ref": "inputs.args"
          },
          "matrix": {
            "ref": "inputs.matrix"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "initial_guard",
        "kind": "call",
        "operation": "pending",
        "arguments": {
          "state": {
            "ref": "steps.prepare.outputs.state"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "traverse",
        "kind": "loop",
        "state_type": "Cursor",
        "initial": {
          "ref": "steps.initial_guard.outputs.cursor"
        },
        "max_iterations": 3,
        "on_exhausted": "fail",
        "description": "One check per pending cursor; retain_empty carries zero checks without invoking run_check. The third advance normally stops after its false guard.",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "pending",
              "when": {
                "ref": "loop.state.pending"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state.state"
                      },
                      "args": {
                        "ref": "inputs.args"
                      },
                      "context": {
                        "ref": "steps.enter.outputs.context"
                      }
                    }
                  },
                  {
                    "id": "guard",
                    "kind": "call",
                    "operation": "pending",
                    "arguments": {
                      "state": {
                        "ref": "steps.advance.outputs.state"
                      },
                      "context": {
                        "ref": "steps.enter.outputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "cursor": {
                    "type": "Cursor",
                    "value": {
                      "ref": "steps.guard.outputs.cursor"
                    }
                  },
                  "pending": {
                    "type": "Bool",
                    "value": {
                      "ref": "steps.guard.outputs.pending"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "retain_empty",
            "arguments": {
              "cursor": {
                "ref": "loop.state"
              },
              "context": {
                "ref": "steps.enter.outputs.context"
              }
            }
          },
          "outputs": {
            "cursor": {
              "type": "Cursor",
              "value": {
                "ref": "selected.outputs.cursor"
              }
            },
            "pending": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.pending"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.cursor"
        },
        "until": {
          "not": {
            "ref": "body.outputs.pending"
          }
        },
        "outputs": {
          "state": {
            "type": "CheckState",
            "value": {
              "ref": "loop.state.state"
            }
          }
        }
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.traverse.outputs.state"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.finalize.outputs.report"
          },
          "args": {
            "ref": "inputs.args"
          },
          "context": {
            "ref": "steps.enter.outputs.context"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.publish.outputs.exit_code"
        }
      },
      "publication": {
        "type": "Publication",
        "value": {
          "ref": "steps.publish.outputs.publication"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 900,
      "max_operation_calls": 12
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native paper validation evidence and publication only; no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
