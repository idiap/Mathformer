          "artifacts/"
        ],
        "timeout_seconds": 900
      }
    },
    "mathformer.native_boundary": {
      "execution": "run_action then run_leaf_action; preflight failure/dry-run returns before launch, otherwise subprocess and final write audit.",
      "failure_policy": "Hub timeout or undeclared writes forces failure independently of the report; unexpected source exceptions propagate.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "block_execution": "MCP tools call shared native functions, recheck service policy and verify server-owned invocation/state/report and phase on every call. Publication returns native stdout separately from JSON-RPC."
    },
    "mathformer.specialization": {
      "matrix_input": "Exact native file tests/test_matrix.json; no alternative manifest or injected rows.",
      "bound": "The root loop carries Cursor(state,pending). retain_empty carries a zero-check selection without calling run_check. This equivalent encoding avoids unsupported branch-local loop exhaustion in Lunar. At most three advances; the final native guard stops normally. Preparation rejects a larger selection before any check.",
      "native_limit": "Native loop has no numeric cap; on_exhausted=fail is unreachable for admitted inputs. The old 3600-second normalization bound was not the native 900-second hub timeout.",
      "checks": "Current order is layout extraction, theory localization, theory planning; each timeout is 120 seconds and none declares optional dependencies.",
      "check_semantics": "Missing optional dependencies skip unless fail-on-warning/strict; exit mismatch or undeclared writes fails the check. run_check owns subprocess, snapshots, timing, logs and fingerprints; timeout results continue without retry.",
      "success": "Zero failed checks and no schema errors; strict additionally requires capability readiness. Matrix coverage and strict mode are disabled by registered defaults.",
      "context": "enter parses registered arguments with the requested run_id once. Other tools require its opaque context handle. The matrix port asserts the canonical file payload; it never supplies executable rows.",
      "operation_calls": "11 calls at the three-row bound (enter, prepare, initial pending, three advance/pending pairs, finalize, publish); the existing 12-call ceiling is retained."
    }
  }
