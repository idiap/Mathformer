          ".lake/"
        ],
        "allows_extra_args": false,
        "timeout_seconds": null,
        "notes": ""
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP installer stages share native functions with main. Lunar executes the ordered graph; the existing hub invocation remains separately controlled.",
      "route": "setup.lean -> run_intent_match -> run_action -> run_leaf_action; one action, no dependencies.",
      "preflight": "Fixed argv and Lean branch flags are checked by callable tools. Mutation requires allow_mutating and service write-root authorization. Lake must match PATH discovery. Hub dry-run and audit are not exported as installer completion.",
      "completion": "Exports the native installer integer return after successful update and build; native diagnostics go to MCP stderr. Exceptions fail the step and stop dependent execution.",
      "context_fields": [
        "allow_mutating"
      ],
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "failure_policy": "Keep native failure payloads; do not infer acceptance from completion.",
      "scientific_payloads": "This graph exports the selected main's successful integer return, not a backend proof or report.",
