        "digest": "sha256:2c8a00fbf461dddcb10899271ca41d47bf90c9a077b47add7db3c250aab1a5fd"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry/setup:lean; run_intent_match; run_action; run_leaf_action",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/setup_lean_tools.py",
        "selector": "register_setup_lean_tools",
        "digest": "sha256:015c53633f6475a2b1427db7142e4c2752b5e666385f2a9e2194e0374b6831e4"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_setup_lean_tools; _graph_layout_write_policy",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "inventory/setup:lean",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Graph specializes main to the immutable setup:lean argv. General Python installation and Lean skip branches are outside this action and cannot be selected through its input schema.",
      "Graph returns the installer exit_code, not a HubResult or write-audit acceptance. The hub envelope remains source-owned boundary metadata. Callable installer steps enforce mutation authorization and service write roots; they do not claim the hub subprocess capture or repository write audit.",
      "Lunar enforces the contract wall-time and call budget; native installer subprocesses have no timeout and cancellation does not guarantee external child termination.",
      "Mandatory runtime receipts do not upgrade optional native reports or qualify network and external effects."
    ]
  },
  "extensions": {
