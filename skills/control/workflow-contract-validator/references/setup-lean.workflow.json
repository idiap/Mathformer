{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_setup_lean_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Fixed setup:lean installer path: validate Python and arguments, require Lake, update, build, then complete.",
  "aliases": [
    "setup:lean"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "InstallerArgv": {
      "schema": {
        "type": "array",
        "const": [
          "--skip-python",
          "--with-lean"
        ]
      },
      "representation": "value"
    },
    "LeanArgs": {
      "schema": {
        "type": "object",
        "properties": {
          "skip_python": {
            "const": true,
            "type": "boolean"
          },
          "with_lean": {
            "const": true,
            "type": "boolean"
          },
          "skip_lean": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "skip_python",
          "with_lean",
          "skip_lean"
        ],
        "additionalProperties": true
      },
      "representation": "value"
    },
    "Lake": {
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "representation": "value"
    },
    "Done": {
      "schema": {
        "type": "null"
      },
      "representation": "value"
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "const": 0
      },
      "representation": "value"
    },
    "MutationAuthorization": {
      "schema": {
        "type": "boolean"
      },
      "representation": "value"
    }
  },
  "inputs": {
    "argv": {
      "type": "InstallerArgv"
    },
    "allow_mutating": {
      "type": "MutationAuthorization"
    }
  },
  "outputs": {
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {
        "argv": {
          "type": "InstallerArgv"
        }
      },
      "outputs": {
        "args": {
          "type": "LeanArgs"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_setup_lean_initialize",
          "operation": "mathformer_setup_lean_initialize"
        }
      }
    },
    "require_lake": {
      "inputs": {
        "args": {
          "type": "LeanArgs"
        }
      },
      "outputs": {
        "lake": {
          "type": "Lake"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_setup_lean_require_lake",
          "operation": "mathformer_setup_lean_require_lake"
        }
      }
    },
    "update": {
      "inputs": {
        "lake": {
          "type": "Lake"
        },
        "allow_mutating": {
          "type": "MutationAuthorization"
        }
      },
      "outputs": {
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_setup_lean_update",
          "operation": "mathformer_setup_lean_update"
        }
      }
    },
    "build": {
      "inputs": {
        "lake": {
          "type": "Lake"
        },
        "updated": {
          "type": "Done"
        },
        "allow_mutating": {
          "type": "MutationAuthorization"
        }
      },
      "outputs": {
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_setup_lean_build",
          "operation": "mathformer_setup_lean_build"
        }
      }
    },
    "complete": {
      "inputs": {
        "built": {
          "type": "Done"
        }
      },
      "outputs": {
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_setup_lean_complete",
          "operation": "mathformer_setup_lean_complete"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "require_lake",
        "kind": "call",
        "operation": "require_lake",
        "arguments": {
          "args": {
            "ref": "steps.initialize.outputs.args"
          }
        }
      },
      {
        "id": "update",
        "kind": "call",
        "operation": "update",
        "arguments": {
          "lake": {
            "ref": "steps.require_lake.outputs.lake"
          },
          "allow_mutating": {
            "ref": "inputs.allow_mutating"
          }
        }
      },
      {
        "id": "build",
        "kind": "call",
        "operation": "build",
        "arguments": {
          "lake": {
            "ref": "steps.require_lake.outputs.lake"
          },
          "updated": {
            "ref": "steps.update.outputs.done"
          },
          "allow_mutating": {
            "ref": "inputs.allow_mutating"
          }
        }
      },
      {
        "id": "complete",
        "kind": "call",
        "operation": "complete",
        "arguments": {
          "built": {
            "ref": "steps.build.outputs.done"
          }
        }
      }
    ],
    "outputs": {
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.complete.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          ".lake/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked setup description only; completion establishes neither scientific results nor runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "scripts/install_env.py",
