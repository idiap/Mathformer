    "mathformer.execution": {
      "component_owner": "autoformalization-reflective-refinement-loop",
      "cross_invocation_state": "Explicit baseline snapshot of successful-case flags and metrics; never a checkpoint.",
      "iteration": "One pass; finite local accumulation only, with no retries, convergence driver or exhaustion signal.",
      "failures": "Uncaught input/I/O errors abort; partial files and observer events may remain.",
      "limits": "Descriptor host ceilings; native main has no timeout. The slow-test caller alone uses 90 seconds.",
      "callers": "Slow deterministic tests and a matrix help smoke check; PRISM projections are separate entrypoints.",
      "parser": "Null argv retains argparse process-argument semantics; supply an explicit argv array for a portable invocation. Native help yields null packet and exit 0; parser errors fail the bound operation."
    }
  }
