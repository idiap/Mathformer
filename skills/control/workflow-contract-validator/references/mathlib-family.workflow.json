    },
    "snapshot": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        },
        "cursor": {
          "type": "Cursor"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_mathlib_family_snapshot",
          "operation": "mathformer_mathlib_family_snapshot"
        }
      }
    },
    "prepare": {
      "inputs": {
        "args": {
          "type": "Args"
        },
        "matrix": {
          "type": "Matrix",
          "required": false
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_mathlib_family_prepare",
          "operation": "mathformer_mathlib_family_prepare"
        }
      }
    },
    "pending": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "pending": {
          "type": "Bool"
        },
        "cursor": {
          "type": "Cursor"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_mathlib_family_pending",
          "operation": "mathformer_mathlib_family_pending"
        }
      }
    },
    "advance": {
      "inputs": {
        "cursor": {
          "type": "Cursor"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_mathlib_family_advance",
          "operation": "mathformer_mathlib_family_advance"
        }
      }
    },
    "retain": {
      "inputs": {
        "cursor": {
          "type": "Cursor"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "cursor": {
          "type": "Cursor"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_mathlib_family_retain",
          "operation": "mathformer_mathlib_family_retain"
        }
      }
    },
    "snapshot_result": {
      "inputs": {
        "cursor": {
          "type": "Cursor"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
