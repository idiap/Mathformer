{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_family_mathlib_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Native mathlib run() traversal with early snapshot, ordered checks and finalization; bounded to nine selected rows.",
