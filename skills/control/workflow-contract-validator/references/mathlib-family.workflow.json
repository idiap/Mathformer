        "properties": {
          "run_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "schema_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matrix_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capability_ledger": {
            "type": "object"
          },
          "dependency_map": {
            "type": "string"
          }
        }
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "handle"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "Cursor": {
      "schema": {
        "type": "object",
        "required": [
          "pending"
        ],
        "properties": {
          "pending": {
            "type": "boolean"
          },
          "state": {
            "type": "object",
            "required": [
              "matrix",
              "selected",
              "families",
              "index",
              "results"
            ],
            "properties": {
              "matrix": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "selected": {
                "type": "array",
                "maxItems": 9,
                "items": {
                  "type": "object"
                }
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "results": {
                "type": "array",
                "maxItems": 9,
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
