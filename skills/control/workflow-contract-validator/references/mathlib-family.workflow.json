          "kind": "tool",
          "target": "mathformer_mathlib_family_snapshot_result",
          "operation": "mathformer_mathlib_family_snapshot_result"
        }
      }
    },
    "finalize": {
      "inputs": {
        "cursor": {
          "type": "Cursor"
        },
        "args": {
          "type": "Args"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_mathlib_family_finalize",
          "operation": "mathformer_mathlib_family_finalize"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "enter",
        "kind": "call",
        "operation": "enter",
        "arguments": {
          "args": {
            "ref": "inputs.args"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "selected",
            "when": {
              "ref": "steps.enter.outputs.snapshot_only"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "snapshot",
                  "kind": "call",
                  "operation": "snapshot",
                  "arguments": {
                    "args": {
                      "ref": "inputs.args"
                    },
                    "context": {
                      "ref": "steps.enter.outputs.context"
                    }
                  }
                }
              ],
              "outputs": {
                "cursor": {
                  "type": "Cursor",
                  "value": {
                    "ref": "steps.snapshot.outputs.cursor"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "prepare",
              "kind": "call",
              "operation": "prepare",
              "arguments": {
                "args": {
                  "ref": "inputs.args"
                },
                "matrix": {
                  "ref": "inputs.matrix"
                },
                "context": {
                  "ref": "steps.enter.outputs.context"
                }
              }
            },
            {
              "id": "initial_guard",
              "kind": "call",
              "operation": "pending",
              "arguments": {
                "state": {
                  "ref": "steps.prepare.outputs.state"
                },
                "context": {
                  "ref": "steps.enter.outputs.context"
                }
              }
            }
          ],
          "outputs": {
            "cursor": {
              "type": "Cursor",
              "value": {
                "ref": "steps.initial_guard.outputs.cursor"
              }
            }
          }
        },
        "outputs": {
          "cursor": {
            "type": "Cursor",
            "value": {
              "ref": "selected.outputs.cursor"
            }
          }
        }
      },
      {
        "id": "checks",
        "kind": "loop",
        "state_type": "Cursor",
        "initial": {
          "ref": "steps.dispatch.outputs.cursor"
        },
        "max_iterations": 9,
        "on_exhausted": "fail",
        "body": {
          "id": "pending_check",
          "kind": "switch",
          "cases": [
            {
              "id": "selected",
              "when": {
                "ref": "loop.state.pending"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "cursor": {
                        "ref": "loop.state"
                      },
                      "args": {
                        "ref": "inputs.args"
                      },
                      "context": {
                        "ref": "steps.enter.outputs.context"
                      }
                    }
                  },
                  {
                    "id": "guard",
                    "kind": "call",
                    "operation": "pending",
                    "arguments": {
                      "state": {
                        "ref": "steps.advance.outputs.state"
                      },
                      "context": {
                        "ref": "steps.enter.outputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "cursor": {
                    "type": "Cursor",
                    "value": {
                      "ref": "steps.guard.outputs.cursor"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "id": "retain",
            "kind": "call",
            "operation": "retain",
            "arguments": {
              "cursor": {
                "ref": "loop.state"
              },
              "context": {
                "ref": "steps.enter.outputs.context"
              }
            }
          },
          "outputs": {
            "cursor": {
              "type": "Cursor",
              "value": {
                "ref": "selected.outputs.cursor"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.cursor"
        },
        "until": {
          "not": {
            "ref": "body.outputs.cursor.pending"
          }
        },
        "outputs": {
          "cursor": {
            "type": "Cursor",
            "value": {
              "ref": "body.outputs.cursor"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "switch",
        "cases": [
          {
            "id": "selected",
            "when": {
              "ref": "steps.enter.outputs.snapshot_only"
            },
            "body": {
              "id": "snapshot_result",
              "kind": "call",
              "operation": "snapshot_result",
              "arguments": {
                "cursor": {
                  "ref": "steps.checks.outputs.cursor"
                },
                "args": {
                  "ref": "inputs.args"
                },
                "context": {
                  "ref": "steps.enter.outputs.context"
                }
              }
            }
          }
        ],
        "default": {
          "id": "finalize",
          "kind": "call",
          "operation": "finalize",
          "arguments": {
            "cursor": {
              "ref": "steps.checks.outputs.cursor"
            },
            "args": {
              "ref": "inputs.args"
            },
            "context": {
              "ref": "steps.enter.outputs.context"
            }
          }
        },
        "outputs": {
          "report": {
            "type": "Report",
            "value": {
              "ref": "selected.outputs.report"
            }
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
