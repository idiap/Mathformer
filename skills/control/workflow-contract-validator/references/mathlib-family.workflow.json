        "additionalProperties": false
      }
    },
    "Matrix": {
      "representation": "value",
      "schema": {
        "description": "Assertion equal to canonical tests/test_matrix.json; never an alternate command source. Required only on the normal path.",
        "type": "object",
        "required": [
          "schema_version",
          "tests"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            },
            "contains": {
              "type": "object",
              "required": [
                "module_family"
              ],
              "properties": {
                "module_family": {
                  "const": "mathlib"
                }
              }
            },
            "minContains": 0,
            "maxContains": 9
          }
        }
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "matrix",
          "selected",
          "families",
          "index",
          "results"
        ],
        "properties": {
          "matrix": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "object"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "results": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
