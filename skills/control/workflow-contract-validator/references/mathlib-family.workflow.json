    "gaps": [
      "Normal-path inputs require canonical matrix equality and at most nine mathlib rows, with changed-files selection disabled; native run has no row cap. Both MCP preparation and contract admission reject overflow without truncation.",
      "Hub preflight/dry-run/subprocess capture/write auditing and main publication remain enclosing native boundaries, not nodes inside run(). The 900-second ceiling is retained from the native hub.",
      "Network/external effects inherit the native binding capabilities and require host qualification; the descriptor does not grant new authority."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "test:family:mathlib",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "test:family:mathlib",
        "summary": "Run the comprehensive test matrix for the mathlib module family.",
        "family": "mathlib",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/test_program/run_comprehensive_tests.py",
          "--module-family",
          "mathlib",
          "--json"
        ],
        "writes": [
          "artifacts/"
        ],
        "allows_extra_args": false,
        "timeout_seconds": 900
      }
    },
    "mathformer.native_boundary": {
      "execution": "Hub run_action delegates to run_leaf_action; mathlib.grounding selects this action.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "defaults": {
        "profile": "workstation",
        "validate_matrix": false,
        "emit_dependency_map_only": false,
        "fail_on_warning": false,
        "changed_files_only": false
      },
      "publication": "main calls run then publish_report, writes JSON and optional JSONL/JUnit, prints JSON for the registered invocation and exits 0 if ok else 3.",
      "failure_policy": "Ordinary check failures return report.ok=false after traversal; unexpected exceptions propagate. Hub timeout terminates the subprocess.",
      "limits": "Nine current mathlib rows use 120/240/480-second per-check timeouts; the enclosing hub allows 900 seconds. The former generated 3600-second limit is not native."
    },
    "mathformer.operation_semantics": {
      "enter": "Native enter_checks creates the artifact root and evaluates emit_dependency_map_only.",
      "snapshot": "Native snapshot_report writes the early dependency snapshot; cursor marks no pending work.",
      "prepare": "Assert canonical matrix equality, invoke native prepare_checks and reject selections above nine; absent matrix fails only on this normal branch.",
      "pending": "Native checks_pending is the while guard. Cursor envelopes retain unmodified source state.",
      "advance": "Native advance_check runs one source check and accumulates its result, including ordinary failures; unexpected exceptions propagate.",
      "retain": "Typed identity adapter for zero checks or a completed early snapshot; invokes no source check or guard.",
      "snapshot_result": "Consume and return the exact report already produced by snapshot_report, with no repeated source effects.",
      "finalize": "Native finalize_checks requires full consumption, validates schemas/optional coverage, aggregates capabilities and writes the dependency snapshot."
    },
    "mathformer.runtime_adaptation": {
      "activation": "Explicit invocation is preserved. On the normal path prepare requires the optional canonical-matrix assertion; snapshot has no matrix requirement.",
      "topology": "Lunar rejects branch-local loop exhaustion. A root-level bounded loop carries a Cursor envelope. An identity retain adapter carries zero checks or an already-written snapshot through one administrative iteration; no native guard or check is added. snapshot_result returns the owned early report without effects.",
      "native_order": "enter_checks -> snapshot_report OR prepare_checks -> checks_pending -> (advance_check -> checks_pending)* -> finalize_checks",
      "context": "A server-owned invocation handle validates exact arguments, source state, cursor and call phases. Every port rechecks service authorization. Terminal report delivery consumes the handle.",
      "observability": "Native check results, write audits, stdout excerpts, fingerprints, capability ledger and dependency snapshot remain source-owned. Lunar produces execution events, digests, effect records and replay artifacts."
    }
  }
}
