        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "mathformer_run_workflow; _cap_unbounded_timeouts",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/quality_smoke_route_tools.py",
        "selector": "register_quality_smoke_route_tools; selected_match; checked_registry; check_state",
        "digest": "sha256:60e4857ce134821020376913e04920f407dd0d1cb995991aa32d63b353dda2f5"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "quality_smoke_route_descriptor; inventory",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Recursive dependency traversal and leaf internals remain inside the bound execute_action native call rather than expanded graph nodes.",
      "Registry JSON selects exact native action declarations (subsets retain unknown-action failures); arbitrary caller-supplied commands are not admitted by MCP.",
      "RouteState children require structural ok only; HubResult validates the complete child output and final transport envelope.",
      "The enclosing Lunar runtime enforces the five-call and 3600-second limits; the native CLI has no equivalent global budget.",
      "Lunar supplies mandatory execution receipts and provenance; native optional logs alone do not implement v1 receipts. Effects remain native declarations, with service write-root checks rather than an OS sandbox."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "quality.smoke",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "quality.smoke",
        "title": "Run the compact quality gate",
        "description": "Use for ordinary development changes when the user wants a broad but practical sanity check.",
        "action_ids": [
          "quality:smoke"
        ],
        "skill_routes": [
          "workflow-contract-validator",
          "skill-hook-coverage-maximizer"
        ],
        "operator_note": "Runs control, quick, docs, Rocq, and KB checks."
      }
    },
    "mathformer.native_boundary": {
      "execution": "Five registered MCP tools reuse the native run_intent_match steps. execute_action calls run_action unchanged; no general-purpose v1 interpreter is added to Mathformer.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "failure_policy": "Preserve native ok/status failure data; propagate unexpected launch errors.",
      "scientific_payloads": "HubResult is a transport envelope, not backend reports or proof artifacts.",
      "caller_controls": "Native route and registry projections are validated; scoring evidence is retained. Registry subsets retain unknown-action handling. Service read-only and write-root ceilings apply before non-dry execution.",
      "timeout_policy": "Native CLI retains declared timeouts, including None. The execute_action MCP binding uses the configurable service cap (default 600 seconds) only for otherwise unbounded leaves."
    },
    "mathformer.composition": {
      "ordered_actions": [
        "quality:smoke"
      ],
      "action_workflows": [
        "hub_quality_smoke_workflow"
      ],
      "keep_going_semantics": "Both native traversal levels stop on failure unless context.keep_going; aggregate success remains false after failure.",
      "selection": "Already selected canonical native route; NL scoring and ambiguity resolution remain native."
    }
  }
