  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "context": {
            "ref": "inputs.context"
          },
          "repository_root": {
            "ref": "inputs.repository_root"
          },
          "extra_args": {
            "ref": "inputs.extra_args"
          },
          "seen": {
            "ref": "inputs.seen"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "launch",
            "when": {
              "ref": "steps.prepare.outputs.execute"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "load",
                  "kind": "call",
                  "operation": "load",
                  "arguments": {
                    "boundary": {
                      "ref": "steps.prepare.outputs.boundary"
                    }
                  }
                },
                {
                  "id": "loaded",
                  "kind": "switch",
                  "cases": [
                    {
                      "id": "read_success",
                      "when": {
                        "ref": "steps.load.outputs.loaded_ok"
                      },
                      "body": {
                        "kind": "sequence",
                        "steps": [
                          {
                            "id": "build",
                            "kind": "call",
                            "operation": "build",
                            "arguments": {
                              "loaded": {
                                "ref": "steps.load.outputs.loaded"
                              }
                            }
                          },
                          {
                            "id": "planned",
                            "kind": "switch",
                            "cases": [
                              {
                                "id": "build_success",
                                "when": {
                                  "ref": "steps.build.outputs.plan_ok"
                                },
                                "body": {
                                  "kind": "sequence",
                                  "steps": [
                                    {
                                      "id": "publish",
                                      "kind": "call",
                                      "operation": "publish",
                                      "arguments": {
                                        "loaded": {
                                          "ref": "steps.load.outputs.loaded"
                                        },
                                        "plan": {
                                          "ref": "steps.build.outputs.plan"
                                        }
                                      }
                                    },
                                    {
                                      "id": "finish_written",
                                      "kind": "call",
                                      "operation": "finish",
                                      "arguments": {
                                        "boundary": {
                                          "ref": "steps.prepare.outputs.boundary"
                                        },
                                        "process": {
                                          "ref": "steps.publish.outputs.process"
                                        }
                                      }
                                    }
                                  ],
                                  "outputs": {
                                    "result": {
                                      "type": "HubResult",
                                      "value": {
                                        "ref": "steps.finish_written.outputs.result"
                                      }
                                    }
                                  }
                                }
                              }
                            ],
                            "default": {
                              "kind": "call",
                              "operation": "finish",
                              "arguments": {
                                "boundary": {
                                  "ref": "steps.prepare.outputs.boundary"
                                },
                                "process": {
                                  "ref": "steps.build.outputs.process"
                                }
                              }
                            },
                            "outputs": {
                              "result": {
                                "type": "HubResult",
                                "value": {
                                  "ref": "selected.outputs.result"
                                }
                              }
                            }
                          }
                        ],
                        "outputs": {
                          "result": {
                            "type": "HubResult",
                            "value": {
                              "ref": "steps.planned.outputs.result"
                            }
                          }
                        }
                      }
                    }
                  ],
                  "default": {
                    "kind": "call",
                    "operation": "finish",
                    "arguments": {
                      "boundary": {
                        "ref": "steps.prepare.outputs.boundary"
                      },
                      "process": {
                        "ref": "steps.load.outputs.process"
                      }
                    }
                  },
                  "outputs": {
                    "result": {
                      "type": "HubResult",
                      "value": {
                        "ref": "selected.outputs.result"
                      }
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "HubResult",
                  "value": {
                    "ref": "steps.loaded.outputs.result"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "finish",
          "arguments": {
            "boundary": {
              "ref": "steps.prepare.outputs.boundary"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.dispatch.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
