  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          }
        },
        "description": "Normalize or strip; reject empty statement and nonpositive effective cycles. Apply exact native first-top-level dispatch predicate, including null seed/shared log/stack/cycle indices. Pack shared state; cap is 1 without delegation, otherwise 20 with enabled audit and non-null target, else 2.\n"
      },
      {
        "id": "cycles",
        "kind": "loop",
        "state_type": "CycleState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 20,
        "on_exhausted": "fail",
        "description": "Default-cap specialization; stop is true at native cap, returning normally. Exhaustion means an adapter invariant violation.",
        "body": {
          "kind": "sequence",
          "description": "Native invocation try/finally removes the active statement on normal return or any propagated error.",
          "steps": [
            {
              "id": "dependencies",
              "kind": "call",
              "operation": "dependencies",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                }
              },
              "description": "Normalize/validate each invocation. Sequentially resolve supplied dependencies using cached normalized statements or recursive calls sharing cache, active stack and reasoning log. Reject cycles; keep the statement active until invocation exits. No recursion-depth bound. Compute expansion guard from flag and configuration.\n"
            },
            {
              "id": "expansion",
              "kind": "switch",
              "cases": [
                {
                  "id": "enabled_configured",
                  "when": {
                    "ref": "steps.dependencies.outputs.expand"
                  },
                  "body": {
                    "kind": "call",
                    "operation": "expand",
                    "arguments": {
                      "invocation": {
                        "ref": "steps.dependencies.outputs.invocation"
                      }
                    },
                    "description": "Expand once. Empty output retains original; normalize nonempty output before use. Catch and log expansion exceptions and continue with native current locals.\n"
                  }
                }
              ],
              "default": {
                "kind": "call",
                "operation": "retain_statement",
                "arguments": {
                  "invocation": {
                    "ref": "steps.dependencies.outputs.invocation"
                  }
                }
              },
              "outputs": {
                "invocation": {
                  "type": "Invocation",
                  "value": {
                    "ref": "selected.outputs.invocation"
                  }
                }
              }
            },
            {
              "id": "review",
              "kind": "call",
              "operation": "review",
              "arguments": {
                "invocation": {
                  "ref": "steps.expansion.outputs.invocation"
                }
              },
              "description": "Skip suite without expansion; otherwise completeness then bindings, skipping missing reviewers. No reviews and no errors yields null; any error or non-True judgment yields false. Record results and continue regardless; no re-expansion or drafting gate.\n"
            },
            {
              "id": "prepare",
              "kind": "call",
              "operation": "prepare",
              "arguments": {
                "invocation": {
                  "ref": "steps.review.outputs.invocation"
                }
              },
              "description": "Extract source annotations, prepend dependency examples, optionally map concepts when enabled or alignment enforced, then construct alignment hints and optional dependency context. Keep native concept-loop helper and its configured bounds internal; mapping errors are recorded.\n"
            },
            {
              "id": "draft",
              "kind": "call",
              "operation": "draft",
              "arguments": {
                "invocation": {
                  "ref": "steps.prepare.outputs.invocation"
                }
              },
              "description": "Use non-null seed verbatim, otherwise draft from effective statement, examples, context and annotations."
            },
            {
              "id": "check_report_save",
              "kind": "call",
              "operation": "check_report_save",
              "arguments": {
                "invocation": {
                  "ref": "steps.draft.outputs.invocation"
                }
              },
              "description": "Hard-check initial code. Invoke native self.run only if correctness != \"True\", max_iterations > 0 and all three refiners/critics are configured; retain its internal algorithm and bounds. Otherwise final hard-check and history annotation. Save versions/output, check saved text, run configured audits/judges/consistency reporting, save history/statistics/report. Preserve native caught-error fallbacks; unhandled errors propagate and active stack is cleared.\n"
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "invocation": {
                  "ref": "steps.check_report_save.outputs.invocation"
                },
                "report": {
                  "ref": "steps.check_report_save.outputs.report"
                }
              },
              "description": "Pack last report, updated dependency cache/stack/log, previous final code and appended cycle summary. Increment cycle index only when continuing. Stop for single invocation, at cap, or when compatibility_target_met and (consistency disabled or consistency_target_met is True). Review success is not a stopping condition. Otherwise carry final code as next seed.\n"
            }
          ],
          "outputs": {
            "state": {
              "type": "CycleState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "stop": {
              "type": "Flag",
              "value": {
                "ref": "steps.advance.outputs.stop"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.stop"
        },
        "outputs": {
          "state": {
            "type": "CycleState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.cycles.outputs.state"
          }
        },
        "description": "Return direct report for single invocation. For delegated cycles, promote last artifacts, save manifest, optionally rerun consistency, save statistics/report and return last report even when targets were unmet.\n"
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      }
    }
  },
