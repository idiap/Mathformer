      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      },
      {
        "path": "tests/mcp/run_cross_backend_parity_workflow_tests.py",
        "digest": "sha256:be4eb007278569b7a94994f415269b89c44c10d01562007c133bdeb8925596f5"
      },
      {
        "path": "tests/mcp/fixtures/cross_backend_parity_original.py.txt",
        "digest": "sha256:0949dc4f0a02c38fe94490f09fe802d9bc715434e8e2f03cf8c399b3099b092c"
      }
    ],
    "gaps": [
      "Specialization admits at most 10000 aligned cases, checked after native preparation and before any packet build. At exactly 10000, normal completion occurs. Native iteration has no literal cap.",
      "3600 seconds and 30002 operation calls are descriptor budgets, not native bounds. Hub timeout is null; test-matrix caller uses 180 seconds.",
      "Packet internals remain an opaque native build_packet call. Required host receipts do not imply native checkpoint support."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "mathformerphysicslib:cross-backend-parity",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "family": "mathformerphysicslib",
      "kind": "validation",
      "safety": "read_only"
    },
    "mathformer.native_boundary": {
      "entrypoint": "tests/physics_sympy/run_cross_backend_parity_gate.py::main",
      "hub_dispatch": "run_action -> run_leaf_action; no dependencies; script --json",
      "timeout_seconds": null,
      "test_matrix_timeout_seconds": 180,
      "failure_policy": "Ordinary case mismatches accumulate; final blocked payload and exit 1. Uncaught exceptions abort without guaranteed payload.",
      "output_semantics": "report and exit_code model native payload/stdout and return code; blocked is a native payload terminal state.",
      "specialization": "case_cap=10000 is a contract admission restriction, not a native CLI argument; native manifest remains source-owned.",
      "context": "Optional manifest_path and artifact_root select real filesystem inputs; defaults retain native paths. prepare loads builder once, the plan carries a service-local module handle; no resume across service restarts.",
      "control_lowering": "Root bounded loop lowers the native pre-test guard to v1 post-test semantics. Empty manifests call prepare, empty (shared native accumulator initialization), then report. Nonempty case calls and state are unchanged. The empty adapter is necessary because Lunar does not support branch-local loop exhaustion or gates; it performs no packet work."
    }
  }
}
