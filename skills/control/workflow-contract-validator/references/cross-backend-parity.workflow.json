        "selector": "build_packet",
        "digest": "sha256:ee1f335e884f514984585f7b5126cf44aa268a8128e8aa22055f2e785b5d6559"
      },
      {
        "path": "libraries/MathformerPhysicsLib/physics_ir.py",
        "selector": "compare_backend_packets",
        "digest": "sha256:875d922159c63a2b2c6daa0967deb96dae577854e3f25b0be9fbbe2f703648b4"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry; run_action; run_leaf_action",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "tests/test_matrix.json",
        "selector": "direct parity gate invocation",
        "digest": "sha256:8e1be09e1de5379ce0f2fe4236ce826369a02e36a001a12787bcde8dcb61394a"
      },
      {
