{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_mathformerphysicslib_cross_backend_parity_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "One-pass shared-IR parity and exact backend coverage gate for promoted Lean/SymPy physics cases.",
  "aliases": [
    "mathformerphysicslib:cross-backend-parity"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Request": {
      "schema": {
        "type": "object",
        "description": "Admission restriction: the source-owned manifest must have at most case_cap aligned promoted Lean/SymPy cases. case_cap is specification metadata, not a native CLI flag.",
        "properties": {
          "json_output": {
            "type": "boolean"
          },
          "case_cap": {
            "const": 10000,
            "type": "integer"
          },
          "manifest_path": {
            "type": "string"
          },
          "artifact_root": {
            "type": "string"
          }
        },
        "required": [
          "json_output",
          "case_cap"
        ],
        "additionalProperties": false
      }
    },
    "Plan": {
      "schema": {
        "type": "object",
        "description": "Sorted manifest sets and aligned cases, with a service-local handle to the builder loaded in prepare and explicit artifact context.",
        "properties": {
          "aligned_cases": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string"
            }
          },
          "promoted": {
            "type": "object"
          },
          "registered": {
            "type": "object"
          },
          "builder_handle": {
            "type": "string"
          },
          "artifact_root": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "aligned_cases",
          "promoted",
          "registered",
          "builder_handle",
          "artifact_root"
        ]
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "CaseId": {
      "schema": {
        "type": "string"
      }
    },
    "Cases": {
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string"
            },
            "semantic_parity": {
              "type": "boolean"
            },
            "expected_backends": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observed_backends": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "coverage_ok": {
              "type": "boolean"
            },
            "source_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "ir_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "findings": {
              "type": "array"
            }
          },
          "required": [
            "case_id",
            "semantic_parity",
            "expected_backends",
            "observed_backends",
            "coverage_ok",
            "source_digest",
            "ir_digest",
            "findings"
          ]
        }
      }
    },
    "Packet": {
      "schema": {
        "type": "object",
        "description": "Native build_packet output, including nullable physics_ir, semantic_parity, validators and findings; exceptions are not converted into packets."
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "style": {
            "const": "physics_cross_backend_parity_gate"
          },
          "workflow_executed": {
            "const": true
          },
          "checks_passed": {
            "type": "boolean"
          },
          "artifact_status": {
            "const": "promoted"
          },
          "library_status": {
            "const": "accepted"
          },
          "release_ok": {
            "type": "boolean"
          },
          "case_count": {
            "type": "integer",
            "minimum": 0
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "coverage": {
            "type": "object"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terminal_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "schema_version",
          "style",
          "workflow_executed",
          "checks_passed",
          "artifact_status",
          "library_status",
          "release_ok",
          "case_count",
          "cases",
          "coverage",
          "blockers",
          "terminal_states"
        ]
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      }
    },
    "Stdout": {
      "schema": {
        "type": "string"
      }
    }
  },
  "inputs": {
    "request": {
      "type": "Request"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    },
    "stdout": {
      "type": "Stdout",
      "value": {
        "ref": "flow.outputs.stdout"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "request": {
          "type": "Request"
        }
      },
      "outputs": {
        "plan": {
          "type": "Plan"
        },
        "cases": {
          "type": "Cases"
        },
        "has_cases": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_parity_prepare",
          "operation": "mathformer_parity_prepare"
        }
      }
    },
    "select_case": {
      "inputs": {
        "plan": {
          "type": "Plan"
        },
        "cases": {
          "type": "Cases"
        }
      },
      "outputs": {
        "case_id": {
          "type": "CaseId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_parity_select_case",
          "operation": "mathformer_parity_select_case"
        }
      }
    },
    "build_packet": {
      "inputs": {
        "case_id": {
          "type": "CaseId"
        },
        "plan": {
          "type": "Plan"
        }
      },
      "outputs": {
        "packet": {
          "type": "Packet"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_parity_build_packet",
          "operation": "mathformer_parity_build_packet"
        }
      }
    },
    "append_case": {
      "inputs": {
        "plan": {
          "type": "Plan"
        },
        "cases": {
          "type": "Cases"
        },
        "case_id": {
          "type": "CaseId"
        },
        "packet": {
          "type": "Packet"
        }
      },
      "outputs": {
        "cases": {
          "type": "Cases"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_parity_append_case",
          "operation": "mathformer_parity_append_case"
        }
      }
    },
    "report": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "plan": {
          "type": "Plan"
        },
        "cases": {
          "type": "Cases"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        },
        "exit_code": {
          "type": "ExitCode"
        },
        "stdout": {
          "type": "Stdout"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_parity_report",
          "operation": "mathformer_parity_report"
        }
      }
    },
    "empty": {
      "inputs": {},
      "outputs": {
        "cases": {
          "type": "Cases"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_parity_empty",
          "operation": "mathformer_parity_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          }
        }
      },
      {
        "id": "scan",
        "kind": "loop",
        "state_type": "Cases",
        "initial": {
          "ref": "steps.prepare.outputs.cases"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "steps.prepare.outputs.has_cases"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "select",
                    "kind": "call",
                    "operation": "select_case",
                    "arguments": {
                      "plan": {
                        "ref": "steps.prepare.outputs.plan"
                      },
                      "cases": {
                        "ref": "loop.state"
                      }
                    }
                  },
                  {
                    "id": "packet",
                    "kind": "call",
                    "operation": "build_packet",
                    "arguments": {
                      "case_id": {
                        "ref": "steps.select.outputs.case_id"
                      },
                      "plan": {
                        "ref": "steps.prepare.outputs.plan"
                      }
                    }
                  },
                  {
                    "id": "append",
                    "kind": "call",
                    "operation": "append_case",
                    "arguments": {
                      "plan": {
                        "ref": "steps.prepare.outputs.plan"
                      },
                      "cases": {
                        "ref": "loop.state"
                      },
                      "case_id": {
                        "ref": "steps.select.outputs.case_id"
                      },
                      "packet": {
                        "ref": "steps.packet.outputs.packet"
                      }
                    }
                  }
                ],
                "outputs": {
                  "cases": {
                    "type": "Cases",
                    "value": {
                      "ref": "steps.append.outputs.cases"
                    }
                  },
                  "done": {
                    "type": "Flag",
                    "value": {
                      "ref": "steps.append.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "empty",
            "arguments": {}
          },
          "outputs": {
            "cases": {
              "type": "Cases",
              "value": {
                "ref": "selected.outputs.cases"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.cases"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "cases": {
            "type": "Cases",
            "value": {
              "ref": "body.outputs.cases"
            }
          }
        }
      },
      {
        "id": "report",
        "kind": "call",
        "operation": "report",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          },
          "plan": {
            "ref": "steps.prepare.outputs.plan"
          },
          "cases": {
            "ref": "steps.scan.outputs.cases"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.report.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.report.outputs.exit_code"
        }
      },
      "stdout": {
        "type": "Stdout",
        "value": {
          "ref": "steps.report.outputs.stdout"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "inspect_backend_artifacts",
        "report_semantic_alignment"
      ],
      "forbidden": [
        "promote_artifacts",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 30002
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Shared-IR alignment and exact coverage only; no backend compilation, scientific correctness, or promotion is established."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "tests/physics_sympy/run_cross_backend_parity_gate.py",
