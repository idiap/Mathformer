{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_paper_mechanistic_diagram_model_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Parse arguments, construct a fixed preset diagram, write JSON once, report and return 0.",
  "aliases": [
    "paper:mechanistic-diagram-model"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "required": [
          "preset",
          "output",
          "json",
          "halted"
        ],
        "properties": {
          "preset": {
            "enum": [
              "mathformer-framework",
              "observability-stack"
            ]
          },
          "output": {
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "halted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Diagram": {
      "schema": {
        "type": "object",
        "required": [
          "id",
          "title",
          "caption",
          "layers",
          "nodes",
          "edges",
          "validation_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "validation_criteria": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "representation": "value"
    },
    "DiagramFile": {
      "schema": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "id",
              "title",
              "caption",
              "layers",
              "nodes",
              "edges",
              "validation_criteria"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "validation_criteria": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "representation": "file",
      "media_type": "application/json"
    },
    "Path": {
      "schema": {
        "type": "string"
      }
    },
    "Report": {
      "schema": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "output",
              "node_count",
              "edge_count"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "output": {
                "type": "string"
              },
              "node_count": {
                "type": "integer",
                "minimum": 0
              },
              "edge_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "const": 0
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    }
  },
  "outputs": {
    "diagram": {
      "type": "DiagramFile",
      "value": {
        "ref": "flow.outputs.diagram"
      }
    },
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    }
  },
  "operations": {
    "parse_arguments": {
      "inputs": {
        "argv": {
          "type": "Argv"
        }
      },
      "outputs": {
        "options": {
          "type": "Options"
        },
        "help_report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_diagram_parse",
          "operation": "mathformer_diagram_parse"
        }
      }
    },
    "construct_model": {
      "inputs": {
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "model": {
          "type": "Diagram"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_diagram_construct",
          "operation": "mathformer_diagram_construct"
        }
      }
    },
    "write_model": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "model": {
          "type": "Diagram"
        }
      },
      "outputs": {
        "diagram": {
          "type": "DiagramFile"
        },
        "output": {
          "type": "Path"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_diagram_write",
          "operation": "mathformer_diagram_write"
        }
      }
    },
    "report_and_return": {
      "inputs": {
        "options": {
          "type": "Options"
        },
        "model": {
          "type": "Diagram"
        },
        "output": {
          "type": "Path"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        },
        "exit_code": {
          "type": "ExitCode"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_diagram_report",
          "operation": "mathformer_diagram_report"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "parse",
        "kind": "call",
        "operation": "parse_arguments",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "help",
            "when": {
              "ref": "steps.parse.outputs.options.halted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "halt",
                  "kind": "gate",
                  "condition": {
                    "literal": true
                  },
                  "on_false": "fail"
                }
              ],
              "outputs": {
                "diagram": {
                  "type": "DiagramFile",
                  "value": {
                    "literal": null
                  }
                },
                "report": {
                  "type": "Report",
                  "value": {
                    "ref": "steps.parse.outputs.help_report"
                  }
                },
                "exit_code": {
                  "type": "ExitCode",
                  "value": {
                    "literal": 0
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "construct",
              "kind": "call",
              "operation": "construct_model",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                }
              }
            },
            {
              "id": "write",
              "kind": "call",
              "operation": "write_model",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                },
                "model": {
                  "ref": "steps.construct.outputs.model"
                }
              }
            },
            {
              "id": "report",
              "kind": "call",
              "operation": "report_and_return",
              "arguments": {
                "options": {
                  "ref": "steps.parse.outputs.options"
                },
                "model": {
                  "ref": "steps.construct.outputs.model"
                },
                "output": {
                  "ref": "steps.write.outputs.output"
                }
              }
            }
          ],
          "outputs": {
            "diagram": {
              "type": "DiagramFile",
              "value": {
                "ref": "steps.write.outputs.diagram"
              }
            },
            "report": {
              "type": "Report",
              "value": {
                "ref": "steps.report.outputs.report"
              }
            },
            "exit_code": {
              "type": "ExitCode",
              "value": {
                "ref": "steps.report.outputs.exit_code"
              }
            }
          }
        },
        "outputs": {
          "diagram": {
            "type": "DiagramFile",
            "value": {
              "ref": "selected.outputs.diagram"
            }
          },
          "report": {
            "type": "Report",
            "value": {
              "ref": "selected.outputs.report"
            }
          },
          "exit_code": {
            "type": "ExitCode",
            "value": {
              "ref": "selected.outputs.exit_code"
            }
          }
        }
      }
    ],
    "outputs": {
      "diagram": {
        "type": "DiagramFile",
        "value": {
          "ref": "steps.dispatch.outputs.diagram"
        }
      },
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.dispatch.outputs.report"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.dispatch.outputs.exit_code"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "cli_output_path_and_parent_directories",
          "artifacts/paper_skills/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 4
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Diagram generation only; feedback edges and validation criteria are data, not executed scientific validation."
  },
  "observability": {
