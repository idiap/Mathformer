          },
          "assessment": {
            "ref": "steps.r.outputs.assessment"
          }
        }
      },
      {
        "id": "terminal",
        "kind": "switch",
        "description": "e.accepted_for_scope accepts; e.reconstruction_gap and e.refuted stop. No subsequent stages.",
        "cases": [
          {
            "id": "accepted_for_scope",
            "when": {
              "eq": [
                {
                  "ref": "steps.e.outputs.physics_status"
                },
                {
                  "literal": "accepted_for_scope"
                }
              ]
            },
            "body": {
              "kind": "call",
              "operation": "accept",
              "arguments": {
                "physics_status": {
                  "ref": "steps.e.outputs.physics_status"
                }
              }
            }
          },
          {
            "id": "reconstruction_gap",
            "when": {
              "eq": [
                {
                  "ref": "steps.e.outputs.physics_status"
                },
                {
                  "literal": "reconstruction_gap"
                }
              ]
            },
            "body": {
              "kind": "call",
              "operation": "stop",
              "arguments": {
                "physics_status": {
                  "ref": "steps.e.outputs.physics_status"
                }
              }
            }
          },
          {
            "id": "refuted",
            "when": {
              "eq": [
                {
                  "ref": "steps.e.outputs.physics_status"
                },
                {
                  "literal": "refuted"
                }
              ]
            },
            "body": {
              "kind": "call",
              "operation": "stop",
              "arguments": {
                "physics_status": {
                  "ref": "steps.e.outputs.physics_status"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "stop",
          "arguments": {
            "physics_status": {
              "ref": "steps.e.outputs.physics_status"
            }
          },
          "description": "Unreachable for the closed Decision enum; required structural default adds no epistemic outcome."
        },
        "outputs": {
          "physics_status": {
            "type": "Decision",
            "value": {
              "ref": "steps.e.outputs.physics_status"
            }
          }
        }
      }
    ],
    "outputs": {
      "physics_status": {
        "type": "Decision",
