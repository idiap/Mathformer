{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_lean_backend_suite_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Fixed Lean physics backend suite; collect plans, check fixtures, run regressions, and write candidate evidence.",
  "aliases": [
    "physics-lean:backend-suite"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Evidence": {
      "schema": {
        "type": "object",
        "required": [
          "consistency",
          "fresh_compile",
          "generative",
          "monitor",
          "objects",
          "workbench",
          "case_dir"
        ],
        "properties": {
          "consistency": {
            "type": "object"
          },
          "fresh_compile": {
            "type": "object"
          },
          "generative": {
            "type": "object"
          },
          "monitor": {
            "type": "object"
          },
          "objects": {
            "type": "object"
          },
          "workbench": {
            "type": "object"
          },
          "case_dir": {
            "type": "string"
          }
        }
      }
    },
    "PlanState": {
      "schema": {
        "type": "object",
        "required": [
          "cursor",
          "repair_reports",
          "repair_paths"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "repair_reports": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "repair_paths": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ArgState": {
      "schema": {
        "type": "object",
        "required": [
          "cursor",
          "repair_args"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "repair_args": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "AdversarialState": {
      "schema": {
        "type": "object",
        "required": [
          "cursor",
          "all_ok",
          "results"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "all_ok": {
            "type": "boolean"
          },
          "results": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    },
    "CheckReport": {
      "schema": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "ControlledReport": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "checks",
          "artifact_status",
          "library_status",
          "blockers",
          "terminal_states",
          "release_ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "artifact_status": {
            "const": "candidate"
          },
          "library_status": {
            "enum": [
              "accepted",
              "blocked"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terminal_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "release_ok": {
            "const": false
          }
        }
      }
    },
    "SuiteReport": {
      "representation": "file",
      "media_type": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "release_ok",
          "artifact_status",
          "controlled_artifact",
          "adversarial",
          "derivation_completeness",
          "grounded_sample_thoroughness",
          "artifact_root"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "release_ok": {
            "type": "boolean",
            "const": false
          },
          "artifact_status": {
            "const": "candidate"
          },
          "controlled_artifact": {
            "type": "object"
          },
          "adversarial": {
            "type": "object"
          },
          "derivation_completeness": {
            "type": "object"
          },
          "grounded_sample_thoroughness": {
            "type": "object"
          },
          "artifact_root": {
            "const": "artifacts/physics_lean/backend_suite"
          }
        }
      }
    }
  },
  "inputs": {},
  "outputs": {
    "report": {
      "type": "SuiteReport",
      "value": {
        "ref": "flow.outputs.report"
      }
    },
    "ok": {
      "type": "Bool",
      "value": {
        "ref": "flow.outputs.report.ok"
      }
    },
    "release_ok": {
      "type": "Bool",
      "value": {
        "ref": "flow.outputs.report.release_ok"
      }
    }
  },
  "operations": {
    "prepare_controlled": {
      "inputs": {},
      "outputs": {
        "evidence": {
          "type": "Evidence"
        },
        "state": {
          "type": "PlanState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_prepare_controlled",
          "operation": "mathformer_physics_backend_prepare_controlled"
        }
      }
    },
    "collect_plan": {
      "inputs": {
        "evidence": {
          "type": "Evidence"
        },
        "state": {
          "type": "PlanState"
        }
      },
      "outputs": {
        "state": {
          "type": "PlanState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_collect_plan",
          "operation": "mathformer_physics_backend_collect_plan"
        }
      }
    },
    "begin_arguments": {
      "inputs": {
        "plans": {
          "type": "PlanState"
        }
      },
      "outputs": {
        "state": {
          "type": "ArgState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_begin_arguments",
          "operation": "mathformer_physics_backend_begin_arguments"
        }
      }
    },
    "append_argument": {
      "inputs": {
        "plans": {
          "type": "PlanState"
        },
        "state": {
          "type": "ArgState"
        }
      },
      "outputs": {
        "state": {
          "type": "ArgState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_append_argument",
          "operation": "mathformer_physics_backend_append_argument"
        }
      }
    },
    "finish_controlled": {
      "inputs": {
        "evidence": {
          "type": "Evidence"
        },
        "plans": {
          "type": "PlanState"
        },
        "args": {
          "type": "ArgState"
        }
      },
      "outputs": {
        "report": {
          "type": "ControlledReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_finish_controlled",
          "operation": "mathformer_physics_backend_finish_controlled"
        }
      }
    },
    "begin_adversarial": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "AdversarialState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_begin_adversarial",
          "operation": "mathformer_physics_backend_begin_adversarial"
        }
      }
    },
    "check_fixture": {
      "inputs": {
        "state": {
          "type": "AdversarialState"
        }
      },
      "outputs": {
        "state": {
          "type": "AdversarialState"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_check_fixture",
          "operation": "mathformer_physics_backend_check_fixture"
        }
      }
    },
    "derivation_regression": {
      "inputs": {},
      "outputs": {
        "report": {
          "type": "CheckReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_derivation_regression",
          "operation": "mathformer_physics_backend_derivation_regression"
        }
      }
    },
    "thoroughness_regression": {
      "inputs": {},
      "outputs": {
        "report": {
          "type": "CheckReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_thoroughness_regression",
          "operation": "mathformer_physics_backend_thoroughness_regression"
        }
      }
    },
    "write_suite": {
      "inputs": {
        "controlled": {
          "type": "ControlledReport"
        },
        "adversarial": {
          "type": "AdversarialState"
        },
        "derivation": {
          "type": "CheckReport"
        },
        "thoroughness": {
          "type": "CheckReport"
        }
      },
      "outputs": {
        "report": {
          "type": "SuiteReport"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_physics_backend_write_suite",
          "operation": "mathformer_physics_backend_write_suite"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare_controlled",
        "arguments": {}
      },
      {
        "id": "plans",
        "kind": "loop",
        "description": "Native ordered plans are notational_collapse, abstraction_elevation, proof_strategy, implicit_premise.",
        "state_type": "PlanState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "collect_plan",
          "arguments": {
            "evidence": {
              "ref": "steps.prepare.outputs.evidence"
            },
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 4,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "PlanState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "args_init",
        "kind": "call",
        "operation": "begin_arguments",
        "arguments": {
          "plans": {
            "ref": "steps.plans.outputs.state"
          }
        }
      },
      {
        "id": "args",
        "kind": "loop",
        "description": "Assemble CLI arguments after every repair plan has been collected.",
        "state_type": "ArgState",
        "initial": {
          "ref": "steps.args_init.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "append_argument",
          "arguments": {
            "plans": {
              "ref": "steps.plans.outputs.state"
            },
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 4,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "ArgState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "controlled",
        "kind": "call",
        "operation": "finish_controlled",
        "arguments": {
          "evidence": {
            "ref": "steps.prepare.outputs.evidence"
          },
          "plans": {
            "ref": "steps.plans.outputs.state"
          },
          "args": {
            "ref": "steps.args.outputs.state"
          }
        }
      },
      {
        "id": "fixtures_init",
        "kind": "call",
        "operation": "begin_adversarial",
        "arguments": {}
      },
      {
        "id": "fixtures",
        "kind": "loop",
        "description": "Visit raw_scalar_erasure, target_as_assumption, missing_dimensions, silent_strengthening, missing_frame_conventions; false checks never stop iteration.",
        "state_type": "AdversarialState",
        "initial": {
          "ref": "steps.fixtures_init.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "check_fixture",
          "arguments": {
            "state": {
              "ref": "loop.state"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 5,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "AdversarialState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "derivation",
        "kind": "call",
        "operation": "derivation_regression",
        "arguments": {}
      },
      {
        "id": "thoroughness",
        "kind": "call",
        "operation": "thoroughness_regression",
        "arguments": {}
      },
      {
        "id": "write",
        "kind": "call",
        "operation": "write_suite",
        "arguments": {
          "controlled": {
            "ref": "steps.controlled.outputs.report"
          },
          "adversarial": {
            "ref": "steps.fixtures.outputs.state"
          },
          "derivation": {
            "ref": "steps.derivation.outputs.report"
          },
          "thoroughness": {
            "ref": "steps.thoroughness.outputs.report"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "SuiteReport",
        "value": {
          "ref": "steps.write.outputs.report"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/physics_lean/backend_suite/",
          "artifacts/workflow_hub/",
          "artifacts/physics_lean/derivation_completeness_regression/",
          "artifacts/physics_lean/grounded_sample_thoroughness/",
          "artifacts/physics_lean/derivation_completeness_self_test/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 20
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Candidate regression evidence only; suite ok is separate from release_ok and never promotes the artifact."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
