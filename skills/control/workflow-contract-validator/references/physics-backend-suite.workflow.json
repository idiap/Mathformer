    "mathformer.native_boundary": {
      "execution": "Hub build_registry registers --json; run_action/run_leaf_action own preflight, dry-run, subprocess execution and write audit. This graph describes run_suite only after dispatch.",
      "intent_route": "validate.physics.lean.backend",
      "failure_policy": "run_json nonzero exits and uncaught load/parse errors raise immediately; a fresh compile nonzero exit is recorded as compiled=false and processing continues. Boolean failures are report data and do not stop subsequent stages.",
      "terminal_policy": "main exits 0 iff aggregate ok, else 1; candidate artifact always has release_ok=false.",
      "tools": "MCP tools share source implementations with run_suite; mutating stages enforce service write policy. Native hub dispatch remains unchanged."
    },
    "mathformer.composition": {
