{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_control_reasoning_flow_language_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Validate ERFL profiles, then check both catalogues through the selected native route.",
  "aliases": [
    "control.reasoning.flow.language"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Context": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "Child": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Result": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "enum": [
          "control:reasoning-flow-language",
          "control:reasoning-flow-catalog"
        ]
      }
    },
    "Match": {
      "schema": {
        "type": "object",
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "properties": {
          "route": {
            "type": "object",
            "required": [
              "route_id",
              "action_ids"
            ],
            "properties": {
              "route_id": {
                "const": "control.reasoning.flow.language"
              },
              "action_ids": {
                "const": [
                  "control:reasoning-flow-language",
                  "control:reasoning-flow-catalog"
                ]
              }
            }
          },
          "score": {
            "type": "integer"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "ok"
              ],
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "inputs": {
    "context": {
      "type": "Context"
    },
    "match": {
      "type": "Match"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "RepositoryRoot"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_route_initialize",
          "operation": "mathformer_reasoning_route_initialize"
        }
      }
    },
    "select_action": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "match": {
          "type": "Match"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_route_select_action",
          "operation": "mathformer_reasoning_route_select_action"
        }
      }
    },
    "run_action": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "context": {
          "type": "Context"
        },
        "registry": {
          "type": "Registry"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "child": {
          "type": "Child"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_route_run_action",
          "operation": "mathformer_reasoning_route_run_action"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "child": {
          "type": "Child"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_route_advance",
          "operation": "mathformer_reasoning_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "match": {
          "type": "Match"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_route_finish",
          "operation": "mathformer_reasoning_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "description": "One or two ordered action attempts. advance returns done on the second append, so reaching two actions returns normally, without exhaustion.",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 2,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select_action",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "execute",
              "kind": "call",
              "operation": "run_action",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                }
              }
            },
            {
              "id": "accumulate",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "steps.accumulate.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "steps.accumulate.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 8
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Route validation status only; no scientific proof or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "interface_only",
    "sources": [
      {
        "path": "scripts/mathformer.py",
        "selector": "run_intent_match",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_intent_routes; initialize_intent_state; select_intent_action; advance_intent_state; finish_intent_state; run_action; prepare_leaf_boundary; launch_leaf_boundary; finish_leaf_boundary",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "skills/control/reasoning-flow-language/scripts/validate_reasoning_flow.py",
        "selector": "main; prepare_validation; expand_validation; validate_next_path; finish_validation",
        "digest": "sha256:fea49a3942ac5f87b61deb179aef2e223f9785d9c7b535854288a69b2e40960e"
      },
      {
        "path": "skills/control/reasoning-flow-language/scripts/render_all_reasoning_flows.py",
        "selector": "main; construct_catalog; render_catalog; dispose_catalog; compare_catalog",
        "digest": "sha256:208c892ff7c6fc3e0485dfb96cf578073b775a0a2d1804c6dae227c9600ed246"
      },
      {
        "path": "scripts/reasoning_flow_route_tools.py",
        "selector": "register_reasoning_flow_route_tools; checked_registry; selected_match; check_state",
        "digest": "sha256:3d53249da3efddafce368a896f2ad2327d6a423fc53e97d37471759a989a694f"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_reasoning_flow_route_tools",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/workflow_write_audit.py",
        "selector": "snapshot_repository; audit_snapshots",
        "digest": "sha256:1f1e5ca40776f1b5671d89668ca1eee5d6802f633749c6cce7a94d8d25c838a1"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "reasoning_flow_route_descriptor; inventory",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Action internals remain inside the shared native run_action boundary; registry projections select only native declarations.",
      "The 3600-second ceiling and eight-operation budget are Lunar limits, not native subprocess timeouts or a native global deadline.",
      "Lunar supplies v1 receipts, digests and provenance; native ordered children, captured outputs and write audits are preserved. Optional caller reports and logs remain outside this selected route."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "control.reasoning.flow.language",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "control.reasoning.flow.language",
        "title": "Validate epistemic reasoning flows",
        "action_ids": [
          "control:reasoning-flow-language",
          "control:reasoning-flow-catalog"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "scripts/mathformer.py::run_intent_match; CLI ask --run and scripts/mcp_server.py dispatchers.",
      "selection": "Already selected route; natural-language scoring remains native.",
      "failure_policy": "Failed child payloads are data; launch exceptions propagate; unexpected repository writes fail the child.",
      "timing": "No action timeout or global deadline is enforced natively.",
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "registry": "Caller projection is compared against native read-only action metadata; missing entries retain native failure behavior. Executable wire overrides are refused.",
      "repository_root": "Explicit nullable mount shared by native preflight, subprocess cwd and write audits; null uses the repository default."
    },
    "mathformer.actions": {
      "control:reasoning-flow-language": {
        "argv": [
          "validate_reasoning_flow.py",
          "examples/reasoning_flows",
          "--strict",
          "--check-registries",
          "--json"
        ],
        "behavior": "Load ERFL registry; expand sorted .rflow paths; validate every expanded file despite individual validation failures; collect reports; warnings block; check registry alignment after file traversal. Bound is expanded file count."
      },
      "control:reasoning-flow-catalog": {
        "argv": [
          "render_all_reasoning_flows.py",
          "--check",
          "--json"
        ],
        "behavior": "Check registry alignment, canonical style/profile coverage and strict semantics; construct both catalogues in memory; compare exact text with existing documentation. Traversal is bounded by canonical styles/profiles. --check selects comparison without generation writes; construction errors or missing/stale documentation produce failure."
      }
    }
  }
}
