{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_test_comprehensive_strict_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Strict all-family native matrix traversal, aggregation and CLI reports through callable MCP blocks.",
  "aliases": [
    "test:comprehensive-strict"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Matrix": {
      "schema": {
        "type": "object",
        "required": [
          "schema_version",
          "tests"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object"
            }
          }
        }
      },
      "representation": "file"
    },
    "State": {
      "schema": {
        "type": "object",
        "required": [
          "matrix",
          "selected",
          "families",
          "index",
          "results",
          "context"
        ],
        "properties": {
          "matrix": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "context": {
            "type": "object",
            "required": [
              "run_id"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "results",
          "summary",
          "schema_errors",
          "capability_ledger",
          "dependency_map"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object"
          },
          "schema_errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capability_ledger": {
            "type": "object"
          },
          "dependency_map": {
            "type": "string"
          }
        }
      }
    },
    "Outcome": {
      "schema": {
        "type": "object",
        "required": [
          "exit_code",
          "json_report",
          "jsonl_report",
          "junit_report",
          "stdout"
        ],
        "properties": {
          "exit_code": {
            "enum": [
              0,
              3
            ]
          },
          "json_report": {
            "type": "string"
          },
          "jsonl_report": {
            "type": "string"
          },
          "junit_report": {
            "type": "string"
          },
          "stdout": {
            "type": "string"
          }
        }
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "matrix": {
      "type": "Matrix"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "steps.finalize.outputs.report"
      }
    },
    "outcome": {
      "type": "Outcome",
      "value": {
        "ref": "steps.publish.outputs.outcome"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "matrix": {
          "type": "Matrix"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "has_rows": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_strict_prepare",
          "operation": "mathformer_comprehensive_strict_prepare"
        }
      }
    },
    "check_next": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_strict_check_next",
          "operation": "mathformer_comprehensive_strict_check_next"
        }
      }
    },
    "finalize": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_strict_finalize",
          "operation": "mathformer_comprehensive_strict_finalize"
        }
      }
    },
    "publish": {
      "inputs": {
        "report": {
          "type": "Report"
        }
      },
      "outputs": {
        "outcome": {
          "type": "Outcome"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_strict_publish",
          "operation": "mathformer_comprehensive_strict_publish"
        }
      }
    },
    "retain_empty": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_comprehensive_strict_retain_empty",
          "operation": "mathformer_comprehensive_strict_retain_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "matrix": {
            "ref": "inputs.matrix"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "rows",
        "kind": "loop",
        "description": "One native check per iteration in matrix order, without retries or fail-fast. Empty selection retains its state once without executing a check. At 10000 selected rows done=true returns normally; exhaustion fails.",
        "state_type": "State",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "steps.prepare.outputs.has_rows"
              },
              "body": {
                "kind": "call",
                "operation": "check_next",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "retain_empty",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 10000,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finalize",
        "kind": "call",
        "operation": "finalize",
        "arguments": {
          "state": {
            "ref": "steps.rows.outputs.state"
          }
        }
      },
      {
        "id": "publish",
        "kind": "call",
        "operation": "publish",
        "arguments": {
          "report": {
            "ref": "steps.finalize.outputs.report"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finalize.outputs.report"
        }
      },
      "outcome": {
        "type": "Outcome",
        "value": {
          "ref": "steps.publish.outputs.outcome"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 10003
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked workflow description only; no scientific result, runtime qualification or promotion is established."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "tests/test_program/run_comprehensive_tests.py",
        "selector": "run; prepare_checks; advance_check; finalize_checks; publish_report; main",
        "digest": "sha256:60c9992ddfa80820b0c1e255d51b3e192f23d19efac01002713637c80056157a"
      },
      {
        "path": "scripts/comprehensive_strict_tools.py",
        "selector": "register_comprehensive_strict_tools",
        "digest": "sha256:692874cb5a8c7869a675ee2fe16f2a3a88ab7be2dfe103a5c995217f372afecd"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "register_comprehensive_strict_tools",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_registry/test:comprehensive-strict; preflight; run_leaf_action; run_action",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "hub_workflows/test:comprehensive-strict",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Specialization admits canonical matrix snapshots with at most 10000 selected rows; native run has no row cap. prepare checks input equality with tests/test_matrix.json and loads it through load_matrix.",
      "Only registered strict/all/default-output behavior is modeled. Dependency-map-only, changed-file selection and optional matrix coverage validation are disabled.",
      "Hub preflight rejection/dry-run and final hub write audit are outer controller boundaries rather than runner DAG nodes. Native per-row dependency and write audits execute inside check_next.",
      "Network/external effects remain unqualified. Deterministic fixtures qualify callable execution and source equivalence, not scientific completion."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "test:comprehensive-strict",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "test:comprehensive-strict",
        "family": "test",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/test_program/run_comprehensive_tests.py",
          "--module-family",
          "all",
          "--profile",
          "strict",
          "--write-jsonl",
          "--write-junit",
          "--json"
        ],
        "depends_on": [],
        "allows_extra_args": false,
        "timeout_seconds": 3600,
        "writes": [
          "artifacts/"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "Callable runner blocks share the original CLI implementation; the surrounding hub remains an outer controller.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "failure_policy": "Hub preflight errors/dry-run stop before launch. Enforce real 3600s whole-run subprocess timeout; final write audit may reject even an exit-0 runner.",
      "scientific_payloads": "Runner reports and exit codes do not certify scientific truth."
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "command_after_dependencies": false,
      "caller": "quality:strict runs control:all first, then test:comprehensive-strict.",
      "keep_going_semantics": "Caller sequence stops on dependency failure unless keep_going; aggregate ok remains false after any failure.",
      "modeling": "Caller dependency order is boundary metadata, not an extra execution of control:all inside this action."
    }
  }
}
