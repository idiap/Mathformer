      },
      {
        "id": "physics",
        "kind": "loop",
        "state_type": "PassState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "visit_physics_stage",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 7,
        "on_exhausted": "fail",
        "description": "Native seven-entry traversal; done is true on its final entry, so the bound returns normally.",
        "outputs": {
          "state": {
            "type": "PassState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "planning",
        "kind": "call",
        "operation": "plan_critique_ground",
        "arguments": {
          "state": {
