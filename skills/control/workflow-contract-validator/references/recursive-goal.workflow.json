          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "repair_plans",
        "kind": "loop",
        "state_type": "PassState",
        "initial": {
          "ref": "steps.planning.outputs.state"
        },
        "body": {
          "kind": "call",
          "operation": "visit_repair_plan",
          "arguments": {
            "state": {
              "ref": "loop.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 4,
        "on_exhausted": "fail",
        "description": "Native four-entry traversal accumulates reports and paths; done is true at the bound. No refinement loop.",
        "outputs": {
          "state": {
            "type": "PassState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "reviews",
        "kind": "call",
        "operation": "finish_plans",
        "arguments": {
          "state": {
            "ref": "steps.repair_plans.outputs.state"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "compile",
        "kind": "call",
        "operation": "compile_interpret",
        "arguments": {
          "state": {
            "ref": "steps.reviews.outputs.state"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "diagnostics",
        "kind": "switch",
        "cases": [
          {
            "id": "silent_success",
            "when": {
              "ref": "steps.compile.outputs.silent_success"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "normalize",
                  "kind": "call",
                  "operation": "normalize_silent",
                  "arguments": {
                    "state": {
                      "ref": "steps.compile.outputs.state"
                    },
                    "context": {
                      "ref": "inputs.context"
                    }
                  }
                },
                {
                  "id": "finish_normalized",
                  "kind": "call",
                  "operation": "validate_report",
                  "arguments": {
                    "state": {
                      "ref": "steps.normalize.outputs.state"
                    },
                    "context": {
                      "ref": "inputs.context"
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "RunResult",
                  "value": {
                    "ref": "steps.finish_normalized.outputs.result"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "validate_report",
          "arguments": {
            "state": {
              "ref": "steps.compile.outputs.state"
            },
            "context": {
              "ref": "inputs.context"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "RunResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "RunResult",
        "value": {
          "ref": "steps.diagnostics.outputs.result"
        }
      }
