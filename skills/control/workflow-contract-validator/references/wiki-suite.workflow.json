{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_lean_wiki_level_suite_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Native Wiki-level LaTeX-to-Lean suite with shared source stages and callable MCP ports.",
  "aliases": [
    "lean:wiki-level-suite"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Manifest": {
      "representation": "file",
      "schema": {
        "type": "string",
        "description": "Path to the authoritative native JSON manifest; at most 1000 cases admitted by prepare."
      }
    },
    "Options": {
      "schema": {
        "type": "object",
        "required": [
          "output_dir",
          "output_name",
          "reasoning_log",
          "no_reasoning_log",
          "append_reasoning_log",
          "skip_concept_map",
          "skip_hierarchy",
          "skip_declaration_checks",
          "verify_timeout_sec"
        ],
        "properties": {
          "output_dir": {
            "type": "string",
            "default": "artifacts/wiki_level_suite"
          },
          "output_name": {
            "type": "string",
            "default": "report.json"
          },
          "reasoning_log": {
            "type": "string",
            "default": "artifacts/wiki_level_suite/reasoning.jsonl"
          },
          "no_reasoning_log": {
            "type": "boolean",
            "default": false
          },
          "append_reasoning_log": {
            "type": "boolean",
            "default": false
          },
          "skip_concept_map": {
            "type": "boolean",
            "default": false
          },
          "skip_hierarchy": {
            "type": "boolean",
            "default": false
          },
          "skip_declaration_checks": {
            "type": "boolean",
            "default": false
          },
          "verify_timeout_sec": {
            "type": "integer",
            "default": 30
          }
        },
        "additionalProperties": false
      }
    },
    "Session": {
      "schema": {
        "type": "object",
        "description": "Manifest and paths, options, gold Lean text, import diagnostics and optional reasoning log."
      }
    },
    "CaseState": {
      "schema": {
        "type": "object",
        "required": [
          "cursor",
          "cases",
          "expected_declarations"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected_declarations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Check": {
      "schema": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "suite",
          "generated_at_utc",
          "manifest_file",
          "gold_lean_file",
          "import_check",
          "cases",
          "lean_execution",
          "compatibility_audit",
          "expected_declaration_checks",
          "summary"
        ],
        "properties": {
          "cases": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object",
            "required": [
              "passed"
            ],
            "properties": {
              "passed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "inputs": {
    "manifest": {
      "type": "Manifest"
    },
    "options": {
      "type": "Options"
    }
  },
  "outputs": {
    "report": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.report"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "manifest": {
          "type": "Manifest"
        },
        "options": {
          "type": "Options"
        }
      },
      "outputs": {
        "session": {
          "type": "Session"
        },
        "state": {
          "type": "CaseState"
        },
        "has_cases": {
          "type": "Flag"
        },
        "skip_declarations": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_prepare",
          "operation": "mathformer_wiki_suite_prepare"
        }
      }
    },
    "case_step": {
      "inputs": {
        "session": {
          "type": "Session"
        },
        "state": {
          "type": "CaseState"
        }
      },
      "outputs": {
        "state": {
          "type": "CaseState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_case_step",
          "operation": "mathformer_wiki_suite_case_step"
        }
      }
    },
    "empty_cases": {
      "inputs": {
        "state": {
          "type": "CaseState"
        }
      },
      "outputs": {
        "state": {
          "type": "CaseState"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_empty_cases",
          "operation": "mathformer_wiki_suite_empty_cases"
        }
      }
    },
    "compile_gold": {
      "inputs": {
        "session": {
          "type": "Session"
        }
      },
      "outputs": {
        "check": {
          "type": "Check"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_compile_gold",
          "operation": "mathformer_wiki_suite_compile_gold"
        }
      }
    },
    "audit": {
      "inputs": {
        "session": {
          "type": "Session"
        }
      },
      "outputs": {
        "check": {
          "type": "Check"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_audit",
          "operation": "mathformer_wiki_suite_audit"
        }
      }
    },
    "check_declarations": {
      "inputs": {
        "session": {
          "type": "Session"
        },
        "state": {
          "type": "CaseState"
        }
      },
      "outputs": {
        "check": {
          "type": "Check"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_check_declarations",
          "operation": "mathformer_wiki_suite_check_declarations"
        }
      }
    },
    "skip_declarations": {
      "inputs": {},
      "outputs": {
        "check": {
          "type": "Check"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_skip_declarations",
          "operation": "mathformer_wiki_suite_skip_declarations"
        }
      }
    },
    "finish": {
      "inputs": {
        "session": {
          "type": "Session"
        },
        "state": {
          "type": "CaseState"
        },
        "lean": {
          "type": "Check"
        },
        "audit": {
          "type": "Check"
        },
        "declarations": {
          "type": "Check"
        }
      },
      "outputs": {
        "report": {
          "type": "Report"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_wiki_suite_finish",
          "operation": "mathformer_wiki_suite_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "manifest": {
            "ref": "inputs.manifest"
          },
          "options": {
            "ref": "inputs.options"
          }
        }
      },
      {
        "id": "cases",
        "kind": "loop",
        "state_type": "CaseState",
        "initial": {
          "ref": "steps.prepare.outputs.state"
        },
        "max_iterations": 1000,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "steps.prepare.outputs.has_cases"
              },
              "body": {
                "kind": "call",
                "operation": "case_step",
                "arguments": {
                  "session": {
                    "ref": "steps.prepare.outputs.session"
                  },
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "empty_cases",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "CaseState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "CaseState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "lean",
        "kind": "call",
        "operation": "compile_gold",
        "arguments": {
          "session": {
            "ref": "steps.prepare.outputs.session"
          }
        }
      },
      {
        "id": "audit",
        "kind": "call",
        "operation": "audit",
        "arguments": {
          "session": {
            "ref": "steps.prepare.outputs.session"
          }
        }
      },
      {
        "id": "declarations",
        "kind": "switch",
        "cases": [
          {
            "id": "skipped",
            "when": {
              "ref": "steps.prepare.outputs.skip_declarations"
            },
            "body": {
              "kind": "call",
              "operation": "skip_declarations",
              "arguments": {}
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "check_declarations",
          "arguments": {
            "session": {
              "ref": "steps.prepare.outputs.session"
            },
            "state": {
              "ref": "steps.cases.outputs.state"
            }
          }
        },
        "outputs": {
          "check": {
            "type": "Check",
            "value": {
              "ref": "selected.outputs.check"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "session": {
            "ref": "steps.prepare.outputs.session"
          },
          "state": {
            "ref": "steps.cases.outputs.state"
          },
          "lean": {
            "ref": "steps.lean.outputs.check"
          },
          "audit": {
            "ref": "steps.audit.outputs.check"
          },
          "declarations": {
            "ref": "steps.declarations.outputs.check"
          }
        }
      }
    ],
    "outputs": {
      "report": {
        "type": "Report",
        "value": {
          "ref": "steps.finish.outputs.report"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/wiki_level_suite/",
          "artifacts/workflow_hub/",
          "configured_suite_outputs"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 1006
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native validation results and deterministic runtime evidence; completion does not establish scientific truth or authorize promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
