    "gaps": [
      "Manifest payload is specialized to at most 1000 cases; larger native manifests are rejected before output initialization.",
      "Global 3600-second and operation-call limits are normalization metadata; native hub outer timeout remains 300 seconds.",
      "Network/external effects inherit native capabilities; deterministic fixtures qualify control flow without a live scientific run."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "lean:wiki-level-suite",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md",
      "contract": {
        "id": "lean:wiki-level-suite",
        "family": "lean",
        "kind": "validation",
        "safety": "writes_artifacts",
        "command": [
          "{python}",
          "tests/wiki_level/run_suite.py",
          "--json"
        ],
        "depends_on": [],
        "timeout_seconds": 300,
        "allows_extra_args": false
      }
    },
    "mathformer.native_boundary": {
      "execution": "run_action dispatches dependency-free action through run_leaf_action with preflight, dry-run, subprocess timeout and write auditing.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "entrypoint": "main accepts --json, calls run_suite and exits 0 on summary.passed else 1. MCP ports share each native stage with run_suite and enforce service write policy."
    },
    "mathformer.blocks": {
      "prepare": "Load manifest, create output directory, optionally reset reasoning log unless append; read gold Lean and record import diagnostics. Pack session, empty accumulators, cursor=0 and guards. Manifest is a path port preserving native manifest_file provenance; prepare admits at most 1000 cases before output initialization.",
      "case_step": "Read next LaTeX case; extract statement/proof; extend expected declarations; static review then difficulty; if not skip_concept_map map concepts; if not skip_hierarchy navigate hierarchy; record Lean declaration presence and append result. Pack incremented cursor/state and done=(cursor reaches manifest length).",
      "empty_cases": "Retain empty accumulators without invoking any per-case work.",
      "checks": "Compile gold, then audit regardless of recorded failure. Declaration helper deduplicates nonempty names in order; empty list succeeds immediately; otherwise writes tmp/expected_declaration_checks.lean and runs Lean.",
      "finish": "Build report and aggregate static, difficulty, enabled concept/hierarchy, theorem-presence, Lean, audit and declaration failures. Import diagnostics do not affect passed. Log completion, write output_dir/output_name (default report.json), return report even when passed=false.",
      "failure": "Recorded check failures/timeouts are data and do not stop later checks; uncaught exceptions abort. No retries or proof repair.",
      "bounds": "One iteration per manifest case; done is true on the last case, including case 1000, so admitted inputs return normally at the bound. Exhaustion indicates an inconsistent adapter, not native exhaustion behavior. The loop is top-level with an empty-case switch in its body for Lunar scoped-exit compatibility; the empty branch returns done=true without per-case work.",
      "helper_limits": "Difficulty/hierarchy 60s; Lean/audit/declarations 120s; concept verification at most 5 concepts and 3 candidates, timeout default 30s; mapping subprocess max(120, verify_timeout_sec * 20)."
    }
  }
}
