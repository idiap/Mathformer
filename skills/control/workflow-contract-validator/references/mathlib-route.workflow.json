{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_mathlib_grounding_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Execute the selected mathlib.grounding route through its native controller.",
  "aliases": [
    "mathlib.grounding"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Match": {
      "schema": {
        "type": "object",
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "properties": {
          "route": {
            "type": "object",
            "required": [
              "route_id",
              "action_ids"
            ],
            "properties": {
              "route_id": {
                "type": "string",
                "const": "mathlib.grounding"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "test:family:mathlib"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "ok"
              ],
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "const": "test:family:mathlib"
      }
    },
    "Done": {
      "schema": {
        "type": "boolean"
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "description": "Assertion of native action metadata. Commands resolve from the source registry. Missing actions retain native unknown_action at execute and metadata lookup failure at finish."
      }
    },
    "Root": {
      "schema": {
        "type": "string",
        "description": "Optional repository mount; omission retains the native repository root."
      }
    },
    "ActionCount": {
      "schema": {
        "type": "integer",
        "const": 1
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "Match"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "Root",
      "required": false
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_mathlib_route_initialize",
          "operation": "mathformer_mathlib_route_initialize"
        }
      }
    },
    "select": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_mathlib_route_select",
          "operation": "mathformer_mathlib_route_select"
        }
      }
    },
    "execute": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "context": {
          "type": "RunContext"
        },
        "registry": {
          "type": "Registry"
        },
        "repository_root": {
          "type": "Root",
          "required": false
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_mathlib_route_execute",
          "operation": "mathformer_mathlib_route_execute"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "action_count": {
          "type": "ActionCount"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_mathlib_route_advance",
          "operation": "mathformer_mathlib_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_mathlib_route_finish",
          "operation": "mathformer_mathlib_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "description": "The fixed route has one action. The body always returns done=true, including a failed child, so reaching this bound returns normally. Exhaustion is unreachable for this source specialization.",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "execute",
              "kind": "call",
              "operation": "execute",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "action_count": {
                  "literal": 1
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Done",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Native validation envelopes establish no proof or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "partial",
    "sources": [
      {
        "path": "scripts/mathformer.py",
        "selector": "run_intent_match",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/mathformer.py",
        "selector": "build_intent_routes; initialize_intent_state; select_intent_action; advance_intent_state; finish_intent_state; run_action; run_leaf_action",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "tests/test_program/run_comprehensive_tests.py",
        "selector": "run; prepare_checks; checks_pending; advance_check; run_check; finalize_checks; publish_report",
        "digest": "sha256:60c9992ddfa80820b0c1e255d51b3e192f23d19efac01002713637c80056157a"
      },
      {
        "path": "scripts/mcp_server.py",
        "selector": "mathformer_run_workflow; mathformer_ask",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathlib_route_tools.py",
        "selector": "register_mathlib_route_tools; selected_match; checked_registry; check_state",
        "digest": "sha256:2b585c4d78e72cdb444e8a7bad76c941355682409046a6427b7aebc6b2780e43"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "selector": "mathlib_route_descriptor",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      },
      {
        "path": "scripts/workflow_write_audit.py",
        "selector": "snapshot_repository; audit_snapshots",
        "digest": "sha256:1f1e5ca40776f1b5671d89668ca1eee5d6802f633749c6cce7a94d8d25c838a1"
      }
    ],
    "gaps": [
      "The native run_action and delegated comprehensive runner remain source-owned calls inside execute; runner internals have no added normalization cap.",
      "Complete effects and network capabilities require native qualification; labels grant no access.",
      "Required receipts and provenance are runtime obligations; native optional logs are not upgraded.",
      "The 3600-second and five-call ceilings are descriptor limits, not native route budgets. The native child process retains its 900-second timeout."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "mathlib.grounding",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "mathlib.grounding",
        "title": "Ground formalization work in mathlib",
        "action_ids": [
          "test:family:mathlib"
        ]
      }
    },
    "mathformer.native_boundary": {
      "execution": "Typed MCP ports reuse the native route functions and run_action; commands and route metadata remain source-owned.",
      "callers": [
        "scripts/mathformer.py:main/ask--run",
        "scripts/mcp_server.py:mathformer_ask",
        "scripts/mcp_server.py:mathformer_run_workflow"
      ],
      "dispatch": "Resolve canonical ID to route; reject route extra_args; check service write roots unless dry-run; call run_intent_match.",
      "failure_policy": "Failed child payloads remain data for sticky aggregation and final failure status. Unexpected exceptions propagate, including finish metadata lookup for a missing registry action. There is no retry.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true
    },
    "mathformer.composition": {
      "ordered_actions": [
        "test:family:mathlib"
      ],
      "action_workflows": [
        "hub_test_family_mathlib_workflow"
      ],
      "selection": "Already selected route; NL scoring and ambiguity resolution remain native.",
      "companion_skills": "Routing metadata only; no sequential skill execution.",
      "keep_going_semantics": "Cannot add route work beyond the sole action; aggregate failure remains sticky."
    }
  }
}
