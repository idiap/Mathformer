{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_docs_workflow_graph_layout_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Resolve CLI paths, read a graph, build its layout plan, and write and report it.",
  "aliases": [
    "docs:workflow-graph-layout"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Argv": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Paths": {
      "schema": {
        "type": "object",
        "required": [
          "graph",
          "output",
          "json",
          "halted",
          "stdout"
        ],
        "properties": {
          "graph": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "halted": {
            "type": "boolean"
          },
          "stdout": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "Graph": {
      "schema": {
        "type": "string",
        "description": "Ordered native Graph JSON text; preserves dictionary insertion order across runtime envelopes."
      }
    },
    "Plan": {
      "schema": {
        "type": "string",
        "description": "Ordered native Plan JSON text; preserves dictionary insertion order across runtime envelopes."
      }
    },
    "Completion": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "output",
          "views",
          "exit_code",
          "stdout"
        ],
        "properties": {
          "ok": {
            "const": true,
            "type": "boolean"
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "const": 0,
            "type": "integer"
          },
          "stdout": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "repository_root"
        ],
        "properties": {
          "repository_root": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "argv": {
      "type": "Argv"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "result": {
      "type": "Completion",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "resolve": {
      "inputs": {
        "argv": {
          "type": "Argv"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "paths": {
          "type": "Paths"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_graph_layout_resolve",
          "operation": "mathformer_graph_layout_resolve"
        }
      }
    },
    "read": {
      "inputs": {
        "paths": {
          "type": "Paths"
        }
      },
      "outputs": {
        "model": {
          "type": "Graph"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_graph_layout_read",
          "operation": "mathformer_graph_layout_read"
        }
      }
    },
    "build": {
      "inputs": {
        "model": {
          "type": "Graph"
        }
      },
      "outputs": {
        "plan": {
          "type": "Plan"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_graph_layout_build",
          "operation": "mathformer_graph_layout_build"
        }
      }
    },
    "emit": {
      "inputs": {
        "paths": {
          "type": "Paths"
        },
        "plan": {
          "type": "Plan"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "result": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_graph_layout_emit",
          "operation": "mathformer_graph_layout_emit"
        }
      }
    },
    "halt": {
      "inputs": {
        "paths": {
          "type": "Paths"
        }
      },
      "outputs": {
        "result": {
          "type": "Completion"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_graph_layout_halt",
          "operation": "mathformer_graph_layout_halt"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "resolve",
        "kind": "call",
        "operation": "resolve",
        "arguments": {
          "argv": {
            "ref": "inputs.argv"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "when": {
              "ref": "steps.resolve.outputs.paths.halted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "halt",
                  "kind": "call",
                  "operation": "halt",
                  "arguments": {
                    "paths": {
                      "ref": "steps.resolve.outputs.paths"
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "Completion",
                  "value": {
                    "ref": "steps.halt.outputs.result"
                  }
                }
              }
            },
            "id": "help"
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "read",
              "kind": "call",
              "operation": "read",
              "arguments": {
                "paths": {
                  "ref": "steps.resolve.outputs.paths"
                }
              }
            },
            {
              "id": "build",
              "kind": "call",
              "operation": "build",
              "arguments": {
                "model": {
                  "ref": "steps.read.outputs.model"
                }
              }
            },
            {
              "id": "emit",
              "kind": "call",
              "operation": "emit",
              "arguments": {
                "paths": {
                  "ref": "steps.resolve.outputs.paths"
                },
                "plan": {
                  "ref": "steps.build.outputs.plan"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            }
          ],
          "outputs": {
            "result": {
              "type": "Completion",
              "value": {
                "ref": "steps.emit.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "Completion",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Completion",
        "value": {
          "ref": "steps.dispatch.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_graphs/",
          "artifacts/workflow_hub/",
          "cli_selected_output"
        ]
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 4
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked layout description only; no runtime qualification or scientific claim."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
