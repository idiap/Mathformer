{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_workflow_router_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Execute the selected workflow.router route through the native controlled action boundary.",
  "aliases": [
    "workflow.router"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext",
      "representation": "value"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult",
      "representation": "value"
    },
    "SelectedMatch": {
      "representation": "value",
      "schema": {
        "type": "object",
        "properties": {
          "route": {
            "type": "object",
            "properties": {
              "route_id": {
                "type": "string",
                "const": "workflow.router"
              },
              "action_ids": {
                "type": "array",
                "const": [
                  "control:workflow-router-coverage"
                ],
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "skill_routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operator_note": {
                "type": "string"
              }
            },
            "required": [
              "route_id",
              "action_ids",
              "title",
              "description",
              "skill_routes",
              "examples",
              "operator_note"
            ]
          },
          "score": {
            "type": "integer"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "route",
          "score",
          "matched_terms"
        ]
      }
    },
    "Registry": {
      "representation": "value",
      "schema": {
        "type": "object",
        "description": "Opaque JSON projection of the native WorkflowAction mapping; admission remains native.",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "RouteState": {
      "representation": "value",
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "const": "control:workflow-router-coverage"
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ],
        "description": "Explicit native repository mount; null or omitted retains the default."
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "SelectedMatch"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "RepositoryRoot",
      "required": false
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_workflow_router_initialize",
          "operation": "mathformer_workflow_router_initialize"
        }
      }
    },
    "select": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_workflow_router_select",
          "operation": "mathformer_workflow_router_select"
        }
      }
    },
    "execute": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "registry": {
          "type": "Registry"
        },
        "context": {
          "type": "RunContext"
        },
        "repository_root": {
          "type": "RepositoryRoot",
          "required": false
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_workflow_router_execute",
          "operation": "mathformer_workflow_router_execute"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "match": {
          "type": "SelectedMatch"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_workflow_router_advance",
          "operation": "mathformer_workflow_router_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_workflow_router_finish",
          "operation": "mathformer_workflow_router_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "description": "Source action loop specialized to the exact one-action selected route. Completion is true after the first append even for a failed child; the bound therefore returns normally with failure data, without exhaustion.",
        "state_type": "RouteState",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "execute",
              "kind": "call",
              "operation": "execute",
              "description": "Leaf argv is route_mathformer_workflow.py --audit-coverage --json. Admission/preflight rejection returns failure data; dry-run skips launch. Otherwise main calls build_coverage_report, which carries route/action indices, covered and per-route families, rows, unknown references and empty routes through finite nested collection loops. Registered references resolve to their family; test:family:* uses its suffix; other references accumulate as blockers. Empty routes are recorded and traversal continues. Final missing families, unknown references or empty routes yield ok=false and CLI exit 1; otherwise exit 0. Captured stdout/stderr/returncode and write audit remain in the child envelope; undeclared writes force failure. There is no retry or native timeout; unexpected launch errors propagate.",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.execute.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Coverage audit and native execution status only; no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
