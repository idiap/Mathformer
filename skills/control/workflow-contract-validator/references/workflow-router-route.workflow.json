      "Native timeout_seconds remains None. Lunar enforces the enclosing 3600-second and five-operation limits; standalone tools retain native behavior.",
      "Required v1 receipts, digests, provenance and events are supplied by Lunar; optional source logging remains caller-owned."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "route",
      "native_id": "workflow.router",
      "owner_skill": "skills/control/mathformer-workflow-router/SKILL.md",
      "contract": {
        "route_id": "workflow.router",
        "title": "Audit the natural-language workflow router",
        "action_ids": [
          "control:workflow-router-coverage"
        ],
        "skill_routes": [
          "mathformer-workflow-router"
        ],
        "operator_note": "Read-only coverage audit over the hub registry and IntentRoute table."
      }
    },
    "mathformer.native_boundary": {
      "execution": "MCP tools call the shared run_intent_match steps; run_action retains the native leaf boundary. Lunar executes the typed outer graph.",
      "failure_policy": "Return native failed child data and intent_run_failed; never convert failure to acceptance.",
      "scientific_payloads": "HubResult is a transport envelope; coverage JSON is captured as stdout.",
      "coverage_bounds": "Native finite collections are exhausted normally; optional coverage-domain caps are unused by this CLI path.",
      "report_ownership": "run_intent_match returns its payload; caller-owned optional reports and logs remain outside this graph.",
      "repository_root": "Optional nullable native mount is used consistently by preflight, subprocess cwd and write audit.",
      "observability": "Source stdout, stderr, returncode, route metadata and ordered children are unchanged. Lunar records v1 receipts and provenance."
    },
    "mathformer.composition": {
      "ordered_actions": [
        "control:workflow-router-coverage"
      ],
      "action_workflows": [
        "hub_control_workflow_router_coverage_workflow"
      ],
      "keep_going_semantics": "Stop on failed child unless keep_going; aggregate ok is sticky.",
      "selection": "Already selected workflow.router route; intent scoring and ambiguity resolution remain native."
    }
  }
}
