  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_famous_corpus_route_initialize",
          "operation": "mathformer_famous_corpus_route_initialize"
        }
      }
    },
    "select": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "Match"
        }
      },
      "outputs": {
        "action": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_famous_corpus_route_select",
          "operation": "mathformer_famous_corpus_route_select"
        }
      }
    },
    "dispatch": {
      "inputs": {
        "action": {
          "type": "ActionId"
        },
