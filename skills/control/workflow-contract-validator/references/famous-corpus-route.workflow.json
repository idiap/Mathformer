        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_famous_corpus_route_dispatch",
          "operation": "mathformer_famous_corpus_route_dispatch"
        }
      }
