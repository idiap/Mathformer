      "schema": {
        "type": "boolean"
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "properties": {
          "kb:famous-corpus": {
            "type": "object"
          }
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "Match"
    },
    "registry": {
