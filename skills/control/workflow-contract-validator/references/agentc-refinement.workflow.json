        "selector": "IterativeSelfRefinementAgentC.iter_refinement_steps"
      },
      {
        "path": "scripts/agentc_workflow_tools.py",
        "digest": "sha256:64b0c2f05fef91d88d0339175d0758f8aac696a84a8dfcfe22d8d17e95537314"
      },
      {
        "path": "scripts/agentc_refinement_workflow_tools.py",
        "digest": "sha256:89abf71256bc0c6de692b0d4fc03abcd3ccbd01bce4214b4b8acb6704c7fb0c9"
      },
      {
        "path": "scripts/mcp_server.py",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer.py",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": [
      "Only the default four-round cap is represented; request.max_iterations must equal four.",
      "History, transition analysis, trace events, diagnostics and timings remain owned by the native iterator. Production trace events are written beside each step’s native diagnostics.",
      "Manual resume_state models native _resume_state; policy declares no durable checkpoint support.",
      "Native success is checked at the next round entry; last-round success has no extra EarlyStop.",
      "Exhaustion returns latest history normally even on compilation failure; exceptions propagate without retries.",
      "run consumes yields and returns history; run_and_save saving and systematic caller gating/outer cycles are outside scope."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "loop",
      "native_id": "draft_execute_refine_loop",
      "owner_skill": "skills/control/workflow-contract-validator/SKILL.md"
    }
  }
}
