      }
    },
    "State": {
      "schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "summaries": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object"
            }
          },
          "summaries_json": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "cursor",
          "summaries",
          "summaries_json"
        ],
        "additionalProperties": false
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Result": {
      "schema": {
        "type": "object",
        "properties": {
          "backend": {
            "const": "sympy"
          },
          "style": {
            "type": "string"
          },
          "case_count": {
            "const": 10
          },
          "ok": {
            "type": "boolean"
          },
          "summaries": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "backend",
          "style",
          "case_count",
          "ok",
          "summaries"
        ],
        "additionalProperties": false
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "enum": [
          0,
          3
        ]
      }
    },
    "Text": {
      "schema": {
        "type": "string"
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "properties": {
          "dry_run": {
            "type": "boolean"
          },
          "json_output": {
            "type": "boolean"
          },
          "keep_going": {
            "type": "boolean"
          },
          "allow_mutating": {
            "type": "boolean"
          },
          "write_report": {
            "type": "boolean"
          }
        },
        "required": [
          "dry_run",
          "json_output",
          "keep_going",
          "allow_mutating",
          "write_report"
        ],
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "options": {
      "type": "Options"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    },
    "stdout": {
      "type": "Text",
      "value": {
        "ref": "flow.outputs.stdout"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_initialize",
          "operation": "mathformer_original_two_sympy_initialize"
        }
      }
    },
    "select_case": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "case": {
          "type": "Case"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_select_case",
          "operation": "mathformer_original_two_sympy_select_case"
        }
      }
    },
    "write_case": {
      "inputs": {
        "case": {
          "type": "Case"
        },
        "options": {
          "type": "Options"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "summary": {
          "type": "Summary"
        },
        "summary_json": {
          "type": "Text"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_write_case",
          "operation": "mathformer_original_two_sympy_write_case"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "State"
        },
        "summary": {
          "type": "Summary"
        },
        "summary_json": {
          "type": "Text"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_advance",
          "operation": "mathformer_original_two_sympy_advance"
        }
      }
    },
    "aggregate": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        },
        "exit_code": {
          "type": "ExitCode"
        },
        "result_json": {
          "type": "Text"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_aggregate",
          "operation": "mathformer_original_two_sympy_aggregate"
        }
      }
    },
    "emit_json": {
      "inputs": {
        "result_json": {
          "type": "Text"
        }
      },
      "outputs": {
        "stdout": {
          "type": "Text"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_emit_json",
          "operation": "mathformer_original_two_sympy_emit_json"
        }
      }
    },
    "emit_paths": {
      "inputs": {
        "result": {
          "type": "Result"
        }
      },
      "outputs": {
        "stdout": {
          "type": "Text"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_original_two_sympy_emit_paths",
          "operation": "mathformer_original_two_sympy_emit_paths"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "cases",
        "kind": "loop",
        "description": "Exactly ten sequential visits for this source snapshot; iteration ten sets done=true and exits normally, even if a summary is non-complete.",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 10,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select_case",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                }
              }
            },
            {
              "id": "generate",
              "kind": "call",
              "operation": "write_case",
              "arguments": {
                "case": {
                  "ref": "steps.select.outputs.case"
                },
                "options": {
                  "ref": "inputs.options"
                },
                "context": {
                  "ref": "inputs.context"
                }
              }
            },
            {
              "id": "accumulate",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "summary": {
                  "ref": "steps.generate.outputs.summary"
                },
                "summary_json": {
                  "ref": "steps.generate.outputs.summary_json"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "steps.accumulate.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "steps.accumulate.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "aggregate",
        "kind": "call",
        "operation": "aggregate",
        "arguments": {
          "state": {
            "ref": "steps.cases.outputs.state"
          }
        }
      },
      {
        "id": "emit",
        "kind": "switch",
        "cases": [
          {
            "id": "json",
            "when": {
              "ref": "inputs.options.json"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "print_json",
                  "kind": "call",
                  "operation": "emit_json",
                  "arguments": {
                    "result_json": {
                      "ref": "steps.aggregate.outputs.result_json"
                    }
                  }
                }
              ],
              "outputs": {
                "stdout": {
                  "type": "Text",
                  "value": {
                    "ref": "steps.print_json.outputs.stdout"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "print_paths",
              "kind": "call",
              "operation": "emit_paths",
              "arguments": {
                "result": {
                  "ref": "steps.aggregate.outputs.result"
                }
              }
            }
          ],
          "outputs": {
            "stdout": {
              "type": "Text",
              "value": {
                "ref": "steps.print_paths.outputs.stdout"
              }
            }
          }
        },
        "outputs": {
          "stdout": {
            "type": "Text",
            "value": {
              "ref": "selected.outputs.stdout"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.aggregate.outputs.result"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.aggregate.outputs.exit_code"
        }
      },
      "stdout": {
        "type": "Text",
        "value": {
          "ref": "steps.emit.outputs.stdout"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/",
          "artifacts/physics_sympy/from_scratch_sympy/",
          "backends/sympy/MathformerSympyPhysics/",
          "libraries/MathformerPhysicsLib/SymPy/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 33
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description only; completion establishes no scientific truth, runtime qualification, or promotion approval."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
