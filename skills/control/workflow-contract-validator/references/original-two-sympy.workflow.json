        ],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "Registered MCP step tools invoke the same helpers as native main; Lunar executes the typed control graph.",
      "hub_options": {
        "promote_lib": false,
        "json": true
      },
      "cli_defaults": {
        "promote_lib": false,
        "json": false
      },
      "failure_policy": "Native main returns 0/3 after all cases; exceptions abort immediately with earlier filesystem outputs retained. Hub ok also depends on subprocess return code and write audit.",
      "effects_status": "partial_native_declarations",
      "qualification_capability_names_are_not_runtime_grants": true,
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ]
    },
    "mathformer.composition": {
      "ordered_dependencies": [],
      "dependency_workflows": [],
      "modeling": "main is authoritative; top10 compatibility calls this same script, while the extra-case generator reuses write_case for eight cases. Neither adds visits to this invocation."
    }
