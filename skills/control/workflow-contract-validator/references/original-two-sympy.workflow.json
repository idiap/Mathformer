{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_formalphysics_original_two_sympy_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Model main() over the ten ordered CASES, retaining write_case as an opaque scientific operation and native CLI output modes.",
  "aliases": [
    "formalphysics:original-two-sympy"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Options": {
      "schema": {
        "type": "object",
        "properties": {
