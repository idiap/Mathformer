{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "route_e2e_all_backends_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Selected e2e.all.backends route: one ordered native action, sticky success aggregation, and native route result.",
  "aliases": [
    "e2e.all.backends"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext",
      "representation": "value"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult",
      "representation": "value"
    },
    "SelectedMatch": {
      "schema": {
        "type": "object",
        "properties": {
          "route": {
            "type": "object",
            "properties": {
              "route_id": {
                "const": "e2e.all.backends"
              },
              "action_ids": {
                "const": [
                  "e2e:all-backends"
                ]
              }
            },
            "required": [
              "route_id",
              "action_ids"
            ],
            "additionalProperties": true
          },
          "score": {
            "type": "number"
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "route",
          "score",
          "matched_terms"
        ],
        "additionalProperties": false,
        "description": "Projection of the already selected native IntentMatch; retain all native route metadata."
      }
    },
    "Registry": {
      "schema": {
        "type": "object",
        "required": [
          "e2e:all-backends"
        ],
        "additionalProperties": {
          "type": "object"
        },
        "description": "Native build_registry mapping projected as data; use the unchanged source e2e registration."
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "ActionId": {
      "schema": {
        "type": "string",
        "const": "e2e:all-backends"
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "RouteState": {
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              },
              "required": [
                "ok"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "ok",
          "children"
        ],
        "additionalProperties": false
      }
    },
    "ActionCount": {
      "schema": {
        "type": "integer",
        "const": 1
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "match": {
      "type": "SelectedMatch"
    },
    "registry": {
      "type": "Registry"
    },
    "repository_root": {
      "type": "RepositoryRoot",
      "required": false
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {},
      "outputs": {
        "state": {
          "type": "RouteState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_e2e_route_initialize",
          "operation": "mathformer_e2e_route_initialize"
        }
      }
    },
    "select": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        }
      },
      "outputs": {
        "action_id": {
          "type": "ActionId"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_e2e_route_select",
          "operation": "mathformer_e2e_route_select"
        }
      }
    },
    "run": {
      "inputs": {
        "action_id": {
          "type": "ActionId"
        },
        "registry": {
          "type": "Registry"
        },
        "context": {
          "type": "RunContext"
        },
        "repository_root": {
          "type": "RepositoryRoot",
          "required": false
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_e2e_route_run",
          "operation": "mathformer_e2e_route_run"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        },
        "action_count": {
          "type": "ActionCount"
        }
      },
      "outputs": {
        "state": {
          "type": "RouteState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_e2e_route_advance",
          "operation": "mathformer_e2e_route_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "RouteState"
        },
        "match": {
          "type": "SelectedMatch"
        },
        "registry": {
          "type": "Registry"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp",
          "kind": "tool",
          "target": "mathformer_e2e_route_finish",
          "operation": "mathformer_e2e_route_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {}
      },
      {
        "id": "actions",
        "kind": "loop",
        "state_type": "RouteState",
        "description": "Exactly one source action. advance.done is true after that action even on failure, so completion at the bound is normal; exhaustion is unreachable for valid inputs.",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "sequence",
          "steps": [
            {
              "id": "select",
              "kind": "call",
              "operation": "select",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "match": {
                  "ref": "inputs.match"
                }
              }
            },
            {
              "id": "run",
              "kind": "call",
              "operation": "run",
              "description": "Returned child ok=false is data and still reaches advance; unexpected exceptions terminate execution.",
              "arguments": {
                "action_id": {
                  "ref": "steps.select.outputs.action_id"
                },
                "registry": {
                  "ref": "inputs.registry"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "repository_root": {
                  "ref": "inputs.repository_root"
                }
              }
            },
            {
              "id": "advance",
              "kind": "call",
              "operation": "advance",
              "arguments": {
                "state": {
                  "ref": "loop.state"
                },
                "child": {
                  "ref": "steps.run.outputs.child"
                },
                "context": {
                  "ref": "inputs.context"
                },
                "action_count": {
                  "literal": 1
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "RouteState",
              "value": {
                "ref": "steps.advance.outputs.state"
              }
            },
            "done": {
              "type": "Boolean",
              "value": {
                "ref": "steps.advance.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "RouteState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "finish",
        "kind": "call",
        "operation": "finish",
        "arguments": {
          "state": {
            "ref": "steps.actions.outputs.state"
          },
          "match": {
            "ref": "inputs.match"
          },
          "registry": {
            "ref": "inputs.registry"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.finish.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/e2e/",
          "artifacts/test_program/",
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 5
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked control-flow specification; completion establishes no scientific truth or promotion."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
