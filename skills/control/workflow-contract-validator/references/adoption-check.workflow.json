{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_adoption_check_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Ordered portable adoption checks through the Python hub.",
  "aliases": [
    "adoption:check"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "RunContext": {
      "schema": "../../hub-interface.schema.json#/$defs/RunContext"
    },
    "HubResult": {
      "schema": "../../hub-interface.schema.json#/$defs/HubResult"
    },
    "Strings": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Boolean": {
      "schema": {
        "type": "boolean"
      }
    },
    "Admission": {
      "schema": {
        "type": "object",
        "required": [
          "accepted",
          "status",
          "ancestry"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "unknown_action",
              "dependency_cycle",
              "extra_args_for_sequence"
            ]
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "ChildState": {
      "schema": {
        "type": "object",
        "required": [
          "index",
          "children",
          "dependencies_ok",
          "ancestry"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "children": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object"
            }
          },
          "dependencies_ok": {
            "type": "boolean"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "context": {
      "type": "RunContext"
    },
    "extra_args": {
      "type": "Strings"
    },
    "seen": {
      "type": "Strings"
    }
  },
  "outputs": {
    "result": {
      "type": "HubResult",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "admit": {
      "inputs": {
        "extra_args": {
          "type": "Strings"
        },
        "seen": {
          "type": "Strings"
        }
      },
      "outputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_adoption_admit",
          "operation": "mathformer_adoption_admit"
        }
      }
    },
    "reject": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_adoption_reject",
          "operation": "mathformer_adoption_reject"
        }
      }
    },
    "initialize": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "state": {
          "type": "ChildState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_adoption_initialize",
          "operation": "mathformer_adoption_initialize"
        }
      }
    },
    "visit_child": {
      "inputs": {
        "state": {
          "type": "ChildState"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_adoption_visit_child",
          "operation": "mathformer_adoption_visit_child"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "ChildState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "RunContext"
        }
      },
      "outputs": {
        "state": {
          "type": "ChildState"
        },
        "done": {
          "type": "Boolean"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_adoption_advance",
          "operation": "mathformer_adoption_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "ChildState"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_adoption_finish",
          "operation": "mathformer_adoption_finish"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "admission",
        "kind": "call",
        "operation": "admit",
        "arguments": {
          "extra_args": {
            "ref": "inputs.extra_args"
          },
          "seen": {
            "ref": "inputs.seen"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "initialize",
                  "kind": "call",
                  "operation": "initialize",
                  "arguments": {
                    "admission": {
                      "ref": "steps.admission.outputs.admission"
                    }
                  }
                },
                {
                  "id": "child_0",
                  "kind": "call",
                  "operation": "visit_child",
                  "arguments": {
                    "state": {
                      "ref": "steps.initialize.outputs.state"
                    },
                    "context": {
                      "ref": "inputs.context"
                    }
                  }
                },
                {
                  "id": "advance_0",
                  "kind": "call",
                  "operation": "advance",
                  "arguments": {
                    "state": {
                      "ref": "steps.initialize.outputs.state"
                    },
                    "child": {
                      "ref": "steps.child_0.outputs.result"
                    },
                    "context": {
                      "ref": "inputs.context"
                    }
                  }
                },
                {
                  "id": "remaining_0",
                  "kind": "switch",
                  "cases": [
                    {
                      "id": "continue",
                      "when": {
                        "not": {
                          "ref": "steps.advance_0.outputs.done"
                        }
                      },
                      "body": {
                        "kind": "sequence",
                        "steps": [
                          {
                            "id": "child_1",
                            "kind": "call",
                            "operation": "visit_child",
                            "arguments": {
                              "state": {
                                "ref": "steps.advance_0.outputs.state"
                              },
                              "context": {
                                "ref": "inputs.context"
                              }
                            }
                          },
                          {
                            "id": "advance_1",
                            "kind": "call",
                            "operation": "advance",
                            "arguments": {
                              "state": {
                                "ref": "steps.advance_0.outputs.state"
                              },
                              "child": {
                                "ref": "steps.child_1.outputs.result"
                              },
                              "context": {
                                "ref": "inputs.context"
                              }
                            }
                          },
                          {
                            "id": "remaining_1",
                            "kind": "switch",
                            "cases": [
                              {
                                "id": "continue",
                                "when": {
                                  "not": {
                                    "ref": "steps.advance_1.outputs.done"
                                  }
                                },
                                "body": {
                                  "kind": "sequence",
                                  "steps": [
                                    {
                                      "id": "child_2",
                                      "kind": "call",
                                      "operation": "visit_child",
                                      "arguments": {
                                        "state": {
                                          "ref": "steps.advance_1.outputs.state"
                                        },
                                        "context": {
                                          "ref": "inputs.context"
                                        }
                                      }
                                    },
                                    {
                                      "id": "advance_2",
                                      "kind": "call",
                                      "operation": "advance",
                                      "arguments": {
                                        "state": {
                                          "ref": "steps.advance_1.outputs.state"
                                        },
                                        "child": {
                                          "ref": "steps.child_2.outputs.result"
                                        },
                                        "context": {
                                          "ref": "inputs.context"
                                        }
                                      }
                                    },
                                    {
                                      "id": "remaining_2",
                                      "kind": "switch",
                                      "cases": [
                                        {
                                          "id": "continue",
                                          "when": {
                                            "not": {
                                              "ref": "steps.advance_2.outputs.done"
                                            }
                                          },
                                          "body": {
                                            "kind": "sequence",
                                            "steps": [
                                              {
                                                "id": "child_3",
                                                "kind": "call",
                                                "operation": "visit_child",
                                                "arguments": {
                                                  "state": {
                                                    "ref": "steps.advance_2.outputs.state"
                                                  },
                                                  "context": {
                                                    "ref": "inputs.context"
                                                  }
                                                }
                                              },
                                              {
                                                "id": "advance_3",
                                                "kind": "call",
                                                "operation": "advance",
                                                "arguments": {
                                                  "state": {
                                                    "ref": "steps.advance_2.outputs.state"
                                                  },
                                                  "child": {
                                                    "ref": "steps.child_3.outputs.result"
                                                  },
                                                  "context": {
                                                    "ref": "inputs.context"
                                                  }
                                                }
                                              },
                                              {
                                                "kind": "call",
                                                "operation": "finish",
                                                "arguments": {
                                                  "state": {
                                                    "ref": "steps.advance_3.outputs.state"
                                                  }
                                                },
                                                "id": "finish"
                                              }
                                            ],
                                            "outputs": {
                                              "result": {
                                                "type": "HubResult",
                                                "value": {
                                                  "ref": "steps.finish.outputs.result"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      ],
                                      "default": {
                                        "kind": "call",
                                        "operation": "finish",
                                        "arguments": {
                                          "state": {
                                            "ref": "steps.advance_2.outputs.state"
                                          }
                                        }
                                      },
                                      "outputs": {
                                        "result": {
                                          "type": "HubResult",
                                          "value": {
                                            "ref": "selected.outputs.result"
                                          }
                                        }
                                      }
                                    }
                                  ],
                                  "outputs": {
                                    "result": {
                                      "type": "HubResult",
                                      "value": {
                                        "ref": "steps.remaining_2.outputs.result"
                                      }
                                    }
                                  }
                                }
                              }
                            ],
                            "default": {
                              "kind": "call",
                              "operation": "finish",
                              "arguments": {
                                "state": {
                                  "ref": "steps.advance_1.outputs.state"
                                }
                              }
                            },
                            "outputs": {
                              "result": {
                                "type": "HubResult",
                                "value": {
                                  "ref": "selected.outputs.result"
                                }
                              }
                            }
                          }
                        ],
                        "outputs": {
                          "result": {
                            "type": "HubResult",
                            "value": {
                              "ref": "steps.remaining_1.outputs.result"
                            }
                          }
                        }
                      }
                    }
                  ],
                  "default": {
                    "kind": "call",
                    "operation": "finish",
                    "arguments": {
                      "state": {
                        "ref": "steps.advance_0.outputs.state"
                      }
                    }
                  },
                  "outputs": {
                    "result": {
                      "type": "HubResult",
                      "value": {
                        "ref": "selected.outputs.result"
                      }
                    }
                  }
                }
              ],
              "outputs": {
                "result": {
                  "type": "HubResult",
                  "value": {
                    "ref": "steps.remaining_0.outputs.result"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "reject",
          "arguments": {
            "admission": {
              "ref": "steps.admission.outputs.admission"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.dispatch.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/workflow_hub/"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 11
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked control-flow description; no scientific validity or runtime qualification."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
