      }
    },
    "mathformer.native_boundary": {
      "execution": "Python hub and MCP step tools share entry guards, dependency state transitions, recursive visits and sequence finalization. Lunar executes the typed composition.",
      "callers": [
        "main direct run branch",
        "run_intent_match via repository.portable-adoption"
      ],
      "context_fields": [
        "dry_run",
        "json_output",
        "keep_going",
        "allow_mutating",
        "write_report"
      ],
      "failure_policy": "Return native failure payloads unchanged; unexpected exceptions propagate.",
      "ancestry": "Copied recursion ancestry only; never a global completed-action cache.",
      "runtime_qualification": "Registered MCP interfaces and real Lunar PRISM parser/checker/compiler/runtime tested deterministically, using native dry-run and recursion guard failures; no production adoption subprocesses were launched."
    },
    "mathformer.composition": {
