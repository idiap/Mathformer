{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_kb_index_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Ordered premise KB ingestion, optional indexes and semantic smoke search, then reporting.",
  "aliases": [
    "kb:index"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Arguments": {
      "schema": {
        "type": "array",
        "maxItems": 1024,
        "items": {
          "type": "string"
        }
      }
    },
    "State": {
      "schema": {
        "type": "object",
        "description": "JSON-safe native locals and persistent KBStore root; each step reopens the same stateless store facade. No checkpoint or rollback.",
        "required": [
          "options",
          "store",
          "files",
          "cursor",
          "results",
          "vampire_count",
          "bloom_paths",
          "embedding_index",
          "smoke_hits",
          "has_files",
          "vampire",
          "bloom",
          "embeddings",
          "smoke"
        ],
        "properties": {
          "options": {
            "type": "object",
            "description": "Parsed CLI options including original seed/corpus lists and resolved kb_root."
          },
          "store": {
            "type": "object",
            "description": "Persistent KBStore root; disk contents and curation history remain visible to subsequent steps."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Ordered accumulated AddResult records."
          },
          "vampire_count": {
            "type": "integer",
            "minimum": 0
          },
          "bloom_paths": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "embedding_index": {
            "type": [
              "string",
              "null"
            ]
          },
          "smoke_hits": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "has_files": {
            "type": "boolean"
          },
          "vampire": {
            "type": "boolean"
          },
          "bloom": {
            "type": "boolean"
          },
          "embeddings": {
            "type": "boolean"
          },
          "smoke": {
            "type": "boolean"
          }
        }
      }
    },
    "Flag": {
      "schema": {
        "type": "boolean"
      }
    },
    "Report": {
      "schema": {
        "type": "object",
        "required": [
          "ok",
          "kb_root",
          "seed_jsonl",
          "corpus_jsonl",
          "vampire_candidate_count",
          "add_results",
          "added_count",
          "duplicate_count",
          "bloom_paths",
          "embedding_index",
          "smoke_hits",
          "entry_count"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "kb_root": {
            "type": "string"
          },
          "seed_jsonl": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "corpus_jsonl": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vampire_candidate_count": {
            "type": "integer"
          },
          "add_results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "added_count": {
            "type": "integer"
          },
          "duplicate_count": {
            "type": "integer"
          },
          "bloom_paths": {
            "type": "object"
          },
          "embedding_index": {
            "type": [
              "string",
              "null"
            ]
          },
          "smoke_hits": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "entry_count": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "ExitCode": {
      "schema": {
        "type": "integer",
        "const": 0
      }
    },
    "Text": {
      "schema": {
        "type": "string"
      }
    }
  },
  "inputs": {
    "extra_args": {
      "type": "Arguments"
    }
  },
  "outputs": {
    "result": {
      "type": "Report",
      "value": {
        "ref": "flow.outputs.result"
      }
    },
    "exit_code": {
      "type": "ExitCode",
      "value": {
        "ref": "flow.outputs.exit_code"
      }
    },
    "stdout": {
      "type": "Text",
      "value": {
        "ref": "flow.outputs.stdout"
      }
    }
  },
  "operations": {
    "initialize": {
      "inputs": {
        "extra_args": {
          "type": "Arguments"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_initialize",
          "operation": "mathformer_kb_index_initialize"
        }
      }
    },
    "ingest_file": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_ingest_file",
          "operation": "mathformer_kb_index_ingest_file"
        }
      }
    },
    "retain": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_retain",
          "operation": "mathformer_kb_index_retain"
        }
      }
    },
    "ingest_vampire": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_ingest_vampire",
          "operation": "mathformer_kb_index_ingest_vampire"
        }
      }
    },
    "build_bloom": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_build_bloom",
          "operation": "mathformer_kb_index_build_bloom"
        }
      }
    },
    "build_embeddings": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_build_embeddings",
          "operation": "mathformer_kb_index_build_embeddings"
        }
      }
    },
    "search": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_search",
          "operation": "mathformer_kb_index_search"
        }
      }
    },
    "report": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "result": {
          "type": "Report"
        },
        "exit_code": {
          "type": "ExitCode"
        },
        "stdout": {
          "type": "Text"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_report",
          "operation": "mathformer_kb_index_report"
        }
      }
    },
    "files_empty": {
      "inputs": {
        "state": {
          "type": "State"
        }
      },
      "outputs": {
        "state": {
          "type": "State"
        },
        "done": {
          "type": "Flag"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_kb_index_files_empty",
          "operation": "mathformer_kb_index_files_empty"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "initialize",
        "kind": "call",
        "operation": "initialize",
        "arguments": {
          "extra_args": {
            "ref": "inputs.extra_args"
          }
        }
      },
      {
        "id": "files",
        "kind": "loop",
        "state_type": "State",
        "initial": {
          "ref": "steps.initialize.outputs.state"
        },
        "max_iterations": 1024,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "nonempty",
              "when": {
                "ref": "loop.state.has_files"
              },
              "body": {
                "kind": "call",
                "operation": "ingest_file",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "files_empty",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "State",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Flag",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        }
      },
      {
        "id": "vampire",
        "kind": "switch",
        "cases": [
          {
            "id": "enabled",
            "when": {
              "ref": "steps.files.outputs.state.vampire"
            },
            "body": {
              "kind": "call",
              "operation": "ingest_vampire",
              "arguments": {
                "state": {
                  "ref": "steps.files.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "retain",
          "arguments": {
            "state": {
              "ref": "steps.files.outputs.state"
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "bloom",
        "kind": "switch",
        "cases": [
          {
            "id": "enabled",
            "when": {
              "ref": "steps.vampire.outputs.state.bloom"
            },
            "body": {
              "kind": "call",
              "operation": "build_bloom",
              "arguments": {
                "state": {
                  "ref": "steps.vampire.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "retain",
          "arguments": {
            "state": {
              "ref": "steps.vampire.outputs.state"
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "embeddings",
        "kind": "switch",
        "cases": [
          {
            "id": "requested",
            "when": {
              "ref": "steps.bloom.outputs.state.embeddings"
            },
            "body": {
              "kind": "call",
              "operation": "build_embeddings",
              "arguments": {
                "state": {
                  "ref": "steps.bloom.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "retain",
          "arguments": {
            "state": {
              "ref": "steps.bloom.outputs.state"
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "smoke",
        "kind": "switch",
        "cases": [
          {
            "id": "query_present",
            "when": {
              "ref": "steps.embeddings.outputs.state.smoke"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "ensure_embeddings",
                  "kind": "switch",
                  "cases": [
                    {
                      "id": "forced",
                      "when": {
                        "not": {
                          "ref": "steps.embeddings.outputs.state.embeddings"
                        }
                      },
                      "body": {
                        "kind": "call",
                        "operation": "build_embeddings",
                        "arguments": {
                          "state": {
                            "ref": "steps.embeddings.outputs.state"
                          }
                        }
                      }
                    }
                  ],
                  "default": {
                    "kind": "call",
                    "operation": "retain",
                    "arguments": {
                      "state": {
                        "ref": "steps.embeddings.outputs.state"
                      }
                    }
                  },
                  "outputs": {
                    "state": {
                      "type": "State",
                      "value": {
                        "ref": "selected.outputs.state"
                      }
                    }
                  }
                },
                {
                  "id": "query",
                  "kind": "call",
                  "operation": "search",
                  "arguments": {
                    "state": {
                      "ref": "steps.ensure_embeddings.outputs.state"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "State",
                  "value": {
                    "ref": "steps.query.outputs.state"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "retain",
          "arguments": {
            "state": {
              "ref": "steps.embeddings.outputs.state"
            }
          }
        },
        "outputs": {
          "state": {
            "type": "State",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "report",
        "kind": "call",
        "operation": "report",
        "arguments": {
          "state": {
            "ref": "steps.smoke.outputs.state"
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Report",
        "value": {
          "ref": "steps.report.outputs.result"
        }
      },
      "exit_code": {
        "type": "ExitCode",
        "value": {
          "ref": "steps.report.outputs.exit_code"
        }
      },
      "stdout": {
        "type": "Text",
        "value": {
          "ref": "steps.report.outputs.stdout"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": [
          "artifacts/kb/",
          "artifacts/workflow_hub/",
          "configured_kb_root"
        ]
      },
      "network": [
        "native_binding_capabilities_require_qualification"
      ],
      "external_write": [
        "native_binding_capabilities_require_qualification"
      ]
    },
    "authority": {
      "allowed": [
        "invoke_registered_native_workflow"
      ],
      "forbidden": [
        "bypass_native_controls",
        "infer_scientific_truth_from_completion"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 1034
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Source-linked description only; completion does not prove premises or qualify runtime behavior."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
  "provenance": {
    "coverage": "complete",
    "sources": [
      {
        "path": "skills/premise-kb/premise-kb-indexer/scripts/index_premise_kb.py",
        "digest": "sha256:92c948b8ce71704da1999309588b9ed763331aef1eb289bcd80463e2df091591",
        "selector": "main"
      },
      {
        "path": "scripts/premise_kb_index_tools.py",
        "digest": "sha256:d139266cb6873389032391a01025ab1d459ad6d70e6c25ea1b56534cd955b178"
      },
      {
        "path": "scripts/mathformer.py",
        "digest": "sha256:9aeea40cc2fa10223d2315409f055e95e4e368ca0358bfe5173b644d008356a0"
      },
      {
        "path": "scripts/mcp_server.py",
        "digest": "sha256:e8d99ef05300267dc16e41f072baedd8cf4bebafb19a82ecf8fdd2ac051c2ba2"
      },
      {
        "path": "scripts/mathformer_mcp_service.py",
        "digest": "sha256:ff2a57a3dc268e73d31e34605d80a65a5bdc6e16e28ad41af5752ad8bae60164"
      },
      {
        "path": "skills/control/workflow-contract-validator/scripts/normalize_workflows.py",
        "digest": "sha256:eaa651dbf2f2e1633a0637e4978f92863b83dbf768e6a16c77f25e6c071fd418"
      }
    ],
    "gaps": []
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "kb:index",
      "owner_skill": "skills/premise-kb/premise-kb-indexer/SKILL.md"
    },
    "mathformer.native_semantics": {
      "initialization": "Defaults: kb_root=artifacts/kb/premise_kb, embedding_dimension=512, vampire_limit=None. Resolve relative paths against REPO_ROOT, preserving absolute paths; initialize store; results=[], vampire_count=0, bloom_paths={}, embedding_index=null, smoke_hits=[]. Flags use native truth tests; files are seed_jsonl followed by corpus_jsonl.",
      "ingestion": "Each file is fully read before insertion; skip blank lines and parse KBEntry JSON records in order. Insert against evolving persistent store canonical hashes, accumulating AddResult records; no rollback on later failure.",
      "vampire": "Recursively discover discovery_report.json, sort paths, apply reports[:limit]; None means all reports. Accumulate entries across selected reports before insertion; limit bounds reports rather than entries and preserves Python slicing, including zero/negative limits.",
      "stopping": "Exhaust each supplied file and its records, then report and return 0. Uncaught parsing, ingestion, indexing or I/O errors abort; argparse may exit before initialization. No retries, convergence loop or native global time budget.",
      "reporting": "JSON prints the full payload and store statistics; compact output prints ok, kb_root, added_count, duplicate_count, entry_count and embedding_index when present."
    },
    "mathformer.native_boundary": {
      "execution": "scripts/mathformer.py kb:index -> run_action -> run_leaf_action; no dependencies, forwards extra CLI arguments. Hub preflight failure/dry run returns before main; subprocess exit determines success, additionally subject to undeclared-write audit.",
      "direct_callers": [
        "tests/kb/run_premise_kb_skill_scripts.py",
        "tests/kb/run_famous_theorem_corpus.py"
      ],
      "outputs": "Graph exports main payload and zero exit code; hub adds its transport envelope outside this selected-source graph.",
      "mcp": "Registered tools invoke shared source steps; service write-root and read-only guards precede mutations. Hub subprocess preflight and write audits remain outside this selected-source graph."
    },
    "mathformer.loop_lowering": {
      "reason": "Lunar requires fail-on-exhausted loops outside switch branches. The immutable has_files guard is tested inside each iteration; an empty file list carries locals once and stops, without any read or insertion."
    },
    "mathformer.binding_qualification": {
      "notes": [
        "CLI specialization accepts at most 1024 tokens, hence at most 1024 supplied files. The last file sets done even at the cap and returns normally; exhaustion failure is unreachable for admitted successful inputs. Native CLI has no such cap.",
        "The 3600-second and operation-call limits are enforced by Lunar for this binding; the direct native CLI remains unbounded and kb:index has no subprocess timeout.",
        "Native report printing is retained on MCP stderr and exported as stdout. Lunar owns the required execution receipts and provenance; native CLI alone does not provide v1 receipts."
      ]
    }
  }
}
