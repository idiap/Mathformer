      }
    }
  },
  "operations": {
    "admit": {
      "inputs": {
        "extra_args": {
          "type": "Strings"
        },
        "seen": {
          "type": "Strings"
        }
      },
      "outputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_admit",
          "operation": "mathformer_coherence_repair_alias_admit"
        }
      }
    },
    "reject": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_reject",
          "operation": "mathformer_coherence_repair_alias_reject"
        }
      }
    },
    "initialize": {
      "inputs": {
        "admission": {
          "type": "Admission"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_initialize",
          "operation": "mathformer_coherence_repair_alias_initialize"
        }
      }
    },
    "visit": {
      "inputs": {
        "context": {
          "type": "Context"
        },
        "state": {
          "type": "DependencyState"
        },
        "repository_root": {
          "type": "RepositoryRoot"
        }
      },
      "outputs": {
        "child": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_visit",
          "operation": "mathformer_coherence_repair_alias_visit"
        }
      }
    },
    "advance": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        },
        "child": {
          "type": "HubResult"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        },
        "done": {
          "type": "Done"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_advance",
          "operation": "mathformer_coherence_repair_alias_advance"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        }
      },
      "outputs": {
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_finish",
          "operation": "mathformer_coherence_repair_alias_finish"
        }
      }
    },
    "carry": {
      "inputs": {
        "state": {
          "type": "DependencyState"
        },
        "result": {
          "type": "HubResult"
        }
      },
      "outputs": {
        "state": {
          "type": "DependencyState"
        },
        "done": {
          "type": "Done"
        },
        "result": {
          "type": "HubResult"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_coherence_repair_alias_carry",
          "operation": "mathformer_coherence_repair_alias_carry"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "admission",
        "kind": "call",
        "operation": "admit",
        "arguments": {
          "extra_args": {
            "ref": "inputs.extra_args"
          },
          "seen": {
            "ref": "inputs.seen"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "initial",
                  "kind": "call",
                  "operation": "initialize",
                  "arguments": {
                    "admission": {
                      "ref": "steps.admission.outputs.admission"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "DependencyState",
                  "value": {
                    "ref": "steps.initial.outputs.state"
                  }
                },
                "rejection": {
                  "type": "HubResult",
                  "value": {
                    "literal": {
                      "ok": true
                    }
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "reject",
              "arguments": {
                "admission": {
                  "ref": "steps.admission.outputs.admission"
                }
              },
              "id": "rejection"
            }
          ],
          "outputs": {
            "state": {
              "type": "DependencyState",
              "value": {
                "literal": {
                  "index": 0,
                  "children": [],
                  "dependencies_ok": true,
                  "ancestry": []
                }
              }
            },
            "rejection": {
              "type": "HubResult",
              "value": {
                "ref": "steps.rejection.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "DependencyState",
            "value": {
              "ref": "selected.outputs.state"
            }
          },
          "rejection": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.rejection"
            }
          }
        }
      },
      {
        "id": "dependencies",
        "kind": "loop",
        "state_type": "DependencyState",
        "initial": {
          "ref": "steps.dispatch.outputs.state"
        },
        "max_iterations": 1,
        "on_exhausted": "fail",
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "accepted",
              "when": {
                "ref": "steps.admission.outputs.admission.accepted"
              },
              "body": {
                "kind": "sequence",
                "steps": [
                  {
                    "id": "child",
                    "kind": "call",
                    "operation": "visit",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "context": {
                        "ref": "inputs.context"
                      },
                      "repository_root": {
                        "ref": "inputs.repository_root"
                      }
                    }
                  },
                  {
                    "id": "advance",
                    "kind": "call",
                    "operation": "advance",
                    "arguments": {
                      "state": {
                        "ref": "loop.state"
                      },
                      "child": {
                        "ref": "steps.child.outputs.child"
                      },
                      "context": {
                        "ref": "inputs.context"
                      }
                    }
                  }
                ],
                "outputs": {
                  "state": {
                    "type": "DependencyState",
                    "value": {
                      "ref": "steps.advance.outputs.state"
                    }
                  },
                  "done": {
                    "type": "Done",
                    "value": {
                      "ref": "steps.advance.outputs.done"
                    }
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "sequence",
            "steps": [
              {
                "kind": "call",
                "operation": "carry",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  },
                  "result": {
                    "ref": "steps.dispatch.outputs.rejection"
                  }
                },
                "id": "carry"
              }
            ],
            "outputs": {
              "state": {
                "type": "DependencyState",
                "value": {
                  "ref": "steps.carry.outputs.state"
                }
              },
              "done": {
                "type": "Done",
                "value": {
                  "ref": "steps.carry.outputs.done"
                }
              }
            }
          },
          "outputs": {
            "state": {
              "type": "DependencyState",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Done",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "outputs": {
          "state": {
            "type": "DependencyState",
            "value": {
              "ref": "body.outputs.state"
            }
          }
        },
        "description": "Exactly one native dependency visit; rejected admission carries data without native work. No retry or refinement."
      },
      {
        "id": "completion",
        "kind": "switch",
        "cases": [
          {
            "id": "accepted",
            "when": {
              "ref": "steps.admission.outputs.admission.accepted"
            },
            "body": {
              "id": "completion",
              "kind": "call",
              "operation": "finish",
              "arguments": {
                "state": {
                  "ref": "steps.dependencies.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "call",
              "operation": "carry",
              "arguments": {
                "state": {
                  "ref": "steps.dispatch.outputs.state"
                },
                "result": {
                  "ref": "steps.dispatch.outputs.rejection"
                }
              },
              "id": "carry"
            }
          ],
          "outputs": {
            "result": {
              "type": "HubResult",
              "value": {
                "ref": "steps.carry.outputs.result"
              }
            }
          }
        },
        "outputs": {
          "result": {
            "type": "HubResult",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "HubResult",
        "value": {
          "ref": "steps.completion.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
