{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_physics_lib_coherence_repair_plan_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Ordered execution of the single registered coherence repair planning dependency through shared native hub stages.",
  "aliases": [
    "physics-lib:coherence-repair-plan"
  ],
  "lifecycle": "active",
  "activation": {
