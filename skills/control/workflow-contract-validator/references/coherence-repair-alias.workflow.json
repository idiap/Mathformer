        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "Done": {
      "schema": {
        "type": "boolean"
      }
    },
    "Admission": {
      "schema": {
        "type": "object",
        "required": [
          "accepted",
          "status",
          "ancestry"
        ],
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "unknown_action",
              "dependency_cycle",
              "extra_args_for_sequence"
            ]
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "DependencyState": {
      "schema": {
        "type": "object",
        "required": [
          "index",
          "children",
          "dependencies_ok",
          "ancestry"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "children": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "ok"
              ],
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              }
            }
          },
          "dependencies_ok": {
            "type": "boolean"
          },
          "ancestry": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "RepositoryRoot": {
      "schema": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "inputs": {
    "context": {
      "type": "Context"
    },
    "extra_args": {
