    "gaps": [
      "Input domain excludes expansions exceeding 4096 paths. Request documents this semantic precondition; Scan constrains the materialized list. Native execution has no file-count cap.",
      "At 4096 files the final iteration sets done=true and returns normally. Exhaustion is unreachable within the input domain; larger expansions are unsupported, not native validation failures.",
      "Recursive checks, expansion iteration and self-test internals remain inside their owning operations; full Python equivalence is not claimed.",
      "Time/call budgets and mandatory receipts are descriptor constraints, not native timeout or logging guarantees. Native subprocess timeout is unset.",
      "CLI emission is captured in Result stdout/stderr to preserve the MCP transport. Context selects the repository registry/profile roots and argparse program name; input paths retain native resolution relative to the server working directory.",
      "Lunar requires loop exhaustion at root scope. The root loop carries early results and empty scans through a single identity settle step; terminal_result forwards an early result. These adapters perform no native validation, I/O or emission. File paths still execute exactly once in order, with the same 4096-file specialization."
    ]
  },
  "extensions": {
    "mathformer.source": {
      "category": "hub",
      "native_id": "control:reasoning-flow-language",
      "owner_skill": "skills/control/reasoning-flow-language/SKILL.md",
      "contract": {
        "id": "control:reasoning-flow-language",
        "family": "control",
        "kind": "validation",
        "safety": "read_only",
        "command": [
          "{python}",
          "skills/control/reasoning-flow-language/scripts/validate_reasoning_flow.py",
          "examples/reasoning_flows",
          "--strict",
          "--check-registries",
          "--json"
        ],
        "depends_on": [],
        "writes": [],
        "allows_extra_args": false,
        "timeout_seconds": null
      }
    },
    "mathformer.native_boundary": {
      "execution": "scripts/mathformer.py: run_action -> run_leaf_action; preflight errors block, dry-run skips execution, writes are audited afterward.",
      "callers": [
        "control:all",
        "control.reasoning.flow.language"
      ],
      "optional_hub_reports": "artifacts/workflow_hub/ is outside this main-only graph.",
      "failure_policy": "Report failures return exit_code=1; argument errors retain SystemExit 2. Uncaught filesystem and other exceptions stop execution.",
      "scientific_payloads": "Result is a CLI envelope around native validation payloads, rather than HubResult.",
      "effects_status": "main reads only"
    },
    "mathformer.validation": {
      "ordering": "Registry load precedes self-test, which precedes absent-path rejection. All expansion precedes file validation; registry checks follow file reports.",
      "state": "Scan carries expanded_paths, cursor, accumulated reports and session. Recursive per-file checks own findings, alias/resource/handle-kind maps, accessed-resource sets and duplicate-edge sets.",
      "semantics": "validate_text -> parse_document -> validate_flow checks sequences, choice output compatibility, handle conservation/kinds, aliases, resource access/persistence, terminal calibration, goal production and handler authority.",
      "failure_continuation": "Missing files and syntax errors append failed reports while processing continues. Strict mode makes warnings blocking.",
      "repeats": "Static declarations require 0 <= minimum <= maximum <= 32, terminal calibration and an internal calibration occurrence for the stopping predicate. Bodies and handlers are never executed.",
      "registry_checks": "Conditional on check_registries; syntax/reference alignment, taxonomy coverage and reasoning-style profile coverage.",
      "completion": "all(report.ok) and no registry findings; zero expanded files can pass. No retry or convergence loop exists.",
      "payload": "schema_version, language_version, ok, flow_count, valid_flow_count, gap_bearing_flow_count, registry_findings, flows.",
      "rendering": "JSON uses indentation and sorted keys; text emits per-file PASS/FAIL and findings, followed by registry failures."
    }
  }
}
