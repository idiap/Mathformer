{
  "schema_version": "workflow-skill/v1",
  "namespace": "mathformer",
  "id": "hub_control_reasoning_flow_language_workflow",
  "version": "1.0.0",
  "kind": "workflow",
  "description": "Static ERFL validation through main(argv), specialized to at most 4096 expanded paths.",
  "aliases": [
    "control:reasoning-flow-language"
  ],
  "lifecycle": "active",
  "activation": {
    "mode": "explicit",
    "prerequisites": []
  },
  "types": {
    "Request": {
      "schema": {
        "type": "object",
        "required": [
          "paths",
          "registry",
          "strict",
          "check_registries",
          "self_test",
          "json"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "string"
            },
            "description": "Input domain requires at most 4096 total expanded paths, including directory entries."
          },
          "registry": {
            "type": "string"
          },
          "strict": {
            "type": "boolean"
          },
          "check_registries": {
            "type": "boolean"
          },
          "self_test": {
            "type": "boolean"
          },
          "json": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Session": {
      "schema": {
        "type": "object",
        "description": "Parsed arguments, loaded semantic registry or caught registry error, and argument-error context."
      }
    },
    "Route": {
      "schema": {
        "type": "string",
        "enum": [
          "registry_error",
          "self_test",
          "argument_error",
          "files"
        ]
      }
    },
    "Bool": {
      "schema": {
        "type": "boolean"
      }
    },
    "Scan": {
      "schema": {
        "type": "object",
        "required": [
          "expanded_paths",
          "cursor",
          "reports",
          "session",
          "pending",
          "result"
        ],
        "properties": {
          "expanded_paths": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "session": {
            "type": "object"
          },
          "pending": {
            "type": "boolean"
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "Result": {
      "schema": {
        "type": "object",
        "required": [
          "exit_code",
          "payload",
          "stdout",
          "stderr"
        ],
        "properties": {
          "exit_code": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ]
          },
          "payload": {
            "type": [
              "object",
              "null"
            ]
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "Context": {
      "schema": {
        "type": "object",
        "required": [
          "repository_root",
          "program"
        ],
        "properties": {
          "repository_root": {
            "type": "string"
          },
          "program": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "inputs": {
    "request": {
      "type": "Request"
    },
    "context": {
      "type": "Context"
    }
  },
  "outputs": {
    "result": {
      "type": "Result",
      "value": {
        "ref": "flow.outputs.result"
      }
    }
  },
  "operations": {
    "prepare": {
      "inputs": {
        "request": {
          "type": "Request"
        },
        "context": {
          "type": "Context"
        }
      },
      "outputs": {
        "session": {
          "type": "Session"
        },
        "route": {
          "type": "Route"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_prepare",
          "operation": "mathformer_reasoning_flow_prepare"
        }
      }
    },
    "early_exit": {
      "inputs": {
        "session": {
          "type": "Session"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        },
        "state": {
          "type": "Scan"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_early_exit",
          "operation": "mathformer_reasoning_flow_early_exit"
        }
      }
    },
    "self_test": {
      "inputs": {
        "session": {
          "type": "Session"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        },
        "state": {
          "type": "Scan"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_self_test",
          "operation": "mathformer_reasoning_flow_self_test"
        }
      }
    },
    "expand": {
      "inputs": {
        "session": {
          "type": "Session"
        }
      },
      "outputs": {
        "state": {
          "type": "Scan"
        },
        "has_files": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_expand",
          "operation": "mathformer_reasoning_flow_expand"
        }
      }
    },
    "validate_next": {
      "inputs": {
        "state": {
          "type": "Scan"
        }
      },
      "outputs": {
        "state": {
          "type": "Scan"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_validate_next",
          "operation": "mathformer_reasoning_flow_validate_next"
        }
      }
    },
    "finish": {
      "inputs": {
        "state": {
          "type": "Scan"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_finish",
          "operation": "mathformer_reasoning_flow_finish"
        }
      }
    },
    "settle": {
      "inputs": {
        "state": {
          "type": "Scan"
        }
      },
      "outputs": {
        "state": {
          "type": "Scan"
        },
        "done": {
          "type": "Bool"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_settle",
          "operation": "mathformer_reasoning_flow_settle"
        }
      }
    },
    "terminal_result": {
      "inputs": {
        "state": {
          "type": "Scan"
        }
      },
      "outputs": {
        "result": {
          "type": "Result"
        }
      },
      "execution": {
        "mode": "deterministic",
        "binding": {
          "adapter": "mcp.tool",
          "kind": "tool",
          "target": "mathformer_reasoning_flow_terminal_result",
          "operation": "mathformer_reasoning_flow_terminal_result"
        }
      }
    }
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "id": "prepare",
        "kind": "call",
        "operation": "prepare",
        "arguments": {
          "request": {
            "ref": "inputs.request"
          },
          "context": {
            "ref": "inputs.context"
          }
        }
      },
      {
        "id": "dispatch",
        "kind": "switch",
        "cases": [
          {
            "id": "self_test",
            "when": {
              "eq": [
                {
                  "ref": "steps.prepare.outputs.route"
                },
                {
                  "literal": "self_test"
                }
              ]
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "invoke",
                  "kind": "call",
                  "operation": "self_test",
                  "arguments": {
                    "session": {
                      "ref": "steps.prepare.outputs.session"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "Scan",
                  "value": {
                    "ref": "steps.invoke.outputs.state"
                  }
                }
              }
            }
          },
          {
            "id": "files",
            "when": {
              "eq": [
                {
                  "ref": "steps.prepare.outputs.route"
                },
                {
                  "literal": "files"
                }
              ]
            },
            "body": {
              "kind": "sequence",
              "steps": [
                {
                  "id": "invoke",
                  "kind": "call",
                  "operation": "expand",
                  "arguments": {
                    "session": {
                      "ref": "steps.prepare.outputs.session"
                    }
                  }
                }
              ],
              "outputs": {
                "state": {
                  "type": "Scan",
                  "value": {
                    "ref": "steps.invoke.outputs.state"
                  }
                }
              }
            }
          }
        ],
        "default": {
          "kind": "sequence",
          "steps": [
            {
              "id": "invoke",
              "kind": "call",
              "operation": "early_exit",
              "arguments": {
                "session": {
                  "ref": "steps.prepare.outputs.session"
                }
              }
            }
          ],
          "outputs": {
            "state": {
              "type": "Scan",
              "value": {
                "ref": "steps.invoke.outputs.state"
              }
            }
          }
        },
        "outputs": {
          "state": {
            "type": "Scan",
            "value": {
              "ref": "selected.outputs.state"
            }
          }
        }
      },
      {
        "id": "files_loop",
        "kind": "loop",
        "state_type": "Scan",
        "initial": {
          "ref": "steps.dispatch.outputs.state"
        },
        "body": {
          "kind": "switch",
          "cases": [
            {
              "id": "pending",
              "when": {
                "ref": "loop.state.pending"
              },
              "body": {
                "kind": "call",
                "operation": "validate_next",
                "arguments": {
                  "state": {
                    "ref": "loop.state"
                  }
                }
              }
            }
          ],
          "default": {
            "kind": "call",
            "operation": "settle",
            "arguments": {
              "state": {
                "ref": "loop.state"
              }
            }
          },
          "outputs": {
            "state": {
              "type": "Scan",
              "value": {
                "ref": "selected.outputs.state"
              }
            },
            "done": {
              "type": "Bool",
              "value": {
                "ref": "selected.outputs.done"
              }
            }
          }
        },
        "next_state": {
          "ref": "body.outputs.state"
        },
        "until": {
          "ref": "body.outputs.done"
        },
        "max_iterations": 4096,
        "on_exhausted": "fail",
        "outputs": {
          "state": {
            "type": "Scan",
            "value": {
              "ref": "loop.state"
            }
          }
        }
      },
      {
        "id": "complete",
        "kind": "switch",
        "cases": [
          {
            "id": "files",
            "when": {
              "eq": [
                {
                  "ref": "steps.prepare.outputs.route"
                },
                {
                  "literal": "files"
                }
              ]
            },
            "body": {
              "kind": "call",
              "operation": "finish",
              "arguments": {
                "state": {
                  "ref": "steps.files_loop.outputs.state"
                }
              }
            }
          }
        ],
        "default": {
          "kind": "call",
          "operation": "terminal_result",
          "arguments": {
            "state": {
              "ref": "steps.files_loop.outputs.state"
            }
          }
        },
        "outputs": {
          "result": {
            "type": "Result",
            "value": {
              "ref": "selected.outputs.result"
            }
          }
        }
      }
    ],
    "outputs": {
      "result": {
        "type": "Result",
        "value": {
          "ref": "steps.complete.outputs.result"
        }
      }
    }
  },
  "policy": {
    "effects": {
      "filesystem": {
        "read": [
          "repository",
          "native_runtime_inputs"
        ],
        "write": []
      },
      "network": [],
      "external_write": []
    },
    "authority": {
      "allowed": [
        "validate_static_reasoning_flow"
      ],
      "forbidden": [
        "execute_repeat_bodies_or_handlers",
        "infer_scientific_truth_from_completion",
        "bypass_native_controls"
      ]
    },
    "limits": {
      "wall_time_seconds": 3600,
      "max_operation_calls": 4100
    },
    "failure": {
      "default": "fail",
      "retry": {
        "max_attempts": 1,
        "retryable_codes": []
      }
    },
    "resume": {
      "mode": "none",
      "require_matching_definition_and_inputs": true
    },
    "claim_ceiling": "Static validation only; completion establishes neither scientific truth nor execution of repeat bodies or handlers."
  },
  "observability": {
    "receipts": "required",
    "artifact_digests": "sha256",
    "provenance": "required",
    "events": [
      "workflow_started",
      "step_completed",
      "step_failed",
      "workflow_completed"
    ]
  },
