{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mathformer Paper Theory Autoformalization Plan",
  "type": "object",
  "required": [
    "status",
    "layout_packet",
    "theory_localization_packet",
    "expanded_intermediate_queue",
    "reference_support_packet",
    "main_result_drafting_queue",
    "blocked_or_unresolved_dependencies"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready_for_expansion", "needs_support", "blocked"]
    },
    "layout_packet": {"type": "object"},
    "theory_localization_packet": {"type": ["object", "null"]},
    "expanded_intermediate_queue": {"type": "array", "items": {"type": "object"}},
    "reference_support_packet": {"type": "object"},
    "main_result_drafting_queue": {"type": "array", "items": {"type": "object"}},
    "blocked_or_unresolved_dependencies": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
