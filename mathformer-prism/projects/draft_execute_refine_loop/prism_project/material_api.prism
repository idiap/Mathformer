from materialization import DraftExecuteRefineLoop
from draft_execute_refine_loop import LeanFormalizationDraftBrief, LeanRefinementOutcome

def run_material(
    workflow_source: LeanFormalizationDraftBrief,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[LeanRefinementOutcome], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve DraftExecuteRefineLoop(workflow_source)
