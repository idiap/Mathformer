# Construct one source-anchored Lean candidate while retaining unresolved obligations. This record retains the authority ceiling of a candidate occurrence.
type LeanDraft:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the candidate.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Record compilation and source-anchor evidence for the exact candidate. This record retains the authority ceiling of a evidence occurrence.
type LeanExecutionEvidence:
    # Inspectible references to evidence in the declared scope.
    evidence_refs: List[String]
    # Results directly observed by the bounded probe or execution.
    observed_results: List[String]
    # Limits on what the evidence can establish.
    limitations: List[String]

# Reviewed domain inputs required by AssessLeanSemantics in draft_execute_refine_loop.
type LeanReviewCase:
    # Reviewed draft supplied to AssessLeanSemantics.
    draft: LeanDraft
    # Reviewed execution evidence supplied to AssessLeanSemantics.
    execution_evidence: LeanExecutionEvidence

# Assess mathematical meaning, preservation, logical soundness, and reference-free drift. This record retains the authority ceiling of a assessment occurrence.
type LeanSemanticAssessment:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AssessLeanSyntax in draft_execute_refine_loop.
type LeanFormalReviewCase:
    # Reviewed draft supplied to AssessLeanSyntax.
    draft: LeanDraft
    # Reviewed execution evidence supplied to AssessLeanSyntax.
    execution_evidence: LeanExecutionEvidence

# Assess syntactic correctness and the combined critique findings. This record retains the authority ceiling of a assessment occurrence.
type LeanFormalAssessment:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AssessMathlibAlignment in draft_execute_refine_loop.
type LeanLibraryReviewCase:
    # Reviewed draft supplied to AssessMathlibAlignment.
    draft: LeanDraft
    # Reviewed execution evidence supplied to AssessMathlibAlignment.
    execution_evidence: LeanExecutionEvidence

# Assess use of applicable mathlib abstractions and imports. This record retains the authority ceiling of a assessment occurrence.
type LeanLibraryAssessment:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by ReviseLeanDraft in draft_execute_refine_loop.
type LeanRevisionCase:
    # Reviewed draft supplied to ReviseLeanDraft.
    draft: LeanDraft
    # Reviewed semantic assessment supplied to ReviseLeanDraft.
    semantic_assessment: LeanSemanticAssessment
    # Reviewed formal assessment supplied to ReviseLeanDraft.
    formal_assessment: LeanFormalAssessment
    # Reviewed library assessment supplied to ReviseLeanDraft.
    library_assessment: LeanLibraryAssessment

# Create a new candidate identity from the criterion-scoped findings. This record retains the authority ceiling of a candidate occurrence.
type RevisedLeanDraft:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the candidate.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Reviewed domain inputs required by CalibrateRefinementStatus in draft_execute_refine_loop.
type RefinementCase:
    # Reviewed revised draft supplied to CalibrateRefinementStatus.
    revised_draft: RevisedLeanDraft
    # Reviewed semantic assessment supplied to CalibrateRefinementStatus.
    semantic_assessment: LeanSemanticAssessment
    # Reviewed formal assessment supplied to CalibrateRefinementStatus.
    formal_assessment: LeanFormalAssessment
    # Reviewed library assessment supplied to CalibrateRefinementStatus.
    library_assessment: LeanLibraryAssessment

# Record the one-pass revision status and the obligations requiring another execution cycle. This record retains the authority ceiling of a decision occurrence.
type LeanRefinementDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
