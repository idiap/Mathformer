# Neuro-symbolic AI Group
# Domain-specific source boundary for the named draft_execute_refine_loop Mathformer workflow.
type LeanFormalizationDraftBrief:
    # Source-anchored mathematical claims to formalize in Lean.
    source_claims: List[String]
    # Lean module, imports, namespace, and version constraints.
    target_context: String
    # Criteria that candidate revisions must satisfy before acceptance.
    acceptance_criteria: String

# Domain-specific result of draft.initial within the named draft_execute_refine_loop workflow.
type DraftExecuteRefineDraftInitialArtifact:
    # Exact subject processed by the draft.initial occurrence.
    subject: String
    # Source anchors retained by the draft.initial occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical draft.initial contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to draft.initial.
    gate_disposition: String
    # Known limitations that constrain use of the draft.initial result.
    limitations: List[String]
    # Candidate transformation or artifact produced for later checks.
    candidate_content: String
    # Obligations that remain before the candidate can be accepted.
    unresolved_obligations: List[String]

