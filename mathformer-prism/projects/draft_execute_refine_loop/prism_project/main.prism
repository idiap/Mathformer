from materialization import converted_reasoning
from reasoning import RefineLeanDraft
from draft_execute_refine_loop import LeanFormalizationDraftBrief, LeanRefinementDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[LeanRefinementDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = LeanFormalizationDraftBrief(
        source_claims = ["fixture:draft_execute_refine_loop:source_claims"],
        target_context = "fixture:draft_execute_refine_loop:target_context",
        acceptance_criteria = "fixture:draft_execute_refine_loop:acceptance_criteria",
    )
    flow = converted_reasoning(workflow_source)
    return solve RefineLeanDraft(workflow_source) using flow
