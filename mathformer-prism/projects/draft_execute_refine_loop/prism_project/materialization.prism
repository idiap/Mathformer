# initial draft, seed replay, Lean execution, critique, refinement, denoising, and transition logging.
workflow DraftExecuteRefineLoop(
    workflow_source: LeanFormalizationDraftBrief,
) -> Computed[LeanRefinementOutcome]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [draft_initial: draft_initial_agent(workflow_source)]
        [draft_seed: draft_seed_material_binding(draft_initial.value)]
        [execute_initial: execute_initial_material_binding(draft_seed.value)]
        [check_compile: check_compile_material_binding(execute_initial.value)]
        [postformalization_source_anchor_drift_guard: postformalization_source_anchor_drift_guard_material_binding(check_compile.value)]
        [critique_semantic: critique_semantic_agent(postformalization_source_anchor_drift_guard.value)]
        [critique_syntax: critique_syntax_agent(critique_semantic.value)]
        [critique_semantic_preservation: critique_semantic_preservation_agent(critique_syntax.value)]
        [critique_logical_soundness: critique_logical_soundness_agent(critique_semantic_preservation.value)]
        [critique_mathlib_alignment: critique_mathlib_alignment_agent(critique_logical_soundness.value)]
        [critique_suite: critique_suite_agent(critique_mathlib_alignment.value)]
        [critique_reference_free_monitor: critique_reference_free_monitor_material_binding(critique_suite.value)]
        [refine_formal: refine_formal_agent(critique_reference_free_monitor.value)]
        [refine_semantic: refine_semantic_agent(refine_formal.value)]
        [output_denoise: output_denoise_agent(refine_semantic.value)]
        [annotate_line_comment_guard: annotate_line_comment_guard_material_binding(output_denoise.value)]
        [transition_taxonomy: transition_taxonomy_material_binding(annotate_line_comment_guard.value)]
    return transition_taxonomy
