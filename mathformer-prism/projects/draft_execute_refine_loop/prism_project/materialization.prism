converted_reasoning = RefineLeanDraft(
    draft = draft_reasoning_agent,
    execution_evidence = execution_evidence_reasoning_agent,
    execution_evidence_by = execution_evidence_reasoning_relation_builder,
    semantic_assessment = semantic_assessment_reasoning_agent,
    semantic_assessment_by = semantic_assessment_reasoning_relation_builder,
    formal_assessment = formal_assessment_reasoning_agent,
    formal_assessment_by = formal_assessment_reasoning_relation_builder,
    library_assessment = library_assessment_reasoning_agent,
    library_assessment_by = library_assessment_reasoning_relation_builder,
    revised_draft = revised_draft_reasoning_agent,
    revised_draft_by = revised_draft_reasoning_relation_builder,
    refinement_status = refinement_status_reasoning_agent,
    refinement_status_by = refinement_status_reasoning_relation_builder,
)

