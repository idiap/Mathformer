# Generative interpretation ProposeLeanDraft uses skill context selected from material steps: draft_initial, draft_seed.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: lean-autoformalization-drafter, autoformalization-workflow-orchestrator.
agent draft_reasoning_agent(
    task: LeanFormalizationDraftBrief,
) -> Result[Generated[LeanDraft], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[LeanFormalizationDraftBrief] = [draft_reasoning_skill_1, draft_reasoning_skill_2]

# Generative interpretation ExecuteLeanDraft uses skill context selected from material steps: execute_initial, check_compile, postformalization_source_anchor_drift_guard.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: lean-execution-runner, lean-compile-checker, source-formalization-drift-guard.
agent execution_evidence_reasoning_agent(
    task: LeanDraft,
) -> Result[Generated[LeanExecutionEvidence], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[LeanDraft] = [execution_evidence_reasoning_skill_1, execution_evidence_reasoning_skill_2, execution_evidence_reasoning_skill_3]

