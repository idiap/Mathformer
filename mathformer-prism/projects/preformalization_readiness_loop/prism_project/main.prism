from materialization import converted_reasoning
from reasoning import PreparePaperTheoryForLean
from preformalization_readiness_loop import PaperFormalizationSourceSelection, DraftingDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[DraftingDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = PaperFormalizationSourceSelection(
        source_paths = ["fixture:preformalization_readiness_loop:source_paths"],
        target_backend = "fixture:preformalization_readiness_loop:target_backend",
        formalization_scope = "fixture:preformalization_readiness_loop:formalization_scope",
    )
    flow = converted_reasoning(workflow_source)
    return solve PreparePaperTheoryForLean(workflow_source) using flow
