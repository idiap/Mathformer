# Neuro-symbolic AI Group
# Domain-specific source boundary for the named preformalization_readiness_loop Mathformer workflow.
type PaperFormalizationSourceSelection:
    # Selected paper or source paths that delimit formalization scope.
    source_paths: List[String]
    # Formal proof backend targeted by the readiness assessment.
    target_backend: String
    # Human-readable scope for theory extraction and expansion.
    formalization_scope: String

# Domain-specific result of intake.paper_layout_extract within the named preformalization_readiness_loop workflow.
type PreformalizationReadinessIntakePaperLayoutExtractArtifact:
    # Exact subject processed by the intake.paper_layout_extract occurrence.
    subject: String
    # Source anchors retained by the intake.paper_layout_extract occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical intake.paper_layout_extract contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to intake.paper_layout_extract.
    gate_disposition: String
    # Known limitations that constrain use of the intake.paper_layout_extract result.
    limitations: List[String]
    # Retrieved or extracted candidates with retained identifiers.
    candidate_references: List[String]
    # Named retrieval, parsing, or grounding basis used for selection.
    selection_basis: String
    # Relevant candidates excluded together with their stated reason.
    exclusions: List[String]

# Domain-specific result of intake.paper_theory_localize within the named preformalization_readiness_loop workflow.
type PreformalizationReadinessIntakePaperTheoryLocalizeArtifact:
