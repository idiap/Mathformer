# Extract provenance-bearing paper structure without endorsing its mathematical claims. This record retains the authority ceiling of a observation occurrence.
type PaperEvidence:
    # Source items explicitly observed in the declared scope.
    observed_items: List[String]
    # Stable source anchors retained for the observed items.
    source_anchors: List[String]
    # Source gaps that prevent a complete observation.
    unresolved_gaps: List[String]

# Identify target results, support units, dependencies, and formalizable source spans. This record retains the authority ceiling of a model occurrence.
type TheoryMap:
    # Domain elements represented by the explicit model.
    modeled_elements: List[String]
    # Assumptions retained by the model.
    assumptions: List[String]
    # Limits on adequacy or applicability of the model.
    scope_limits: List[String]

# Expose missing assumptions, intermediate results, and proof-support obligations. This record retains the authority ceiling of a obligation occurrence.
type ExpansionNeeds:
    # Conditions required before the named downstream use.
    required_conditions: List[String]
    # Premises required but not established by the source.
    missing_premises: List[String]
    # Domain or formal side conditions that remain explicit.
    side_conditions: List[String]

# Retrieve source-backed support while preserving unresolved uncertainty. This record retains the authority ceiling of a retrieval occurrence.
type ExpansionSupport:
    # Retrieved candidates without an applicability claim.
    candidates: List[String]
    # References identifying candidate provenance.
    provenance_refs: List[String]
    # Requested items for which no candidate was retrieved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by ExpandTheory in preformalization_readiness_loop.
type ExpansionBasis:
    # Reviewed theory map supplied to ExpandTheory.
    theory_map: TheoryMap
    # Reviewed expansion needs supplied to ExpandTheory.
    expansion_needs: ExpansionNeeds
    # Reviewed expansion support supplied to ExpandTheory.
    expansion_support: ExpansionSupport

# Construct an explicit expanded theory while retaining unresolved dependencies. This record retains the authority ceiling of a candidate occurrence.
type ExpandedTheory:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the candidate.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Assess assumptions, prerequisites, side conditions, and conclusion preservation. This record retains the authority ceiling of a assessment occurrence.
type CompletenessCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Assess identifier binding, domains, quantification, and binding drift. This record retains the authority ceiling of a assessment occurrence.
type BindingCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AlignSourceLines in preformalization_readiness_loop.
type SourceAlignmentCase:
    # Reviewed theory map supplied to AlignSourceLines.
    theory_map: TheoryMap
    # Reviewed expanded theory supplied to AlignSourceLines.
    expanded_theory: ExpandedTheory
    # Reviewed completeness check supplied to AlignSourceLines.
    completeness_check: CompletenessCheck
    # Reviewed binding check supplied to AlignSourceLines.
    binding_check: BindingCheck

# Align source spans with stable Lean-facing drafting surfaces. This record retains the authority ceiling of a grounding occurrence.
type DraftingBasis:
    # Items with scope-bound applicability or semantic alignment.
    aligned_items: List[String]
    # Candidates rejected by the grounding criteria.
    rejected_candidates: List[String]
    # Concepts for which grounding remains unresolved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by CalibrateDraftingReadiness in preformalization_readiness_loop.
type ReadinessCase:
    # Reviewed expanded theory supplied to CalibrateDraftingReadiness.
    expanded_theory: ExpandedTheory
    # Reviewed completeness check supplied to CalibrateDraftingReadiness.
    completeness_check: CompletenessCheck
    # Reviewed binding check supplied to CalibrateDraftingReadiness.
    binding_check: BindingCheck
    # Reviewed drafting basis supplied to CalibrateDraftingReadiness.
    drafting_basis: DraftingBasis

# Combine expansion review and prior-result checks into a proceed, reuse, revise, or blocked disposition. This record retains the authority ceiling of a decision occurrence.
type DraftingDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
