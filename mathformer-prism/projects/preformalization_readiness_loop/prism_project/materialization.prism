# source-unit inventory, expansion support, LaTeX readiness review, and duplicate-result precheck before drafting.
workflow PreformalizationReadinessLoop(
    workflow_source: PaperFormalizationSourceSelection,
) -> Computed[LeanDraftingReadinessDisposition]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [intake_paper_layout_extract: intake_paper_layout_extract_material_binding(workflow_source)]
        [intake_paper_theory_localize: intake_paper_theory_localize_material_binding(intake_paper_layout_extract.value)]
        [intake_source_unit_inventory: intake_source_unit_inventory_material_binding(intake_paper_theory_localize.value)]
        [preformalization_paper_theory_expand: preformalization_paper_theory_expand_agent(intake_source_unit_inventory.value)]
        [preformalization_expansion_support: preformalization_expansion_support_agent(preformalization_paper_theory_expand.value)]
        [preformalization_expansion_difficulty: preformalization_expansion_difficulty_material_binding(preformalization_expansion_support.value)]
        [preformalization_expansion_web_support: preformalization_expansion_web_support_agent(preformalization_expansion_difficulty.value)]
        [preformalization_expand: preformalization_expand_agent(preformalization_expansion_web_support.value)]
        [preformalization_review_suite: preformalization_review_suite_agent(preformalization_expand.value)]
        [preformalization_review_completeness: preformalization_review_completeness_agent(preformalization_review_suite.value)]
        [preformalization_review_bindings: preformalization_review_bindings_agent(preformalization_review_completeness.value)]
        [dependency_resolve: dependency_resolve_material_binding(preformalization_review_bindings.value)]
        [preformalization_line_translation_packet: preformalization_line_translation_packet_material_binding(dependency_resolve.value)]
        [preformalization_result_existence_precheck: preformalization_result_existence_precheck_material_binding(preformalization_line_translation_packet.value)]
    return preformalization_result_existence_precheck
