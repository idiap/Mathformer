from materialization import PreformalizationReadinessLoop
from preformalization_readiness_loop import PaperFormalizationSourceSelection, LeanDraftingReadinessDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[LeanDraftingReadinessDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = PaperFormalizationSourceSelection(
        source_paths = ["fixture:preformalization_readiness_loop:source_paths"],
        target_backend = "fixture:preformalization_readiness_loop:target_backend",
        formalization_scope = "fixture:preformalization_readiness_loop:formalization_scope",
    )
    return solve PreformalizationReadinessLoop(workflow_source)
