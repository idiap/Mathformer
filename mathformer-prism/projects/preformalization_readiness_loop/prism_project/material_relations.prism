type FormalizesPreformalizationPaperTheoryExpandCertificate:
    source: PreformalizationReadinessIntakeSourceUnitInventoryArtifact
    target: Generated[PreformalizationReadinessPreformalizationPaperTheoryExpandArtifact]

relation FormalizesPreformalizationPaperTheoryExpand(
    source: PreformalizationReadinessIntakeSourceUnitInventoryArtifact,
    target: Generated[PreformalizationReadinessPreformalizationPaperTheoryExpandArtifact],
) -> FormalizesPreformalizationPaperTheoryExpandCertificate

type FormalizesPreformalizationExpansionSupportCertificate:
