# Neuro-symbolic AI Group
# Domain-specific source boundary for the named lean_consistency_testing_loop Mathformer workflow.
type CompiledLeanArtifactSet:
    # Compiled Lean artifacts selected for consistency testing.
    artifact_paths: List[String]
    # References to Lean compilation evidence for the exact artifacts.
    compiler_evidence: String
    # Declared cross-file and source-alignment scope of the assessment.
    consistency_scope: String

# Domain-specific result of check.compile within the named lean_consistency_testing_loop workflow.
type LeanConsistencyTestingCheckCompileArtifact:
    # Exact subject processed by the check.compile occurrence.
    subject: String
    # Source anchors retained by the check.compile occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical check.compile contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to check.compile.
    gate_disposition: String
    # Known limitations that constrain use of the check.compile result.
    limitations: List[String]
    # Named criteria applied by this scoped assessment.
    criteria: List[String]
    # Scoped findings with no authority beyond their cited grounds.
    findings: List[String]
    # Non-authoritative repairs proposed for identified findings.
    recommended_repairs: List[String]

# Domain-specific result of annotate.line_comment_guard within the named lean_consistency_testing_loop workflow.
type LeanConsistencyTestingAnnotateLineCommentGuardArtifact:
    # Exact subject processed by the annotate.line_comment_guard occurrence.
    subject: String
    # Source anchors retained by the annotate.line_comment_guard occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical annotate.line_comment_guard contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to annotate.line_comment_guard.
    gate_disposition: String
    # Known limitations that constrain use of the annotate.line_comment_guard result.
    limitations: List[String]
    # Summary of the linked material operation represented by this record.
    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

# Domain-specific result of postformalization.source_anchor_drift_guard within the named lean_consistency_testing_loop workflow.
type LeanConsistencyTestingPostformalizationSourceAnchorDriftGuardArtifact:
    # Exact subject processed by the postformalization.source_anchor_drift_guard occurrence.
    subject: String
    # Source anchors retained by the postformalization.source_anchor_drift_guard occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical postformalization.source_anchor_drift_guard contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to postformalization.source_anchor_drift_guard.
    gate_disposition: String
    # Known limitations that constrain use of the postformalization.source_anchor_drift_guard result.
    limitations: List[String]
    # Candidate transformation or artifact produced for later checks.
    candidate_content: String
    # Obligations that remain before the candidate can be accepted.
    unresolved_obligations: List[String]

# Domain-specific result of artifact.realness_gate within the named lean_consistency_testing_loop workflow.
type LeanConsistencyTestingArtifactRealnessGateArtifact:
    # Exact subject processed by the artifact.realness_gate occurrence.
    subject: String
    # Source anchors retained by the artifact.realness_gate occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical artifact.realness_gate contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to artifact.realness_gate.
    gate_disposition: String
    # Known limitations that constrain use of the artifact.realness_gate result.
    limitations: List[String]
    # Dispositions considered by the named workflow gate.
    considered_dispositions: List[String]
    # Policy-selected disposition without creating object-level evidence.
    selected_disposition: String
    # Scope-bounded rationale for the selected operational disposition.
    rationale: String

