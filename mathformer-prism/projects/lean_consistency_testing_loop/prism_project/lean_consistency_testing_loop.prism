    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

# Recover a human-interpretable account of the compiled declarations. This record retains the authority ceiling of a interpretation occurrence.
type LeanMeaning:
    # Domain meanings explicitly attributed to the source.
    interpreted_meanings: List[String]
    # Assumptions required by the interpretation.
    assumptions: List[String]
    # Regimes that bound use of the interpretation.
    validity_regimes: List[String]

# Reviewed domain inputs required by AssessLeanValidity in lean_consistency_testing_loop.
type LeanValidityCase:
    # Reviewed workflow source supplied to AssessLeanValidity.
    workflow_source: CompiledLeanArtifactSet
    # Reviewed lean meaning supplied to AssessLeanValidity.
    lean_meaning: LeanMeaning

# Assess compilation, declaration shape, non-vacuity, and artifact realness. This record retains the authority ceiling of a assessment occurrence.
type FormalValidity:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AssessSourceFidelity in lean_consistency_testing_loop.
type LeanFidelityCase:
    # Reviewed workflow source supplied to AssessSourceFidelity.
    workflow_source: CompiledLeanArtifactSet
    # Reviewed lean meaning supplied to AssessSourceFidelity.
    lean_meaning: LeanMeaning

# Assess internal meaning and agreement with available source anchors. This record retains the authority ceiling of a assessment occurrence.
type SourceFidelity:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AssessLibraryCoherence in lean_consistency_testing_loop.
type LeanLibraryCase:
    # Reviewed workflow source supplied to AssessLibraryCoherence.
    workflow_source: CompiledLeanArtifactSet
    # Reviewed lean meaning supplied to AssessLibraryCoherence.
    lean_meaning: LeanMeaning

# Assess cross-file concepts and applicability of mathlib grounding. This record retains the authority ceiling of a assessment occurrence.
type LibraryCoherence:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CompareConsistencyEvidence in lean_consistency_testing_loop.
type ConsistencyReviewSet:
    # Reviewed formal validity supplied to CompareConsistencyEvidence.
    formal_validity: FormalValidity
    # Reviewed source fidelity supplied to CompareConsistencyEvidence.
    source_fidelity: SourceFidelity
    # Reviewed library coherence supplied to CompareConsistencyEvidence.
    library_coherence: LibraryCoherence

# Compare criterion-specific findings without treating score agreement as proof. This record retains the authority ceiling of a reflection occurrence.
type ReferenceFreeAssessment:
    # Scope-bound comparisons among the supplied trajectories or reviews.
    comparisons: List[String]
    # Defeasible hypotheses suggested by the comparison.
    improvement_hypotheses: List[String]
    # Limits on generalizing the reflective result.
    limitations: List[String]

# Reviewed domain inputs required by CalibrateLeanConsistency in lean_consistency_testing_loop.
type LeanConsistencyCase:
    # Reviewed formal validity supplied to CalibrateLeanConsistency.
    formal_validity: FormalValidity
    # Reviewed source fidelity supplied to CalibrateLeanConsistency.
    source_fidelity: SourceFidelity
    # Reviewed library coherence supplied to CalibrateLeanConsistency.
    library_coherence: LibraryCoherence
    # Reviewed reference free supplied to CalibrateLeanConsistency.
    reference_free: ReferenceFreeAssessment

# Assign a scoped consistency status and retain every blocking finding. This record retains the authority ceiling of a decision occurrence.
type LeanConsistencyDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
