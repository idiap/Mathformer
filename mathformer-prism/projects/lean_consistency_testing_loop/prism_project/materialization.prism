def formal_validity_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> TestLeanValidityCertificate[SourceValue, TargetValue]:
    return TestLeanValidityCertificate(source = source, target = target)

def source_fidelity_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> TestSourceFidelityCertificate[SourceValue, TargetValue]:
    return TestSourceFidelityCertificate(source = source, target = target)

def library_coherence_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> TestLibraryCoherenceCertificate[SourceValue, TargetValue]:
    return TestLibraryCoherenceCertificate(source = source, target = target)

def reference_free_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> CompareConsistencyReviewsCertificate[SourceValue, TargetValue]:
    return CompareConsistencyReviewsCertificate(source = source, target = target)

def disposition_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> CalibrateConsistencyStatusCertificate[SourceValue, TargetValue]:
    return CalibrateConsistencyStatusCertificate(source = source, target = target)

# Generative interpretation RecoverLeanMeaning uses skill context selected from material steps: annotate_line_comment_guard, postformalization_informalize.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: lean-line-annotation, lean-informalization-extractor.
agent lean_meaning_reasoning_agent(
    task: CompiledLeanArtifactSet,
) -> Result[Generated[LeanMeaning], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[CompiledLeanArtifactSet] = [lean_meaning_reasoning_skill_1, lean_meaning_reasoning_skill_2]

# Generative interpretation AssessLeanValidity uses skill context selected from material steps: check_compile, consistency_declaration_shape, consistency_nonvacuity, artifact_realness_gate.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: lean-compile-checker, lean-declaration-shape-consistency-checker, lean-nonvacuity-consistency-checker, autoformalization-result-realness-verifier.
agent formal_validity_reasoning_agent(
    task: LeanValidityCase,
) -> Result[Generated[FormalValidity], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[LeanValidityCase] = [formal_validity_reasoning_skill_1, formal_validity_reasoning_skill_2, formal_validity_reasoning_skill_3, formal_validity_reasoning_skill_4]

# Generative interpretation AssessSourceFidelity uses skill context selected from material steps: postformalization_source_anchor_drift_guard, postformalization_informal_internal_consistency, postformalization_informal_consistency.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: source-formalization-drift-guard, lean-informal-proof-internal-consistency-verifier, lean-informal-consistency-verifier.
agent source_fidelity_reasoning_agent(
    task: LeanFidelityCase,
) -> Result[Generated[SourceFidelity], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[LeanFidelityCase] = [source_fidelity_reasoning_skill_1, source_fidelity_reasoning_skill_2, source_fidelity_reasoning_skill_3]

# Generative interpretation AssessLibraryCoherence uses skill context selected from material steps: consistency_cross_file_concepts, mathlib_grounding_maximize.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: lean-cross-file-concept-consistency-indexer, mathlib-grounding-maximizer.
agent library_coherence_reasoning_agent(
    task: LeanLibraryCase,
) -> Result[Generated[LibraryCoherence], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[LeanLibraryCase] = [library_coherence_reasoning_skill_1, library_coherence_reasoning_skill_2]

# Generative interpretation CompareConsistencyEvidence uses skill context selected from material steps: critique_reference_free_monitor, evaluation_rfde_report.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: reference-free-critic-monitor, reference-free-descriptive-evaluator.
agent reference_free_reasoning_agent(
    task: ConsistencyReviewSet,
) -> Result[Generated[ReferenceFreeAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConsistencyReviewSet] = [reference_free_reasoning_skill_1, reference_free_reasoning_skill_2]

# Generative interpretation CalibrateLeanConsistency uses skill context selected from material steps: consistency_unified_report.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: lean-consistency-report-orchestrator.
agent disposition_reasoning_agent(
    task: LeanConsistencyCase,
) -> Result[Generated[LeanConsistencyDisposition], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[LeanConsistencyCase] = [disposition_reasoning_skill_1]

converted_reasoning = AssessLeanConsistency(
    lean_meaning = lean_meaning_reasoning_agent,
    formal_validity = formal_validity_reasoning_agent,
    formal_validity_by = formal_validity_reasoning_relation_builder,
    source_fidelity = source_fidelity_reasoning_agent,
    source_fidelity_by = source_fidelity_reasoning_relation_builder,
    library_coherence = library_coherence_reasoning_agent,
    library_coherence_by = library_coherence_reasoning_relation_builder,
    reference_free = reference_free_reasoning_agent,
    reference_free_by = reference_free_reasoning_relation_builder,
    disposition = disposition_reasoning_agent,
    disposition_by = disposition_reasoning_relation_builder,
)

