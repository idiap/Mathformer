def check_compile_material_binding(source: CompiledLeanArtifactSet) -> Computed[LeanConsistencyTestingCheckCompileArtifact]:
    artifact = LeanConsistencyTestingCheckCompileArtifact(
        subject = "typed material binding for check_compile",
        source_anchors = ["skills/SKILL_HOOKS.yaml"],
        declared_artifacts = ["see hook-coverage.json"],
        gate_disposition = "not_executed_by_structural_fixture",
        limitations = ["native implementation not executed by the structural fixture"],
        criteria = [],
        findings = [],
        recommended_repairs = [],
    )
    return compute(artifact, procedure = "linked material binding: check_compile")

