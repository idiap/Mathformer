# reference-free consistency testing over compiled Lean artifacts using local semantic comments, reverse informalization, non-vacuity, cross-file concept indexing, mathlib grounding, and monotone critic monitoring.
workflow LeanConsistencyTestingLoop(
    workflow_source: CompiledLeanArtifactSet,
) -> Computed[LeanConsistencyAssessment]:
    sequence:
        [check_compile: check_compile_material_binding(workflow_source)]
        [annotate_line_comment_guard: annotate_line_comment_guard_material_binding(check_compile.value)]
        [postformalization_source_anchor_drift_guard: postformalization_source_anchor_drift_guard_material_binding(annotate_line_comment_guard.value)]
        [artifact_realness_gate: artifact_realness_gate_material_binding(postformalization_source_anchor_drift_guard.value)]
        [postformalization_informalize: postformalization_informalize_material_binding(artifact_realness_gate.value)]
        [consistency_declaration_shape: consistency_declaration_shape_material_binding(postformalization_informalize.value)]
        [postformalization_informal_internal_consistency: postformalization_informal_internal_consistency_material_binding(consistency_declaration_shape.value)]
        [postformalization_informal_consistency: postformalization_informal_consistency_material_binding(postformalization_informal_internal_consistency.value)]
        [consistency_nonvacuity: consistency_nonvacuity_material_binding(postformalization_informal_consistency.value)]
        [consistency_cross_file_concepts: consistency_cross_file_concepts_material_binding(consistency_nonvacuity.value)]
        [mathlib_grounding_maximize: mathlib_grounding_maximize_material_binding(consistency_cross_file_concepts.value)]
        [critique_reference_free_monitor: critique_reference_free_monitor_material_binding(mathlib_grounding_maximize.value)]
        [consistency_unified_report: consistency_unified_report_material_binding(critique_reference_free_monitor.value)]
        [evaluation_rfde_report: evaluation_rfde_report_material_binding(consistency_unified_report.value)]
    return evaluation_rfde_report
