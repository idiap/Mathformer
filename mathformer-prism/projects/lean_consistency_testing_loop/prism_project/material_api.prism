from materialization import LeanConsistencyTestingLoop
from lean_consistency_testing_loop import CompiledLeanArtifactSet, LeanConsistencyAssessment

def run_material(workflow_source: CompiledLeanArtifactSet) -> Computed[LeanConsistencyAssessment]:
    return solve LeanConsistencyTestingLoop(workflow_source)
