# Neuro-symbolic AI Group
from reflection_testing_loop import (
    ImprovementCase,
    MathformerWorkflowTrajectoryEvidence,
    ProcessDisposition,
    RevisionBasis,
    RevisionEvidence,
    RevisionTestCase,
    TrajectoryAssessment,
    WorkflowRevision,
)

# Compare workflow evidence and expose bounded improvement hypotheses.
type AssessWorkflowTrajectory = (source: MathformerWorkflowTrajectoryEvidence) -> Generated[TrajectoryAssessment]

# Create an immutable candidate revision with explicit preservation obligations.
type ProposeMonotoneRevision = (source: RevisionBasis) -> Generated[WorkflowRevision]

# Run deterministic and content probes against the candidate revision and baseline cases.
type TestRevisionAgainstBaseline = (source: RevisionTestCase) -> Generated[RevisionEvidence]

# Adopt, retain experimentally, reject, or block the revision under regression and control constraints.
type DecideRevisionAdoption = (source: ImprovementCase) -> Generated[ProcessDisposition]
