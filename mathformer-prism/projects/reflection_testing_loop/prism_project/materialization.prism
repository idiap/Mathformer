# monotonic process improvement with deterministic and content-skill regression checks.
workflow ReflectionTestingLoop(
    workflow_source: MathformerWorkflowTrajectoryEvidence,
) -> Computed[MathformerProcessImprovementDisposition]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [critique_reference_free_monitor: critique_reference_free_monitor_material_binding(workflow_source)]
        [evaluation_rfde_report: evaluation_rfde_report_material_binding(critique_reference_free_monitor.value)]
        [reflection_process_refinement: reflection_process_refinement_agent(evaluation_rfde_report.value)]
        [test_skill_program: test_skill_program_material_binding(reflection_process_refinement.value)]
        [control_workflow_contract: control_workflow_contract_material_binding(test_skill_program.value)]
        [control_skill_hook_coverage: control_skill_hook_coverage_material_binding(control_workflow_contract.value)]
    return control_skill_hook_coverage
