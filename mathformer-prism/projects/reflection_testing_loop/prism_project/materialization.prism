# Epistemic occurrence owned by `autoformalization-reflective-refinement-loop`; output assurance remains Generated.
agent reflection_process_refinement_agent(
    task: ReflectionTestingEvaluationRfdeReportArtifact,
) -> Result[Generated[ReflectionTestingReflectionProcessRefinementArtifact], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ReflectionTestingEvaluationRfdeReportArtifact] = [reflection_process_refinement_skill_binding]

def reflection_process_refinement_relation_builder(
