# Neuro-symbolic AI Group
# Domain-specific source boundary for the named reflection_testing_loop Mathformer workflow.
type MathformerWorkflowTrajectoryEvidence:
    # Workflow run identifiers included in reflective analysis.
    run_identifiers: List[String]
    # Digest of the successful baseline that revisions must preserve.
    baseline_digest: String
    # Observed regressions or unresolved failures motivating revision.
    observed_regressions: List[String]

# Domain-specific result of critique.reference_free_monitor within the named reflection_testing_loop workflow.
type ReflectionTestingCritiqueReferenceFreeMonitorArtifact:
    # Exact subject processed by the critique.reference_free_monitor occurrence.
    subject: String
    # Source anchors retained by the critique.reference_free_monitor occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical critique.reference_free_monitor contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to critique.reference_free_monitor.
    gate_disposition: String
    # Known limitations that constrain use of the critique.reference_free_monitor result.
    limitations: List[String]
    # Named criteria applied by this scoped assessment.
    criteria: List[String]
    # Scoped findings with no authority beyond their cited grounds.
    findings: List[String]
    # Non-authoritative repairs proposed for identified findings.
    recommended_repairs: List[String]

# Domain-specific result of evaluation.rfde_report within the named reflection_testing_loop workflow.
type ReflectionTestingEvaluationRfdeReportArtifact:
    # Exact subject processed by the evaluation.rfde_report occurrence.
    subject: String
    # Source anchors retained by the evaluation.rfde_report occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical evaluation.rfde_report contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to evaluation.rfde_report.
    gate_disposition: String
    # Known limitations that constrain use of the evaluation.rfde_report result.
    limitations: List[String]
    # Summary of the linked material operation represented by this record.
    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

# Domain-specific result of reflection.process_refinement within the named reflection_testing_loop workflow.
type ReflectionTestingReflectionProcessRefinementArtifact:
    # Exact subject processed by the reflection.process_refinement occurrence.
    subject: String
    # Source anchors retained by the reflection.process_refinement occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical reflection.process_refinement contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to reflection.process_refinement.
    gate_disposition: String
    # Known limitations that constrain use of the reflection.process_refinement result.
    limitations: List[String]
    # Candidate transformation or artifact produced for later checks.
    candidate_content: String
    # Obligations that remain before the candidate can be accepted.
    unresolved_obligations: List[String]

