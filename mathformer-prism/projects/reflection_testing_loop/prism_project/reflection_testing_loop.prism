    evidence_references: List[String]

# Compare workflow evidence and expose bounded improvement hypotheses. This record retains the authority ceiling of a reflection occurrence.
type TrajectoryAssessment:
    # Scope-bound comparisons among the supplied trajectories or reviews.
    comparisons: List[String]
    # Defeasible hypotheses suggested by the comparison.
    improvement_hypotheses: List[String]
    # Limits on generalizing the reflective result.
    limitations: List[String]

# Reviewed domain inputs required by ProposeWorkflowRevision in reflection_testing_loop.
type RevisionBasis:
    # Reviewed workflow source supplied to ProposeWorkflowRevision.
    workflow_source: MathformerWorkflowTrajectoryEvidence
    # Reviewed trajectory assessment supplied to ProposeWorkflowRevision.
    trajectory_assessment: TrajectoryAssessment

# Create an immutable candidate revision with explicit preservation obligations. This record retains the authority ceiling of a plan occurrence.
type WorkflowRevision:
    # Prospective actions that remain unauthoritative until executed.
    proposed_actions: List[String]
    # Dependencies that constrain the proposed actions.
    dependencies: List[String]
    # Checks required after executing the plan.
    revalidation_obligations: List[String]

# Reviewed domain inputs required by TestWorkflowRevision in reflection_testing_loop.
type RevisionTestCase:
    # Reviewed workflow source supplied to TestWorkflowRevision.
    workflow_source: MathformerWorkflowTrajectoryEvidence
    # Reviewed workflow revision supplied to TestWorkflowRevision.
    workflow_revision: WorkflowRevision

# Run deterministic and content probes against the candidate revision and baseline cases. This record retains the authority ceiling of a evidence occurrence.
type RevisionEvidence:
    # Inspectible references to evidence in the declared scope.
    evidence_refs: List[String]
    # Results directly observed by the bounded probe or execution.
    observed_results: List[String]
    # Limits on what the evidence can establish.
    limitations: List[String]

# Reviewed domain inputs required by CalibrateProcessImprovement in reflection_testing_loop.
type ImprovementCase:
    # Reviewed trajectory assessment supplied to CalibrateProcessImprovement.
    trajectory_assessment: TrajectoryAssessment
    # Reviewed workflow revision supplied to CalibrateProcessImprovement.
    workflow_revision: WorkflowRevision
    # Reviewed revision evidence supplied to CalibrateProcessImprovement.
    revision_evidence: RevisionEvidence

# Adopt, retain experimentally, reject, or block the revision under regression and control constraints. This record retains the authority ceiling of a decision occurrence.
type ProcessDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
