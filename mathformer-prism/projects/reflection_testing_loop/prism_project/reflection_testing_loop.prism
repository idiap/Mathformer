    # Exact subject processed by the control.skill_hook_coverage occurrence.
    subject: String
    # Source anchors retained by the control.skill_hook_coverage occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical control.skill_hook_coverage contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to control.skill_hook_coverage.
    gate_disposition: String
    # Known limitations that constrain use of the control.skill_hook_coverage result.
