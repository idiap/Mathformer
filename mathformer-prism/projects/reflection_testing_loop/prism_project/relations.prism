# Neuro-symbolic AI Group
type CalibrateImprovementCertificate[SourceValue, TargetValue]:
    source: SourceValue
    target: TargetValue

relation CalibrateImprovement[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> CalibrateImprovementCertificate[SourceValue, TargetValue]

type ReviseFromTrajectoryCertificate[SourceValue, TargetValue]:
    source: SourceValue
    target: TargetValue

relation ReviseFromTrajectory[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> ReviseFromTrajectoryCertificate[SourceValue, TargetValue]

type TestRevisionCertificate[SourceValue, TargetValue]:
    source: SourceValue
    target: TargetValue

relation TestRevision[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> TestRevisionCertificate[SourceValue, TargetValue]
