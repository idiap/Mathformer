# Neuro-symbolic AI Group
from materialization import ReflectionTestingLoop
from reflection_testing_loop import MathformerWorkflowTrajectoryEvidence, MathformerProcessImprovementDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[MathformerProcessImprovementDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = MathformerWorkflowTrajectoryEvidence(
        run_identifiers = ["fixture:reflection_testing_loop:run_identifiers"],
        baseline_digest = "fixture:reflection_testing_loop:baseline_digest",
        observed_regressions = ["fixture:reflection_testing_loop:observed_regressions"],
    )
    return solve ReflectionTestingLoop(workflow_source)
