# Record modules, concepts, and canonical ownership. This record retains the authority ceiling of an inventory occurrence.
type PhysicsLibraryInventory:
    # Domain items included in the reviewed library_inventory.
    inventoried_items: List[String]
    # Dependencies among the inventoried items.
    dependencies: List[String]
    # Known omissions or unresolved ownership gaps.
    inventory_gaps: List[String]

# Identify canonical concepts, aliases, and unresolved ownership conflicts. This record retains the authority ceiling of a model occurrence.
type PhysicsOwnershipMap:
    # Domain elements represented by the explicit model.
    modeled_elements: List[String]
    # Assumptions retained by the model.
    assumptions: List[String]
    # Limits on adequacy or applicability of the model.
    scope_limits: List[String]

# Reviewed domain inputs required by GroundPhysicsInMathlib in mathformerphysicslib_coherence_grounding_loop.
type PhysicsGroundingCase:
    # Reviewed workflow source supplied to GroundPhysicsInMathlib.
    workflow_source: MathformerPhysicsLibrarySnapshot
    # Reviewed concept map supplied to GroundPhysicsInMathlib.
    ownership_map: PhysicsOwnershipMap

# Establish scope-bound applicability of existing mathlib declarations. This record retains the authority ceiling of a grounding occurrence.
type MathlibReuseAudit:
    # Items with scope-bound applicability or semantic alignment.
    aligned_items: List[String]
    # Candidates rejected by the grounding criteria.
    rejected_candidates: List[String]
    # Concepts for which grounding remains unresolved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by AssessRedefinitionRisk in mathformerphysicslib_coherence_grounding_loop.
type RedefinitionReviewBasis:
    # Reviewed library_inventory supplied to AssessRedefinitionRisk.
    library_inventory: PhysicsLibraryInventory
    # Reviewed concept map supplied to AssessRedefinitionRisk.
    ownership_map: PhysicsOwnershipMap
    # Reviewed mathlib alignment supplied to AssessRedefinitionRisk.
    reuse_audit: MathlibReuseAudit

# Assess duplication, shadowing, and redefinition spread. This record retains the authority ceiling of a assessment occurrence.
type RedefinitionReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AssessLibraryIntegration in mathformerphysicslib_coherence_grounding_loop.
type IntegrationReviewBasis:
    # Reviewed library_inventory supplied to AssessLibraryIntegration.
    library_inventory: PhysicsLibraryInventory
    # Reviewed concept map supplied to AssessLibraryIntegration.
    ownership_map: PhysicsOwnershipMap
    # Reviewed mathlib alignment supplied to AssessLibraryIntegration.
    reuse_audit: MathlibReuseAudit

# Assess imports, dependency structure, and discoverability. This record retains the authority ceiling of a assessment occurrence.
type IntegrationReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by AssessPhysicsApi in mathformerphysicslib_coherence_grounding_loop.
type ApiReviewBasis:
    # Reviewed library_inventory supplied to AssessPhysicsApi.
    library_inventory: PhysicsLibraryInventory
    # Reviewed concept map supplied to AssessPhysicsApi.
    ownership_map: PhysicsOwnershipMap
    # Reviewed mathlib alignment supplied to AssessPhysicsApi.
    reuse_audit: MathlibReuseAudit

# Assess whether the public physics API is usable in its declared scope. This record retains the authority ceiling of a assessment occurrence.
type ApiOperabilityReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by ProbeLibraryCoherence in mathformerphysicslib_coherence_grounding_loop.
type GenerativeReviewBasis:
    # Reviewed library_inventory supplied to ProbeLibraryCoherence.
    library_inventory: PhysicsLibraryInventory
    # Reviewed concept map supplied to ProbeLibraryCoherence.
    ownership_map: PhysicsOwnershipMap
    # Reviewed mathlib alignment supplied to ProbeLibraryCoherence.
    reuse_audit: MathlibReuseAudit

# Probe coherence claims while retaining the bounded authority of generative evidence. This record retains the authority ceiling of a assessment occurrence.
type GenerativeCoherenceProbe:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by PlanCoherenceRepairs in mathformerphysicslib_coherence_grounding_loop.
type CoherenceRepairCase:
    # Reviewed redefinition assessment supplied to PlanCoherenceRepairs.
    redefinition_review: RedefinitionReview
    # Reviewed integration assessment supplied to PlanCoherenceRepairs.
    integration_review: IntegrationReview
    # Reviewed api assessment supplied to PlanCoherenceRepairs.
    api_review: ApiOperabilityReview
    # Reviewed generative assessment supplied to PlanCoherenceRepairs.
    coherence_probe: GenerativeCoherenceProbe

# Propose monotone repairs and explicit revalidation obligations. This record retains the authority ceiling of a plan occurrence.
type CoherenceRepairActions:
    # Prospective actions that remain unauthoritative until executed.
    proposed_actions: List[String]
    # Dependencies that constrain the proposed actions.
    dependencies: List[String]
    # Checks required after executing the plan.
    revalidation_obligations: List[String]

# Reviewed domain inputs required by GatePhysicsLibrary in mathformerphysicslib_coherence_grounding_loop.
type CoherenceDecisionCase:
    # Reviewed repair plan supplied to GatePhysicsLibrary.
    repair_actions: CoherenceRepairActions
    # Reviewed redefinition assessment supplied to GatePhysicsLibrary.
    redefinition_review: RedefinitionReview
    # Reviewed integration assessment supplied to GatePhysicsLibrary.
    integration_review: IntegrationReview
    # Reviewed api assessment supplied to GatePhysicsLibrary.
    api_review: ApiOperabilityReview
    # Reviewed generative assessment supplied to GatePhysicsLibrary.
    coherence_probe: GenerativeCoherenceProbe

# Assign a scoped coherence gate_report without treating a repair plan as repaired code. This record retains the authority ceiling of a decision occurrence.
type PhysicsLibraryGateReport:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
