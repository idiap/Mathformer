# Neuro-symbolic AI Group
# Domain-specific source boundary for the named mathformerphysicslib_coherence_grounding_loop Mathformer workflow.
type MathformerPhysicsLibrarySnapshot:
    # MathformerPhysicsLib modules included in the coherence snapshot.
    module_paths: List[String]
    # Mathlib revision used for grounding and redefinition checks.
    mathlib_revision: String
    # Named criteria for API, integration, and conceptual coherence.
    coherence_policy: String

# Domain-specific result of library.physics.coherence.inventory within the named mathformerphysicslib_coherence_grounding_loop workflow.
type MathformerphysicslibCoherenceGroundingLibraryPhysicsCoherenceInventoryArtifact:
    # Exact subject processed by the library.physics.coherence.inventory occurrence.
    subject: String
    # Source anchors retained by the library.physics.coherence.inventory occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical library.physics.coherence.inventory contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to library.physics.coherence.inventory.
    gate_disposition: String
    # Known limitations that constrain use of the library.physics.coherence.inventory result.
    limitations: List[String]
    # Summary of the linked material operation represented by this record.
    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

