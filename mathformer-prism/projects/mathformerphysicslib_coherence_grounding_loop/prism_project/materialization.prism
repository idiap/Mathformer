# MathformerPhysicsLib coherence and grounding loop over canonical ownership, Mathlib-first grounding, redefinition spread, integration/discoverability, API operability, guarded generative interpretation, monotonic repair planning, and final report gates.
workflow MathformerphysicslibCoherenceGroundingLoop(
    workflow_source: MathformerPhysicsLibrarySnapshot,
) -> Computed[MathformerPhysicsLibraryCoherenceDisposition]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [library_physics_coherence_inventory: library_physics_coherence_inventory_material_binding(workflow_source)]
        [library_physics_coherence_canonicalize: library_physics_coherence_canonicalize_material_binding(library_physics_coherence_inventory.value)]
        [library_physics_coherence_mathlib_grounding: library_physics_coherence_mathlib_grounding_material_binding(library_physics_coherence_canonicalize.value)]
        [library_physics_coherence_redefinition_critic: library_physics_coherence_redefinition_critic_material_binding(library_physics_coherence_mathlib_grounding.value)]
        [library_physics_coherence_integration_critic: library_physics_coherence_integration_critic_material_binding(library_physics_coherence_redefinition_critic.value)]
        [library_physics_coherence_api_critic: library_physics_coherence_api_critic_material_binding(library_physics_coherence_integration_critic.value)]
        [library_physics_coherence_generative_critic: library_physics_coherence_generative_critic_material_binding(library_physics_coherence_api_critic.value)]
        [library_physics_coherence_repair_plan: library_physics_coherence_repair_plan_agent(library_physics_coherence_generative_critic.value)]
        [library_physics_coherence_gate: library_physics_coherence_gate_material_binding(library_physics_coherence_repair_plan.value)]
        [library_physics_coherence_loop: library_physics_coherence_loop_material_binding(library_physics_coherence_gate.value)]
    return library_physics_coherence_loop
