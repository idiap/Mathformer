from materialization import MathformerphysicslibCoherenceGroundingLoop
from mathformerphysicslib_coherence_grounding_loop import MathformerPhysicsLibrarySnapshot, MathformerPhysicsLibraryCoherenceDisposition

def run_material(
    workflow_source: MathformerPhysicsLibrarySnapshot,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[MathformerPhysicsLibraryCoherenceDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MathformerphysicslibCoherenceGroundingLoop(workflow_source)
