from materialization import converted_reasoning
from reasoning import AutoformalizeTextbook
from textbook_theory_autoformalization_loop import LatexTextbookArchiveSelection, TextbookDisposition

def run_reasoning(
    request: LatexTextbookArchiveSelection,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[TextbookDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    flow = converted_reasoning(request)
    return solve AutoformalizeTextbook(request) using flow
