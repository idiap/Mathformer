from materialization import TextbookTheoryAutoformalizationLoop
from textbook_theory_autoformalization_loop import LatexTextbookArchiveSelection, TextbookAutoformalizationAcceptanceSummary

def run_material(
    request: LatexTextbookArchiveSelection,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[TextbookAutoformalizationAcceptanceSummary], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve TextbookTheoryAutoformalizationLoop(request)
