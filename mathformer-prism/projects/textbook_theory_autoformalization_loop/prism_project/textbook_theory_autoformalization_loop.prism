# Neuro-symbolic AI Group
# Domain-specific source boundary for the named textbook_theory_autoformalization_loop Mathformer workflow.
type LatexTextbookArchiveSelection:
    # Selected LaTeX textbook archives and their source identity.
    archive_paths: List[String]
    # Chapter identifiers selected for the autoformalization batch.
    target_chapters: List[String]
    # Formal proof backend targeted by generated textbook jobs.
    target_backend: String

# Domain-specific result of intake.latex_archive_theory_extract within the named textbook_theory_autoformalization_loop workflow.
type TextbookTheoryAutoformalizationIntakeLatexArchiveTheoryExtractArtifact:
    # Exact subject processed by the intake.latex_archive_theory_extract occurrence.
    subject: String
    # Source anchors retained by the intake.latex_archive_theory_extract occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical intake.latex_archive_theory_extract contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to intake.latex_archive_theory_extract.
    gate_disposition: String
    # Known limitations that constrain use of the intake.latex_archive_theory_extract result.
    limitations: List[String]
    # Retrieved or extracted candidates with retained identifiers.
    candidate_references: List[String]
    # Named retrieval, parsing, or grounding basis used for selection.
    selection_basis: String
    # Relevant candidates excluded together with their stated reason.
    exclusions: List[String]

# Domain-specific result of preformalization.textbook_theory_organize within the named textbook_theory_autoformalization_loop workflow.
type TextbookTheoryAutoformalizationPreformalizationTextbookTheoryOrganizeArtifact:
    # Exact subject processed by the preformalization.textbook_theory_organize occurrence.
    subject: String
    # Source anchors retained by the preformalization.textbook_theory_organize occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical preformalization.textbook_theory_organize contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to preformalization.textbook_theory_organize.
    gate_disposition: String
    # Known limitations that constrain use of the preformalization.textbook_theory_organize result.
    limitations: List[String]
    # Candidate transformation or artifact produced for later checks.
    candidate_content: String
    # Obligations that remain before the candidate can be accepted.
    unresolved_obligations: List[String]

