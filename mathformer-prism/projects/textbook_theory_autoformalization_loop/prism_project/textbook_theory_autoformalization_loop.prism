# Extracted theorem-like units and proofs with exact source identity.
type TheoryCorpus:
    # Stable extracted unit identifiers.
    unit_ids: List[String]
    # Literal source locations retained by extraction.
    source_anchors: List[String]
    # Paired theorem and proof identifiers.
    proof_pairs: List[String]
    # Proofs that remain explicitly unpaired.
    unpaired_proofs: List[String]
    # Extraction gaps requiring review.
    extraction_gaps: List[String]

# Source-preserving chapter or section bundles and their dependencies.
type OrganizedTheory:
    # Organized source bundles.
    bundles: List[String]
    # Unit order retained within bundles.
    ordered_units: List[String]
    # Dependencies between units.
    dependencies: List[String]
    # Proof adjacency retained by organization.
    proof_adjacencies: List[String]
    # Source anchors retained by organization.
    source_anchors: List[String]

# Ordered chapter slices used for bounded textbook execution.
type ChapterQueue:
    # Ordered chapter identifiers.
    ordered_chapters: List[String]
    # Chapter manifest references.
    chapter_manifests: List[String]
    # Unit inventory retained by chapter.
    unit_inventory: List[String]
    # Proof inventory retained by chapter.
    proof_inventory: List[String]

# Per-unit routes prepared before Lean drafting.
type UnitJobSet:
    # Jobs routed to drafting.
    draft_jobs: List[String]
    # Jobs routed to existing declarations.
    reuse_jobs: List[String]
    # Explicit proof-obligation jobs.
    proof_jobs: List[String]
    # Unsupported proof material retained for support only.
    support_only_jobs: List[String]
    # Per-unit line translation packet references.
    line_translation_packets: List[String]
    # Required mathlib grounding work.
    grounding_requirements: List[String]

# Lean artifacts and reused declarations produced by object-level jobs.
type LeanUnitSet:
    # Generated Lean artifact references.
    generated_artifacts: List[String]
    # Existing declarations selected for reuse.
    reused_declarations: List[String]
    # Source anchors retained by Lean units.
    source_anchors: List[String]
    # Validation obligations still open.
    open_obligations: List[String]

# Jobs and Lean units supplied to the concrete gate stack.
type LeanCheckBasis:
    # Prepared unit jobs.
    jobs: UnitJobSet
    # Generated or reused Lean units.
    lean_units: LeanUnitSet

# Concrete per-unit execution and acceptance-gate results.
type UnitGateReport:
    # Initial Lean execution receipts.
    execution_receipts: List[String]
    # Lean compile receipts.
    compile_receipts: List[String]
    # Source-anchor drift reports.
    source_drift_reports: List[String]
    # Mathlib grounding reports.
    grounding_reports: List[String]
    # Artifact realness reports.
    realness_reports: List[String]
    # Blocking gate results.
    blockers: List[String]

# All chapter, job, artifact, and gate results required for aggregation.
type BatchSummaryBasis:
    # Processed chapter queue.
    chapters: ChapterQueue
    # Prepared unit jobs.
    jobs: UnitJobSet
    # Generated or reused Lean units.
    lean_units: LeanUnitSet
    # Concrete gate report.
    gate_report: UnitGateReport

# Batch summary retaining every completed, blocked, reused, and support-only unit.
type TextbookDisposition:
    # Overall batch status.
    status: String
    # Status for every unit identity.
    per_unit_statuses: List[String]
    # Units that completed all gates.
    completed_units: List[String]
    # Units resolved by verified reuse.
    reused_units: List[String]
    # Units blocked by generation or gates.
    blocked_units: List[String]
    # Proof material intentionally retained as support only.
    support_only_units: List[String]
    # Limits on interpreting the batch result.
    limitations: List[String]
