converted_reasoning = AutoformalizeTextbook(
    corpus = corpus_reasoning_agent,
    theory = theory_reasoning_agent,
    theory_by = theory_reasoning_relation_builder,
    chapters = chapters_reasoning_agent,
    chapters_by = chapters_reasoning_relation_builder,
    jobs = jobs_reasoning_agent,
    jobs_by = jobs_reasoning_relation_builder,
    lean_units = lean_units_reasoning_agent,
    lean_units_by = lean_units_reasoning_relation_builder,
    gate_report = gate_report_reasoning_agent,
    gate_report_by = gate_report_reasoning_relation_builder,
    disposition = disposition_reasoning_agent,
    disposition_by = disposition_reasoning_relation_builder,
)

