# LaTeX textbook archive extraction, thematic TeX organization, truthful per-unit job queuing, and standard Lean workflow gates for each target unit.
workflow TextbookTheoryAutoformalizationLoop(
    request: LatexTextbookArchiveSelection,
) -> Computed[TextbookAutoformalizationAcceptanceSummary]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [intake_latex_archive_theory_extract: intake_latex_archive_theory_extract_material_binding(request)]
        [preformalization_textbook_theory_organize: preformalization_textbook_theory_organize_material_binding(intake_latex_archive_theory_extract.value)]
        [draft_textbook_chapter_autoformalization: draft_textbook_chapter_autoformalization_agent(preformalization_textbook_theory_organize.value)]
        [draft_textbook_batch_autoformalize: draft_textbook_batch_autoformalize_agent(draft_textbook_chapter_autoformalization.value)]
        [preformalization_line_translation_packet: preformalization_line_translation_packet_material_binding(draft_textbook_batch_autoformalize.value)]
        [preformalization_result_existence_precheck: preformalization_result_existence_precheck_material_binding(preformalization_line_translation_packet.value)]
        [draft_textbook_object_autoformalization_run: draft_textbook_object_autoformalization_run_agent(preformalization_result_existence_precheck.value)]
        [mathlib_grounding_maximize: mathlib_grounding_maximize_material_binding(draft_textbook_object_autoformalization_run.value)]
        [execute_initial: execute_initial_material_binding(mathlib_grounding_maximize.value)]
        [check_compile: check_compile_material_binding(execute_initial.value)]
        [postformalization_source_anchor_drift_guard: postformalization_source_anchor_drift_guard_material_binding(check_compile.value)]
        [artifact_realness_gate: artifact_realness_gate_material_binding(postformalization_source_anchor_drift_guard.value)]
        [consistency_unified_report: consistency_unified_report_material_binding(artifact_realness_gate.value)]
    return consistency_unified_report
