# Neuro-symbolic AI Group
from lean_physics_derivation_trace_loop import (
    AcceptanceCase,
    FormalizationBasis,
    GroundingBasis,
    LeanAssessment,
    LeanDerivation,
    LeanValidityCase,
    MathlibGrounding,
    PhysicalAssessment,
    PhysicalFidelityCase,
    PhysicsDisposition,
    PhysicsInterpretation,
    PhysicsLeanDerivationRequest,
    ProofObligations,
)

# Expand source prerequisites and model symbols, quantities, dimensions, units, equations, regimes, frames, gaps, and physical laws.
type InterpretPhysics = (source: PhysicsLeanDerivationRequest) -> Generated[PhysicsInterpretation]

# Turn the interpreted derivation into explicit goals, premises, and side conditions.
type DeriveProofObligations = (source: PhysicsInterpretation) -> Generated[ProofObligations]

# Resolve physical concepts and proof obligations to compatible mathlib declarations and imports.
type GroundInMathlib = (source: GroundingBasis) -> Generated[MathlibGrounding]

# Draft and refine a Lean derivation from the physical model and grounded APIs.
type SynthesizeLeanDerivation = (source: FormalizationBasis) -> Generated[LeanDerivation]

# Execute Lean and assess elaboration, kernel acceptance, and obligation coverage.
type AssessLeanValidity = (source: LeanValidityCase) -> Generated[LeanAssessment]

# Assess preservation of physical meaning, assumptions, regimes, dimensions, and laws.
type AssessPhysicalFidelity = (source: PhysicalFidelityCase) -> Generated[PhysicalAssessment]

# Combine final reviewers and consistency evidence into the workflow disposition.
type CalibrateAcceptance = (source: AcceptanceCase) -> Generated[PhysicsDisposition]
