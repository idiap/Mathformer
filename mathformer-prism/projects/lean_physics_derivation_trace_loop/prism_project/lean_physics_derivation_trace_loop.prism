# Domain-specific source boundary for the named lean_physics_derivation_trace_loop Mathformer workflow.
type PhysicsLeanDerivationRequest:
    # Source-anchored informal physics derivation to formalize in Lean.
    source_derivation: String
    # Units, dimensions, frames, regimes, and assumptions in scope.
    physical_context: String
    # Lean version, imports, namespace, and target theorem context.
    lean_context: String

# Domain-specific result of intake.source_unit_inventory within the named lean_physics_derivation_trace_loop workflow.
type LeanPhysicsDerivationTraceIntakeSourceUnitInventoryArtifact:
    # Exact subject processed by the intake.source_unit_inventory occurrence.
    subject: String
    # Source anchors retained by the intake.source_unit_inventory occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical intake.source_unit_inventory contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to intake.source_unit_inventory.
    gate_disposition: String
    # Known limitations that constrain use of the intake.source_unit_inventory result.
    limitations: List[String]
    # Summary of the linked material operation represented by this record.
    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

