from materialization import converted_reasoning
from reasoning import ReconstructInLean
from lean_physics_derivation_trace_loop import PhysicsLeanDerivationRequest, PhysicsDisposition

def run_reasoning(
    workflow_source: PhysicsLeanDerivationRequest,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[PhysicsDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    flow = converted_reasoning(workflow_source)
    return solve ReconstructInLean(workflow_source) using flow
