# controlled physics derivation autoformalization over Lean using maximal mathematical preformalization reuse, dependency resolution for intermediate definitions/background lemmas, proof-expansion web support, anchored source extraction, physical quantity typing, contextual assumption encoding, unit and dimension obligations, mathlib web grounding, Lean execution interpretation, refinement loops, reverse informalization, and reference-free consistency metrics.
workflow LeanPhysicsDerivationTraceLoop(
    workflow_source: PhysicsLeanDerivationRequest,
) -> Computed[PhysicsLeanConsistencyAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [intake_source_unit_inventory: intake_source_unit_inventory_material_binding(workflow_source)]
        [preformalization_expansion_support: preformalization_expansion_support_agent(intake_source_unit_inventory.value)]
        [preformalization_expansion_difficulty: preformalization_expansion_difficulty_material_binding(preformalization_expansion_support.value)]
        [preformalization_expansion_web_support: preformalization_expansion_web_support_agent(preformalization_expansion_difficulty.value)]
        [preformalization_expand: preformalization_expand_agent(preformalization_expansion_web_support.value)]
        [preformalization_review_suite: preformalization_review_suite_agent(preformalization_expand.value)]
        [preformalization_review_completeness: preformalization_review_completeness_agent(preformalization_review_suite.value)]
        [preformalization_review_bindings: preformalization_review_bindings_agent(preformalization_review_completeness.value)]
        [dependency_resolve: dependency_resolve_material_binding(preformalization_review_bindings.value)]
        [physics_source_extract: physics_source_extract_material_binding(dependency_resolve.value)]
