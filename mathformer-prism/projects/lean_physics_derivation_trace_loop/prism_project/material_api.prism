from materialization import LeanPhysicsDerivationTraceLoop
from lean_physics_derivation_trace_loop import PhysicsLeanDerivationRequest, PhysicsLeanConsistencyAssessment

def run_material(
    workflow_source: PhysicsLeanDerivationRequest,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[PhysicsLeanConsistencyAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve LeanPhysicsDerivationTraceLoop(workflow_source)
