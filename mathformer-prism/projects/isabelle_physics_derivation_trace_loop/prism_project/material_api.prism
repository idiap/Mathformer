from materialization import IsabellePhysicsDerivationTraceLoop
from isabelle_physics_derivation_trace_loop import PhysicsIsabelleDerivationRequest, PhysicsIsabelleConsistencyAssessment

def run_material(
    workflow_source: PhysicsIsabelleDerivationRequest,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[PhysicsIsabelleConsistencyAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve IsabellePhysicsDerivationTraceLoop(workflow_source)
