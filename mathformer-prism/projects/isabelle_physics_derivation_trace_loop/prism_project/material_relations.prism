type FormalizesPreformalizationExpansionSupportCertificate:
    source: IsabellePhysicsDerivationTraceIntakeSourceUnitInventoryArtifact
    target: Generated[IsabellePhysicsDerivationTracePreformalizationExpansionSupportArtifact]

relation FormalizesPreformalizationExpansionSupport(
    source: IsabellePhysicsDerivationTraceIntakeSourceUnitInventoryArtifact,
    target: Generated[IsabellePhysicsDerivationTracePreformalizationExpansionSupportArtifact],
) -> FormalizesPreformalizationExpansionSupportCertificate

