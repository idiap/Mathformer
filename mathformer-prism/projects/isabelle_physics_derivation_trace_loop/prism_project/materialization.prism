# controlled physics derivation autoformalization over Isabelle/HOL using shared physics preformalization and Isabelle-specific grounding, drafting, execution, final review, and consistency gates without modifying the Lean physics loop.
workflow IsabellePhysicsDerivationTraceLoop(
    workflow_source: PhysicsIsabelleDerivationRequest,
) -> Computed[PhysicsIsabelleConsistencyAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [intake_source_unit_inventory: intake_source_unit_inventory_material_binding(workflow_source)]
        [preformalization_expansion_support: preformalization_expansion_support_agent(intake_source_unit_inventory.value)]
        [preformalization_expansion_difficulty: preformalization_expansion_difficulty_material_binding(preformalization_expansion_support.value)]
        [preformalization_expansion_web_support: preformalization_expansion_web_support_agent(preformalization_expansion_difficulty.value)]
        [preformalization_expand: preformalization_expand_agent(preformalization_expansion_web_support.value)]
        [preformalization_review_suite: preformalization_review_suite_agent(preformalization_expand.value)]
        [preformalization_review_completeness: preformalization_review_completeness_agent(preformalization_review_suite.value)]
        [preformalization_review_bindings: preformalization_review_bindings_agent(preformalization_review_completeness.value)]
        [preformalization_line_translation_packet: preformalization_line_translation_packet_material_binding(preformalization_review_bindings.value)]
        [preformalization_result_existence_precheck: preformalization_result_existence_precheck_material_binding(preformalization_line_translation_packet.value)]
        [physics_source_extract: physics_source_extract_material_binding(preformalization_result_existence_precheck.value)]
        [physics_informal_elicit: physics_informal_elicit_material_binding(physics_source_extract.value)]
        [physics_informal_expand: physics_informal_expand_material_binding(physics_informal_elicit.value)]
        [physics_informal_review: physics_informal_review_material_binding(physics_informal_expand.value)]
        [physics_symbols_build: physics_symbols_build_material_binding(physics_informal_review.value)]
        [physics_dimensions_model: physics_dimensions_model_material_binding(physics_symbols_build.value)]
        [physics_units_ground: physics_units_ground_material_binding(physics_dimensions_model.value)]
        [physics_equations_parse: physics_equations_parse_material_binding(physics_units_ground.value)]
        [physics_regimes_model: physics_regimes_model_material_binding(physics_equations_parse.value)]
        [physics_frames_build: physics_frames_build_material_binding(physics_regimes_model.value)]
        [physics_gaps_detect: physics_gaps_detect_material_binding(physics_frames_build.value)]
        [physics_gaps_expand: physics_gaps_expand_material_binding(physics_gaps_detect.value)]
        [physics_laws_ground: physics_laws_ground_material_binding(physics_gaps_expand.value)]
        [isabelle_grounding_search: isabelle_grounding_search_material_binding(physics_laws_ground.value)]
        [physics_isabelle_workflow_plan: physics_isabelle_workflow_plan_material_binding(isabelle_grounding_search.value)]
        [physics_isabelle_type_system_build: physics_isabelle_type_system_build_material_binding(physics_isabelle_workflow_plan.value)]
        [physics_isabelle_background_plan: physics_isabelle_background_plan_material_binding(physics_isabelle_type_system_build.value)]
        [physics_isabelle_assumptions_encode: physics_isabelle_assumptions_encode_material_binding(physics_isabelle_background_plan.value)]
        [draft_physics_isabelle_derivation: draft_physics_isabelle_derivation_material_binding(physics_isabelle_assumptions_encode.value)]
        [execute_physics_isabelle_derivation: execute_physics_isabelle_derivation_material_binding(draft_physics_isabelle_derivation.value)]
        [artifact_realness_gate: artifact_realness_gate_material_binding(execute_physics_isabelle_derivation.value)]
        [review_physics_isabelle_final_hypotheses: review_physics_isabelle_final_hypotheses_material_binding(artifact_realness_gate.value)]
        [review_mathematical_isabelle_final_hypotheses: review_mathematical_isabelle_final_hypotheses_material_binding(review_physics_isabelle_final_hypotheses.value)]
        [consistency_physics_isabelle_report: consistency_physics_isabelle_report_material_binding(review_mathematical_isabelle_final_hypotheses.value)]
        [reflection_physics_isabelle_process: reflection_physics_isabelle_process_material_binding(consistency_physics_isabelle_report.value)]
    return reflection_physics_isabelle_process
