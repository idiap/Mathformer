# Recover source-anchored physical meaning and applicability scope. This record retains the authority ceiling of an interpretation occurrence.
type SourceDerivationModel:
    # Domain meanings explicitly attributed to the source.
    interpreted_meanings: List[String]
    # Assumptions required by the source_model.
    assumptions: List[String]
    # Regimes that bound use of the source_model.
    validity_regimes: List[String]

# Expose theorem goals, missing premises, bindings, and side conditions. This record retains the authority ceiling of a obligation occurrence.
type IsabelleFormalizationPacket:
    # Conditions required before the named downstream use.
    required_conditions: List[String]
    # Premises required but not established by the source.
    missing_premises: List[String]
    # Domain or formal side conditions that remain explicit.
    side_conditions: List[String]

# Model quantities, dimensions, units, frames, regimes, and laws. This record retains the authority ceiling of a context occurrence.
type PhysicalModel:
    # Domain elements fixed by this explicit context.
    context_elements: List[String]
    # Constraints governing use of the context.
    constraints: List[String]
    # Assumptions carried by the context.
    assumptions: List[String]

# Reviewed domain inputs required by PlanIsabelleTheory in isabelle_physics_derivation_trace_loop.
type IsabelleGroundingBasis:
    # Reviewed proof obligations supplied to PlanIsabelleTheory.
    formalization_packet: IsabelleFormalizationPacket
    # Reviewed physics context supplied to PlanIsabelleTheory.
    physical_model: PhysicalModel

# Align obligations and physical concepts with applicable Isabelle/HOL material. This record retains the authority ceiling of a grounding occurrence.
type IsabelleDerivationPlan:
    # Items with scope-bound applicability or semantic alignment.
    aligned_items: List[String]
    # Candidates rejected by the grounding criteria.
    rejected_candidates: List[String]
    # Concepts for which grounding remains unresolved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by DraftIsabelleTheory in isabelle_physics_derivation_trace_loop.
type IsabelleTheoryBasis:
    # Reviewed source_model supplied to DraftIsabelleTheory.
    source_model: SourceDerivationModel
    # Reviewed proof obligations supplied to DraftIsabelleTheory.
    formalization_packet: IsabelleFormalizationPacket
    # Reviewed isabelle grounding supplied to DraftIsabelleTheory.
    isabelle_plan: IsabelleDerivationPlan

# Construct a theory Isabelle theory with open obligations retained. This record retains the authority ceiling of a theory occurrence.
type IsabelleTheory:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the theory.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Record session-build evidence and artifact-realness findings. This record retains the authority ceiling of a evidence occurrence.
type IsabelleSessionReport:
    # Inspectible references to evidence in the declared scope.
    evidence_refs: List[String]
    # Results directly observed by the bounded probe or execution.
    observed_results: List[String]
    # Limits on what the evidence can establish.
    limitations: List[String]

# Reviewed domain inputs required by ReviewIsabelleMathematics in isabelle_physics_derivation_trace_loop.
type IsabelleReviewCase:
    # Reviewed theory supplied to ReviewIsabelleMathematics.
    theory: IsabelleTheory
    # Reviewed build evidence supplied to ReviewIsabelleMathematics.
    session_report: IsabelleSessionReport
    # Reviewed proof obligations supplied to ReviewIsabelleMathematics.
    formalization_packet: IsabelleFormalizationPacket

# Assess formal hypotheses and obligation coverage. This record retains the authority ceiling of a assessment occurrence.
type IsabelleMathematicalReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by ReviewPhysicsFidelity in isabelle_physics_derivation_trace_loop.
type IsabellePhysicsCase:
    # Reviewed theory supplied to ReviewPhysicsFidelity.
    theory: IsabelleTheory
    # Reviewed physics context supplied to ReviewPhysicsFidelity.
    physical_model: PhysicalModel

# Assess preservation of the intended physical meaning. This record retains the authority ceiling of a assessment occurrence.
type IsabellePhysicsReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by ReviewIsabelleProcess in isabelle_physics_derivation_trace_loop.
type IsabelleReflectionCase:
    # Reviewed formal assessment supplied to ReviewIsabelleProcess.
    math_review: IsabelleMathematicalReview
    # Reviewed physical assessment supplied to ReviewIsabelleProcess.
    physics_review: IsabellePhysicsReview

# Record process lessons without changing the artifact's authority. This record retains the authority ceiling of a reflection occurrence.
type IsabelleProcessReview:
    # Scope-bound comparisons among the supplied trajectories or reviews.
    comparisons: List[String]
    # Defeasible hypotheses suggested by the comparison.
    improvement_hypotheses: List[String]
    # Limits on generalizing the reflective result.
    limitations: List[String]

# Reviewed domain inputs required by ReportIsabellePhysics in isabelle_physics_derivation_trace_loop.
type IsabelleAcceptanceCase:
    # Reviewed theory supplied to ReportIsabellePhysics.
    theory: IsabelleTheory
    # Reviewed formal assessment supplied to ReportIsabellePhysics.
    math_review: IsabelleMathematicalReview
    # Reviewed physical assessment supplied to ReportIsabellePhysics.
    physics_review: IsabellePhysicsReview
    # Reviewed process reflection supplied to ReportIsabellePhysics.
    process_review: IsabelleProcessReview

# Assign a scoped Isabelle physics report. This record retains the authority ceiling of a decision occurrence.
type IsabellePhysicsDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
