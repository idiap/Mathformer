# Domain-specific result of mathlib.grounding_maximize within the named artifact_acceptance_loop workflow.
type ArtifactAcceptanceMathlibGroundingMaximizeArtifact:
    # Exact subject processed by the mathlib.grounding_maximize occurrence.
    subject: String
    # Source anchors retained by the mathlib.grounding_maximize occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical mathlib.grounding_maximize contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to mathlib.grounding_maximize.
    gate_disposition: String
    # Known limitations that constrain use of the mathlib.grounding_maximize result.
    limitations: List[String]
    # Retrieved or extracted candidates with retained identifiers.
    candidate_references: List[String]
    # Named retrieval, parsing, or grounding basis used for selection.
    selection_basis: String
    # Relevant candidates excluded together with their stated reason.
    exclusions: List[String]

# Domain-specific result of audit.compatibility within the named artifact_acceptance_loop workflow.
type ArtifactAcceptanceAuditCompatibilityArtifact:
    # Exact subject processed by the audit.compatibility occurrence.
    subject: String
    # Source anchors retained by the audit.compatibility occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical audit.compatibility contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to audit.compatibility.
    gate_disposition: String
    # Known limitations that constrain use of the audit.compatibility result.
    limitations: List[String]
    # Named criteria applied by this scoped assessment.
    criteria: List[String]
    # Scoped findings with no authority beyond their cited grounds.
    findings: List[String]
    # Non-authoritative repairs proposed for identified findings.
    recommended_repairs: List[String]

