# Produce a review identity with controlled imports and source-aware comments. This record retains the authority ceiling of a candidate occurrence.
type ReviewArtifact:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the candidate.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Relate artifact concepts and imports to applicable mathlib declarations. This record retains the authority ceiling of a grounding occurrence.
type ArtifactMathlibGrounding:
    # Items with scope-bound applicability or semantic alignment.
    aligned_items: List[String]
    # Candidates rejected by the grounding criteria.
    rejected_candidates: List[String]
    # Concepts for which grounding remains unresolved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by AuditMathlibCompatibility in artifact_acceptance_loop.
type CompatibilityCase:
    # Reviewed review artifact supplied to AuditMathlibCompatibility.
    review_artifact: ReviewArtifact
    # Reviewed mathlib grounding supplied to AuditMathlibCompatibility.
    mathlib_grounding: ArtifactMathlibGrounding

# Assess abstraction and API compatibility against the established grounding. This record retains the authority ceiling of a assessment occurrence.
type CompatibilityCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Conservatively reconstruct statements and proof summaries from the Lean artifact. This record retains the authority ceiling of a interpretation occurrence.
type LeanMeaning:
    # Domain meanings explicitly attributed to the source.
    interpreted_meanings: List[String]
    # Assumptions required by the interpretation.
    assumptions: List[String]
    # Regimes that bound use of the interpretation.
    validity_regimes: List[String]

# Reviewed domain inputs required by CheckDeclarationShape in artifact_acceptance_loop.
type ShapeReviewCase:
    # Reviewed review artifact supplied to CheckDeclarationShape.
    review_artifact: ReviewArtifact
    # Reviewed lean meaning supplied to CheckDeclarationShape.
    lean_meaning: LeanMeaning

# Assess preservation of conditional, existential, uniqueness, and equivalence structure. This record retains the authority ceiling of a assessment occurrence.
type ShapeCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckProofIntegrity in artifact_acceptance_loop.
type ProofReviewCase:
    # Reviewed review artifact supplied to CheckProofIntegrity.
    review_artifact: ReviewArtifact
    # Reviewed lean meaning supplied to CheckProofIntegrity.
    lean_meaning: LeanMeaning

# Assess reverse proof packets for placeholders, circularity, and proof-shape contradictions. This record retains the authority ceiling of a assessment occurrence.
type ProofCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckSourceFidelity in artifact_acceptance_loop.
type SourceReviewCase:
    # Reviewed review artifact supplied to CheckSourceFidelity.
    review_artifact: ReviewArtifact
    # Reviewed lean meaning supplied to CheckSourceFidelity.
    lean_meaning: LeanMeaning

# Assess agreement among source claims, comments, reverse meaning, and Lean signatures. This record retains the authority ceiling of a assessment occurrence.
type SourceCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckNonvacuity in artifact_acceptance_loop.
type NonvacuityReviewCase:
    # Reviewed review artifact supplied to CheckNonvacuity.
    review_artifact: ReviewArtifact
    # Reviewed lean meaning supplied to CheckNonvacuity.
    lean_meaning: LeanMeaning

# Assess axioms, false-premise vacuity, target-restating hypotheses, and trivial wrappers. This record retains the authority ceiling of a assessment occurrence.
type NonvacuityCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Assess declaration collisions and divergent concept families across the artifact corpus. This record retains the authority ceiling of a assessment occurrence.
type CorpusCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CalibrateArtifactAcceptance in artifact_acceptance_loop.
type ArtifactAcceptanceCase:
    # Reviewed review artifact supplied to CalibrateArtifactAcceptance.
    review_artifact: ReviewArtifact
    # Reviewed mathlib grounding supplied to CalibrateArtifactAcceptance.
    mathlib_grounding: ArtifactMathlibGrounding
    # Reviewed compatibility check supplied to CalibrateArtifactAcceptance.
    compatibility_check: CompatibilityCheck
    # Reviewed lean meaning supplied to CalibrateArtifactAcceptance.
    lean_meaning: LeanMeaning
    # Reviewed shape check supplied to CalibrateArtifactAcceptance.
    shape_check: ShapeCheck
    # Reviewed proof check supplied to CalibrateArtifactAcceptance.
    proof_check: ProofCheck
    # Reviewed source check supplied to CalibrateArtifactAcceptance.
    source_check: SourceCheck
    # Reviewed nonvacuity check supplied to CalibrateArtifactAcceptance.
    nonvacuity_check: NonvacuityCheck
    # Reviewed corpus check supplied to CalibrateArtifactAcceptance.
    corpus_check: CorpusCheck

# Aggregate required layers and realness findings into a scoped acceptance disposition. This record retains the authority ceiling of a decision occurrence.
type ArtifactDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
