from materialization import ArtifactAcceptanceLoop
from artifact_acceptance_loop import LeanArtifactAcceptanceRequest, LeanArtifactAcceptanceDecision

def run_material(workflow_source: LeanArtifactAcceptanceRequest) -> Computed[LeanArtifactAcceptanceDecision]:
    return solve ArtifactAcceptanceLoop(workflow_source)
