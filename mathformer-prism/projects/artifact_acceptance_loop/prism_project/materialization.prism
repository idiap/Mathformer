    review_artifact = review_artifact_reasoning_agent,
    mathlib_grounding = mathlib_grounding_reasoning_agent,
    mathlib_grounding_by = mathlib_grounding_reasoning_relation_builder,
    compatibility_check = compatibility_check_reasoning_agent,
    compatibility_check_by = compatibility_check_reasoning_relation_builder,
    lean_meaning = lean_meaning_reasoning_agent,
    lean_meaning_by = lean_meaning_reasoning_relation_builder,
    shape_check = shape_check_reasoning_agent,
    shape_check_by = shape_check_reasoning_relation_builder,
    proof_check = proof_check_reasoning_agent,
    proof_check_by = proof_check_reasoning_relation_builder,
    source_check = source_check_reasoning_agent,
    source_check_by = source_check_reasoning_relation_builder,
    nonvacuity_check = nonvacuity_check_reasoning_agent,
    nonvacuity_check_by = nonvacuity_check_reasoning_relation_builder,
    corpus_check = corpus_check_reasoning_agent,
    corpus_check_by = corpus_check_reasoning_relation_builder,
    acceptance_status = acceptance_status_reasoning_agent,
    acceptance_status_by = acceptance_status_reasoning_relation_builder,
)

