# post-generation import minimization, compatibility audit, reverse informalization consistency, declaration-shape/non-vacuity/cross-file consistency, line-comment guard, realness gate, unified consistency report, and statistics.
workflow ArtifactAcceptanceLoop(
    workflow_source: LeanArtifactAcceptanceRequest,
) -> Computed[LeanArtifactAcceptanceDecision]:
    sequence:
        [annotate_line_comment_guard: annotate_line_comment_guard_material_binding(workflow_source)]
        [mathlib_import_minimize: mathlib_import_minimize_material_binding(annotate_line_comment_guard.value)]
        [mathlib_grounding_maximize: mathlib_grounding_maximize_material_binding(mathlib_import_minimize.value)]
        [audit_compatibility: audit_compatibility_material_binding(mathlib_grounding_maximize.value)]
        [postformalization_informalize: postformalization_informalize_material_binding(audit_compatibility.value)]
        [consistency_declaration_shape: consistency_declaration_shape_material_binding(postformalization_informalize.value)]
        [postformalization_informal_internal_consistency: postformalization_informal_internal_consistency_material_binding(consistency_declaration_shape.value)]
        [postformalization_informal_consistency: postformalization_informal_consistency_material_binding(postformalization_informal_internal_consistency.value)]
        [consistency_nonvacuity: consistency_nonvacuity_material_binding(postformalization_informal_consistency.value)]
        [consistency_cross_file_concepts: consistency_cross_file_concepts_material_binding(consistency_nonvacuity.value)]
        [consistency_unified_report: consistency_unified_report_material_binding(consistency_cross_file_concepts.value)]
        [artifact_realness_gate: artifact_realness_gate_material_binding(consistency_unified_report.value)]
        [artifact_statistics: artifact_statistics_material_binding(artifact_realness_gate.value)]
        [evaluation_rfde_report: evaluation_rfde_report_material_binding(artifact_statistics.value)]
        [library_documentation: library_documentation_material_binding(evaluation_rfde_report.value)]
        [library_aligned_html_documentation: library_aligned_html_documentation_material_binding(library_documentation.value)]
    return library_aligned_html_documentation
