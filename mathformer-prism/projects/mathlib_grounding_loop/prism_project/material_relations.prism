type SynthesizesMathlibCompatibilityLoopCertificate:
    source: MathlibGroundingMathlibVerifyArtifact
    target: Generated[MathlibGroundingMathlibCompatibilityLoopArtifact]

relation SynthesizesMathlibCompatibilityLoop(
    source: MathlibGroundingMathlibVerifyArtifact,
    target: Generated[MathlibGroundingMathlibCompatibilityLoopArtifact],
) -> SynthesizesMathlibCompatibilityLoopCertificate

type GroundsMathlibWebGroundingLoopCertificate:
    source: MathlibGroundingMathlibWebEvidenceArtifact
    target: Generated[MathlibGroundingMathlibWebGroundingLoopArtifact]

relation GroundsMathlibWebGroundingLoop(
    source: MathlibGroundingMathlibWebEvidenceArtifact,
    target: Generated[MathlibGroundingMathlibWebGroundingLoopArtifact],
) -> GroundsMathlibWebGroundingLoopCertificate

type RecommendsMathlibApiPlanCertificate:
    source: MathlibGroundingMathlibGroundingMaximizeArtifact
    target: Generated[MathlibGroundingMathlibApiPlanArtifact]

relation RecommendsMathlibApiPlan(
    source: MathlibGroundingMathlibGroundingMaximizeArtifact,
    target: Generated[MathlibGroundingMathlibApiPlanArtifact],
) -> RecommendsMathlibApiPlanCertificate
