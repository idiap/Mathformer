from materialization import converted_reasoning
from reasoning import GroundLeanAPIs
from mathlib_grounding_loop import LeanFormalizationConceptDemand, GroundingDisposition

def run_reasoning(
    workflow_source: LeanFormalizationConceptDemand,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[GroundingDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    flow = converted_reasoning(workflow_source)
    return solve GroundLeanAPIs(workflow_source) using flow
