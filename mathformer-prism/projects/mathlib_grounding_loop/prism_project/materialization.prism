    return compute(artifact, procedure = "linked material binding: mathlib_import_context")

# local mathlib, MathformerLib, web grounding, import, and compatibility controls before prompts rely on APIs.
workflow MathlibGroundingLoop(
    workflow_source: LeanFormalizationConceptDemand,
) -> Computed[MathlibGroundingDisposition]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [mathlib_result_existence_search: mathlib_result_existence_search_material_binding(workflow_source)]
        [mathlib_discovery: mathlib_discovery_material_binding(mathlib_result_existence_search.value)]
        [mathlib_ontology_validate: mathlib_ontology_validate_material_binding(mathlib_discovery.value)]
        [mathlib_index_build: mathlib_index_build_material_binding(mathlib_ontology_validate.value)]
        [mathlib_term_annotate: mathlib_term_annotate_material_binding(mathlib_index_build.value)]
        [mathlib_navigation_state: mathlib_navigation_state_material_binding(mathlib_term_annotate.value)]
        [mathlib_hierarchy_navigate: mathlib_hierarchy_navigate_material_binding(mathlib_navigation_state.value)]
        [mathlib_hierarchy_module_tree: mathlib_hierarchy_module_tree_material_binding(mathlib_hierarchy_navigate.value)]
        [mathlib_hierarchy_declaration_neighborhood: mathlib_hierarchy_declaration_neighborhood_material_binding(mathlib_hierarchy_module_tree.value)]
        [mathlib_verify: mathlib_verify_material_binding(mathlib_hierarchy_declaration_neighborhood.value)]
        [mathlib_compatibility_loop: mathlib_compatibility_loop_agent(mathlib_verify.value)]
        [mathlib_coverage: mathlib_coverage_material_binding(mathlib_compatibility_loop.value)]
        [mathlib_web_strategy: mathlib_web_strategy_material_binding(mathlib_coverage.value)]
        [mathlib_web_evidence: mathlib_web_evidence_material_binding(mathlib_web_strategy.value)]
        [mathlib_web_grounding_loop: mathlib_web_grounding_loop_agent(mathlib_web_evidence.value)]
        [mathlib_grounding_maximize: mathlib_grounding_maximize_material_binding(mathlib_web_grounding_loop.value)]
        [mathlib_api_plan: mathlib_api_plan_agent(mathlib_grounding_maximize.value)]
        [mathlib_import_plan: mathlib_import_plan_material_binding(mathlib_api_plan.value)]
        [mathlib_import_context: mathlib_import_context_material_binding(mathlib_import_plan.value)]
    return mathlib_import_context
