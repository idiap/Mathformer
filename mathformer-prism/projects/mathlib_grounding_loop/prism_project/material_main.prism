# Neuro-symbolic AI Group
from materialization import MathlibGroundingLoop
from mathlib_grounding_loop import LeanFormalizationConceptDemand, MathlibGroundingDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[MathlibGroundingDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = LeanFormalizationConceptDemand(
        concepts = ["fixture:mathlib_grounding_loop:concepts"],
        mathlib_revision = "fixture:mathlib_grounding_loop:mathlib_revision",
        target_context = "fixture:mathlib_grounding_loop:target_context",
    )
    return solve MathlibGroundingLoop(workflow_source)
