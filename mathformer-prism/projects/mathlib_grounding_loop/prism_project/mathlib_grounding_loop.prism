# Resolve requested concepts, ambiguity, proof roles, and navigation bounds. This record retains the authority ceiling of a model occurrence.
type ConceptModel:
    # Domain elements represented by the explicit model.
    modeled_elements: List[String]
    # Assumptions retained by the model.
    assumptions: List[String]
    # Limits on adequacy or applicability of the model.
    scope_limits: List[String]

# Observe a version-stamped declaration and import snapshot. This record retains the authority ceiling of a observation occurrence.
type MathlibSnapshot:
    # Source items explicitly observed in the declared scope.
    observed_items: List[String]
    # Stable source anchors retained for the observed items.
    source_anchors: List[String]
    # Source gaps that prevent a complete observation.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by RetrieveMathlibCandidates in mathlib_grounding_loop.
type MathlibSearchBasis:
    # Reviewed concept model supplied to RetrieveMathlibCandidates.
    concept_model: ConceptModel
    # Reviewed mathlib snapshot supplied to RetrieveMathlibCandidates.
    mathlib_snapshot: MathlibSnapshot

# Retrieve candidate declarations without claiming applicability. This record retains the authority ceiling of a retrieval occurrence.
type MathlibCandidateSet:
    # Retrieved candidates without an applicability claim.
    candidates: List[String]
    # References identifying candidate provenance.
    provenance_refs: List[String]
    # Requested items for which no candidate was retrieved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by VerifyMathlibGrounding in mathlib_grounding_loop.
type GroundingVerificationBasis:
    # Reviewed concept model supplied to VerifyMathlibGrounding.
    concept_model: ConceptModel
    # Reviewed mathlib snapshot supplied to VerifyMathlibGrounding.
    mathlib_snapshot: MathlibSnapshot
    # Reviewed candidates supplied to VerifyMathlibGrounding.
    candidates: MathlibCandidateSet

# Establish snapshot-bound applicability using local checks and validated official-source evidence. This record retains the authority ceiling of a grounding occurrence.
type MathlibGroundingEvidence:
    # Items with scope-bound applicability or semantic alignment.
    aligned_items: List[String]
    # Candidates rejected by the grounding criteria.
    rejected_candidates: List[String]
    # Concepts for which grounding remains unresolved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by AssessConceptCoverage in mathlib_grounding_loop.
type MathlibCoverageCase:
    # Reviewed concept model supplied to AssessConceptCoverage.
    concept_model: ConceptModel
    # Reviewed grounding evidence supplied to AssessConceptCoverage.
    grounding_evidence: MathlibGroundingEvidence

# Assess whether every demanded concept has verified coverage or an explicit gap. This record retains the authority ceiling of a assessment occurrence.
type MathlibCoverageCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by PlanLeanAPIs in mathlib_grounding_loop.
type ApiPlanCase:
    # Reviewed concept model supplied to PlanLeanAPIs.
    concept_model: ConceptModel
    # Reviewed grounding evidence supplied to PlanLeanAPIs.
    grounding_evidence: MathlibGroundingEvidence
    # Reviewed coverage check supplied to PlanLeanAPIs.
    coverage_check: MathlibCoverageCheck

# Select verified declarations and narrow imports while isolating unresolved gaps. This record retains the authority ceiling of a plan occurrence.
type LeanApiPlan:
    # Prospective actions that remain unauthoritative until executed.
    proposed_actions: List[String]
    # Dependencies that constrain the proposed actions.
    dependencies: List[String]
    # Checks required after executing the plan.
    revalidation_obligations: List[String]

# Reviewed domain inputs required by AssessImportContext in mathlib_grounding_loop.
type ImportCase:
    # Reviewed api plan supplied to AssessImportContext.
    api_plan: LeanApiPlan
    # Reviewed grounding evidence supplied to AssessImportContext.
    grounding_evidence: MathlibGroundingEvidence

# Assess whether selected declarations work under the intended imports. This record retains the authority ceiling of a assessment occurrence.
type ImportCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CalibrateGroundingStatus in mathlib_grounding_loop.
type GroundingCase:
    # Reviewed grounding evidence supplied to CalibrateGroundingStatus.
    grounding_evidence: MathlibGroundingEvidence
    # Reviewed coverage check supplied to CalibrateGroundingStatus.
    coverage_check: MathlibCoverageCheck
    # Reviewed api plan supplied to CalibrateGroundingStatus.
    api_plan: LeanApiPlan
    # Reviewed import check supplied to CalibrateGroundingStatus.
    import_check: ImportCheck

# Return verified coverage, explicit gaps, or a blocked status without promoting retrieval candidates. This record retains the authority ceiling of a decision occurrence.
type GroundingDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
