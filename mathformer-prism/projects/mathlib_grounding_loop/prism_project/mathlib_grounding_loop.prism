# Neuro-symbolic AI Group
# Domain-specific source boundary for the named mathlib_grounding_loop Mathformer workflow.
type LeanFormalizationConceptDemand:
    # Concepts and declarations required by the proposed Lean artifact.
    concepts: List[String]
    # Exact mathlib revision against which grounding is requested.
    mathlib_revision: String
    # Lean import and namespace context constraining candidate APIs.
    target_context: String

# Domain-specific result of mathlib.result_existence_search within the named mathlib_grounding_loop workflow.
type MathlibGroundingMathlibResultExistenceSearchArtifact:
    # Exact subject processed by the mathlib.result_existence_search occurrence.
    subject: String
    # Source anchors retained by the mathlib.result_existence_search occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical mathlib.result_existence_search contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to mathlib.result_existence_search.
    gate_disposition: String
    # Known limitations that constrain use of the mathlib.result_existence_search result.
    limitations: List[String]
    # Retrieved or extracted candidates with retained identifiers.
    candidate_references: List[String]
    # Named retrieval, parsing, or grounding basis used for selection.
    selection_basis: String
    # Relevant candidates excluded together with their stated reason.
    exclusions: List[String]

