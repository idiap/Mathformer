# Generative interpretation AssessLibraryCandidates uses skill context selected from material steps: artifact_realness_gate.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: autoformalization-result-realness-verifier.
agent assessment_reasoning_agent(
    task: MathformerLibraryCandidateSet,
) -> Result[Generated[CandidateAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[MathformerLibraryCandidateSet] = [assessment_reasoning_skill_1]

