# Generative interpretation PublishLibraryUpdate uses skill context selected from material steps: library_aligned_html_documentation.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: mathformer-library-docs-generator.
agent update_reasoning_agent(
    task: PublicationBasis,
) -> Result[Generated[MathformerLibUpdate], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[PublicationBasis] = [update_reasoning_skill_1]

converted_reasoning = UpdateMathformerLib(
    assessment = assessment_reasoning_agent,
    promotion = promotion_reasoning_agent,
    promotion_by = promotion_reasoning_relation_builder,
    placement = placement_reasoning_agent,
    placement_by = placement_reasoning_relation_builder,
    registry = registry_reasoning_agent,
    registry_by = registry_reasoning_relation_builder,
    documentation = documentation_reasoning_agent,
    documentation_by = documentation_reasoning_relation_builder,
    update = update_reasoning_agent,
    update_by = update_reasoning_relation_builder,
)

# Material binding descriptor for `autoformalization-result-realness-verifier`; this does not execute the linked native resource.
def artifact_realness_gate_material_binding(source: MathformerLibraryCandidateSet) -> Computed[MathformerlibAccumulationArtifactRealnessGateArtifact]:
    artifact = MathformerlibAccumulationArtifactRealnessGateArtifact(
        subject = "typed material binding for artifact_realness_gate",
        source_anchors = ["skills/SKILL_HOOKS.yaml"],
        declared_artifacts = ["see hook-coverage.json"],
        gate_disposition = "not_executed_by_structural_fixture",
        limitations = ["native implementation not executed by the structural fixture"],
        considered_dispositions = ["pass", "warn", "fail", "blocked"],
        selected_disposition = "not_tested",
        rationale = "native execution is outside this structural PRISM fixture",
    )
    return compute(artifact, procedure = "linked material binding: artifact_realness_gate")

