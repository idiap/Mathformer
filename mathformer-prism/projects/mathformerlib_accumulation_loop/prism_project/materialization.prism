# controlled accumulation into the parallel MathformerLib library.
workflow MathformerlibAccumulationLoop(
    candidates: MathformerLibraryCandidateSet,
) -> Computed[MathformerLibraryAccumulationDisposition]:
    sequence:
        [artifact_realness_gate: artifact_realness_gate_material_binding(candidates)]
        [mathformerlib_promotion_gate: mathformerlib_promotion_gate_material_binding(artifact_realness_gate.value)]
        [mathformerlib_accumulate: mathformerlib_accumulate_material_binding(mathformerlib_promotion_gate.value)]
        [mathformerlib_registry: mathformerlib_registry_material_binding(mathformerlib_accumulate.value)]
        [library_documentation: library_documentation_material_binding(mathformerlib_registry.value)]
        [library_aligned_html_documentation: library_aligned_html_documentation_material_binding(library_documentation.value)]
    return library_aligned_html_documentation
