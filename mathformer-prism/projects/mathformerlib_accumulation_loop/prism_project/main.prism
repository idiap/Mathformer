from materialization import converted_reasoning
from reasoning import UpdateMathformerLib
from mathformerlib_accumulation_loop import MathformerLibraryCandidateSet, MathformerLibUpdate

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MathformerLibUpdate], ModelFailure] ! {AI.Generate, Context.Disclose}:
    candidates = MathformerLibraryCandidateSet(
        candidate_paths = ["fixture:mathformerlib_accumulation_loop:candidate_paths"],
        registry_revision = "fixture:mathformerlib_accumulation_loop:registry_revision",
        promotion_policy = "fixture:mathformerlib_accumulation_loop:promotion_policy",
    )
    flow = converted_reasoning(candidates)
    return solve UpdateMathformerLib(candidates) using flow
