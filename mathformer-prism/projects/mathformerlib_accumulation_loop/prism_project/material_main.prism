from materialization import MathformerlibAccumulationLoop
from mathformerlib_accumulation_loop import MathformerLibraryCandidateSet, MathformerLibraryAccumulationDisposition

def main() -> Computed[MathformerLibraryAccumulationDisposition]:
    candidates = MathformerLibraryCandidateSet(
        candidate_paths = ["fixture:mathformerlib_accumulation_loop:candidate_paths"],
        registry_revision = "fixture:mathformerlib_accumulation_loop:registry_revision",
        promotion_policy = "fixture:mathformerlib_accumulation_loop:promotion_policy",
    )
    return solve MathformerlibAccumulationLoop(candidates)
