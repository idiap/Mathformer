# Generative interpretation ApplyControlGate uses skill context selected from material steps: control_gate_policy.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: gate-policy-controller.
agent control_status_reasoning_agent(
    task: ControlCase,
) -> Result[Generated[ControlDisposition], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ControlCase] = [control_status_reasoning_skill_1]

converted_reasoning = ValidateMathformerControl(
    contract_check = contract_check_reasoning_agent,
    route_check = route_check_reasoning_agent,
    route_check_by = route_check_reasoning_relation_builder,
    flow_check = flow_check_reasoning_agent,
    flow_check_by = flow_check_reasoning_relation_builder,
    coverage_check = coverage_check_reasoning_agent,
    coverage_check_by = coverage_check_reasoning_relation_builder,
    log_check = log_check_reasoning_agent,
    log_check_by = log_check_reasoning_relation_builder,
    control_status = control_status_reasoning_agent,
    control_status_by = control_status_reasoning_relation_builder,
)

# Material binding descriptor for `workflow-contract-validator`; this does not execute the linked native resource.
def control_workflow_contract_material_binding(source: MathformerControlSurfaceSnapshot) -> Computed[ControlValidationControlWorkflowContractArtifact]:
    artifact = ControlValidationControlWorkflowContractArtifact(
        subject = "typed material binding for control_workflow_contract",
        source_anchors = ["skills/SKILL_HOOKS.yaml"],
        declared_artifacts = ["see hook-coverage.json"],
        gate_disposition = "not_executed_by_structural_fixture",
        limitations = ["native implementation not executed by the structural fixture"],
        operation_summary = "linked material operation control_workflow_contract",
        evidence_references = [],
    )
    return compute(artifact, procedure = "linked material binding: control_workflow_contract")

