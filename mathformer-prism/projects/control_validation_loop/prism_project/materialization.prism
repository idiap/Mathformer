# core contract, coverage, reasoning-log, and gate normalization checks.
workflow ControlValidationLoop(
    workflow_source: MathformerControlSurfaceSnapshot,
) -> Computed[MathformerControlValidationDecision]:
    sequence:
        [control_workflow_contract: control_workflow_contract_material_binding(workflow_source)]
        [control_workflow_router: control_workflow_router_material_binding(control_workflow_contract.value)]
        [control_reasoning_flow_language: control_reasoning_flow_language_material_binding(control_workflow_router.value)]
        [control_skill_hook_coverage: control_skill_hook_coverage_material_binding(control_reasoning_flow_language.value)]
        [control_reasoning_log_schema: control_reasoning_log_schema_material_binding(control_skill_hook_coverage.value)]
        [control_gate_policy: control_gate_policy_material_binding(control_reasoning_log_schema.value)]
    return control_gate_policy
