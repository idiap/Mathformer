# Generative interpretation AuditWorkflowContract uses skill context selected from material steps: control_workflow_contract.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: workflow-contract-validator.
agent contract_check_reasoning_agent(
    task: MathformerControlSurfaceSnapshot,
) -> Result[Generated[ContractCheck], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[MathformerControlSurfaceSnapshot] = [contract_check_reasoning_skill_1]

