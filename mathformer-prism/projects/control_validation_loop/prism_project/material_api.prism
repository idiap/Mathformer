from materialization import ControlValidationLoop
from control_validation_loop import MathformerControlSurfaceSnapshot, MathformerControlValidationDecision

def run_material(workflow_source: MathformerControlSurfaceSnapshot) -> Computed[MathformerControlValidationDecision]:
    return solve ControlValidationLoop(workflow_source)
