from materialization import converted_reasoning
from reasoning import ValidateMathformerControl
from control_validation_loop import MathformerControlSurfaceSnapshot, ControlDisposition

def run_reasoning(
    workflow_source: MathformerControlSurfaceSnapshot,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[ControlDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    flow = converted_reasoning(workflow_source)
    return solve ValidateMathformerControl(workflow_source) using flow
