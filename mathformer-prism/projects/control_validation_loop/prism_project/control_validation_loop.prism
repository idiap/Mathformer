# Assess hook, owner, routing, and shared-runtime integrity against the canonical contract. This record retains the authority ceiling of a assessment occurrence.
type ContractCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckWorkflowRoutes in control_validation_loop.
type RoutingCheckBasis:
    # Reviewed workflow source supplied to CheckWorkflowRoutes.
    workflow_source: MathformerControlSurfaceSnapshot
    # Reviewed contract check supplied to CheckWorkflowRoutes.
    contract_check: ContractCheck

# Assess whether every controlled workflow family remains reachable from natural language. This record retains the authority ceiling of a assessment occurrence.
type RouteCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckReasoningFlows in control_validation_loop.
type FlowCheckBasis:
    # Reviewed workflow source supplied to CheckReasoningFlows.
    workflow_source: MathformerControlSurfaceSnapshot
    # Reviewed contract check supplied to CheckReasoningFlows.
    contract_check: ContractCheck

# Assess typed handles, licensed relations, calibrated endpoints, and registry alignment. This record retains the authority ceiling of a assessment occurrence.
type FlowCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckSkillCoverage in control_validation_loop.
type CoverageCheckBasis:
    # Reviewed workflow source supplied to CheckSkillCoverage.
    workflow_source: MathformerControlSurfaceSnapshot
    # Reviewed contract check supplied to CheckSkillCoverage.
    contract_check: ContractCheck

# Assess whether skills, hooks, owners, and named loops remain fully connected. This record retains the authority ceiling of a assessment occurrence.
type CoverageCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CheckReasoningLogs in control_validation_loop.
type LogCheckBasis:
    # Reviewed workflow source supplied to CheckReasoningLogs.
    workflow_source: MathformerControlSurfaceSnapshot
    # Reviewed contract check supplied to CheckReasoningLogs.
    contract_check: ContractCheck

# Assess reasoning-log structure, event identity, skill attribution, and hook identity. This record retains the authority ceiling of a assessment occurrence.
type LogCheck:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by CalibrateControlStatus in control_validation_loop.
type ControlCase:
    # Reviewed contract check supplied to CalibrateControlStatus.
    contract_check: ContractCheck
    # Reviewed route check supplied to CalibrateControlStatus.
    route_check: RouteCheck
    # Reviewed flow check supplied to CalibrateControlStatus.
    flow_check: FlowCheck
    # Reviewed coverage check supplied to CalibrateControlStatus.
    coverage_check: CoverageCheck
    # Reviewed log check supplied to CalibrateControlStatus.
    log_check: LogCheck

# Apply blocking and waiver policy without turning validation results into new evidence. This record retains the authority ceiling of a decision occurrence.
type ControlDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
