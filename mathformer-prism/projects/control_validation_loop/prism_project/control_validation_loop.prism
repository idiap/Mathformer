# Neuro-symbolic AI Group
# Domain-specific source boundary for the named control_validation_loop Mathformer workflow.
type MathformerControlSurfaceSnapshot:
    # Digest of the canonical hook and loop-contract registry.
    hook_registry_digest: String
    # Digest of the controlled natural-language routing registry.
    routing_registry_digest: String
    # Ordered control checks requested for this validation run.
    requested_checks: List[String]

# Domain-specific result of control.workflow_contract within the named control_validation_loop workflow.
type ControlValidationControlWorkflowContractArtifact:
    # Exact subject processed by the control.workflow_contract occurrence.
    subject: String
    # Source anchors retained by the control.workflow_contract occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical control.workflow_contract contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to control.workflow_contract.
    gate_disposition: String
    # Known limitations that constrain use of the control.workflow_contract result.
    limitations: List[String]
    # Summary of the linked material operation represented by this record.
    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

# Domain-specific result of control.workflow_router within the named control_validation_loop workflow.
type ControlValidationControlWorkflowRouterArtifact:
    # Exact subject processed by the control.workflow_router occurrence.
    subject: String
    # Source anchors retained by the control.workflow_router occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical control.workflow_router contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to control.workflow_router.
    gate_disposition: String
    # Known limitations that constrain use of the control.workflow_router result.
    limitations: List[String]
    # Dispositions considered by the named workflow gate.
    considered_dispositions: List[String]
    # Policy-selected disposition without creating object-level evidence.
    selected_disposition: String
    # Scope-bounded rationale for the selected operational disposition.
    rationale: String

