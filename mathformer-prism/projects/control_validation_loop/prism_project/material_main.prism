from materialization import ControlValidationLoop
from control_validation_loop import MathformerControlSurfaceSnapshot, MathformerControlValidationDecision

def main() -> Computed[MathformerControlValidationDecision]:
    workflow_source = MathformerControlSurfaceSnapshot(
        hook_registry_digest = "fixture:control_validation_loop:hook_registry_digest",
        routing_registry_digest = "fixture:control_validation_loop:routing_registry_digest",
        requested_checks = ["fixture:control_validation_loop:requested_checks"],
    )
    return solve ControlValidationLoop(workflow_source)
