type CalibrateControlCertificate[SourceValue, TargetValue]:
    source: SourceValue
    target: TargetValue

relation CalibrateControl[SourceValue, TargetValue](
    source: SourceValue,
    target: TargetValue,
) -> CalibrateControlCertificate[SourceValue, TargetValue]

