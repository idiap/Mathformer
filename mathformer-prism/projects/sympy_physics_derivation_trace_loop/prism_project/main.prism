from materialization import converted_reasoning
from reasoning import ReconstructWithSympy
from sympy_physics_derivation_trace_loop import PhysicsSympyDerivationRequest, SympyPhysicsDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[SympyPhysicsDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = PhysicsSympyDerivationRequest(
        source_derivation = "fixture:sympy_physics_derivation_trace_loop:source_derivation",
        physical_context = "fixture:sympy_physics_derivation_trace_loop:physical_context",
        target_quantity = "fixture:sympy_physics_derivation_trace_loop:target_quantity",
    )
    flow = converted_reasoning(workflow_source)
    return solve ReconstructWithSympy(workflow_source) using flow
