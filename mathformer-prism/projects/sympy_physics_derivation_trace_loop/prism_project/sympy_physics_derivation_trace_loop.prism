# Domain-specific source boundary for the named sympy_physics_derivation_trace_loop Mathformer workflow.
type PhysicsSympyDerivationRequest:
    # Source-anchored informal physics derivation to represent in SymPy.
    source_derivation: String
    # Units, dimensions, frames, regimes, and assumptions in scope.
    physical_context: String
    # Physical quantity or equation targeted by the derivation.
    target_quantity: String

# Domain-specific result of physics.sympy.goal_sample.plan within the named sympy_physics_derivation_trace_loop workflow.
type SympyPhysicsDerivationTracePhysicsSympyGoalSamplePlanArtifact:
    # Exact subject processed by the physics.sympy.goal_sample.plan occurrence.
    subject: String
    # Source anchors retained by the physics.sympy.goal_sample.plan occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical physics.sympy.goal_sample.plan contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to physics.sympy.goal_sample.plan.
    gate_disposition: String
    # Known limitations that constrain use of the physics.sympy.goal_sample.plan result.
    limitations: List[String]
    # Prospective directives that remain unauthoritative until executed.
    directives: List[String]
    # Dependencies that constrain ordering or feasibility of the plan.
    dependencies: List[String]
    # Current blockers that prevent safe execution of plan directives.
    blockers: List[String]

