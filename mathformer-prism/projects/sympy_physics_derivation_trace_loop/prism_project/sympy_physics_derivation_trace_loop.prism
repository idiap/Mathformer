# Recover source-anchored laws, assumptions, regimes, and intended target. This record retains the authority ceiling of an interpretation occurrence.
type SourceDerivationModel:
    # Domain meanings explicitly attributed to the source.
    interpreted_meanings: List[String]
    # Assumptions required by the source_model.
    assumptions: List[String]
    # Regimes that bound use of the source_model.
    validity_regimes: List[String]

# Model quantities, units, dimensions, regimes, and frames. This record retains the authority ceiling of a context occurrence.
type PhysicalModel:
    # Domain elements fixed by this explicit context.
    context_elements: List[String]
    # Constraints governing use of the context.
    constraints: List[String]
    # Assumptions carried by the context.
    assumptions: List[String]

# Reviewed domain inputs required by ExpandDerivationSteps in sympy_physics_derivation_trace_loop.
type SympyDerivationBasis:
    # Reviewed source_model supplied to ExpandDerivationSteps.
    source_model: SourceDerivationModel
    # Reviewed physics context supplied to ExpandDerivationSteps.
    physical_model: PhysicalModel

# Propose explicit bridges for detected derivation gaps without claiming proof. This record retains the authority ceiling of a candidate occurrence.
type ExpandedDerivation:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the sympy_artifact.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Reviewed domain inputs required by PlanSympyDerivation in sympy_physics_derivation_trace_loop.
type SympyGroundingBasis:
    # Reviewed completed derivation supplied to PlanSympyDerivation.
    expanded_steps: ExpandedDerivation
    # Reviewed physics context supplied to PlanSympyDerivation.
    physical_model: PhysicalModel

# Align the physical model with applicable SymPy APIs and assumptions. This record retains the authority ceiling of a grounding occurrence.
type SympyDerivationPlan:
    # Items with scope-bound applicability or semantic alignment.
    aligned_items: List[String]
    # Candidates rejected by the grounding criteria.
    rejected_candidates: List[String]
    # Concepts for which grounding remains unresolved.
    unresolved_gaps: List[String]

# Reviewed domain inputs required by DraftSympyDerivation in sympy_physics_derivation_trace_loop.
type SympyPhysicsBasis:
    # Reviewed completed derivation supplied to DraftSympyDerivation.
    expanded_steps: ExpandedDerivation
    # Reviewed physics context supplied to DraftSympyDerivation.
    physical_model: PhysicalModel
    # Reviewed sympy grounding supplied to DraftSympyDerivation.
    sympy_plan: SympyDerivationPlan

# Construct the executable physics derivation sympy_artifact. This record retains the authority ceiling of a candidate occurrence.
type SympyDerivationArtifact:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the sympy_artifact.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Record execution results and their source_model. This record retains the authority ceiling of a evidence occurrence.
type SympyExecutionReport:
    # Inspectible references to evidence in the declared scope.
    evidence_refs: List[String]
    # Results directly observed by the bounded probe or execution.
    observed_results: List[String]
    # Limits on what the evidence can establish.
    limitations: List[String]

# Reviewed domain inputs required by ReviewSympyMathematics in sympy_physics_derivation_trace_loop.
type SympyFormalReviewCase:
    # Reviewed sympy_artifact supplied to ReviewSympyMathematics.
    sympy_artifact: SympyDerivationArtifact
    # Reviewed run evidence supplied to ReviewSympyMathematics.
    execution_report: SympyExecutionReport

# Assess steps, units, samples, and final mathematical equations. This record retains the authority ceiling of a assessment occurrence.
type SympyMathematicalReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by ReviewPhysicsFidelity in sympy_physics_derivation_trace_loop.
