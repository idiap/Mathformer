    # Reviewed physics context supplied to ReviewPhysicsFidelity.
    physical_model: PhysicalModel
    # Reviewed run evidence supplied to ReviewPhysicsFidelity.
    execution_report: SympyExecutionReport

# Assess physical meaning, dimensions, regimes, and governing laws. This record retains the authority ceiling of a assessment occurrence.
type SympyPhysicsReview:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by RouteSympyRepairs in sympy_physics_derivation_trace_loop.
type SympyRepairCase:
    # Reviewed sympy_artifact supplied to RouteSympyRepairs.
    sympy_artifact: SympyDerivationArtifact
    # Reviewed formal assessment supplied to RouteSympyRepairs.
    math_review: SympyMathematicalReview
    # Reviewed physical assessment supplied to RouteSympyRepairs.
    physics_review: SympyPhysicsReview

# Record a bounded revision and its explicit revalidation obligations. This record retains the authority ceiling of a candidate occurrence.
type SympyRepairRoute:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the sympy_artifact.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Probe the revised outcome over the declared grounded sample. This record retains the authority ceiling of a evidence occurrence.
type SampleCoverageReview:
    # Inspectible references to evidence in the declared scope.
    evidence_refs: List[String]
    # Results directly observed by the bounded probe or execution.
    observed_results: List[String]
    # Limits on what the evidence can establish.
    limitations: List[String]

# Reviewed domain inputs required by ReportSympyPhysics in sympy_physics_derivation_trace_loop.
type SympyPhysicsCase:
    # Reviewed repair outcome supplied to ReportSympyPhysics.
    repair_route: SympyRepairRoute
    # Reviewed grounded sample supplied to ReportSympyPhysics.
    sample_review: SampleCoverageReview
    # Reviewed formal assessment supplied to ReportSympyPhysics.
    math_review: SympyMathematicalReview
    # Reviewed physical assessment supplied to ReportSympyPhysics.
    physics_review: SympyPhysicsReview

# Assign a scoped status while preserving revalidation obligations after revision. This record retains the authority ceiling of a decision occurrence.
type SympyPhysicsDisposition:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
