from materialization import SympyPhysicsDerivationTraceLoop
from sympy_physics_derivation_trace_loop import PhysicsSympyDerivationRequest, PhysicsSympyConsistencyAssessment

def run_material(
    workflow_source: PhysicsSympyDerivationRequest,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[PhysicsSympyConsistencyAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve SympyPhysicsDerivationTraceLoop(workflow_source)
