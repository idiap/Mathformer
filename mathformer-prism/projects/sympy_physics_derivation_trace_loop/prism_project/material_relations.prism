type TestsCritiquePhysicsSympySemanticsCertificate:
    source: SympyPhysicsDerivationTracePhysicsNumericSampleArtifact
    target: Generated[SympyPhysicsDerivationTraceCritiquePhysicsSympySemanticsArtifact]

relation TestsCritiquePhysicsSympySemantics(
    source: SympyPhysicsDerivationTracePhysicsNumericSampleArtifact,
    target: Generated[SympyPhysicsDerivationTraceCritiquePhysicsSympySemanticsArtifact],
) -> TestsCritiquePhysicsSympySemanticsCertificate

