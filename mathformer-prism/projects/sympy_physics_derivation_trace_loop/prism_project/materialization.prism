# executable physics derivation autoformalization over SymPy using anchored source extraction, informal expansion, quantity binding, equation surfaces, contextual assumptions, dimensional and unit modeling, implicit gap closure, physical law grounding, artifact execution, execution interpretation, equational semantics critics, final equation reviewers, localized monotonic refinement, numeric sanity sampling, and reference-free consistency metrics.
workflow SympyPhysicsDerivationTraceLoop(
    workflow_source: PhysicsSympyDerivationRequest,
) -> Computed[PhysicsSympyConsistencyAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [physics_sympy_goal_sample_plan: physics_sympy_goal_sample_plan_material_binding(workflow_source)]
        [physics_sympy_source_only_run: physics_sympy_source_only_run_material_binding(physics_sympy_goal_sample_plan.value)]
        [physics_dependencies_probe: physics_dependencies_probe_material_binding(physics_sympy_source_only_run.value)]
        [physics_source_extract: physics_source_extract_material_binding(physics_dependencies_probe.value)]
        [physics_informal_elicit: physics_informal_elicit_material_binding(physics_source_extract.value)]
        [physics_informal_expand: physics_informal_expand_material_binding(physics_informal_elicit.value)]
        [physics_informal_review: physics_informal_review_material_binding(physics_informal_expand.value)]
        [physics_symbols_build: physics_symbols_build_material_binding(physics_informal_review.value)]
        [physics_dimensions_model: physics_dimensions_model_material_binding(physics_symbols_build.value)]
        [physics_units_ground: physics_units_ground_material_binding(physics_dimensions_model.value)]
        [physics_equations_parse: physics_equations_parse_material_binding(physics_units_ground.value)]
        [physics_regimes_model: physics_regimes_model_material_binding(physics_equations_parse.value)]
        [physics_frames_build: physics_frames_build_material_binding(physics_regimes_model.value)]
        [physics_gaps_detect: physics_gaps_detect_material_binding(physics_frames_build.value)]
        [physics_gaps_expand: physics_gaps_expand_material_binding(physics_gaps_detect.value)]
        [physics_laws_ground: physics_laws_ground_material_binding(physics_gaps_expand.value)]
        [physics_sympy_library_grounding_build: physics_sympy_library_grounding_build_material_binding(physics_laws_ground.value)]
        [physics_sympy_workflow_plan: physics_sympy_workflow_plan_material_binding(physics_sympy_library_grounding_build.value)]
        [physics_sympy_equation_surface_build: physics_sympy_equation_surface_build_material_binding(physics_sympy_workflow_plan.value)]
        [physics_sympy_assumptions_encode: physics_sympy_assumptions_encode_material_binding(physics_sympy_equation_surface_build.value)]
        [draft_physics_sympy_derivation: draft_physics_sympy_derivation_material_binding(physics_sympy_assumptions_encode.value)]
        [execute_physics_sympy_derivation: execute_physics_sympy_derivation_material_binding(draft_physics_sympy_derivation.value)]
        [execute_physics_sympy_interpret: execute_physics_sympy_interpret_material_binding(execute_physics_sympy_derivation.value)]
        [physics_units_verify: physics_units_verify_material_binding(execute_physics_sympy_interpret.value)]
        [physics_steps_verify: physics_steps_verify_material_binding(physics_units_verify.value)]
        [physics_numeric_sample: physics_numeric_sample_material_binding(physics_steps_verify.value)]
        [critique_physics_sympy_semantics: critique_physics_sympy_semantics_agent(physics_numeric_sample.value)]
        [critique_physics_sympy_dimensions: critique_physics_sympy_dimensions_material_binding(critique_physics_sympy_semantics.value)]
        [review_physics_sympy_final_equations: review_physics_sympy_final_equations_material_binding(critique_physics_sympy_dimensions.value)]
        [review_mathematical_sympy_final_equations: review_mathematical_sympy_final_equations_material_binding(review_physics_sympy_final_equations.value)]
        [physics_sympy_design_guard_review: physics_sympy_design_guard_review_agent(review_mathematical_sympy_final_equations.value)]
        [refine_physics_sympy_review: refine_physics_sympy_review_agent(physics_sympy_design_guard_review.value)]
        [physics_sympy_repair_expansion_map: physics_sympy_repair_expansion_map_material_binding(refine_physics_sympy_review.value)]
        [physics_sympy_recursive_repair_control: physics_sympy_recursive_repair_control_material_binding(physics_sympy_repair_expansion_map.value)]
        [physics_sympy_grounded_sample_thoroughness: physics_sympy_grounded_sample_thoroughness_material_binding(physics_sympy_recursive_repair_control.value)]
        [consistency_physics_derivation_report: consistency_physics_derivation_report_material_binding(physics_sympy_grounded_sample_thoroughness.value)]
    return consistency_physics_derivation_report
