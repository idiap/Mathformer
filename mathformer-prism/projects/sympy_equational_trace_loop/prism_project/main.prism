from materialization import converted_reasoning
from reasoning import TraceSympyEquations
from sympy_equational_trace_loop import SympyEquationFormalizationRequest, SympyConsistencyReport

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[SympyConsistencyReport], ModelFailure] ! {AI.Generate, Context.Disclose}:
    workflow_source = SympyEquationFormalizationRequest(
        equations = ["fixture:sympy_equational_trace_loop:equations"],
        symbol_assumptions = ["fixture:sympy_equational_trace_loop:symbol_assumptions"],
        target_identity = "fixture:sympy_equational_trace_loop:target_identity",
    )
    flow = converted_reasoning(workflow_source)
    return solve TraceSympyEquations(workflow_source) using flow
