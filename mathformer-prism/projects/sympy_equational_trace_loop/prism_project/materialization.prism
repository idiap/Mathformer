# executable symbolic algebra autoformalization over SymPy using source parsing, assumption modeling, local API grounding, symbolic validation, bounded counterexample search, trace verification, and reference-free consistency metrics.
workflow SympyEquationalTraceLoop(
    workflow_source: SympyEquationFormalizationRequest,
) -> Computed[SympyEquationalTraceAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        [sympy_dependencies_probe: sympy_dependencies_probe_material_binding(workflow_source)]
        [sympy_api_docs_index: sympy_api_docs_index_material_binding(sympy_dependencies_probe.value)]
        [sympy_expression_parse: sympy_expression_parse_material_binding(sympy_api_docs_index.value)]
        [sympy_assumptions_model: sympy_assumptions_model_material_binding(sympy_expression_parse.value)]
        [sympy_grounding_navigate: sympy_grounding_navigate_material_binding(sympy_assumptions_model.value)]
        [draft_sympy_initial: draft_sympy_initial_agent(sympy_grounding_navigate.value)]
        [execute_sympy_initial: execute_sympy_initial_material_binding(draft_sympy_initial.value)]
        [sympy_identity_validate: sympy_identity_validate_material_binding(execute_sympy_initial.value)]
        [sympy_counterexample_search: sympy_counterexample_search_material_binding(sympy_identity_validate.value)]
        [sympy_trace_verify: sympy_trace_verify_material_binding(sympy_counterexample_search.value)]
        [consistency_sympy_report: consistency_sympy_report_material_binding(sympy_trace_verify.value)]
    return consistency_sympy_report
