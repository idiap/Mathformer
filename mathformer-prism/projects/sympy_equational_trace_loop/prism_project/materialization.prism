) -> Result[Generated[SympyExecutionReport], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[SympyArtifact] = [execution_report_reasoning_skill_1]

# Generative interpretation ValidateSympyTrace uses skill context selected from material steps: sympy_identity_validate, sympy_counterexample_search, sympy_trace_verify.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: sympy-identity-validator, sympy-counterexample-searcher, sympy-transformation-trace-verifier.
agent validation_report_reasoning_agent(
    task: SympyTraceCase,
) -> Result[Generated[SympyValidationReport], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[SympyTraceCase] = [validation_report_reasoning_skill_1, validation_report_reasoning_skill_2, validation_report_reasoning_skill_3]

# Generative interpretation ReportSympyConsistency uses skill context selected from material steps: consistency_sympy_report.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: sympy-consistency-report-orchestrator.
agent report_reasoning_agent(
    task: SympyAssessmentCase,
) -> Result[Generated[SympyConsistencyReport], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[SympyAssessmentCase] = [report_reasoning_skill_1]

converted_reasoning = TraceSympyEquations(
    equations = equations_reasoning_agent,
    sympy_context = sympy_context_reasoning_agent,
    sympy_artifact = sympy_artifact_reasoning_agent,
    sympy_artifact_by = sympy_artifact_reasoning_relation_builder,
    execution_report = execution_report_reasoning_agent,
    execution_report_by = execution_report_reasoning_relation_builder,
    validation_report = validation_report_reasoning_agent,
    validation_report_by = validation_report_reasoning_relation_builder,
    report = report_reasoning_agent,
    report_by = report_reasoning_relation_builder,
)

