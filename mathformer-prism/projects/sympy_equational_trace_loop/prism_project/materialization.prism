) -> Result[Generated[SympyArtifact], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[SympyDraftBasis] = [sympy_artifact_reasoning_skill_1]

# Generative interpretation RunSympyArtifact uses skill context selected from material steps: execute_sympy_initial.
# The detailed material steps execute only through material_main.prism; this agent does not claim their evidence.
# Reviewed skill composition: sympy-execution-runner.
agent execution_report_reasoning_agent(
