# Neuro-symbolic AI Group
# Domain-specific source boundary for the named sympy_equational_trace_loop Mathformer workflow.
type SympyEquationFormalizationRequest:
    # Mathematical equations selected for SymPy formalization.
    equations: List[String]
    # Declared assumptions constraining symbols and transformations.
    symbol_assumptions: List[String]
    # Identity or result that execution and counterexample search assess.
    target_identity: String

# Domain-specific result of sympy.dependencies.probe within the named sympy_equational_trace_loop workflow.
type SympyEquationalTraceSympyDependenciesProbeArtifact:
    # Exact subject processed by the sympy.dependencies.probe occurrence.
    subject: String
    # Source anchors retained by the sympy.dependencies.probe occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical sympy.dependencies.probe contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to sympy.dependencies.probe.
    gate_disposition: String
    # Known limitations that constrain use of the sympy.dependencies.probe result.
    limitations: List[String]
    # Summary of the linked material operation represented by this record.
    operation_summary: String
    # References to evidence that a native execution may later produce.
    evidence_references: List[String]

# Domain-specific result of sympy.api_docs.index within the named sympy_equational_trace_loop workflow.
type SympyEquationalTraceSympyApiDocsIndexArtifact:
    # Exact subject processed by the sympy.api_docs.index occurrence.
    subject: String
    # Source anchors retained by the sympy.api_docs.index occurrence.
    source_anchors: List[String]
    # Artifact labels declared by the canonical sympy.api_docs.index contract.
    declared_artifacts: List[String]
    # Disposition under the explicit gate attached to sympy.api_docs.index.
    gate_disposition: String
    # Known limitations that constrain use of the sympy.api_docs.index result.
    limitations: List[String]
    # Retrieved or extracted candidates with retained identifiers.
    candidate_references: List[String]
    # Named retrieval, parsing, or grounding basis used for selection.
    selection_basis: String
    # Relevant candidates excluded together with their stated reason.
    exclusions: List[String]

