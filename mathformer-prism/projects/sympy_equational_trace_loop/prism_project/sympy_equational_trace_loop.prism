# Expose equations, symbols, and the exact identity under investigation. This record retains the authority ceiling of a model occurrence.
type ParsedEquations:
    # Domain elements represented by the explicit model.
    modeled_elements: List[String]
    # Assumptions retained by the model.
    assumptions: List[String]
    # Limits on adequacy or applicability of the model.
    scope_limits: List[String]

# Model assumptions and establish scope-bound API applicability. This record retains the authority ceiling of a context occurrence.
type SympyGroundingContext:
    # Domain elements fixed by this explicit context.
    context_elements: List[String]
    # Constraints governing use of the context.
    constraints: List[String]
    # Assumptions carried by the context.
    assumptions: List[String]

# Reviewed domain inputs required by DraftSympyArtifact in sympy_equational_trace_loop.
type SympyDraftBasis:
    # Reviewed equation structure supplied to DraftSympyArtifact.
    equations: ParsedEquations
    # Reviewed symbolic context supplied to DraftSympyArtifact.
    sympy_context: SympyGroundingContext

# Construct an executable candidate while retaining validation obligations. This record retains the authority ceiling of a candidate occurrence.
type SympyArtifact:
    # Candidate artifacts produced for later checks.
    candidate_artifacts: List[String]
    # Source requirements explicitly retained by the candidate.
    preserved_requirements: List[String]
    # Validation obligations that remain open.
    open_obligations: List[String]

# Record the result supported by execution and identity validation. This record retains the authority ceiling of a evidence occurrence.
type SympyExecutionReport:
    # Inspectible references to evidence in the declared scope.
    evidence_refs: List[String]
    # Results directly observed by the bounded probe or execution.
    observed_results: List[String]
    # Limits on what the evidence can establish.
    limitations: List[String]

# Reviewed domain inputs required by ValidateSympyTrace in sympy_equational_trace_loop.
type SympyTraceCase:
    # Reviewed sympy_artifact supplied to ValidateSympyTrace.
    sympy_artifact: SympyArtifact
    # Reviewed symbolic result supplied to ValidateSympyTrace.
    execution_report: SympyExecutionReport

# Search bounded counterexamples and verify the transformation trace. This record retains the authority ceiling of a assessment occurrence.
type SympyValidationReport:
    # Named criteria applied by this assessment.
    criteria: List[String]
    # Criterion-scoped findings supported by cited inputs.
    findings: List[String]
    # Findings that block the named downstream use.
    blockers: List[String]

# Reviewed domain inputs required by ReportSympyConsistency in sympy_equational_trace_loop.
type SympyAssessmentCase:
    # Reviewed symbolic result supplied to ReportSympyConsistency.
    execution_report: SympyExecutionReport
    # Reviewed trace evidence supplied to ReportSympyConsistency.
    validation_report: SympyValidationReport

# Assign a scoped result status without treating bounded nonrefutation as proof. This record retains the authority ceiling of a decision occurrence.
type SympyConsistencyReport:
    # Scoped policy status selected by calibration.
    status: String
    # Blocking findings retained by the decision.
    blockers: List[String]
    # Limits on interpreting or using the decision.
    limitations: List[String]
