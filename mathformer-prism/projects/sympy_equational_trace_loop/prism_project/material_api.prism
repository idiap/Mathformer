from materialization import SympyEquationalTraceLoop
from sympy_equational_trace_loop import SympyEquationFormalizationRequest, SympyEquationalTraceAssessment

def run_material(
    workflow_source: SympyEquationFormalizationRequest,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Computed[SympyEquationalTraceAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve SympyEquationalTraceLoop(workflow_source)
