[Unit]
Description=Mathformer independent MCP service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/mathformer
ExecStart=%h/mathformer/.venv/bin/python scripts/mathformer_mcp_service.py --config config/mathformer_mcp.local.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
