{
  "schema_version": "mathformer.meta_skills.generated_skill_lifecycle.schema.v0.1",
  "states": [
    "draft",
    "task_local_validated",
    "repeated_use_candidate",
    "promoted",
    "quarantined",
    "deprecated"
  ],
  "required": [
    "schema_version",
    "generated_skill_id",
    "state",
    "task_id",
    "artifacts",
    "promotion_boundary",
    "required_evidence",
    "promotion_gate"
  ],
  "required_artifacts_for_task_local_validation": [
    "SKILL.md",
    "QUALITY_CARD.json",
    "EVAL.json",
    "EVOLUTION_LOG.md",
    "run_trace.jsonl",
    "seeded_defect_result.json"
  ],
  "promotion_gate_required": [
    "current_state",
    "target_state",
    "allowed",
    "required_repeated_use_count",
    "observed_repeated_use_count",
    "blocking_conditions"
  ]
}
